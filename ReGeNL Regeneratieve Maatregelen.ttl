practice:R1-0035 a skos:Concept ;
    dcterms:identifier "PRACTICE_R1_0035" ;
    skos:broader practice:meso-9f7398758c93bc3a ;
    skos:changeNote "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; formele benamingen aangescherpt; nieuwe afbeelding nodig."@nl ;
    skos:definition "The deliberate adjustment of sowing and/or planting dates to give the crop a competitive advantage over weeds, for example by better aligning crop establishment with soil and climatic conditions or with expected weed pressure."@en,
        "Het doelgericht aanpassen van het zaai- en/of plantmoment om het gewas een concurrentievoordeel te geven ten opzichte van onkruid, bijvoorbeeld door de gewasontwikkeling beter af te stemmen op bodem- en klimaatomstandigheden of op de verwachte onkruiddruk."@nl ;
    skos:inScheme practice:scheme ;
    skos:notation "Micro" ;
    skos:prefLabel "Altered sowing and planting dates"@en,
        "Aangepaste zaai- en plantdata"@nl ;
