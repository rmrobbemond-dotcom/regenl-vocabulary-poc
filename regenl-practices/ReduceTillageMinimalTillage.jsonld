        "nl": "Ondiepe grondbewerking"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MinimumTillage",
      "prefLabel": {
        "en": "Minimum tillage",
        "nl": "Minimale grondbewerking"
      }
    },
    {
