        vocab:NoResidualStreams,
        vocab:SelfSufficiency,
        vocab:UseLocalInputs,
        vocab:UseOfNaturalRenewableResources,
        vocab:UseOfResidualMaterials ;
    skos:notation "Meso" ;
    skos:prefLabel "Reduce external inputs"@en,
        "Externe inputs verminderen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Sheep_under_solar_panels_(1)_2025-07-26.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows solar panels over agricultural land with sheep. It illustrates the combination of renewable energy and agricultural land use as an aspect of the practice “Reduce external inputs”."@en,
        "De foto toont zonnepanelen boven landbouwgrond met schapen. Zo wordt de combinatie van hernieuwbare energie en agrarisch landgebruik zichtbaar als onderdeel van de praktijk ‘Externe inputs verminderen’."@nl ;
    schema:creditText "Foto: Andy Li (CC0 1.0)."@nl .

vocab:SoilAmendments a skos:Concept ;
