vocab: a skos:ConceptScheme ;
    dct:description "SKOS publication representation derived from the ReGeNL ontology. Hierarchical levels: Mega, Macro, Meso, Micro, Nano. Labels and definitions are copied from the source where present; missing text is not generated."@en ;
    dct:title "ReGeNL – regenerative practices (PoC)"@en,
        "ReGeNL – regeneratieve landbouwpraktijken (PoC)"@nl ;
    skos:definition "Controlled vocabulary of regenerative practice classifications in the ReGeNL programme. This publication is a draft for review."@en,
        "Gecontroleerde begrippenlijst van classificaties van regeneratieve landbouwpraktijken in ReGeNL. Deze publicatie is een concept voor beoordeling."@nl ;
    skos:hasTopConcept vocab:Biodigester,
        vocab:Bioeconomy,
        vocab:CropProductionManagement,
        vocab:CropProductionManagementGrasslandManagement,
        vocab:ExtendedGrazingTimeMinimumOf1500HoursYear,
        vocab:ExtendedGrazingTimeMinimumOf720HoursYearMaximumOf1500HoursPerYear,
        vocab:FinancialManagement,
        vocab:InfraAndEquipmentManagement,
        vocab:LandManagement,
        vocab:LivestockManagementAnimalHusbandryMega,
        vocab:PeopleManagement,
        vocab:SolarPannels ;
    skos:prefLabel "ReGeNL regenerative practice framework"@en,
        "ReGeNL raamwerk regeneratieve landbouwpraktijken"@nl .

