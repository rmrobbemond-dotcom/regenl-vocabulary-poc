vocab:SolarPannels a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Sheep_under_solar_panels_(1)_2025-07-26.jpg> ;
    skos:broader vocab:RenewableEnergy ;
    skos:definition "Installing or using photovoltaic panels that convert sunlight into electricity for farm operations or export to the grid."@en,
        "Het plaatsen of benutten van fotovoltaïsche zonnepanelen die zonlicht omzetten in elektriciteit voor bedrijfsgebruik of levering aan het net."@nl ;
