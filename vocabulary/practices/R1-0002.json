{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/R1-0002",
  "type": "Concept",
  "prefLabel": {
    "nl": "Vermindering van het gebruik van chemische producten (fungiciden) die volgens de biologische regelgeving niet zijn toegestaan",
    "en": "Reduction in use of chemical products (fungicides) not allowed by organic regulations"
  },
  "definition": {
    "nl": "Het verminderen van de frequentie of hoeveelheid van toepassingen van fungiciden die niet zijn toegestaan binnen de biologische landbouw.",
    "en": "Reducing the frequency or quantity of applications of fungicides that are not permitted under organic farming regulations."
  },
  "changeNote": {
    "nl": [
      "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; afbeelding voorlopig behouden en gemarkeerd voor vervanging."
    ]
  },
  "editorialNote": {
    "en": [
      "Not really a practice. Needs to be replaced by other practices"
    ]
  },
  "notation": [
    "Micro"
  ],
  "broader": {
    "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/meso-2a4f6215769a1b7b",
    "prefLabel": {
      "nl": "Vermindering van niet-biologisch toegestane insecticiden en fungiciden",
      "en": "Reduction of chemical products (insecticides/fungicides) not allowed by organic regulations"
    }
  },
