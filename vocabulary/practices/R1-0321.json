{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/R1-0321",
  "type": "Concept",
  "prefLabel": {
    "nl": "Lokale inputs gebruiken",
    "en": "Use local inputs"
  },
  "definition": {
    "nl": "Het voorrang geven aan materialen, voer, zaden of andere productiemiddelen van het eigen bedrijf of uit de regio om aanvoerketens te verkorten.",
    "en": "Prioritising materials, feed, seeds or other production inputs sourced on the farm or within the local region to shorten supply chains."
  },
  "editorialNote": {
    "nl": [
      "Dubbele bronrij van R1-0318; behouden voor traceerbaarheid, niet selecteerbaar."
    ]
  },
  "notation": [
    "Micro"
  ],
  "broader": {
