vocab:ReduceTillageMinimalTillage a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilManagement ;
    skos:definition "Reducing the frequency, depth or area of mechanical soil cultivation compared with conventional tillage to limit soil disturbance."@en,
