vocab:ExtensiveCropRotations a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Plodozmian.jpg> ;
    skos:broader vocab:CropManagament ;
    skos:definition "Using rotations with more crops or longer intervals before the same crop returns, potentially including soil-restoring crops and fallow phases."@en,
