practice:R1-0011 a skos:Concept ;
    dcterms:identifier "PRACTICE_R1_0011" ;
    skos:broader practice:meso-f31d4e5e55d878b1 ;
    skos:changeNote "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; Nederlandse voorkeursbenaming gecorrigeerd van ‘Vanggewassen’ naar ‘Lokgewassen’; nieuwe afbeelding nodig."@nl ;
    skos:definition "The deliberate cultivation of crops that preferentially attract specific pest organisms away from the main crop in order to reduce pest pressure on that crop."@en,
        "Het doelgericht telen van gewassen die specifieke plaagorganismen sterker aantrekken dan het hoofdgewas, met als doel deze organismen van het hoofdgewas weg te lokken en de plaagdruk daarop te verminderen."@nl ;
    skos:inScheme practice:scheme ;
    skos:notation "Micro" ;
    skos:prefLabel "Trap crops"@en,
        "Lokgewassen"@nl ;
    regenlmeta:classificationLevel "Micro" ;
    regenlmeta:definitionStatus "user-reviewed" ;
    regenlmeta:farmerContentSource "Geplakte tekst(20261124-142404).txt" ;
    regenlmeta:farmerDescription "Growing crops that attract harmful insects away from the main crop."@en,
