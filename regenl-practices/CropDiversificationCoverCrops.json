  "type": "Concept",
  "prefLabel": {
    "nl": "Gewasdiversificatie met bodembedekkers",
    "en": "Crop diversification -Cover crops:"
  },
  "definition": {
    "nl": "Gewassen die worden geteeld voor agronomische of milieu/ ecologische doeleinden, aanvullend op een hoofdgewas",
    "en": "the inclusion of plants grown for agronomic or environmental purposes in addition to the main crop on a land management unit"
  },
  "changeNote": {
    "nl": [
      "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch meso. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."
    ]
  },
  "editorialNote": {
    "nl": [
      "Nederlandse vertaling is een redactioneel voorstel op basis van de bestaande Engelstalige bron en moet nog worden gevalideerd."
    ]
  },
  "historyNote": {
    "nl": [
      "Voorgaande PoC-definitie (nl): Het telen van een aanvullend gewas voor landbouwkundige of milieukundige doeleinden naast of tussen de hoofdteelten."
    ]
  },
