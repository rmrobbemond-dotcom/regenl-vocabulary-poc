{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CropDiversificationIntercroppingPolycultureNoMonocultureCompanionPlanting",
  "type": "Concept",
  "prefLabel": {
    "en": "Crop diversification - Intercropping/ polyculture / no monoculture / companion planting",
    "nl": "Gewasdiversificatie met mengteelt, polycultuur en combinatieteelt"
  },
  "definition": {
    "en": "Intercropping consists of growing several crops (annual or perennial) simultaneously in the same field for a significant amount of time, each crop developing and growing according to its physiology.",
    "nl": "Classificatieonderdeel binnen het ReGeNL-raamwerk voor regeneratieve landbouwpraktijken dat betrekking heeft op gewasdiversificatie met mengteelt, polycultuur en combinatieteelt. De precieze afbakening en eventuele toepassingscriteria moeten nog door domeinexperts worden vastgesteld."
  },
  "editorialNote": {
    "nl": [
      "Nederlandstalig label en omschrijving zijn voorstellen voor de PoC en zijn nog niet gevalideerd door de harmonisatietaakgroep."
    ]
  },
  "notation": [
    "Meso"
  ],
  "narrower": [
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MixedIntercroppingMixedCropping",
