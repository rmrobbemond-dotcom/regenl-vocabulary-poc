{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/R1-0015",
  "type": "Concept",
  "prefLabel": {
    "nl": "Aanleg van ecologische infrastructuur voor natuurlijke vijanden",
    "en": "Creating ecological infrastructure to shelter predators"
  },
  "definition": {
    "nl": "Het doelgericht aanleggen van ecologische infrastructuur, zoals hagen, akkerranden en struweel, die natuurlijke vijanden van gewasplagen schuilplaatsen, overwinteringsmogelijkheden of geschikte leefomstandigheden biedt ter ondersteuning van biologische plaagbeheersing.",
    "en": "The deliberate establishment of ecological infrastructure, such as hedgerows, field margins and scrub patches, providing natural enemies of crop pests with shelter, overwintering sites or suitable habitat conditions to support biological pest management."
  },
  "changeNote": {
    "nl": [
      "Annotaties, formele naamswijziging en selecteerbaarheid goedgekeurd tijdens conceptreview; afbeelding kandidaat 1 overgenomen, visuele controle en licentiecontrole nog nodig. Hiërarchische positie behouden voor latere review."
    ]
  },
  "notation": [
    "Micro"
  ],
  "broader": {
    "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/meso-1c38510133a39039",
    "prefLabel": {
      "nl": "Push-pull-plaagbeheer",
      "en": "Push-pull pest manamgent"
    }
  },
  "inScheme": [
    {
