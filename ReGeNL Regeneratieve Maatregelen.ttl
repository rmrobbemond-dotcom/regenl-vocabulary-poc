vocab:UsingOrganicFertilizers a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:UseOfSpecificFertilizerTypesOrManure ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Applying fertilising materials derived from plant or animal sources, such as manure or compost, to supply nutrients and often organic matter."@en,
        "Het toedienen van bemestende materialen uit plantaardige of dierlijke bronnen, zoals mest of compost, voor nutriënten en vaak organische stof."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Using organic fertilizers"@en,
        "Organische meststoffen gebruiken"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9286755_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Using organic fertilizers'."@en,
        "Het toepassen van meststoffen van organische aard"@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:Vermicompost a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:UseOfSpecificFertilizerTypesOrManure ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Using organic material decomposed and processed with the help of earthworms and microorganisms as a soil amendment or fertiliser."@en,
        "Het gebruiken van organisch materiaal dat met behulp van regenwormen en micro-organismen is afgebroken en omgezet als bodemverbeteraar of meststof."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Vermicompost"@en,
        "Wormencompost"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9284810_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Vermicompost'."@en,
        "Het gebruik van Wormenkweek/vermicompost als meststof"@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:VoisinRationalGrazing a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg> ;
    skos:broader vocab:GrazingSystem ;
    skos:definition "A planned rotational grazing method based on adequate pasture recovery periods, short occupation times and allocating forage according to livestock needs."@en,
        "Een planmatige vorm van rotatiebeweiding gebaseerd op voldoende herstelperiodes van gras, korte bezettingsduur en afstemming van het grasaanbod op de behoeften van het vee."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Voisin rational grazing"@en,
        "Rationeel beweiden volgens Voisin"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9285405_2 ;
    regenlmeta:definitionReference <https://pmc.ncbi.nlm.nih.gov/articles/PMC8698051/> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "VRG can be defined as a rational method for managing the soil–plant–animal complex through direct grazing and well-planned pasture rotation. the VRG follows four principles (1ste. recovery period, occupation, maximum performance, regualr performance)"@en,
        "Een planmatige vorm van rotatiebeweiding waarin de graas- en herstelperioden worden afgestemd op de groei van het gras en de beweidingsbehoefte van de dieren."@nl ;
    schema:creditText "Foto: Jeff Vanuga / USDA NRCS (publiek domein in de Verenigde Staten)."@nl .

vocab:WalkingTrailsOnFarmLandCamping a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Saddlescombe_farm_campsite_2025-08-26.jpg> ;
    skos:broader vocab:Agrotourism ;
    skos:definition "Providing recreational access, walking routes or camping facilities on agricultural land while coordinating visitor use with farming operations."@en,
        "Het aanbieden van wandelroutes, recreatieve toegang of kampeervoorzieningen op landbouwgrond, afgestemd op de reguliere bedrijfsvoering."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Walking trails on farm land, camping,"@en,
        "Wandelpaden en kamperen op landbouwgrond"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Saddlescombe_farm_campsite_2025-08-26.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9288739_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Wikimedia Commons, kamperen op landbouwgrond (controleer bron en licentie)." .

vocab:WaterBuffers a skos:Concept ;
