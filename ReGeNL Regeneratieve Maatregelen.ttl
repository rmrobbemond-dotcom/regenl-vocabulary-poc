practice:R1-0029 a skos:Concept ;
    dcterms:identifier "PRACTICE_R1_0029" ;
    skos:broader practice:meso-55ab0520b8c7ba93 ;
    skos:changeNote "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; Nederlandse voorkeursbenaming aangepast naar Bodemsolarisatie; nieuwe afbeelding nodig."@nl ;
    skos:definition "The deliberate increase of soil temperature by covering moist soil with transparent film for a defined period, using solar radiation to reduce the germination capacity, growth or survival of weeds and other unwanted soil organisms."@en,
        "Het doelgericht verhogen van de bodemtemperatuur door vochtige grond gedurende een bepaalde periode af te dekken met transparante folie, waarbij zonnestraling wordt benut om de kiemkracht, groei of overleving van onkruiden en andere ongewenste bodemorganismen te beperken."@nl ;
    skos:inScheme practice:scheme ;
    skos:notation "Micro" ;
    skos:prefLabel "Soil solarisation"@en,
        "Bodemsolarisatie"@nl ;
    regenlmeta:classificationLevel "Micro" ;
    regenlmeta:definitionStatus "user-reviewed" ;
    regenlmeta:farmerContentSource "Geplakte tekst(20261124-142404).txt" ;
    regenlmeta:farmerDescription "Covering moist soil with transparent film so that solar heat suppresses weed seeds and other unwanted soil organisms."@en,
        "Het afdekken van vochtige grond met transparante folie, zodat de zon de bodem sterk opwarmt en onkruidzaden en andere ongewenste bodemorganismen worden bestreden."@nl ;
    regenlmeta:farmerDescriptionStatus "user-reviewed" ;
    regenlmeta:farmerLabel "Apply soil solarisation"@en,
        "Bodem verwarmen met zonnewarmte (solarisatie)"@nl ;
    regenlmeta:farmerTopic "Weed management"@en,
        "Onkruidbeheer"@nl ;
    regenlmeta:originalPracticeIdentifier "PRACTICE_R1_0029" ;
