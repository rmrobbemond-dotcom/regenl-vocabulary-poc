practice:R1-0033 a skos:Concept ;
    dcterms:identifier "PRACTICE_R1_0033" ;
    skos:broader practice:meso-9f7398758c93bc3a ;
    skos:changeNote "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; formele benaming aangescherpt; nieuwe afbeelding nodig."@nl ;
    skos:definition "The selection and cultivation of crop varieties with traits that suppress the establishment, growth or competitive ability of weeds, for example through rapid early growth, strong ground cover, greater crop competitiveness or favourable crop architecture."@en,
        "Het selecteren en telen van gewasrassen met eigenschappen die de vestiging, groei of concurrentiekracht van onkruid beperken, bijvoorbeeld door snelle beginontwikkeling, sterke bodembedekking, hogere concurrentiekracht of een gunstige gewasarchitectuur."@nl ;
    skos:inScheme practice:scheme ;
    skos:notation "Micro" ;
    skos:prefLabel "Weed-suppressive varieties"@en,
        "Onkruidonderdrukkende rassen"@nl ;
    regenlmeta:classificationLevel "Micro" ;
    regenlmeta:definitionStatus "user-reviewed" ;
    regenlmeta:farmerContentSource "Geplakte tekst(20261124-142404).txt" ;
    regenlmeta:farmerDescription "Choosing crop varieties that give weeds less chance by growing quickly or covering the soil well."@en,
        "Het kiezen van gewasrassen die door snelle groei of goede bodembedekking onkruid minder kans geven."@nl ;
    regenlmeta:farmerDescriptionStatus "user-reviewed" ;
    regenlmeta:farmerLabel "Choose weed-suppressive varieties"@en,
        "Onkruidonderdrukkende rassen kiezen"@nl ;
    regenlmeta:farmerTopic "Weed management"@en,
        "Onkruidbeheer"@nl ;
    regenlmeta:originalPracticeIdentifier "PRACTICE_R1_0033" ;
    regenlmeta:originalPracticeLabel "Varieties tolerant of weeds"@en,
        "Onkruidbestendige rassen"@nl ;
