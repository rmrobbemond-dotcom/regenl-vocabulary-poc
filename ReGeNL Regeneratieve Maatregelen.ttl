    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a farm shop. It illustrates the sale of farm products to consumers as an aspect of the practice “Private brand”."@en,
        "De foto toont een boerderijwinkel. Zo wordt de verkoop van landbouwproducten aan consumenten zichtbaar als onderdeel van de praktijk ‘Eigen merk’."@nl ;
    schema:creditText "Foto: Wikimedia Commons, boerderijwinkel (controleer bron en licentie)." .

vocab:ProductiveMultispeciesSward a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg> ;
    skos:broader vocab:GrasslandTypeEnhancedSpeciesRichness ;
    skos:definition "A grassland sward intentionally composed of multiple productive grasses, legumes or herbs that contribute to forage yield and diverse rooting."@en,
        "Een graszode die bewust uit meerdere productieve grassen, vlinderbloemigen of kruiden bestaat voor ruwvoeropbrengst en gevarieerde beworteling."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "productive multispecies sward"@en,
        "Productieve soortenrijke graszode"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows cows grazing outdoors on grassland. It illustrates the use of grassland by grazing livestock as an aspect of the practice “productive multispecies sward”."@en,
        "De foto toont koeien die buiten op grasland grazen. Zo wordt het gebruik van grasland door weidend vee zichtbaar als onderdeel van de praktijk ‘Productieve soortenrijke graszode’."@nl ;
    schema:creditText "Foto: Wikimedia Commons, grazende koeien in de provincie Utrecht (Nederland)." .

vocab:ProtectNativeSpecies a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Flowering_cow_parsley_along_the_field.jpg> ;
    skos:broader vocab:NativeCropAndAnimalSpecies ;
    skos:definition "Applying management measures that conserve or improve the survival of plant and animal species naturally occurring in the region."@en,
        "Het uitvoeren van beheermaatregelen die het voortbestaan van in de regio van nature voorkomende planten- en diersoorten beschermen of verbeteren."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Protect native species"@en,
        "Inheemse soorten beschermen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Flowering_cow_parsley_along_the_field.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows flowering wild plants alongside a field. It illustrates space for flowering vegetation along farmland as an aspect of the practice “Protect native species”."@en,
        "De foto toont bloeiende kruiden langs een perceelrand. Zo wordt ruimte voor bloeiende vegetatie langs landbouwgrond zichtbaar als onderdeel van de praktijk ‘Inheemse soorten beschermen’."@nl ;
    schema:creditText "Foto: Wikimedia Commons, bloemrijke akkerrand met fluitenkruid in Drenthe (Nederland)." .

vocab:ProvideCareFarming a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:De_Marsen_varken_voeren.jpg> ;
