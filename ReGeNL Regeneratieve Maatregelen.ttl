vocab:CatchCrops a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg> ;
    skos:broader vocab:CropDiversificationCoverCrops ;
    skos:definition "fast growing cover crop, grown between successive plantings of a main crop. \" It scavenges the remaining nitrogen after the main crop is harvested, thereby reducing nutrient losses from leaching\" (for undersow see intercropping)"@en,
        "Een snelgroeiend vanggewas dat tussen opeenvolgende hoofdteelten wordt geteeld en resterende nutriënten, met name stikstof, kan opnemen om uitspoeling te beperken."@nl ;
    skos:editorialNote "Nederlandse vertaling is een redactioneel voorstel op basis van de bestaande Engelstalige bron en moet nog worden gevalideerd."@nl ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Catch crops"@en,
        "Vanggewassen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg?width=960> ;
    schema:creditText "Foto: Hugh Venables (Controleer licentie op Commons)."@nl .

