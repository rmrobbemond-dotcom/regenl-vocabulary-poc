{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/IncomeBroadeningPaymentsForEcosystemServices",
  "type": "Concept",
  "prefLabel": {
    "en": "Income broadening- Payments for ecosystem services",
    "nl": "Inkomensverbreding via betalingen voor ecosysteemdiensten"
  },
  "definition": {
    "en": "A classification entry in the ReGeNL regenerative practice framework referring to income broadening- payments for ecosystem services. The precise scope and operational criteria have not yet been validated.",
    "nl": "Classificatieonderdeel binnen het ReGeNL-raamwerk voor regeneratieve landbouwpraktijken dat betrekking heeft op inkomensverbreding via betalingen voor ecosysteemdiensten. De precieze afbakening en eventuele toepassingscriteria moeten nog door domeinexperts worden vastgesteld."
  },
  "editorialNote": {
    "nl": [
      "Nederlandstalig label en omschrijving zijn voorstellen voor de PoC en zijn nog niet gevalideerd door de harmonisatietaakgroep."
    ]
  },
  "notation": [
    "Meso"
  ],
  "narrower": [
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/EcosystemservicePaymentsFromGovernment",
      "prefLabel": {
        "en": "Ecosystemservice payments from government",
        "nl": "Overheidsbetalingen voor ecosysteemdiensten"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SustainabilityCertificationEGOrganicBiodynamicOnTheWayTo",
      "prefLabel": {
        "en": "(Sustainability) certification (e.g. organic, biodynamic, on the way to...)",
        "nl": "Duurzaamheidscertificering (biologisch, biodynamisch enzovoort)"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SustainabilityPaymentsByChainPartners",
      "prefLabel": {
        "en": "Sustainability payments by chain partners",
        "nl": "Duurzaamheidsbetalingen door ketenpartners"
      }
    }
  ],
  "broader": {
    "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/FarmSocioEconomicManagement",
    "prefLabel": {
      "en": "Farm socio-economic management",
      "nl": "Sociaal-economisch bedrijfsbeheer"
    }
  },
