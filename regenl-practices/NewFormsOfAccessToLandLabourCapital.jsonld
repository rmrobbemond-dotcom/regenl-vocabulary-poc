{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NewFormsOfAccessToLandLabourCapital",
  "type": "Concept",
  "prefLabel": {
    "nl": "Nieuwe vormen van toegang tot grond, arbeid en kapitaal",
    "en": "New forms of access to  land, labour, capital"
  },
  "definition": {
    "nl": "Regelingen waarmee boeren via alternatieven voor traditioneel eigendom of krediet toegang krijgen tot grond, arbeid of financiering, zoals coöperaties en gedeeld gebruik.",
    "en": "Arrangements that give farmers access to land, labour or financing through alternatives to conventional ownership or credit, such as cooperatives or shared-use contracts."
  },
  "editorialNote": {
    "en": [
      "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."
    ]
  },
  "notation": [
    "Meso"
  ],
  "narrower": [
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CrowdfundingZoopSharesTimebankingOfLabour",
      "prefLabel": {
        "nl": "Crowdfunding, Zoöp, aandelen en tijdsruil van arbeid",
        "en": "Crowdfunding, zoop, shares, timebanking of labour"
      }
    }
  ],
  "broader": {
    "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/FarmSocioEconomicManagement",
    "prefLabel": {
      "nl": "Sociaal-economisch bedrijfsbeheer",
      "en": "Farm socio-economic management"
    }
  },
