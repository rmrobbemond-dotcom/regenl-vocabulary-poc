vocab:ReductionInGrazingIntensity15LUHaForInstanceForVoluntaryEcoPracticePackages a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg> ;
    skos:broader vocab:ExtensificationOfGrazingManagementAdaptiveGrazingManagementMethod ;
    skos:definition "Reducing grazing pressure by limiting livestock units per hectare, for example to around 1.5 livestock units per hectare where required by a management agreement."@en,
        "Het verlagen van de graasdruk door de veebezetting per hectare te begrenzen, bijvoorbeeld rond 1,5 grootvee-eenheid per hectare wanneer een beheerovereenkomst dat vereist."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:MinimumGrazingPeriodNoOrRestrictedGrazingGrazingLivestockDensityLimitation ;
    skos:notation "Micro" ;
    skos:prefLabel "Reduction in grazing intensity (1.5 LU/ha), for instance for voluntary eco practice packages"@en,
        "Verlagen van beweidingsintensiteit (bijvoorbeeld 1,5 GVE per ha)"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9295223_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "for the ecoregeling , additional payment 2500 hours in 120 days max 3 LU per ha (huiskavel), 1500 hours in 120 days  max 5 LU ha ( huiskavel), for ALNb depending on the region as restriction in the number of LU per grassland site can be restricted"@en ;
    schema:creditText "Foto: Jeff Vanuga / USDA NRCS (publiek domein in de Verenigde Staten)."@nl .

vocab:ReductionOrganicFertilizers a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:ReductionLimitationOfSpecificFertilizers ;
