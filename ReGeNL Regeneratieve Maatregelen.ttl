regenlmeta:photoCaptionStatus a rdf:Property ;
    rdfs:label "Status fotobijschrift"@nl ;
    rdfs:comment "Status van de redactionele en visuele controle van de foto en de bijbehorende toelichting."@nl .

regenlmeta:photoPracticeDescription a rdf:Property ;
    rdfs:label "Beschrijving van de foto in relatie tot de maatregel"@nl ;
    rdfs:comment "Positief geformuleerde Nederlandstalige toelichting bij de afgebeelde landbouwpraktijk."@nl .

vocab:AddingWaterToSlurryManure a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:SpecificFertilizerApplicationTechniques ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Diluting livestock slurry with water before or during application to improve flow and infiltration and potentially reduce ammonia loss under suitable conditions."@en,
        "Het verdunnen van drijfmest met water vóór of tijdens het uitrijden, zodat de mest beter vloeit en infiltreert en onder geschikte omstandigheden minder ammoniak kan vervluchtigen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Adding water to slurry manure"@en,
        "Water toevoegen aan drijfmest"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Adding water to slurry manure'."@en,
        "Water toedienen aan de drijfmest voor effiëntere bemesting en minder vervluchtiging"@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a compost heap containing organic material. It illustrates the collection and processing of organic residual materials as an aspect of the practice “Adding water to slurry manure”."@en,
        "De foto toont een composthoop met organisch materiaal. Zo wordt het verzamelen en verwerken van organische restmaterialen zichtbaar als onderdeel van de praktijk ‘Water toevoegen aan drijfmest’."@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:AfforestationReforestationReplantingTrees a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Schoolkinderen_uit_Halfweg_en_Spaarndam_planten_de_eerste_bomen_van_het_Houtrakbos._NL-HlmNHA_54031775.JPG> ;
    skos:broader vocab:Reforestation ;
    skos:definition "Establishing trees on previously non-forested land, restoring tree cover on deforested land, or replacing lost trees through planting or natural regeneration."@en,
        "Het vestigen van bomen op voorheen onbeboste grond, herstellen van boombedekking na ontbossing of vervangen van verdwenen bomen door aanplant of natuurlijke verjonging."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Afforestation, Reforestation, replanting trees"@en,
        "Bebossing, herbebossing en herplant van bomen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Schoolkinderen_uit_Halfweg_en_Spaarndam_planten_de_eerste_bomen_van_het_Houtrakbos._NL-HlmNHA_54031775.JPG?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “Schoolkinderen uit Halfweg en Spaarndam planten de eerste bomen v”. It illustrates the related agricultural context as an aspect of the practice “Afforestation, Reforestation, replanting trees”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘Schoolkinderen uit Halfweg en Spaarndam planten de eerste bomen v’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Bebossing, herbebossing en herplant van bomen’."@nl .

vocab:Agroforestry a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Agroforestry.jpg> ;
    skos:broader vocab:TreePlanning ;
    skos:definition "Deliberately integrating trees or shrubs with crops and/or livestock on the same land management unit so that the woody and agricultural components interact."@en,
        "Het doelbewust combineren van bomen of struiken met gewassen en/of vee binnen dezelfde beheereenheid, zodat houtige en agrarische onderdelen ecologisch en economisch samenhangen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Agroforestry"@en,
        "Agroforestry"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Agroforestry.jpg?width=960> ;
    regenlmeta:definitionReference <https://www.fao.org/agroforestry/about-agroforestry/overview/> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "Trees stand within an agricultural landscape, illustrating how woody crops or vegetation can be combined with other farming activities."@en,
        "De bomen staan in een agrarische omgeving en laten zien hoe houtige gewassen of beplanting met andere landbouwactiviteiten kunnen worden gecombineerd."@nl ;
    schema:creditText "Foto: NatureDan (CC BY-SA 3.0)."@nl .

vocab:Agrovoltaics a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Agrivoltaics.jpg> ;
    skos:broader vocab:RenewableEnergy ;
    skos:definition "Combining electricity generation from photovoltaic panels with agricultural production on the same area, with a layout that allows crops or livestock beneath or between panels."@en,
        "Het combineren van elektriciteitsopwekking met zonnepanelen en landbouwproductie op hetzelfde grondoppervlak, waarbij gewassen of dieren onder of tussen de panelen ruimte behouden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Agrovoltaics"@en,
        "Agrovoltaïsche systemen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Agrivoltaics.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "Solar panels stand in an agricultural setting, illustrating energy generation on or near agricultural land."@en,
        "Zonnepanelen staan in een agrarische omgeving. Daarmee wordt een toepassing van energieopwekking op of bij landbouwgrond zichtbaar."@nl .

vocab:AlternativeBiocontrolProductUse a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Ladybird_and_aphids.JPG> ;
    skos:broader vocab:NonChemicalControlWeedsPestsAndDiseases ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Using biological control agents or biologically derived products, such as beneficial microorganisms or natural enemies, as alternatives to conventional chemical pest-control products."@en,
        "Het inzetten van biologische bestrijders of biologisch afgeleide middelen, zoals nuttige micro-organismen of natuurlijke vijanden, als alternatief voor gangbare chemische bestrijdingsmiddelen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Alternative biocontrol product use"@en,
        "Gebruik van alternatieve biologische bestrijdingsmiddelen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Ladybird_and_aphids.JPG?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Alternative biocontrol product use'."@en,
        "Alternatieve biologische middelen of biologische bestrijding"@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "A ladybird or its larva feeds on aphids. The photograph illustrates natural pest control as an alternative to insecticide application."@en,
        "Een lieveheersbeestje of de larve ervan voedt zich met bladluizen. Zo is natuurlijke plaagbeheersing als alternatief voor insecticidetoepassing in beeld gebracht."@nl .

vocab:ApplicationMachinesWithLowerAxelweight10TonsAxle a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilAndMachineryUse ;
    skos:definition "Using field application machinery with an axle load below 10 tonnes per axle to reduce pressure on soil and the risk of deep compaction compared with heavier equipment."@en,
        "Het gebruiken van werktuigen voor veldtoepassingen met een aslast onder 10 ton per as om de belasting van de bodem en het risico op diepe verdichting te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Application machines with lower axelweight (<10 tons/axle)"@en,
        "Machines met lagere aslast (minder dan 10 ton per as)"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows soil and vegetation on agricultural land. It illustrates the relationship between soil management and crop growth as an aspect of the practice “Application machines with lower axelweight (<10 tons/axle)”."@en,
        "De foto toont de bodem en de begroeiing van landbouwgrond. Zo wordt de relatie tussen bodembeheer en gewasgroei zichtbaar als onderdeel van de praktijk ‘Machines met lagere aslast (minder dan 10 ton per as)’."@nl ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:BioInocculantsBiostimulantEffectiveMicroorganismsOrganicBasedPreparations a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Introducing_plant_beneficial_bacteria_into_plant_seed.jpg> ;
    skos:broader vocab:SoilInnoculationWithMicrobiology ;
    skos:definition "Applying microbial inoculants, biostimulants or organic preparations intended to influence nutrient availability, plant growth, root development or soil biological processes."@en,
        "Het toedienen van microbiële inoculanten, biostimulanten of organische preparaten om nutriëntenbeschikbaarheid, plantengroei, wortelontwikkeling of biologische bodemprocessen te beïnvloeden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "Bio inocculants; Biostimulant; Effective microorganisms; Organic-based preparations"@en,
        "Microbiële inoculanten, biostimulanten en organische preparaten"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Introducing_plant_beneficial_bacteria_into_plant_seed.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “Introducing plant beneficial bacteria into plant seed”. It illustrates the related agricultural context as an aspect of the practice “Bio inocculants; Biostimulant; Effective microorganisms; Organic-based preparations”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘Introducing plant beneficial bacteria into plant seed’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Microbiële inoculanten, biostimulanten en organische preparaten’."@nl .

vocab:Biochar a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Charged_and_inoculated_biochar_ready_for_soil_application.jpg> ;
    skos:broader vocab:SoilAmendments ;
    skos:definition "Applying carbon-rich material made by heating biomass under oxygen-limited conditions, mainly as a soil amendment and potentially as a long-term carbon store."@en,
        "Het toepassen van koolstofrijk materiaal dat door verhitting van biomassa bij weinig zuurstof is gemaakt, vooral als bodemverbeteraar en mogelijk voor langdurige koolstofvastlegging."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "biochar"@en,
        "Biochar"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Charged_and_inoculated_biochar_ready_for_soil_application.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'biochar'."@en ;
    regenlmeta:photoCaptionStatus "visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows biochar prepared for application to the soil. This material illustrates the practice of adding biochar to farmland."@en,
        "De foto toont biochar die is voorbereid voor toepassing in de bodem. Het materiaal maakt de praktijk van het toevoegen van biochar aan landbouwgrond concreet."@nl ;
    schema:creditText "Foto: Tim Brunauer / GIZ (Vrije licentie; controleer bronpagina)."@nl .

vocab:Biodigester a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Biogas_plant_near_Wremen.jpg> ;
    skos:broader vocab:RenewableEnergy ;
    skos:definition "An installation that anaerobically decomposes organic material such as manure or crop residues to produce biogas and a residual material called digestate."@en,
        "Een installatie waarin organisch materiaal, zoals mest of gewasresten, zonder zuurstof wordt afgebroken tot biogas en een restproduct dat digestaat wordt genoemd."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Biodigester"@en,
        "Vergistingsinstallatie"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Biogas_plant_near_Wremen.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The installation with digestion tanks illustrates how organic material can be processed on or near a farm to produce biogas."@en,
        "De installatie met vergistingstanks laat zien hoe organisch materiaal op of nabij een landbouwbedrijf kan worden vergist voor biogasproductie."@nl .

vocab:BiodiversityLanesFieldMarginsSteppingStones05Ha a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Bl%C3%BChstreifen_001.jpg> ;
    skos:broader vocab:FlowerHerbNatureStrips ;
    skos:definition "Creating or maintaining vegetated field margins, corridors or habitat patches larger than 0.5 hectares that offer food, shelter and ecological connections for species."@en,
        "Het aanleggen of beheren van begroeide akkerranden, verbindingsstroken of leefgebiedplekken groter dan 0,5 hectare die voedsel, beschutting en verbindingen voor soorten bieden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "biodiversity lanes; field margins; stepping stones (> 0.5 ha)"@en,
        "Biodiversiteitsstroken, akkerranden en stapstenen (meer dan 0,5 ha)"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Bl%C3%BChstreifen_001.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "Flowering vegetation grows along the field. The photograph shows how a vegetated field margin provides space for herbs and flowers within the agricultural landscape."@en,
        "Langs het perceel staat bloeiende vegetatie. De foto toont hoe een begroeide rand ruimte biedt aan kruiden en bloemen binnen het landbouwlandschap."@nl .

vocab:BiodiversitySheltersEGBushes a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Hedgerow_on_Farmland_-_geograph.org.uk_-_7294771.jpg> ;
    skos:broader vocab:HabitatProvisionBiodiversityEnhancement ;
    skos:definition "Providing small habitat structures such as shrubs, scrub patches or shelter belts that give wild organisms cover, nesting opportunities or refuge."@en,
        "Het behouden of aanleggen van kleine leefgebiedstructuren, zoals struiken en struweel, die wilde soorten beschutting, nestgelegenheid of een schuilplek bieden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Biodiversity shelters (e.g. bushes)"@en,
        "Schuilplaatsen voor biodiversiteit (bijvoorbeeld struiken)"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Hedgerow_on_Farmland_-_geograph.org.uk_-_7294771.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a hedgerow and trees in farmland. It illustrates woody landscape elements as habitats and corridors as an aspect of the practice “Biodiversity shelters (e.g. bushes)”."@en,
        "De foto toont een haag en bomen in het agrarisch landschap. Zo wordt houtige landschapselementen als leefgebied en verbinding zichtbaar als onderdeel van de praktijk ‘Schuilplaatsen voor biodiversiteit (bijvoorbeeld struiken)’."@nl .

vocab:Biofertilizer a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:UseOfSpecificFertilizerTypesOrManure ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Using a microbial product or biologically derived fertilising input to support nutrient availability or plant nutrition; the exact category depends on product composition and regulation."@en,
        "Het toepassen van microbiële producten of biologisch verkregen bemestende inputs om nutriëntenbeschikbaarheid of plantenvoeding te ondersteunen; de precieze categorie hangt af van samenstelling en regelgeving."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Biofertilizer"@en,
        "Biologische meststof"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Biofertilizer'."@en,
        "Het gebruik van Bio-meststof of andere natuurlijke meststoffen als meststof"@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a compost heap containing organic material. It illustrates the collection and processing of organic residual materials as an aspect of the practice “Biofertilizer”."@en,
        "De foto toont een composthoop met organisch materiaal. Zo wordt het verzamelen en verwerken van organische restmaterialen zichtbaar als onderdeel van de praktijk ‘Biologische meststof’."@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:BirdAndBatBoxes a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Nesting_box.jpg> ;
    skos:broader vocab:HabitatProvisionBiodiversityEnhancement ;
    skos:definition "Installing artificial nesting or roosting structures for birds and bats on or near agricultural land where suitable natural sites are scarce."@en,
        "Het plaatsen van kunstmatige nest- of verblijfplaatsen voor vogels en vleermuizen op of naast landbouwgrond waar natuurlijke plaatsen beperkt aanwezig zijn."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Bird and bat boxes"@en,
        "Vogel- en vleermuiskasten"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Nesting_box.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The nesting box attached to a tree shows how farms can provide additional nesting opportunities for birds."@en,
        "De nestkast aan de boom laat zien hoe op het bedrijf extra nestgelegenheid voor vogels kan worden aangeboden."@nl .

vocab:BreakPeriodInTheRotation a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg> ;
    skos:broader vocab:ExtensiveCropRotations ;
    skos:definition "Including a planned interval or low-intensity phase between crops in a rotation to interrupt pest cycles and allow soil or vegetation recovery."@en,
        "Het opnemen van een geplande tussenperiode of extensieve fase tussen teelten om ziekte- en plaagcycli te doorbreken en bodem of vegetatie te laten herstellen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Break period in the rotation"@en,
        "Rustperiode in de vruchtwisseling"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The field is covered with oilseed radish. This crop illustrates how green manure can contribute to soil cover and crop rotation."@en,
        "Het perceel is begroeid met bladrammenas. Het gewas laat zien hoe een groenbemester onderdeel kan zijn van bodembedekking en vruchtwisseling."@nl ;
    schema:creditText "Foto: Wikimedia Commons, bladrammenas als groenbemester in Nederland." .

vocab:CSASelfPickingOnFarmsShops a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Strawberry_greenhouse_at_a_pick-your-own_farm,_near_Den_Burg,_Texel,_2022.jpg> ;
    skos:broader vocab:FormsOfDirectFoodProvisioning ;
    skos:definition "Farm-to-consumer arrangements in which customers obtain produce through community-supported agriculture, self-harvesting or a shop on the farm."@en,
        "Vormen van rechtstreekse voedselvoorziening waarbij consumenten producten verkrijgen via gemeenschapslandbouw, zelfoogst of een winkel op het landbouwbedrijf."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "CSA, self-picking, on-farms shops"@en,
        "Gemeenschapslandbouw, zelfpluk en boerderijwinkels"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Strawberry_greenhouse_at_a_pick-your-own_farm%2C_near_Den_Burg%2C_Texel%2C_2022.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a farm in an agricultural landscape. It illustrates the agricultural context of the practice as an aspect of the practice “CSA, self-picking, on-farms shops”."@en,
        "De foto toont een landbouwbedrijf in een agrarisch landschap. Zo wordt de landbouwkundige context van de praktijk zichtbaar als onderdeel van de praktijk ‘Gemeenschapslandbouw, zelfpluk en boerderijwinkels’."@nl .

vocab:CatchCrops a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg> ;
    skos:broader vocab:CropDiversificationCoverCrops ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Growing a crop after or alongside the main crop to take up residual nutrients, especially nitrogen, and reduce losses between production cycles."@en,
        "Het telen van een gewas na of naast de hoofdteelt dat resterende nutriënten, vooral stikstof, opneemt en verliezen tussen teelten beperkt."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (nl): Een snelgroeiend vanggewas dat tussen opeenvolgende hoofdteelten wordt geteeld en resterende nutriënten, met name stikstof, kan opnemen om uitspoeling te beperken."@nl ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Catch crops"@en,
        "Vanggewassen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "fast growing cover crop, grown between successive plantings of a main crop. \" It scavenges the remaining nitrogen after the main crop is harvested, thereby reducing nutrient losses from leaching\" (for undersow see intercropping)"@en,
        "snelgroeiende gewassen die worden gezaaid tussen twee hoofdteelten. Ze nemen stikstof op die anders zou uitspoelen na de oogst van het hoofdgewas, en beperkt daardoor nutrienten verliezen (als er temporale overlap is tussen het hoofdgewas en vanggewas, dan valt dit onder 'onderzaai')"@nl ;
    regenlmeta:photoCaptionStatus "visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The field is covered with oilseed radish. This crop illustrates how green manure can contribute to soil cover and crop rotation."@en,
        "Het perceel is begroeid met bladrammenas. Het gewas laat zien hoe een groenbemester onderdeel kan zijn van bodembedekking en vruchtwisseling."@nl ;
    schema:creditText "Foto: Wikimedia Commons, bladrammenas als groenbemester in Nederland." .

vocab:ChiselPlowingSubsoiling a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:John_Deere_9400T_b.jpg> ;
    skos:broader vocab:NonInversionTillage ;
    skos:definition "Loosening compacted soil layers with tines or subsoilers, usually without fully inverting the soil, to improve rooting and water movement."@en,
        "Het losmaken van verdichte bodemlagen met tanden of diepwoelers, meestal zonder de bodem volledig te keren, om beworteling en waterbeweging te verbeteren."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "chisel plowing, subsoiling"@en,
        "Woelen en diepwoelen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/John_Deere_9400T_b.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a tractor using a subsoiler on arable land in England, illustrating the practice of deep loosening and subsoiling."@en,
        "De foto toont tractor met diepwoeler in gebruik op Engels akkerland. Daarmee wordt een onderdeel van ‘Woelen en diepwoelen’ zichtbaar."@nl .

vocab:ClimateAndLightControl a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Greenhouse_indoor_view_20170826.jpg> ;
    skos:broader vocab:AnimalHousing ;
    skos:definition "Regulating temperature, humidity, ventilation and light in agricultural production environments to meet crop or animal requirements while managing resource use."@en,
        "Het regelen van temperatuur, luchtvochtigheid, ventilatie en licht in agrarische productieomgevingen om aan gewas- of dierbehoeften te voldoen en hulpbronnen efficiënt te benutten."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "climate and light control"@en,
        "Klimaat- en lichtregeling"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Greenhouse_indoor_view_20170826.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "A crop is grown in a greenhouse. This protected growing environment illustrates where light and climate conditions can be controlled for crop production."@en,
        "Het gewas wordt in een kas geteeld. De beschutte teeltomgeving laat zien waar licht en klimaat voor de teelt kunnen worden gereguleerd."@nl ;
    schema:creditText "Foto: Wikimedia Commons, kasinterieur (controleer bron en licentie)." .

vocab:CollectiveBrand a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Shop_front_-_farm_shop.jpg> ;
    skos:broader vocab:IncomeDeepeningIncreasingAddedValueOfProduct ;
    skos:definition "Developing and using a shared product identity or trade mark by several producers to market goods under common quality or origin characteristics."@en,
        "Het ontwikkelen en gebruiken van één gezamenlijk merk door meerdere producenten om producten met gedeelde kwaliteits- of herkomstkenmerken te vermarkten."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Collective brand"@en,
        "Collectief merk"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Shop_front_-_farm_shop.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a farm shop. It illustrates the sale of farm products to consumers as an aspect of the practice “Collective brand”."@en,
        "De foto toont een boerderijwinkel. Zo wordt de verkoop van landbouwproducten aan consumenten zichtbaar als onderdeel van de praktijk ‘Collectief merk’."@nl ;
    schema:creditText "Foto: Wikimedia Commons, boerderijwinkel (controleer bron en licentie)." .

vocab:CollectiveProssesing a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:FarmersMarket.jpg> ;
    skos:broader vocab:IncomeDeepeningIncreasingAddedValueOfProduct ;
    skos:definition "Processing agricultural products jointly through shared facilities, equipment or a producer organisation to increase efficiency or product value."@en,
        "Het gezamenlijk verwerken van agrarische producten via gedeelde voorzieningen, machines of een producentenorganisatie om kosten te delen of productwaarde te verhogen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Collective prossesing"@en,
        "Collectieve verwerking"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/FarmersMarket.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows products offered at a farmers market. It illustrates direct marketing of farm products as an aspect of the practice “Collective prossesing”."@en,
        "De foto toont producten die op een boerenmarkt worden aangeboden. Zo wordt rechtstreekse afzet van landbouwproducten zichtbaar als onderdeel van de praktijk ‘Collectieve verwerking’."@nl ;
    schema:creditText "Foto: Wikimedia Commons, boerenmarkt / afzet (controleer bron en licentie)." .

vocab:CommunityBasedSupportedAgriculture a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Shop_front_-_farm_shop.jpg> ;
    skos:broader vocab:IncomeDeepeningIncreasingAddedValueOfProduct ;
    skos:definition "A food production and distribution arrangement in which consumers make a direct commitment to a farm, often through subscriptions or prepayment and sometimes sharing risks and harvests."@en,
        "Een voedselproductie- en afzetsysteem waarin consumenten zich direct aan een bedrijf verbinden, vaak via abonnement of vooruitbetaling en soms door risico en oogst te delen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Community based/supported agriculture"@en,
        "Gemeenschapslandbouw (CSA)"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Shop_front_-_farm_shop.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a farm shop. It illustrates the sale of farm products to consumers as an aspect of the practice “Community based/supported agriculture”."@en,
        "De foto toont een boerderijwinkel. Zo wordt de verkoop van landbouwproducten aan consumenten zichtbaar als onderdeel van de praktijk ‘Gemeenschapslandbouw (CSA)’."@nl ;
    schema:creditText "Foto: Wikimedia Commons, boerderijwinkel (controleer bron en licentie)." .

vocab:CompartmentedContinousGrazingNewNederlandsWeiden a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Strip_Grazing_at_Merrivale_Farm_-_geograph.org.uk_-_158315.jpg> ;
    skos:broader vocab:GrazingSystem ;
    skos:definition "A grazing system dividing grassland into several compartments while supplying grazing areas in a planned sequence and maintaining frequent access to fresh pasture."@en,
        "Een beweidingssysteem waarbij grasland in compartimenten is verdeeld en koeien volgens een planning regelmatig vers gras krijgen, zoals bij Nieuw Nederlands Weiden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "compartmented continous grazing (New nederlands weiden)"@en,
        "Gecompartimenteerd continu beweiden (Nieuw Nederlands Weiden)"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Strip_Grazing_at_Merrivale_Farm_-_geograph.org.uk_-_158315.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "(CCG) is a daily rotational grazing system where a pasture is divided into multiple compartments, and livestock are moved to a new compartment each day"@en,
        "Een beweidingssysteem waarbij grasland in compartimenten is verdeeld en dieren dagelijks naar een volgend compartiment worden verplaatst."@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "Animals are grazing on grassland. The photograph illustrates the practical connection between grazing, grassland use and livestock farming."@en,
        "De dieren grazen op grasland. De foto toont de praktische samenhang tussen beweiding, het gebruik van grasland en het houden van vee."@nl .

vocab:CompetenceDevelopmentOpportunitiesAtPublicEducationalInstitutes a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Dairy_Campus_Ljouwert08.jpg> ;
    skos:broader vocab:FormalLearning ;
    skos:definition "Providing farmers or farm workers with opportunities to acquire skills and knowledge through courses, training or qualifications offered by public educational institutions."@en,
        "Het bieden van mogelijkheden aan boeren of medewerkers om kennis en vaardigheden te ontwikkelen via opleidingen, cursussen of trainingen bij openbare onderwijsinstellingen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "(Competence) development opportunities at public educational institutes"@en,
        "Mogelijkheden voor competentieontwikkeling in het openbaar onderwijs"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Dairy_Campus_Ljouwert08.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural research and learning setting. It illustrates knowledge development and professional education as an aspect of the practice “(Competence) development opportunities at public educational institutes”."@en,
        "De foto toont een agrarische onderzoeks- en leeromgeving. Zo wordt kennisontwikkeling en professionele scholing zichtbaar als onderdeel van de praktijk ‘Mogelijkheden voor competentieontwikkeling in het openbaar onderwijs’."@nl .

vocab:CompostTea a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:UseOfSpecificFertilizerTypesOrManure ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "An aqueous extract of compost, sometimes prepared with aeration, used as a liquid soil or plant treatment; composition and evidence of effectiveness vary by preparation."@en,
        "Een waterig extract van compost, soms met beluchting bereid, dat als vloeibare bodem- of plantbehandeling wordt gebruikt; samenstelling en werkzaamheid verschillen per bereiding."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Compost tea"@en,
        "Compostthee"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Compost tea'."@en,
        "Het gebruik van Compostthee als meststof"@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a compost heap containing organic material. It illustrates the collection and processing of organic residual materials as an aspect of the practice “Compost tea”."@en,
        "De foto toont een composthoop met organisch materiaal. Zo wordt het verzamelen en verwerken van organische restmaterialen zichtbaar als onderdeel van de praktijk ‘Compostthee’."@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:CompostUse a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:UseOfSpecificFertilizerTypesOrManure ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Applying biologically decomposed organic materials to soil to add organic matter and nutrients and influence soil structure and biological activity."@en,
        "Het toedienen van biologisch afgebroken organisch materiaal aan de bodem voor aanvoer van organische stof en nutriënten en beïnvloeding van structuur en bodemleven."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Compost use"@en,
        "Compostgebruik"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Compost use'."@en,
        "Het gebruik van compost van plantaardige oorsprong (niet dierlijk)"@nl ;
    regenlmeta:photoCaptionStatus "visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "Compost on a farmyard illustrates the organic material used in compost application for soil management and nutrient cycling."@en,
        "De compost op het agrarische erf laat het organische materiaal zien dat bij compostgebruik wordt ingezet voor de bodem en nutriëntenkringloop."@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:ControlledTrafficLanes a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilAndMachineryUse ;
    skos:definition "Restricting heavy field traffic to permanent, designated wheel tracks so that the remainder of the field is driven on less frequently and is less compacted."@en,
        "Het concentreren van zware veldbewegingen op vaste rijsporen zodat de overige bodem minder vaak wordt bereden en minder risico op verdichting heeft."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Controlled traffic lanes"@en,
        "Vaste rijpaden"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows soil and vegetation on agricultural land. It illustrates the relationship between soil management and crop growth as an aspect of the practice “Controlled traffic lanes”."@en,
        "De foto toont de bodem en de begroeiing van landbouwgrond. Zo wordt de relatie tussen bodembeheer en gewasgroei zichtbaar als onderdeel van de praktijk ‘Vaste rijpaden’."@nl ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:ControlledTrafficLanesPerSeason a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilAndMachineryUse ;
    skos:definition "Planning designated machine tracks for a growing season, rather than driving randomly across the field, to limit the area repeatedly compacted by wheels."@en,
        "Het per teeltseizoen aanwijzen en gebruiken van rijsporen voor machines om willekeurig rijden en de oppervlakte met herhaalde wielbelasting te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Controlled traffic lanes per season"@en,
        "Seizoensgebonden vaste rijpaden"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows soil and vegetation on agricultural land. It illustrates the relationship between soil management and crop growth as an aspect of the practice “Controlled traffic lanes per season”."@en,
        "De foto toont de bodem en de begroeiing van landbouwgrond. Zo wordt de relatie tussen bodembeheer en gewasgroei zichtbaar als onderdeel van de praktijk ‘Seizoensgebonden vaste rijpaden’."@nl ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:CropRotation a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg> ;
    skos:broader vocab:ExtensiveCropRotations ;
    skos:definition "Growing different crop species or crop groups on the same field in a planned temporal sequence across successive growing seasons."@en,
        "Het achtereenvolgens telen van verschillende gewassen of gewasgroepen op hetzelfde perceel volgens een gepland meerjarig bouwplan."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Crop rotation"@en,
        "Vruchtwisseling"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The field is covered with oilseed radish. This crop illustrates how green manure can contribute to soil cover and crop rotation."@en,
        "Het perceel is begroeid met bladrammenas. Het gewas laat zien hoe een groenbemester onderdeel kan zijn van bodembedekking en vruchtwisseling."@nl ;
    schema:creditText "Foto: Wikimedia Commons, bladrammenas als groenbemester in Nederland." .

vocab:CrowdfundingZoopSharesTimebankingOfLabour a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:FarmersMarket.jpg> ;
    skos:broader vocab:NewFormsOfAccessToLandLabourCapital ;
    skos:definition "Using alternative arrangements to mobilise money, participation or work for a farm, such as crowdfunding, ownership shares, labour exchanges or a Zoöp governance structure."@en,
        "Het inzetten van alternatieve vormen om financiering, betrokkenheid of arbeid te organiseren, zoals crowdfunding, aandelen, arbeidsruil of een Zoöp-bestuursmodel."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Crowdfunding, zoop, shares, timebanking of labour"@en,
        "Crowdfunding, Zoöp, aandelen en tijdsruil van arbeid"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/FarmersMarket.jpg?width=960> ;
    regenlmeta:definitionReference <https://nieuweinstituut.nl/en/projects/zoop/zoop-model> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows products offered at a farmers market. It illustrates direct marketing of farm products as an aspect of the practice “Crowdfunding, zoop, shares, timebanking of labour”."@en,
        "De foto toont producten die op een boerenmarkt worden aangeboden. Zo wordt rechtstreekse afzet van landbouwproducten zichtbaar als onderdeel van de praktijk ‘Crowdfunding, Zoöp, aandelen en tijdsruil van arbeid’."@nl ;
    schema:creditText "Foto: Wikimedia Commons, boerenmarkt / afzet (controleer bron en licentie)." .

vocab:DeepRootedSpecies a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg> ;
    skos:broader vocab:CultivationOfSpecificCropsOrVarieties ;
    skos:definition "Including plant species with relatively deep root systems to access deeper soil layers and influence soil structure, nutrient uptake and drought tolerance."@en,
        "Het inzetten van plantensoorten met relatief diepe wortels die diepere bodemlagen benutten en bodemstructuur, nutriëntenopname en droogtebestendigheid kunnen beïnvloeden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Deep rooted species"@en,
        "Diepwortelende soorten"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows oilseed radish grown as a green-manure crop. It illustrates the use of living ground cover in cropping as an aspect of the practice “Deep rooted species”."@en,
        "De foto toont bladrammenas als groenbemestend gewas op een akker. Zo wordt het gebruik van levende bodembedekking in de teelt zichtbaar als onderdeel van de praktijk ‘Diepwortelende soorten’."@nl ;
    schema:creditText "Foto: Wikimedia Commons, bladrammenas als groenbemester in Nederland." .

vocab:DelayedMowingDateForBirdProtection a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Vluchtheuvel_weiland.jpg> ;
    skos:broader vocab:DelayedMowingDateForMeadowBirdProtection15JuneOrBotanicalProtectionJuly ;
    skos:definition "Postponing cutting of grassland or vegetation until a specified date or after nesting periods to reduce disturbance and mortality of birds."@en,
        "Het uitstellen van het maaien van grasland of vegetatie tot een bepaalde datum of na het broedseizoen om verstoring en sterfte van vogels te verminderen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "delayed mowing date for bird protection"@en,
        "Uitgestelde maaidatum voor vogelbescherming"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Vluchtheuvel_weiland.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows part of a meadow left uncut as a refuge. It illustrates leaving vegetation as a refuge during grassland management as an aspect of the practice “delayed mowing date for bird protection”."@en,
        "De foto toont een deel van het grasland dat als schuilplaats ongemaaid blijft. Zo wordt het sparen van vegetatie als schuilplaats bij graslandbeheer zichtbaar als onderdeel van de praktijk ‘Uitgestelde maaidatum voor vogelbescherming’."@nl .

vocab:DepeningOnTheNeedOfTheCropLesOrLessOften a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:NRCSIA99244_-_Iowa_(3183)(NRCS_Photo_Gallery).jpg> ;
    skos:broader vocab:SpecificFertilizerApplicationTechniques ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Adjusting application rates and frequency of irrigation, fertilisers or other inputs to measured or expected crop demand rather than applying a fixed excess."@en,
        "Het afstemmen van hoeveelheden en frequentie van water, meststoffen of andere inputs op de gemeten of verwachte gewasbehoefte in plaats van standaard meer toe te dienen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Depening on the need of the crop (les or less often)"@en,
        "Afstemmen op gewasbehoefte (minder of minder vaak)"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/NRCSIA99244_-_Iowa_(3183)(NRCS_Photo_Gallery).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Depening on the need of the crop (les or less often)'."@en,
        "Bemesting op basis van het groei potentieel, bv. gedurende het seizoen en afhangelijk van de groeiomstandigheden"@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “NRCSIA99244 - Iowa”. It illustrates the related agricultural context as an aspect of the practice “Depening on the need of the crop (les or less often)”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘NRCSIA99244 - Iowa’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Afstemmen op gewasbehoefte (minder of minder vaak)’."@nl .

vocab:DifferentTypesOfClients a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:FarmersMarket.jpg> ;
    skos:broader vocab:GreenCare ;
    skos:definition "Diversifying the farm's customer base across consumer, business, institutional or cooperative buyers to reduce dependence on a single sales channel."@en,
        "Het spreiden van de klantenkring over consumenten, bedrijven, instellingen of coöperatieve afnemers om minder afhankelijk te worden van één afzetkanaal."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Different types of clients"@en,
        "Verschillende typen afnemers"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/FarmersMarket.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "Agricultural products are offered for sale at a market or farm shop. This illustrates a sales channel through which farms can sell their produce to customers."@en,
        "Op de foto worden landbouwproducten op een markt of bij een boerderijwinkel aangeboden. Dit illustreert een verkoopkanaal waarmee landbouwbedrijven hun producten aan afnemers kunnen aanbieden."@nl ;
    schema:creditText "Foto: Wikimedia Commons, boerenmarkt / afzet (controleer bron en licentie)." .

vocab:Digestate a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Anaerobic_digestate.JPG> ;
    skos:broader vocab:UseOfSpecificFertilizerTypesOrManure ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Using the residual material remaining after anaerobic digestion of manure or other biomass as a nutrient source or soil input, subject to composition and regulations."@en,
        "Het benutten van het restmateriaal na anaerobe vergisting van mest of andere biomassa als nutriëntenbron of bodeminvoer, afhankelijk van samenstelling en regelgeving."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "digestate"@en,
        "Digestaat"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Anaerobic_digestate.JPG?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'digestate'."@en,
        "Het gebruik van restproducten uit vergisters, als bemesting"@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows digestate from the anaerobic digestion of organic matter. It illustrates the use of a by-product from anaerobic digestion as an aspect of the practice “digestate”."@en,
        "De foto toont digestaat uit vergisting van organisch materiaal. Zo wordt het benutten van het restproduct van vergisting zichtbaar als onderdeel van de praktijk ‘Digestaat’."@nl .

vocab:DirectOnfarmAndCollectiveFormsOfSales a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:-2021-11-28_Farm_shop,_Vine_house_farm,_Deeping_St_Nicholas,_Lincolnshire.jpg> ;
    skos:broader vocab:IncomeDeepeningIncreasingAddedValueOfProduct ;
    skos:definition "Selling farm products directly to consumers on the farm or jointly through producer-owned shops, markets, box schemes or other collective channels."@en,
        "Het rechtstreeks verkopen van boerderijproducten aan consumenten op het bedrijf of gezamenlijk via producentenwinkels, markten, pakketten of andere collectieve afzetkanalen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Direct onfarm and collective forms of sales"@en,
        "Directe boerderijverkoop en collectieve afzet"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/-2021-11-28_Farm_shop%2C_Vine_house_farm%2C_Deeping_St_Nicholas%2C_Lincolnshire.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a farm in an agricultural landscape. It illustrates the agricultural context of the practice as an aspect of the practice “Direct onfarm and collective forms of sales”."@en,
        "De foto toont een landbouwbedrijf in een agrarisch landschap. Zo wordt de landbouwkundige context van de praktijk zichtbaar als onderdeel van de praktijk ‘Directe boerderijverkoop en collectieve afzet’."@nl .

vocab:DirectSeeding a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Ackerbohnen-Direktsaat_2.jpg> ;
    skos:broader vocab:SoilSeedbedPreparation ;
    skos:definition "Sowing seed directly into its final growing position, often into crop residues or minimally disturbed soil, without raising and transplanting seedlings."@en,
        "Het direct zaaien van zaad op de uiteindelijke groeiplaats, vaak in gewasresten of nauwelijks bewerkte grond, zonder eerst planten op te kweken en te verplanten."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Direct seeding"@en,
        "Directzaai"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Ackerbohnen-Direktsaat_2.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The image shows a stage in sowing or renewing a crop."@en,
        "De afbeelding laat een stap in het zaaien of vernieuwen van een gewas zien."@nl .

vocab:Ditches a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Sloot_in_een_weiland_met_koeien_bij_een_boerderij_op_de_achtergrond_een_dorp,_Bestanddeelnr_191-0655.jpg> ;
    skos:broader vocab:WaterStorage ;
    skos:definition "Managing or maintaining open drainage and water-conveyance channels in farmland to regulate water levels and movement while considering habitat functions."@en,
        "Het beheren of onderhouden van open sloten en afwateringskanalen in landbouwgebied om waterstanden en afvoer te regelen met aandacht voor leefgebiedfuncties."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Ditches"@en,
        "Sloten"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Sloot_in_een_weiland_met_koeien_bij_een_boerderij_op_de_achtergrond_een_dorp%2C_Bestanddeelnr_191-0655.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a ditch alongside agricultural grassland. It illustrates the management of surface water alongside fields as an aspect of the practice “Ditches”."@en,
        "De foto toont een sloot langs agrarisch grasland. Zo wordt het beheer van oppervlaktewater langs percelen zichtbaar als onderdeel van de praktijk ‘Sloten’."@nl .

vocab:DiversifiedCropRotation a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg> ;
    skos:broader vocab:ExtensiveCropRotations ;
    skos:definition "Designing a rotation with several crop species or botanical families and differing growth periods to interrupt pest cycles and diversify soil use."@en,
        "Het ontwerpen van een vruchtwisseling met meerdere gewassoorten of plantenfamilies en verschillende groeiperioden om plaagcycli te doorbreken en het bodemgebruik te variëren."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "diversified crop rotation"@en,
        "Gevarieerde vruchtwisseling"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The field is covered with oilseed radish. This crop illustrates how green manure can contribute to soil cover and crop rotation."@en,
        "Het perceel is begroeid met bladrammenas. Het gewas laat zien hoe een groenbemester onderdeel kan zijn van bodembedekking en vruchtwisseling."@nl ;
    schema:creditText "Foto: Wikimedia Commons, bladrammenas als groenbemester in Nederland." .

vocab:DragHoseManureSpreading a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Spreading_Slurry_-_geograph.org.uk_-_43788.jpg> ;
    skos:broader vocab:SoilAndMachineryUse ;
    skos:definition "Supplying slurry to a field applicator through a hose from a remote pump or tank, avoiding repeated trips by heavy slurry tankers on the field."@en,
        "Het via een lange slang vanaf een pomp of opslagtank aanvoeren van drijfmest naar de veldmachine, zodat zware mesttanks minder over het perceel hoeven te rijden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Drag hose manure spreading"@en,
        "Mest uitrijden met sleepslangen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Spreading_Slurry_-_geograph.org.uk_-_43788.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural operation involving slurry. It illustrates the management and application of animal slurry as an aspect of the practice “Drag hose manure spreading”."@en,
        "De foto toont een landbouwtoepassing met vloeibare mest. Zo wordt het beheer en de toepassing van dierlijke mest zichtbaar als onderdeel van de praktijk ‘Mest uitrijden met sleepslangen’."@nl .

vocab:DripIrrigation a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Drip_irrigation.jpg> ;
    skos:broader vocab:WaterSavingIrrigation ;
    skos:definition "Applying water slowly and locally through emitters or drip lines near plant roots, allowing controlled watering with reduced evaporation and runoff."@en,
        "Het langzaam en plaatselijk toedienen van water via druppelaars of druppelslangen bij de wortelzone, met gerichte dosering en minder verdamping en afstroming."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "Drip irrigation"@en,
        "Druppelirrigatie"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Drip_irrigation.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "Water is delivered close to the plants through drip irrigation lines. This is a clear example of targeted water application in crop production."@en,
        "Water wordt via druppelleidingen dicht bij de planten aangevoerd. Dit is een herkenbaar voorbeeld van gerichte watertoediening in de teelt."@nl ;
    schema:creditText "Foto: USDA (Public domain (US federal government))."@nl .

vocab:DroughtTolerantCrops a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Sorghum_field.jpg> ;
    skos:broader vocab:CultivationOfSpecificCropsOrVarieties ;
    skos:definition "Choosing crop species or varieties capable of maintaining growth or yield under limited water availability through physiological or morphological adaptations."@en,
        "Het kiezen van gewassen of rassen die bij beperkte watervoorziening relatief goed kunnen groeien of produceren dankzij fysiologische of bouwkundige eigenschappen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "drought tolerant crops"@en,
        "Droogtetolerante gewassen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Sorghum_field.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “Sorghum field”. It illustrates the related agricultural context as an aspect of the practice “drought tolerant crops”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘Sorghum field’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Droogtetolerante gewassen’."@nl .

vocab:DryFarming a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Drip_irrigation.jpg> ;
    skos:broader vocab:MinimizeWaterUse ;
    skos:definition "Growing crops without routine irrigation by relying on precipitation, stored soil moisture and water-conserving soil and crop management."@en,
        "Het telen van gewassen zonder reguliere beregening, op basis van neerslag, opgeslagen bodemvocht en maatregelen die water vasthouden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Dry farming"@en,
        "Droge teelt zonder irrigatie"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Drip_irrigation.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows drip lines delivering water close to plants. It illustrates targeted irrigation close to the crop as an aspect of the practice “Dry farming”."@en,
        "De foto toont druppelleidingen die water gericht bij planten brengen. Zo wordt gerichte irrigatie bij het gewas zichtbaar als onderdeel van de praktijk ‘Droge teelt zonder irrigatie’."@nl ;
    schema:creditText "Foto: USDA (public domain, U.S. federal government)."@nl .

vocab:EGAnimalManure a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:A_manure_heap_in_the_field_-_geograph.org.uk_-_7427875.jpg> ;
    skos:broader vocab:ReductionOrganicFertilizers ;
    skos:definition "Applying excreta or bedding-based manure from farm animals as an organic source of nutrients and organic matter, with attention to storage and application impacts."@en,
        "Het toepassen van uitwerpselen of strooiselmest van landbouwhuisdieren als organische bron van nutriënten en organische stof, met aandacht voor opslag en emissies."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "(e.g. animal manure)"@en,
        "Dierlijke mest"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/A_manure_heap_in_the_field_-_geograph.org.uk_-_7427875.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows animal manure on a farm. It illustrates the management of organic nutrient flows as an aspect of the practice “(e.g. animal manure)”."@en,
        "De foto toont dierlijke mest op een landbouwbedrijf. Zo wordt het beheer van organische nutriëntenstromen zichtbaar als onderdeel van de praktijk ‘Dierlijke mest’."@nl .

vocab:EcoPlough a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Plowing_ecomat.jpg> ;
    skos:broader vocab:ShallowTillage ;
    skos:definition "Using a plough or tillage implement designed to work shallower or disturb the soil less than conventional deep inversion ploughing; the exact method depends on the machine."@en,
        "Het gebruiken van een ploeg of werktuig dat ondieper werkt of de bodem minder verstoort dan conventioneel diep kerend ploegen; de uitvoering hangt af van het werktuig."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "eco plough"@en,
        "Ecologische ploeg"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Plowing_ecomat.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a farm machine cultivating the soil. It illustrates mechanical soil and seedbed cultivation as an aspect of the practice “eco plough”."@en,
        "De foto toont een landbouwmachine die de bodem bewerkt. Zo wordt mechanische bodem- en zaaibedbewerking zichtbaar als onderdeel van de praktijk ‘Ecologische ploeg’."@nl .

vocab:EcosystemservicePaymentsFromGovernment a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Farm_Office.jpg> ;
    skos:broader vocab:IncomeBroadeningPaymentsForEcosystemServices ;
    skos:definition "Receiving public compensation for verified or agreed farm management that provides ecosystem services such as biodiversity, water quality or carbon storage."@en,
        "Het ontvangen van een overheidsvergoeding voor afgesproken of aantoonbaar geleverd beheer dat ecosysteemdiensten ondersteunt, zoals biodiversiteit, waterkwaliteit of koolstofopslag."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Ecosystemservice payments from government"@en,
        "Overheidsbetalingen voor ecosysteemdiensten"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Farm_Office.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an administrative workplace on a farm. It illustrates the organisational side of running a farm as an aspect of the practice “Ecosystemservice payments from government”."@en,
        "De foto toont een administratieve werkplek op een landbouwbedrijf. Zo wordt de organisatorische kant van het agrarisch bedrijf zichtbaar als onderdeel van de praktijk ‘Overheidsbetalingen voor ecosysteemdiensten’."@nl ;
    schema:creditText "Foto: Tvjeevaraj / Wikimedia Commons (controleer bron en licentie)." .

vocab:ExtendedGrazingTimeMinimumOf1500HoursYear a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg> ;
    skos:broader vocab:GrazingManagement ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Providing grazing access to livestock for at least 1,500 hours per year, measured as accumulated time outdoors on pasture."@en,
        "Het vee gedurende minimaal 1.500 uur per jaar toegang geven tot grasland, opgeteld over de afzonderlijke perioden van weidegang."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Extended grazing time: minimum of 1500 hours/year"@en,
        "Verlengde weidegang: minimaal 1.500 uur per jaar"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "ecoregeling weidepremie 1500 uur of 2500 uur"@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "Animals are grazing on grassland. The photograph illustrates the practical connection between grazing, grassland use and livestock farming."@en,
        "De dieren grazen op grasland. De foto toont de praktische samenhang tussen beweiding, het gebruik van grasland en het houden van vee."@nl ;
    schema:creditText "Foto: Wikimedia Commons, grazende koeien in de provincie Utrecht (Nederland)." .

vocab:ExtendedGrazingTimeMinimumOf720HoursYearMaximumOf1500HoursPerYear a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg> ;
    skos:broader vocab:GrazingManagement ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Providing grazing access to livestock for at least 720 but less than 1,500 hours per year, measured as accumulated pasture access time."@en,
        "Het vee gedurende minimaal 720 maar minder dan 1.500 uur per jaar toegang geven tot grasland, opgeteld over de afzonderlijke weideperioden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Extended grazing time: minimum of 720 hours/year (maximum of 1500 hours per year)"@en,
        "Verlengde weidegang: 720–1.500 uur per jaar"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "weidepremie (basis 120 dagen = 720 uur)"@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "Animals are grazing on grassland. The photograph illustrates the practical connection between grazing, grassland use and livestock farming."@en,
        "De dieren grazen op grasland. De foto toont de praktische samenhang tussen beweiding, het gebruik van grasland en het houden van vee."@nl ;
    schema:creditText "Foto: Wikimedia Commons, grazende koeien in de provincie Utrecht (Nederland)." .

vocab:ExtensiveSpeciesRichGrassland a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg> ;
    skos:broader vocab:GrasslandTypeEnhancedSpeciesRichness ;
    skos:definition "Maintaining low-input grassland with a diverse mixture of grasses and herbs, often managed through low fertilisation and adjusted mowing or grazing."@en,
        "Het beheren van kruiden- en soortenrijk grasland met weinig externe inputs, doorgaans via beperkte bemesting en aangepast maaien of beweiden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "extensive species rich grassland"@en,
        "Extensief soortenrijk grasland"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "> 15 grasses and herbs per  25 m2"@en,
        "Soortenrijk grasland waarvoor in de bron een drempel van meer dan vijftien gras- en kruidensoorten per 25 m² wordt genoemd."@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "Animals are grazing on grassland. The photograph illustrates the practical connection between grazing, grassland use and livestock farming."@en,
        "De dieren grazen op grasland. De foto toont de praktische samenhang tussen beweiding, het gebruik van grasland en het houden van vee."@nl ;
    schema:creditText "Foto: Wikimedia Commons, grazende koeien in de provincie Utrecht (Nederland)." .

vocab:FaciliateFarmVisits a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Agriculture_Secretary_Vilsack_Farm_visit_and_roundtable_Poland_(20220516-OSEC-OK-0243).jpg> ;
    skos:broader vocab:FarmEducation ;
    skos:definition "Organising farm visits for citizens, advisers, students or other farmers to observe production practices and exchange information on site."@en,
        "Het organiseren van bezoeken aan het landbouwbedrijf voor burgers, adviseurs, studenten of collega-boeren om de bedrijfsvoering te bekijken en kennis uit te wisselen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Faciliate 'farm visits'"@en,
        "Faciliteren van boerderijbezoeken"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Agriculture_Secretary_Vilsack_Farm_visit_and_roundtable_Poland_(20220516-OSEC-OK-0243).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a farm in an agricultural landscape. It illustrates the agricultural context of the practice as an aspect of the practice “Faciliate 'farm visits'”."@en,
        "De foto toont een landbouwbedrijf in een agrarisch landschap. Zo wordt de landbouwkundige context van de praktijk zichtbaar als onderdeel van de praktijk ‘Faciliteren van boerderijbezoeken’."@nl .

vocab:Flachenrotte a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilSeedbedPreparation ;
    skos:definition "Shallow surface decomposition of fresh plant residues or organic materials, often with limited incorporation into the topsoil to encourage biological breakdown."@en,
        "Het oppervlakkig laten verteren van verse plantenresten of organisch materiaal, vaak met lichte inwerking in de bovenste bodemlaag om biologische afbraak te stimuleren."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Flachenrotte"@en,
        "Flächenrotte (oppervlakkige compostering)"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows soil and vegetation on agricultural land. It illustrates the relationship between soil management and crop growth as an aspect of the practice “Flachenrotte”."@en,
        "De foto toont de bodem en de begroeiing van landbouwgrond. Zo wordt de relatie tussen bodembeheer en gewasgroei zichtbaar als onderdeel van de praktijk ‘Flächenrotte (oppervlakkige compostering)’."@nl ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:FoliarFertilizerUse a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:New_agriculture_1.jpg> ;
    skos:broader vocab:UseOfSpecificFertilizerTypesOrManure ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Applying dissolved nutrients to leaves by spraying in order to supplement crop nutrition, with uptake depending on nutrient form and plant conditions."@en,
        "Het via bespuiting toedienen van opgeloste voedingsstoffen op bladeren als aanvulling op de gewasvoeding, waarbij opname afhangt van nutriëntvorm en gewastoestand."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Foliar fertilizer use"@en,
        "Bladbemesting"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/New_agriculture_1.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Foliar fertilizer use'."@en,
        "Het gebruik van Bladbemesting als meststof"@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows crops and an agricultural field treatment. It illustrates the treatment of a crop during cultivation as an aspect of the practice “Foliar fertilizer use”."@en,
        "De foto toont landbouwgewassen en de toepassing van een gewasbehandeling. Zo wordt het behandelen van het gewas tijdens de teelt zichtbaar als onderdeel van de praktijk ‘Bladbemesting’."@nl .

vocab:FoodForest a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Lagen_in_een_voedselbos.png> ;
    skos:broader vocab:TreePlanning ;
    skos:definition "A deliberately designed, multi-layered system of mainly perennial edible plants, including trees and shrubs, managed for food and other useful products."@en,
        "Een doelbewust ingericht meerlagig teeltsysteem met vooral meerjarige eetbare planten, waaronder bomen en struiken, voor voedsel en andere producten."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Food forest"@en,
        "Voedselbos"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Lagen_in_een_voedselbos.png?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows the different growing layers in a food forest. It illustrates the combination of food crops in a layered system as an aspect of the practice “Food forest”."@en,
        "De foto toont de verschillende groeilagen van een voedselbos. Zo wordt het combineren van voedselgewassen in een gelaagd systeem zichtbaar als onderdeel van de praktijk ‘Voedselbos’."@nl .

vocab:FoodPurchasingByCitizensCooperatives a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Shop_front_-_farm_shop.jpg> ;
    skos:broader vocab:IncomeDeepeningIncreasingAddedValueOfProduct ;
    skos:definition "Consumers organising joint food purchases through a cooperative that sources products directly from farmers or defined producer networks."@en,
        "Het gezamenlijk inkopen van voedsel door consumenten via een coöperatie die rechtstreeks bij boeren of afgesproken producentennetwerken afneemt."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Food purchasing by citizens cooperatives"@en,
        "Voedselaankoop door burgercoöperaties"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Shop_front_-_farm_shop.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a farm shop. It illustrates the sale of farm products to consumers as an aspect of the practice “Food purchasing by citizens cooperatives”."@en,
        "De foto toont een boerderijwinkel. Zo wordt de verkoop van landbouwproducten aan consumenten zichtbaar als onderdeel van de praktijk ‘Voedselaankoop door burgercoöperaties’."@nl ;
    schema:creditText "Foto: Wikimedia Commons, boerderijwinkel (controleer bron en licentie)." .

vocab:Food_crops_only a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg> ;
    skos:broader vocab:ReduceExternalInputs ;
    skos:definition "Restricting a specified cropping area or production strategy to crops intended directly or indirectly for human food rather than non-food uses."@en,
        "Het beperken van een teeltareaal of productiestrategie tot gewassen bestemd voor menselijke voeding, in plaats van andere toepassingen zoals energie of sierproducten."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Food crops only"@en,
        "Alleen voedselgewassen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Organic%20agriculture%20in%20the%20Netherlands%20(P-025148-00-08).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows crops grown in an organic farming context. It illustrates crop production and management on farmland as an aspect of the practice “Food crops only”."@en,
        "De foto toont een landbouwperceel met gewassen in een biologische landbouwcontext. Zo wordt teelt en gewasbeheer op landbouwgrond zichtbaar als onderdeel van de praktijk ‘Alleen voedselgewassen’."@nl ;
    schema:creditText "Foto: Europese Commissie, audiovisuele dienst (CC BY 4.0)."@nl .

vocab:ForestConservation a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:A_cherry_orchard_with_sheep_in_Bemmel.jpg> ;
    skos:broader vocab:Reforestation ;
    skos:definition "Protecting existing forest cover and ecological functions by avoiding clearing and managing threats such as degradation or fragmentation."@en,
        "Het beschermen van bestaande bossen en hun ecologische functies door ontbossing te voorkomen en aantasting of versnippering tegen te gaan."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Forest conservation"@en,
        "Bosbehoud"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/A_cherry_orchard_with_sheep_in_Bemmel.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an orchard with fruit trees. It illustrates the cultivation of perennial woody crops as an aspect of the practice “Forest conservation”."@en,
        "De foto toont een boomgaard met fruitbomen. Zo wordt de teelt van meerjarige houtige gewassen zichtbaar als onderdeel van de praktijk ‘Bosbehoud’."@nl ;
    schema:creditText "Foto: Wikimedia Commons, kersenboomgaard met schapen in Bemmel (Nederland)." .

vocab:GrazingGeneral a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg> ;
    skos:broader vocab:GrazingManagement ;
    skos:definition "Allowing farm animals to consume standing vegetation directly from grassland or other grazable land rather than supplying all forage as harvested feed."@en,
        "Het laten opnemen van staande vegetatie door landbouwhuisdieren op grasland of andere beweidbare grond in plaats van uitsluitend geoogst voer aan te bieden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Grazing (general)"@en,
        "Beweiding (algemeen)"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "for the label \"weidemelk\" the minimum grazing period is 120 days for 6 hours a day, addional payments if grazing is extended"@en ;
    regenlmeta:photoCaptionStatus "visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "Animals are grazing on grassland. The photograph illustrates the practical connection between grazing, grassland use and livestock farming."@en,
        "De dieren grazen op grasland. De foto toont de praktische samenhang tussen beweiding, het gebruik van grasland en het houden van vee."@nl ;
    schema:creditText "Foto: Wikimedia Commons, grazende koeien in de provincie Utrecht (Nederland)." .

vocab:GrazingTrainingOfYoungstock a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Young_Calf_Grazing_Peacefully.jpg> ;
    skos:broader vocab:GrazingSystem ;
    skos:definition "Gradually introducing young livestock to pasture to develop grazing behaviour and familiarity with fences, weather and outdoor feeding."@en,
        "Het geleidelijk laten wennen van jongvee aan grasland om graasgedrag te ontwikkelen en vertrouwd te raken met afrasteringen, weersomstandigheden en buiten voeren."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "grazing training of youngstock"@en,
        "Jongvee laten wennen aan weidegang"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Young_Calf_Grazing_Peacefully.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "training of youngstock improves immunity and grass intake"@en ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The grazing animals illustrate the connection between grassland and livestock farming."@en,
        "De grazende dieren maken zichtbaar hoe grasland en veehouderij in het bedrijf samenkomen."@nl .

vocab:GreenManureUse a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg> ;
    skos:broader vocab:UseOfSpecificFertilizerTypesOrManure ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Growing or incorporating a crop mainly to supply organic matter and sometimes nutrients to the soil rather than harvesting it as a marketable product."@en,
        "Het telen of inwerken van een gewas voornamelijk om organische stof en soms nutriënten aan de bodem toe te voegen, in plaats van het als hoofdproduct te oogsten."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Green manure use"@en,
        "Groenbemesting"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Green manure use'."@en,
        "Het gebruik van Groenbemesting (green manure) als meststof"@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The field is covered with oilseed radish. This crop illustrates how green manure can contribute to soil cover and crop rotation."@en,
        "Het perceel is begroeid met bladrammenas. Het gewas laat zien hoe een groenbemester onderdeel kan zijn van bodembedekking en vruchtwisseling."@nl .

vocab:Gypsum a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:SoilAmendments ;
    skos:definition "Applying calcium sulphate to soil as an amendment that supplies calcium and sulphur and can influence soil chemistry or structure under suitable conditions."@en,
        "Het toedienen van calciumsulfaat aan de bodem als bodemverbeteraar die calcium en zwavel levert en onder geschikte omstandigheden bodemchemie of structuur beïnvloedt."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "gypsum"@en,
        "Gips"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'gypsum'."@en ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a compost heap containing organic material. It illustrates the collection and processing of organic residual materials as an aspect of the practice “gypsum”."@en,
        "De foto toont een composthoop met organisch materiaal. Zo wordt het verzamelen en verwerken van organische restmaterialen zichtbaar als onderdeel van de praktijk ‘Gips’."@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:HaveAMinimumRotationLengthOf6YearsFallow a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg> ;
    skos:broader vocab:ExtensiveCropRotations ;
    skos:definition "Using a crop rotation lasting at least six years before the starting crop recurs, potentially including a fallow or low-intensity phase."@en,
        "Het hanteren van een vruchtwisseling van minimaal zes jaar voordat het uitgangsgewas terugkeert, eventueel met een braak- of extensieve fase."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "have a minimum rotation length of 6 years/ fallow"@en,
        "Vruchtwisseling van minimaal zes jaar of braaklegging"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The field is covered with oilseed radish. This crop illustrates how green manure can contribute to soil cover and crop rotation."@en,
        "Het perceel is begroeid met bladrammenas. Het gewas laat zien hoe een groenbemester onderdeel kan zijn van bodembedekking en vruchtwisseling."@nl ;
    schema:creditText "Foto: Wikimedia Commons, bladrammenas als groenbemester in Nederland." .

vocab:HolisticGrazing a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg> ;
    skos:broader vocab:GrazingSystem ;
    skos:definition "Adaptive planned grazing that adjusts herd movements, grazing intensity and recovery periods in response to ecological and livestock conditions."@en,
        "Adaptief geplande beweiding waarbij verplaatsingen van vee, graasdruk en herstelperiodes worden aangepast aan de toestand van vegetatie, bodem en dieren."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Holistic grazing"@en,
        "Holistisch beweiden"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "similar to rotational grazing but differs in that it more explicitly recognizes and provides a framework for adapting to the four basic ecosystem processes by increasing the recovery time"@en,
        "Een adaptieve vorm van beweidingsbeheer waarin graasdruk en herstelperioden worden afgestemd op de toestand van vegetatie, bodem en ecosysteemprocessen."@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "Animals are grazing on grassland. The photograph illustrates the practical connection between grazing, grassland use and livestock farming."@en,
        "De dieren grazen op grasland. De foto toont de praktische samenhang tussen beweiding, het gebruik van grasland en het houden van vee."@nl ;
    schema:creditText "Foto: Wikimedia Commons, grazende koeien in de provincie Utrecht (Nederland)." .

vocab:HugelkulturRaisedBeds a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Huegelbeet-by-Maseltov.jpg> ;
    skos:broader vocab:SoilSeedbedPreparation ;
    skos:definition "Building raised planting beds with woody material and organic matter, allowing decomposition and gradual release of moisture and nutrients."@en,
        "Het aanleggen van verhoogde teeltbedden met houtachtig materiaal en organische stof die geleidelijk verteren en vocht en nutriënten kunnen vasthouden of vrijgeven."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Hügelkultur/ raised beds"@en,
        "Hügelkultur en verhoogde teeltbedden"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Huegelbeet-by-Maseltov.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The raised growing bed shows how organic material and soil can be arranged to create a bed for crop cultivation."@en,
        "Het verhoogde teeltbed toont hoe organisch materiaal en grond in een teeltbed worden opgebouwd voor de teelt van gewassen."@nl .

vocab:HumanureComposting a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Composting_toilet.jpg> ;
    skos:broader vocab:UseOfSpecificFertilizerTypesOrManure ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Treating human excreta through controlled composting to stabilise organic material and reduce pathogens before any permitted use; strict hygiene and legal requirements apply."@en,
        "Het onder gecontroleerde omstandigheden composteren van menselijke uitwerpselen om organisch materiaal te stabiliseren en ziekteverwekkers te verminderen; strenge hygiëne- en wettelijke eisen gelden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Humanure composting"@en,
        "Compostering van menselijke uitwerpselen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Composting_toilet.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Humanure composting'."@en,
        "Het gebruik van Humane mest compostering als meststof"@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "Compost on a farmyard illustrates the organic material used in compost application for soil management and nutrient cycling."@en,
        "De compost op het agrarische erf laat het organische materiaal zien dat bij compostgebruik wordt ingezet voor de bodem en nutriëntenkringloop."@nl .

vocab:ImplementHousingSystemToSeperateManureAndUrineInSolidAndLiquidFractions a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Dairy_farm_(P-062705-00-19).jpg> ;
    skos:broader vocab:BuildingForEmissionReduction ;
    skos:definition "Using housing floors or manure collection systems that separate faeces and urine soon after excretion to enable different treatment and reduce some emissions."@en,
        "Het toepassen van stalvloeren of opvangsystemen die feces en urine kort na uitscheiding scheiden zodat beide fracties afzonderlijk kunnen worden behandeld en bepaalde emissies worden beperkt."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "Implement housing system to seperate manure and urine in solid and liquid fractions"@en,
        "Huisvestingssysteem voor scheiding van mest en urine"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Dairy%20farm%20(P-062705-00-19).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The historical photograph shows a dairy farm, illustrating the livestock housing context in which manure and urine separation systems can be installed."@en,
        "De foto toont een melkveebedrijf op een historische foto. Daarmee wordt een onderdeel van ‘Huisvestingssysteem voor scheiding van mest en urine’ zichtbaar."@nl ;
    schema:creditText "Foto: Europese Commissie, audiovisuele dienst / Lukasz Kobus, Yügen (CC BY 4.0)."@nl .

vocab:IncomeBroadeningMicro a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:FarmersMarket.jpg> ;
    skos:broader vocab:IncomeBroadeningMeso ;
    skos:definition "Introducing concrete supplementary income activities, such as tourism, education, processing or paid services, alongside existing farm production."@en,
        "Het toevoegen van concrete neveninkomsten, zoals toerisme, educatie, verwerking of betaalde diensten, naast de bestaande agrarische productie."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Income broadening"@en,
        "Inkomensverbreding"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/FarmersMarket.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "Agricultural products are offered for sale at a market or farm shop. This illustrates a sales channel through which farms can sell their produce to customers."@en,
        "Op de foto worden landbouwproducten op een markt of bij een boerderijwinkel aangeboden. Dit illustreert een verkoopkanaal waarmee landbouwbedrijven hun producten aan afnemers kunnen aanbieden."@nl .

vocab:IncorperatingCropResidues a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Harrowing_to_incorporate_straw,_near_Thame_-_geograph.org.uk_-_228241.jpg> ;
    skos:broader vocab:UseOfSpecificFertilizerTypesOrManure ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Mixing harvested crop residues such as straw, stems or leaves into the soil for decomposition and return of organic matter and nutrients."@en,
        "Het inwerken van oogstresten, zoals stro, stengels en bladeren, in de bodem zodat ze afbreken en organische stof en nutriënten terugleveren."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Incorperating crop residues"@en,
        "Inwerken van gewasresten"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Harrowing_to_incorporate_straw%2C_near_Thame_-_geograph.org.uk_-_228241.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Incorperating crop residues'."@en,
        "Het gebruik van Gewasresten onder-/inwerken als meststof"@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a field being harrowed. It illustrates the cultivation of topsoil and crop residues as an aspect of the practice “Incorperating crop residues”."@en,
        "De foto toont het eggen van een akker. Zo wordt het bewerken van de bovenste bodemlaag en gewasresten zichtbaar als onderdeel van de praktijk ‘Inwerken van gewasresten’."@nl .

vocab:InfiltrationChannels a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Grass_lined_channel_NRCS.jpg> ;
    skos:broader vocab:WaterStorage ;
    skos:definition "Constructing shallow channels or trenches that direct and retain runoff so that water can infiltrate into the soil instead of flowing away rapidly."@en,
        "Het aanleggen van ondiepe geulen of sleuven die afstromend water opvangen en geleiden zodat het in de bodem kan infiltreren in plaats van snel af te voeren."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Infiltration channels"@en,
        "Infiltratiegeulen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Grass_lined_channel_NRCS.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a grass-lined drainage channel. It illustrates the collection and conveyance of water across the landscape as an aspect of the practice “Infiltration channels”."@en,
        "De foto toont een met gras begroeide watergeul. Zo wordt het opvangen en geleiden van water in het landschap zichtbaar als onderdeel van de praktijk ‘Infiltratiegeulen’."@nl .

vocab:InputReductionOfEGAgrochemicalsAndFeed a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg> ;
    skos:broader vocab:IndividualAndCollectiveFormsOfCostReducingMeasures ;
    skos:definition "Lowering the quantity or dependency on purchased external inputs, such as agrochemicals and feed, while managing production and animal needs."@en,
        "Het verminderen van hoeveelheden of afhankelijkheid van ingekochte inputs, zoals gewasbeschermingsmiddelen en voer, met behoud van aandacht voor productie- en dierbehoeften."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Input reduction of e.g. agrochemicals and feed"@en,
        "Vermindering van externe inputs zoals gewasbeschermingsmiddelen en voer"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows cows grazing outdoors on grassland. It illustrates the use of grassland by grazing livestock as an aspect of the practice “Input reduction of e.g. agrochemicals and feed”."@en,
        "De foto toont koeien die buiten op grasland grazen. Zo wordt het gebruik van grasland door weidend vee zichtbaar als onderdeel van de praktijk ‘Vermindering van externe inputs zoals gewasbeschermingsmiddelen en voer’."@nl ;
    schema:creditText "Foto: Wikimedia Commons, grazende koeien in de provincie Utrecht (Nederland)." .

vocab:InsectHotels a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Insect_hotel.jpg> ;
    skos:broader vocab:HabitatProvisionBiodiversityEnhancement ;
    skos:definition "Installing structures with cavities or nesting materials that provide shelter or nesting sites for certain solitary bees and other beneficial insects."@en,
        "Het plaatsen van constructies met holtes of nestmateriaal als schuil- of nestgelegenheid voor bepaalde solitaire bijen en andere nuttige insecten."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Insect hotels"@en,
        "Insectenhotels"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Insect_hotel.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The insect hotel provides small nesting and shelter spaces, illustrating how insect habitats can be added to farmland."@en,
        "Het insectenhotel biedt kleine nest- en schuilruimten en laat zien hoe voorzieningen voor insecten aan een perceel kunnen worden toegevoegd."@nl ;
    schema:creditText "Foto: Alexandre Dulaunoy (CC BY-SA 2.0)."@nl .

vocab:IntegratedPestManagementPrinciplesIPM a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:NRCSIA99279_-_Iowa_(3253)(NRCS_Photo_Gallery).jpg> ;
    skos:broader vocab:NonChemicalControlWeedsPestsAndDiseases ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Preventing and managing pests through monitoring, thresholds, resistant varieties and biological or non-chemical methods, using pesticides only when justified."@en,
        "Het voorkomen en beheersen van plagen via monitoring, schadedrempels, resistente rassen en biologische of niet-chemische methoden, met chemische middelen alleen wanneer gerechtvaardigd."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Integrated pest management principles (IPM)"@en,
        "Principes van geïntegreerde gewasbescherming (IPM)"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/NRCSIA99279_-_Iowa_(3253)(NRCS_Photo_Gallery).jpg?width=960> ;
    regenlmeta:definitionReference <https://www.fao.org/pest-and-pesticide-management/ipm/integrated-pest-management/en/> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Integrated pest management principles (IPM)'."@en,
        "Geintegreerd gebruik van bestrijdingsmethoden, waarbij biologische, mechanische en andere niet synthetische methoden de voorkeur hebben. Synthetische middelen worden alleen gebruikt als het niet anders kan."@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a crop adviser inspecting a field for pests, illustrating field monitoring as part of integrated pest management (IPM)."@en,
        "De foto toont een gewasadviseur inspecteert een perceel op plagen. Daarmee wordt een onderdeel van ‘Principes van geïntegreerde gewasbescherming (IPM)’ zichtbaar."@nl .

vocab:IntegratedWeedManagement a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Einb%C3%B6ck_Chopstar_3-60_Hackger%C3%A4t_Row-crop_cultivator_Bineuse_016.jpg> ;
    skos:broader vocab:NonChemicalControlWeedsPestsAndDiseases ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Combining preventive, cultural, mechanical and where necessary chemical approaches to manage weeds while reducing reliance on any single method."@en,
        "Het combineren van preventieve, teeltkundige, mechanische en zo nodig chemische maatregelen tegen onkruid om afhankelijkheid van één aanpak te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Integrated weed management"@en,
        "Geïntegreerd onkruidbeheer"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Einb%C3%B6ck_Chopstar_3-60_Hackger%C3%A4t_Row-crop_cultivator_Bineuse_016.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Integrated weed management'."@en,
        "Geintegreerd gebruik van onkruidbestrijdingsmethoden, waarbij biologische, mechanische en andere niet synthetische methoden de voorkeur hebben. Synthetische herbiciden worden alleen gebruikt als het niet anders kan."@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a mechanical hoe working between crop rows. It illustrates mechanical weed control between crops as an aspect of the practice “Integrated weed management”."@en,
        "De foto toont een schoffelwerktuig dat onkruid tussen gewasrijen bewerkt. Zo wordt mechanische onkruidbeheersing tussen de gewassen zichtbaar als onderdeel van de praktijk ‘Geïntegreerd onkruidbeheer’."@nl .

vocab:KeepLivingRoots a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilSeedbedPreparation ;
    skos:definition "Maintaining living plant roots in the soil for as much of the year as practical through perennial crops, cover crops or overlapping growing periods."@en,
        "Het zo lang mogelijk gedurende het jaar behouden van levende plantenwortels in de bodem via meerjarige gewassen, bodembedekkers of overlappende teeltperioden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Keep living roots"@en,
        "Levende wortels in de bodem behouden"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "Agricultural soil is the focus of the photograph, making the physical basis of soil management visible."@en,
        "De landbouwbodem staat centraal op de foto. Zo wordt de fysieke basis van het bodembeheer zichtbaar."@nl ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:KeepWaterLevelsHighMicro a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Drip_irrigation.jpg> ;
    skos:broader vocab:KeepWaterLevelsHighMeso ;
    skos:definition "Maintaining an agreed elevated surface-water or groundwater level through adjustable drains, weirs or water-control structures."@en,
        "Het handhaven van een afgesproken hogere oppervlaktewater- of grondwaterstand met regelbare drainage, stuwen of andere waterregelvoorzieningen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "keep water levels high"@en,
        "Hoge waterstanden handhaven"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Drip_irrigation.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows drip lines delivering water close to plants. It illustrates targeted irrigation close to the crop as an aspect of the practice “keep water levels high”."@en,
        "De foto toont druppelleidingen die water gericht bij planten brengen. Zo wordt gerichte irrigatie bij het gewas zichtbaar als onderdeel van de praktijk ‘Hoge waterstanden handhaven’."@nl ;
    schema:creditText "Foto: USDA (public domain, U.S. federal government)."@nl .

vocab:LegumesNFixingPlantsInOration a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:A_field_of_clover_on_Clan_Down_-_geograph.org.uk_-_974046.jpg> ;
    skos:broader vocab:ExtensiveCropRotations ;
    skos:definition "Including legumes or other nitrogen-fixing plants in crop rotations to introduce biologically fixed nitrogen and diversify cropping sequences."@en,
        "Het opnemen van vlinderbloemigen of andere stikstofbindende planten in de vruchtwisseling om biologisch gebonden stikstof aan te voeren en teelten te variëren."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Legumes (N-fixing plants) in oration"@en,
        "Vlinderbloemigen en stikstofbindende gewassen in de rotatie"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/A_field_of_clover_on_Clan_Down_-_geograph.org.uk_-_974046.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “A field of clover on Clan Down - geograph.org.uk - 974046”. It illustrates the related agricultural context as an aspect of the practice “Legumes (N-fixing plants) in oration”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘A field of clover on Clan Down - geograph.org.uk - 974046’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Vlinderbloemigen en stikstofbindende gewassen in de rotatie’."@nl .

vocab:LocalOrNativeCropAndAnimalSpecies a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Rode_blaarkop_hoogdrachtig.jpg> ;
    skos:broader vocab:NativeCropAndAnimalSpecies ;
    skos:definition "Selecting crop or livestock species and varieties that are locally adapted or native to the region, with attention to agroecological suitability."@en,
        "Het kiezen van gewas- of diersoorten en rassen die lokaal aangepast of inheems zijn, rekening houdend met geschiktheid voor het agro-ecosysteem."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Local or native crop and animal species"@en,
        "Lokale of inheemse gewas- en diersoorten"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Rode_blaarkop_hoogdrachtig.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “Rode blaarkop hoogdrachtig”. It illustrates the related agricultural context as an aspect of the practice “Local or native crop and animal species”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘Rode blaarkop hoogdrachtig’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Lokale of inheemse gewas- en diersoorten’."@nl .

vocab:LocalOrRegionalCollaborationBetweenSectorsEGCropLivestock a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Sheep_under_solar_panels_(1)_2025-07-26.jpg> ;
    skos:broader vocab:ResourceSharingCollaborationBetweenArableProductionAndDairy ;
    skos:definition "Cooperation between farms or sectors in a locality, for example exchanging manure, feed, straw or land use between crop and livestock farms."@en,
        "Samenwerking tussen bedrijven of sectoren in een regio, bijvoorbeeld door uitwisseling van mest, voer, stro of grondgebruik tussen akkerbouw en veehouderij."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Local or regional collaboration between sectors (e.g. crop-livestock)"@en,
        "Lokale of regionale samenwerking tussen sectoren"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Sheep_under_solar_panels_(1)_2025-07-26.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows solar panels over agricultural land with sheep. It illustrates the combination of renewable energy and agricultural land use as an aspect of the practice “Local or regional collaboration between sectors (e.g. crop-livestock)”."@en,
        "De foto toont zonnepanelen boven landbouwgrond met schapen. Zo wordt de combinatie van hernieuwbare energie en agrarisch landgebruik zichtbaar als onderdeel van de praktijk ‘Lokale of regionale samenwerking tussen sectoren’."@nl ;
    schema:creditText "Foto: Andy Li (CC0 1.0)."@nl .

vocab:MOBGrazing a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:NRCSAR02040_-_Arkansas_(263)(NRCS_Photo_Gallery).jpg> ;
    skos:broader vocab:GrazingSystem ;
    skos:definition "Grazing a pasture with a very high animal density for a short period followed by a comparatively long recovery period for vegetation."@en,
        "Het gedurende korte tijd beweiden van grasland met een zeer hoge dierdichtheid, gevolgd door een relatief lange herstelperiode van de vegetatie."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "MOB grazing"@en,
        "Mobbeweiding"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/NRCSAR02040_-_Arkansas_(263)(NRCS_Photo_Gallery).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "high denisty grazing, a grazing management system where a large herd of livestock grazes a small area for a short period, followed by a long rest period for the pasture to recover"@en,
        "Beweiding met een hoge veedichtheid gedurende een korte graasperiode, gevolgd door een relatief lange herstelperiode voor de vegetatie."@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “NRCSAR02040 - Arkansas”. It illustrates the related agricultural context as an aspect of the practice “MOB grazing”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘NRCSAR02040 - Arkansas’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Mobbeweiding’."@nl .

vocab:ManureSampleAnalysis a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Field_soil_sampling.jpg> ;
    skos:broader vocab:MeasuringAndMonitoring ;
    skos:definition "Laboratory or on-farm analysis of manure samples to determine nutrient contents and other properties needed for fertilisation planning."@en,
        "Het analyseren van mestmonsters in het laboratorium of op het bedrijf om nutriëntengehalten en andere eigenschappen voor de bemestingsplanning te bepalen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Manure sample analysis"@en,
        "Mestmonsteranalyse"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Field_soil_sampling.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows samples being collected from agricultural soil. It illustrates the assessment of soil properties as an aspect of the practice “Manure sample analysis”."@en,
        "De foto toont het nemen van monsters uit landbouwgrond. Zo wordt het onderzoeken van bodemkenmerken zichtbaar als onderdeel van de praktijk ‘Mestmonsteranalyse’."@nl ;
    schema:creditText "Foto: Alessandro Samuel-Rosa (CC0 1.0)."@nl .

vocab:MechanicalPestManagement a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Vernon_Pitfall_Trap.png> ;
    skos:broader vocab:NonChemicalControlWeedsPestsAndDiseases ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Reducing pest populations using physical or mechanical interventions such as barriers, traps, removal or mechanical destruction rather than chemical pesticides."@en,
        "Het verminderen van plaagorganismen met fysieke of mechanische ingrepen, zoals barrières, vallen, verwijderen of mechanisch bestrijden, in plaats van chemische middelen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Mechanical pest management"@en,
        "Mechanische plaagbeheersing"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Vernon_Pitfall_Trap.png?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Mechanical pest management'."@en,
        "Plaagbestrijding met behulp van werktuigen of andere fysieke maatregelen, bv. netten of geluid"@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a pheromone trapping system for click beetles, illustrating a trapping method used in pest management."@en,
        "De foto toont een feromoonvallen-systeem voor kniptorren. Daarmee wordt een onderdeel van ‘Mechanische plaagbeheersing’ zichtbaar."@nl .

vocab:MechanicalWeedManagement a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Gurken_Feld_Unkraut_Hackger%C3%A4t-1-Josef_Schlaghecken.jpg> ;
    skos:broader vocab:NonChemicalControlWeedsPestsAndDiseases ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Managing weeds by mechanical actions such as hoeing, harrowing, brushing or cutting, instead of or in addition to herbicides."@en,
        "Het beheersen van onkruid met mechanische bewerkingen zoals schoffelen, eggen, borstelen of maaien, in plaats van of naast herbiciden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Mechanical weed management"@en,
        "Mechanische onkruidbestrijding"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Gurken_Feld_Unkraut_Hackger%C3%A4t-1-Josef_Schlaghecken.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Mechanical weed management'."@en,
        "Onkruidbestrijding met behulp van werktuigen of andere fysiek maatregelen, incl. handmatig wieden"@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "Weeds are mechanically hoed between crop rows. The photograph illustrates how equipment can control weeds without directly applying herbicides."@en,
        "Tussen de gewasrijen wordt mechanisch geschoffeld. De foto illustreert hoe onkruid met een werktuig kan worden bestreden zonder directe inzet van herbiciden."@nl .

vocab:MinimalUseOfExternalFertilizersInputsFromOutsideTheFarm a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:ReductionLimitationOfSpecificFertilizers ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Obtaining as much crop nutrition as feasible from on-farm nutrient cycling while limiting purchased or imported fertilisers."@en,
        "Het zoveel mogelijk voorzien in gewasvoeding door nutriëntenkringlopen op het eigen bedrijf en het beperken van aangekochte of aangevoerde meststoffen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Minimal use of external fertilizers inputs (from outside the farm)"@en,
        "Minimaal gebruik van meststoffen van buiten het bedrijf"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Minimal use of external fertilizers inputs (from outside the farm)'."@en,
        "Het verminderd of minimaal gebruik van externe messtoffen"@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a compost heap containing organic material. It illustrates the collection and processing of organic residual materials as an aspect of the practice “Minimal use of external fertilizers inputs (from outside the farm)”."@en,
        "De foto toont een composthoop met organisch materiaal. Zo wordt het verzamelen en verwerken van organische restmaterialen zichtbaar als onderdeel van de praktijk ‘Minimaal gebruik van meststoffen van buiten het bedrijf’."@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:MinimizeIrrigation a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Drip_irrigation.jpg> ;
    skos:broader vocab:MinimizeWaterUse ;
    skos:definition "Reducing irrigation frequency or volume by matching watering to crop needs and using soil-moisture conservation measures."@en,
        "Het beperken van beregeningsfrequentie of watervolume door watergiften op de gewasbehoefte af te stemmen en bodemvocht vast te houden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Minimize irrigation"@en,
        "Irrigatie minimaliseren"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Drip_irrigation.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "Water is delivered close to the plants through drip irrigation lines. This is a clear example of targeted water application in crop production."@en,
        "Water wordt via druppelleidingen dicht bij de planten aangevoerd. Dit is een herkenbaar voorbeeld van gerichte watertoediening in de teelt."@nl ;
    schema:creditText "Foto: USDA (public domain, U.S. federal government)."@nl .

vocab:MinimizeTractorUse a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilAndMachineryUse ;
    skos:definition "Reducing the number, distance or intensity of tractor operations through combined tasks, alternative equipment or less frequent field passes."@en,
        "Het verminderen van aantallen, afstanden of intensiteit van tractorbewerkingen door werkzaamheden te combineren, ander materieel of minder werkgangen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Minimize tractor use"@en,
        "Tractorinzet minimaliseren"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows soil and vegetation on agricultural land. It illustrates the relationship between soil management and crop growth as an aspect of the practice “Minimize tractor use”."@en,
        "De foto toont de bodem en de begroeiing van landbouwgrond. Zo wordt de relatie tussen bodembeheer en gewasgroei zichtbaar als onderdeel van de praktijk ‘Tractorinzet minimaliseren’."@nl ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:MinimumGrazingPeriodNoOrRestrictedGrazingGrazingLivestockDensityLimitation a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg> ;
    skos:broader vocab:ReductionInGrazingIntensity15LUHaForInstanceForVoluntaryEcoPracticePackages ;
    skos:definition "Restricting grazing duration, timing or livestock density on designated land to protect vegetation, soils or biodiversity under defined management rules."@en,
        "Het beperken van graasduur, graasmomenten of veebezetting op aangewezen grond om vegetatie, bodem of biodiversiteit volgens bepaalde beheerregels te beschermen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "minimum grazing period; no or restricted grazing; grazing livestock density limitation"@en,
        "Minimale beweidingsperiode of beperkingen aan beweiding en veebezetting"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "Animals are grazing on grassland. The photograph illustrates the practical connection between grazing, grassland use and livestock farming."@en,
        "De dieren grazen op grasland. De foto toont de praktische samenhang tussen beweiding, het gebruik van grasland en het houden van vee."@nl ;
    schema:creditText "Foto: Wikimedia Commons, grazende koeien in de provincie Utrecht (Nederland)." .

vocab:MinimumTillage a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:NRCS_Kentucky_(20240418-NRCS-JP-0004).jpg> ;
    skos:broader vocab:ReduceTillageMinimalTillage ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Preparing or managing soil with a reduced number or intensity of tillage operations compared with conventional plough-based cultivation."@en,
        "Het bewerken van de bodem met minder werkgangen of lagere bewerkingsintensiteit dan bij conventionele teelt met ploegen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Minimum tillage"@en,
        "Minimale grondbewerking"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/NRCS_Kentucky_(20240418-NRCS-JP-0004).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "tillage only in spots where plants are seeded"@en,
        "Alleen daar waar gezaaid of geplant wordt, wordt de bodem bewerkt"@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “NRCS Kentucky”. It illustrates the related agricultural context as an aspect of the practice “Minimum tillage”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘NRCS Kentucky’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Minimale grondbewerking’."@nl .

vocab:MixedFarmingIntegrateLivestock a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Sheep_under_solar_panels_(1)_2025-07-26.jpg> ;
    skos:broader vocab:ResourceSharingCollaborationBetweenArableProductionAndDairy ;
    skos:definition "Combining arable or horticultural crops with livestock on one farm so that resources such as feed, manure and crop residues can be cycled internally."@en,
        "Het combineren van akkerbouw of tuinbouw met veehouderij op één bedrijf zodat voer, mest en gewasresten onderling kunnen worden benut."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Mixed farming / integrate livestock"@en,
        "Gemengd bedrijf met geïntegreerde veehouderij"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Sheep_under_solar_panels_(1)_2025-07-26.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "Sheep graze among or beneath solar panels. The photograph shows how grazing and solar energy generation can share the same area."@en,
        "Schapen grazen tussen of onder zonnepanelen. De foto laat zien hoe beweiding en opwekking van zonne-energie ruimtelijk kunnen worden gecombineerd."@nl ;
    schema:creditText "Foto: Andy Li (CC0 1.0)."@nl .

vocab:MixedIntercroppingMixedCropping a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Intercropping_maize_and_beans.jpg> ;
    skos:broader vocab:CropDiversificationIntercroppingPolycultureNoMonocultureCompanionPlanting ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Growing two or more crop species at the same time in a mixed stand on one field without necessarily separating them into distinct rows."@en,
        "Het gelijktijdig verbouwen van twee of meer gewassoorten in een gemengde stand op één perceel, zonder dat afzonderlijke rijen nodig zijn."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (nl): Het op hetzelfde perceel gemengd inzaaien of telen van twee of meer gewassen zonder afzonderlijke rijen of stroken."@nl ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Mixed intercropping / mixed cropping"@en,
        "Mengteelt en gewascombinaties"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Intercropping_maize_and_beans.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "Mixed cropping is a system of sowing two or more crops mixed together on the same field without any distinct row or strip pattern"@en,
        "Twee of meer gewassen worden gemengd op hetzelfde perceel gezaaid, zonder ruimtelijke structuur"@nl ;
    regenlmeta:photoCaptionStatus "description-review-needed" ;
    regenlmeta:photoPracticeDescription "Maize and beans grow together in the same field. The photograph shows how different crops can be grown simultaneously on the same agricultural land."@en,
        "Maïs en bonen groeien samen op hetzelfde perceel. De foto laat zien hoe verschillende gewassen gelijktijdig op één stuk landbouwgrond kunnen worden geteeld."@nl ;
    schema:creditText "Foto: AnnaJB (CC BY-SA 4.0)."@nl .

vocab:MobileChickenCoopsMicro a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Freilandhaltung_mit_mobilem_H%C3%BChnerstall.jpg> ;
    skos:broader vocab:AnimalHousing ;
    skos:definition "Using movable poultry housing that can be relocated across farmland to provide changing outdoor access and distribute manure and grazing pressure."@en,
        "Het gebruiken van verplaatsbare kippenhokken die over landbouwgrond worden verschoven om wisselende buitenuitloop te bieden en mest en gebruiksdruk te spreiden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Mobile chicken coops"@en,
        "Mobiele kippenhokken"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Freilandhaltung_mit_mobilem_H%C3%BChnerstall.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The mobile chicken coop stands next to an outdoor area used by chickens. Moving the coop allows the birds to use different parts of the field."@en,
        "Het mobiele kippenhok staat bij de uitloop van kippen. Door het hok te verplaatsen kunnen de dieren verschillende delen van het perceel benutten."@nl .

vocab:MobileChickenCoopsNano a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Mobile_Chicken_Barn.png> ;
    skos:broader vocab:OutdoorAccess ;
    skos:definition "Moving a portable chicken coop between specific pasture positions according to a planned schedule to avoid prolonged pressure at one spot."@en,
        "Het volgens een planning verplaatsen van een mobiel kippenhok tussen concrete plekken in het grasland om langdurige belasting van één locatie te vermijden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "Mobile chicken coops"@en,
        "Mobiele kippenhokken"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Mobile_Chicken_Barn.png?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a mobile chicken house with free-ranging hens. It illustrates mobile housing and outdoor access for chickens as an aspect of the practice “Mobile chicken coops”."@en,
        "De foto toont een verplaatsbaar kippenhok met buitenlopende kippen. Zo wordt de verplaatsbare huisvesting en de uitloop voor kippen zichtbaar als onderdeel van de praktijk ‘Mobiele kippenhokken’."@nl .

vocab:MonitoringOfAnimalWelfare a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:11VS04-047_(52034992972).jpg> ;
    skos:broader vocab:AnimalHousing ;
    skos:definition "Regularly assessing animal-based indicators such as behaviour, injuries, body condition and health to detect and address welfare problems."@en,
        "Het regelmatig beoordelen van diergebonden indicatoren, zoals gedrag, verwondingen, lichaamsconditie en gezondheid, om welzijnsproblemen te signaleren en aan te pakken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "monitoring of animal welfare"@en,
        "Monitoring van dierenwelzijn"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/11VS04-047_(52034992972).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “11VS04-047”. It illustrates the related agricultural context as an aspect of the practice “monitoring of animal welfare”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘11VS04-047’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Monitoring van dierenwelzijn’."@nl .

vocab:MoreEfficientFertilizerAplication a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:SpecificFertilizerApplicationTechniques ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Improving placement, timing, dosing or equipment used for fertiliser application so that crops capture more nutrients and losses are reduced."@en,
        "Het verbeteren van plaatsing, timing, dosering of apparatuur bij bemesting zodat gewassen nutriënten beter benutten en verliezen afnemen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "More efficient fertilizer aplication"@en,
        "Efficiëntere meststoftoediening"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'More efficient fertilizer aplication'."@en,
        "Maatregelen voor een effiecientere opname en minder verliezen van meststoffen"@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a compost heap containing organic material. It illustrates the collection and processing of organic residual materials as an aspect of the practice “More efficient fertilizer aplication”."@en,
        "De foto toont een composthoop met organisch materiaal. Zo wordt het verzamelen en verwerken van organische restmaterialen zichtbaar als onderdeel van de praktijk ‘Efficiëntere meststoftoediening’."@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:MultispeciesCoverCrops a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Awesome_Cover_Crops_started_in_Eastern_South_Dakota_(14941079819).jpg> ;
    skos:broader vocab:CropDiversificationCoverCrops ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Growing a cover-crop mixture containing at least two plant species with complementary root, nutrient or habitat characteristics."@en,
        "Het telen van een mengsel van minimaal twee bodembedekkende plantensoorten met verschillende wortel-, nutriënten- of leefgebiedfuncties."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (nl): Het inzaaien van een mengsel van minstens twee soorten groenbedekkers, bijvoorbeeld grassen, kruisbloemigen of vlinderbloemigen."@nl ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Multispecies cover crops"@en,
        "Bodembedekkers met meerdere soorten"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Awesome_Cover_Crops_started_in_Eastern_South_Dakota_(14941079819).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "More then 1 different types of species of cover crops are sown (eg. Combination of combination of annual grasses, brassicas, and legumes)"@en,
        "mengsel van verschillende soorten bodembedekker (zoals een combinatie van eenjarige grassen, kruisbloemigen en vlinderbloemigen"@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a field planted with diverse cover crops. It illustrates the combination of cover crop species as an aspect of the practice “Multispecies cover crops”."@en,
        "De foto toont een akker met verschillende bodembedekkende gewassen. Zo wordt het combineren van bodembedekkende plantensoorten zichtbaar als onderdeel van de praktijk ‘Bodembedekkers met meerdere soorten’."@nl .

vocab:NativeTrees a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Hedgerow_planting_-_geograph.org.uk_-_1555297.jpg> ;
    skos:broader vocab:NativeCropAndAnimalSpecies ;
    skos:definition "Planting or retaining tree species naturally occurring in the region and suited to local ecological conditions."@en,
        "Het planten of behouden van boomsoorten die van nature in de regio voorkomen en passen bij de lokale ecologische omstandigheden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Native trees"@en,
        "Inheemse bomen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Hedgerow_planting_-_geograph.org.uk_-_1555297.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a hedgerow and trees in farmland. It illustrates woody landscape elements as habitats and corridors as an aspect of the practice “Native trees”."@en,
        "De foto toont een haag en bomen in het agrarisch landschap. Zo wordt houtige landschapselementen als leefgebied en verbinding zichtbaar als onderdeel van de praktijk ‘Inheemse bomen’."@nl .

vocab:NaturalBufferZones a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:NRCSIA00045(16046)(NRCS_Photo_Gallery).jpg> ;
    skos:broader vocab:HabitatProvisionBiodiversityEnhancement ;
    skos:definition "Maintaining strips or patches of semi-natural vegetation between farmland and vulnerable areas to intercept runoff, provide habitat or reduce disturbance."@en,
        "Het behouden van stroken of plekken halfnatuurlijke vegetatie tussen landbouwgrond en kwetsbare gebieden om afstroming op te vangen, leefgebied te bieden of verstoring te verminderen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Natural buffer zones"@en,
        "Natuurlijke bufferzones"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/NRCSIA00045(16046)(NRCS_Photo_Gallery).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “NRCSIA00045”. It illustrates the related agricultural context as an aspect of the practice “Natural buffer zones”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘NRCSIA00045’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Natuurlijke bufferzones’."@nl .

vocab:NaturalPestManagement a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Hoverfly_larva.jpg> ;
    skos:broader vocab:NonChemicalControlWeedsPestsAndDiseases ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Controlling crop pests by supporting natural enemies and ecological processes, such as predators, parasitoids or habitat-based regulation."@en,
        "Het beheersen van gewasplagen door natuurlijke vijanden en ecologische processen te ondersteunen, zoals predatoren, parasitoïden en leefgebiedbeheer."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Natural pest management"@en,
        "Natuurlijke plaagbeheersing"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Hoverfly_larva.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Natural pest management'."@en,
        "Het gebruik van nuttige organismen om schadelijke plagen te bestrijden."@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “Hoverfly larva”. It illustrates the related agricultural context as an aspect of the practice “Natural pest management”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘Hoverfly larva’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Natuurlijke plaagbeheersing’."@nl .

vocab:NaturalWaterHarvesting a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Pond_in_the_region_near_Utrecht_in_the_Netherlands.jpg> ;
    skos:broader vocab:WaterStorage ;
    skos:definition "Capturing and retaining rainfall or surface runoff using landscape features, soil measures or natural storage for later infiltration or use."@en,
        "Het opvangen en vasthouden van neerslag of afstromend water met landschapselementen, bodemmaatregelen of natuurlijke buffers voor latere infiltratie of benutting."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Natural water harvesting"@en,
        "Natuurlijke wateropvang"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Pond_in_the_region_near_Utrecht_in_the_Netherlands.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a pond in the countryside near Utrecht, illustrating a landscape feature that can collect and retain water naturally."@en,
        "De foto toont een poel in het buitengebied bij Utrecht. Daarmee wordt een onderdeel van ‘Natuurlijke wateropvang’ zichtbaar."@nl ;
    schema:creditText "Foto: Wikimedia Commons, poel bij Utrecht (Nederland)." .

vocab:NaturalWeedManagement a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Mechanical_Weed_Control.jpg> ;
    skos:broader vocab:NonChemicalControlWeedsPestsAndDiseases ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Suppressing weeds through ecological measures such as competition, mulching, grazing or crop rotation without relying primarily on synthetic herbicides."@en,
        "Het onderdrukken van onkruid via ecologische maatregelen zoals concurrentie door gewassen, mulch, beweiding of vruchtwisseling, zonder primair op synthetische herbiciden te steunen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Natural weed management"@en,
        "Natuurlijk onkruidbeheer"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Mechanical_Weed_Control.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Natural weed management'."@en,
        "Ander natuurlijk onkruidbeheer, bv. specifieke groenbemesters of landbewerking voor de teelt"@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “Mechanical Weed Control”. It illustrates the related agricultural context as an aspect of the practice “Natural weed management”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘Mechanical Weed Control’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Natuurlijk onkruidbeheer’."@nl .

vocab:NoExternalFertilizersUsedAsInput a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:ReductionLimitationOfSpecificFertilizers ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Operating the crop production system without fertilisers imported from outside the farm, relying instead on internal nutrient sources and cycling."@en,
        "Het telen zonder aanvoer van meststoffen van buiten het bedrijf en de gewasvoeding baseren op interne nutriëntenbronnen en kringlopen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "No external fertilizers used as input"@en,
        "Geen meststoffen van buiten het bedrijf"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'No external fertilizers used as input'."@en,
        "Meststoffengebruik van alleen binnen het bedrijf en niet extern aangewende meststoffen"@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a compost heap containing organic material. It illustrates the collection and processing of organic residual materials as an aspect of the practice “No external fertilizers used as input”."@en,
        "De foto toont een composthoop met organisch materiaal. Zo wordt het verzamelen en verwerken van organische restmaterialen zichtbaar als onderdeel van de praktijk ‘Geen meststoffen van buiten het bedrijf’."@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:NoFertilizationAlongsideOpenWater a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:SpecificFertilizerApplicationTechniques ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Leaving a designated strip adjacent to open water unfertilised to limit direct nutrient inputs and runoff into the watercourse."@en,
        "Het onbemest laten van een aangewezen strook langs open water om directe nutriëntenbelasting en afspoeling naar de watergang te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "No fertilization alongside open water"@en,
        "Niet bemesten langs open water"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'No fertilization alongside open water'."@en,
        "Een bepaalde afstand houden tot de sloot of ander open water, met bemesting"@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a compost heap containing organic material. It illustrates the collection and processing of organic residual materials as an aspect of the practice “No fertilization alongside open water”."@en,
        "De foto toont een composthoop met organisch materiaal. Zo wordt het verzamelen en verwerken van organische restmaterialen zichtbaar als onderdeel van de praktijk ‘Niet bemesten langs open water’."@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:NoFungicides a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg> ;
    skos:broader vocab:LimitationOnTheUseOfPlantProtectionProducts ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Not applying fungicidal plant protection products to the specified crop or field during the relevant management period."@en,
        "Het gedurende de betreffende beheerperiode niet toepassen van fungiciden op het aangewezen gewas of perceel."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "No fungicides"@en,
        "Geen fungiciden"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'No fungicides'."@en,
        "Totaal geen gebruik van fungiciden op het bedrijf. Eventueel wel andere middelen."@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows crops grown in an organic farming context. It illustrates crop production and management on farmland as an aspect of the practice “No fungicides”."@en,
        "De foto toont een landbouwperceel met gewassen in een biologische landbouwcontext. Zo wordt teelt en gewasbeheer op landbouwgrond zichtbaar als onderdeel van de praktijk ‘Geen fungiciden’."@nl ;
    schema:creditText "Foto: Henk Monster / Anefo / Wikimedia Commons (controleer bron en licentie)." .

vocab:NoHeavyMachinery a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilAndMachineryUse ;
    skos:definition "Avoiding field machinery above a chosen weight or axle-load threshold to reduce pressure and the risk of soil compaction."@en,
        "Het vermijden van machines boven een afgesproken massa- of aslastgrens op percelen om drukbelasting en bodemverdichting te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "No heavy machinery"@en,
        "Geen zware machines"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows soil and vegetation on agricultural land. It illustrates the relationship between soil management and crop growth as an aspect of the practice “No heavy machinery”."@en,
        "De foto toont de bodem en de begroeiing van landbouwgrond. Zo wordt de relatie tussen bodembeheer en gewasgroei zichtbaar als onderdeel van de praktijk ‘Geen zware machines’."@nl ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:NoHerbicides a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg> ;
    skos:broader vocab:LimitationOnTheUseOfPlantProtectionProducts ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Not applying herbicides to the specified crop or field, and using other means to manage weeds if needed."@en,
        "Het niet toepassen van herbiciden op het aangewezen gewas of perceel en waar nodig andere vormen van onkruidbeheer gebruiken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "No herbicides"@en,
        "Geen herbiciden"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'No herbicides'."@en,
        "Totaal geen gebruik van herbiciden op het bedrijf. Eventueel wel andere middelen."@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows crops grown in an organic farming context. It illustrates crop production and management on farmland as an aspect of the practice “No herbicides”."@en,
        "De foto toont een landbouwperceel met gewassen in een biologische landbouwcontext. Zo wordt teelt en gewasbeheer op landbouwgrond zichtbaar als onderdeel van de praktijk ‘Geen herbiciden’."@nl ;
    schema:creditText "Foto: Henk Monster / Anefo / Wikimedia Commons (controleer bron en licentie)." .

vocab:NoInsecticides a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg> ;
    skos:broader vocab:LimitationOnTheUseOfPlantProtectionProducts ;
    skos:definition "Not applying insecticidal products to the specified crop or field, using monitoring or non-insecticidal control measures where needed."@en,
        "Het niet toepassen van insecticiden op het aangewezen gewas of perceel en zo nodig monitoring of andere bestrijdingsmethoden gebruiken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "No insecticides"@en,
        "Geen insecticiden"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'No insecticides'."@en ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows crops grown in an organic farming context. It illustrates crop production and management on farmland as an aspect of the practice “No insecticides”."@en,
        "De foto toont een landbouwperceel met gewassen in een biologische landbouwcontext. Zo wordt teelt en gewasbeheer op landbouwgrond zichtbaar als onderdeel van de praktijk ‘Geen insecticiden’."@nl ;
    schema:creditText "Foto: Henk Monster / Anefo / Wikimedia Commons (controleer bron en licentie)." .

vocab:NoResidualStreams a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Sheep_under_solar_panels_(1)_2025-07-26.jpg> ;
    skos:broader vocab:ReduceExternalInputs ;
    skos:definition "Designing farm processes so that usable by-products and waste streams are prevented, reduced or reused rather than leaving unmanaged residual material."@en,
        "Het zo inrichten van bedrijfsprocessen dat bruikbare bijproducten en afvalstromen worden voorkomen, verminderd of hergebruikt in plaats van als onbeheerde reststroom over te blijven."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "No residual streams"@en,
        "Geen reststromen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Sheep_under_solar_panels_(1)_2025-07-26.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows solar panels over agricultural land with sheep. It illustrates the combination of renewable energy and agricultural land use as an aspect of the practice “No residual streams”."@en,
        "De foto toont zonnepanelen boven landbouwgrond met schapen. Zo wordt de combinatie van hernieuwbare energie en agrarisch landgebruik zichtbaar als onderdeel van de praktijk ‘Geen reststromen’."@nl ;
    schema:creditText "Foto: Andy Li (CC0 1.0)."@nl .

vocab:NoSyntheticPesticides a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Gurken_Feld_Unkraut_Hackger%C3%A4t-1-Josef_Schlaghecken.jpg> ;
    skos:broader vocab:LimitationOnTheUseOfPlantProtectionProducts ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Managing crops without applying synthetic chemical crop-protection pesticides, relying on preventive, biological or mechanical methods where necessary."@en,
        "Het telen zonder synthetisch-chemische gewasbeschermingsmiddelen en zo nodig preventieve, biologische of mechanische methoden toepassen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "No synthetic pesticides"@en,
        "Geen synthetische gewasbeschermingsmiddelen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Gurken_Feld_Unkraut_Hackger%C3%A4t-1-Josef_Schlaghecken.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'No synthetic pesticides'."@en,
        "Totaal geen gebruik van synthetische bestrijdingsmiddelen/gewasbeschermingsmiddelen op het bedrijf. Geen enkel type."@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "Weeds are mechanically hoed between crop rows. The photograph illustrates how equipment can control weeds without directly applying herbicides."@en,
        "Tussen de gewasrijen wordt mechanisch geschoffeld. De foto illustreert hoe onkruid met een werktuig kan worden bestreden zonder directe inzet van herbiciden."@nl .

vocab:NoTillageMicro a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Planter_Johndeere_02.jpg> ;
    skos:broader vocab:NoTillageMeso ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Directly sowing or planting a crop without mechanically loosening or inverting the soil across the field before establishment."@en,
        "Het rechtstreeks zaaien of planten van een gewas zonder voorafgaande mechanische bewerking of kering van de bodem over het perceel."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "No tillage"@en,
        "Geen grondbewerking"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Planter_Johndeere_02.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "Geen bodembewerking tussen oogst en inzaai. Het nieuwe gewas wordt direct in de onbewerkte bodem gezaaid, zondat dat de grond sinds de vorige oogst is omgeploegd of losgemaakt"@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “Planter Johndeere 02”. It illustrates the related agricultural context as an aspect of the practice “No tillage”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘Planter Johndeere 02’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Geen grondbewerking’."@nl .

vocab:NonFarmAndOffFarmEmployment a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg> ;
    skos:broader vocab:PluralactivityWorkBeyondFarm ;
    skos:definition "Earning income from employment or professional activities outside the farm enterprise alongside agricultural work."@en,
        "Het verkrijgen van inkomsten uit betaald werk of beroepsactiviteiten buiten het landbouwbedrijf naast de agrarische werkzaamheden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "non-farm and off-farm employment"@en,
        "Werk buiten het landbouwbedrijf"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows oilseed radish grown as a green-manure crop. It illustrates the use of living ground cover in cropping as an aspect of the practice “non-farm and off-farm employment”."@en,
        "De foto toont bladrammenas als groenbemestend gewas op een akker. Zo wordt het gebruik van levende bodembedekking in de teelt zichtbaar als onderdeel van de praktijk ‘Werk buiten het landbouwbedrijf’."@nl ;
    schema:creditText "Foto: Wikimedia Commons, bladrammenas als groenbemester in Nederland." .

vocab:NutrientManagementPlan a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Field_soil_sampling.jpg> ;
    skos:broader vocab:DiagnosisAndManagementPlansMeso ;
    skos:definition "A documented assessment of nutrient supply, crop demand, application timing and nutrient balances used to guide fertilisation and limit losses."@en,
        "Een vastgelegd overzicht van nutriëntenaanbod, gewasbehoefte, toedieningstijdstippen en nutriëntenbalansen om bemesting te sturen en verliezen te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "nutrient management plan"@en,
        "Nutriëntenbeheerplan"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Field_soil_sampling.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows samples being collected from agricultural soil. It illustrates the assessment of soil properties as an aspect of the practice “nutrient management plan”."@en,
        "De foto toont het nemen van monsters uit landbouwgrond. Zo wordt het onderzoeken van bodemkenmerken zichtbaar als onderdeel van de praktijk ‘Nutriëntenbeheerplan’."@nl ;
    schema:creditText "Foto: Alessandro Samuel-Rosa (CC0 1.0)."@nl .

vocab:OnFarmProcessing a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Belgian_female_agricultural_worker_making_cheese_-_2002.jpg> ;
    skos:broader vocab:IncomeDeepeningIncreasingAddedValueOfProduct ;
    skos:definition "Processing farm-grown or farm-raised products on the farm into food, feed or other goods to increase their usability or value."@en,
        "Het op het landbouwbedrijf verwerken van eigen plantaardige of dierlijke producten tot voedsel, voer of andere goederen om bruikbaarheid of waarde te verhogen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "On-farm processing"@en,
        "Verwerking op het landbouwbedrijf"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Belgian_female_agricultural_worker_making_cheese_-_2002.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “Belgian female agricultural worker making cheese - 2002”. It illustrates the related agricultural context as an aspect of the practice “On-farm processing”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘Belgian female agricultural worker making cheese - 2002’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Verwerking op het landbouwbedrijf’."@nl .

vocab:OnlyUseMachineryOnDryPeriods a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilAndMachineryUse ;
    skos:definition "Scheduling field operations with heavy equipment only when the soil is sufficiently dry or load-bearing to limit structural damage and compaction."@en,
        "Het uitvoeren van veldwerk met zware machines alleen wanneer de bodem voldoende droog of draagkrachtig is om structuurschade en verdichting te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "only use machinery on dry periods"@en,
        "Machines alleen inzetten in droge perioden"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows soil and vegetation on agricultural land. It illustrates the relationship between soil management and crop growth as an aspect of the practice “only use machinery on dry periods”."@en,
        "De foto toont de bodem en de begroeiing van landbouwgrond. Zo wordt de relatie tussen bodembeheer en gewasgroei zichtbaar als onderdeel van de praktijk ‘Machines alleen inzetten in droge perioden’."@nl ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:OrganiseActivitiesForTheLocalCommunityEGParticipationEveningsWorkshopsParties a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Farm_Extension_Worker.jpg> ;
    skos:broader vocab:CommunityEngagement ;
    skos:definition "Hosting activities such as participation meetings, workshops or community gatherings that connect the farm with residents and local organisations."@en,
        "Het organiseren van bijvoorbeeld inspraakavonden, workshops of buurtbijeenkomsten die het landbouwbedrijf verbinden met bewoners en lokale organisaties."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Organise activities for the local community (e.g. participation evenings, workshops, parties)"@en,
        "Activiteiten voor de lokale gemeenschap organiseren"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Farm%20Extension%20Worker.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a person involved in agricultural extension or farm advisory work, illustrating a setting for organising activities for the local community."@en,
        "De foto toont een medewerker in de context van landbouwvoorlichting of bedrijfsbegeleiding. Daarmee wordt een onderdeel van ‘Activiteiten voor de lokale gemeenschap organiseren’ zichtbaar."@nl ;
    schema:creditText "Foto: Samuel Macharia (Vrije licentie, controleer bronpagina)."@nl .

vocab:Paludicultuur a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Paludi-bederkesa-1_hg.jpg> ;
    skos:broader vocab:KeepWaterLevelsHighMeso ;
    skos:definition "Cultivating crops adapted to permanently wet or rewetted soils, such as peatlands, while maintaining high water tables."@en,
        "Het telen van gewassen die geschikt zijn voor permanent natte of vernatte bodems, zoals veengronden, terwijl hoge waterstanden behouden blijven."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "paludicultuur"@en,
        "Paludicultuur (natte teelt)"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Paludi-bederkesa-1_hg.jpg?width=960> ;
    regenlmeta:definitionReference <https://www.rvo.nl/subsidies-financiering/glb-2026/eco-regeling/eco-activiteiten-punten-en-waarde> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “Paludi-bederkesa-1 hg”. It illustrates the related agricultural context as an aspect of the practice “paludicultuur”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘Paludi-bederkesa-1 hg’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Paludicultuur (natte teelt)’."@nl .

vocab:ParticipationInCollectivesNetworksOrBoardsEGWaterboardPolitics a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Farm_Extension_Worker.jpg> ;
    skos:broader vocab:RepresentationOfFarmers ;
    skos:definition "Taking part in producer groups, networks, governing boards or public organisations to influence decisions and coordinate actions relevant to farming."@en,
        "Het deelnemen aan producentencollectieven, netwerken, besturen of publieke organisaties om besluiten te beïnvloeden en gezamenlijke agrarische activiteiten af te stemmen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Participation in collectives, networks or boards (e.g. waterboard, politics)"@en,
        "Deelname aan collectieven, netwerken en besturen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Farm%20Extension%20Worker.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a person involved in agricultural extension or farm advisory work, illustrating a setting for participation in agricultural networks and collective activities."@en,
        "De foto toont een medewerker in de context van landbouwvoorlichting of bedrijfsbegeleiding. Daarmee wordt een onderdeel van ‘Deelname aan collectieven, netwerken en besturen’ zichtbaar."@nl ;
    schema:creditText "Foto: Samuel Macharia (Vrije licentie, controleer bronpagina)."@nl .

vocab:ParticipationInStudyGroupsReconsideringHumanNonhumanRelations a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Farm_Extension_Worker.jpg> ;
    skos:broader vocab:InformalLearning ;
    skos:definition "Joining organised discussions or learning groups that examine how farming practices affect and relate to animals, plants, soils and other non-human life."@en,
        "Het deelnemen aan studiegroepen die bespreken hoe landbouwpraktijken zich verhouden tot dieren, planten, bodems en ander niet-menselijk leven."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Participation in study groups, (reconsidering human-nonhuman relations)"@en,
        "Deelname aan studiegroepen over relaties tussen mens en natuur"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Farm%20Extension%20Worker.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The meeting or advisory setting illustrates the exchange of knowledge about farming practices."@en,
        "De ontmoeting of voorlichtingssituatie illustreert kennisuitwisseling rondom landbouwpraktijken."@nl ;
    schema:creditText "Foto: Samuel Macharia (Vrije licentie, controleer bronpagina)."@nl .

vocab:Permaculture a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Permaculture_garden_with_a_fruit_tree,_herbs,_flowers_and_vetetables_mulched_with_hay.JPG> ;
    skos:broader vocab:TreePlanning ;
    skos:definition "A design approach for productive landscapes that uses ecological relationships, diversity and resource cycling to organise crops, animals, water and human activities."@en,
        "Een ontwerpbenadering voor productieve landschappen die ecologische relaties, diversiteit en kringlopen benut om gewassen, dieren, water en menselijke activiteiten samenhangend in te richten."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Permaculture"@en,
        "Permacultuur"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Permaculture_garden_with_a_fruit_tree%2C_herbs%2C_flowers_and_vetetables_mulched_with_hay.JPG?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows flowering plants alongside farmland. It illustrates flower-rich vegetation in the agricultural landscape as an aspect of the practice “Permaculture”."@en,
        "De foto toont bloeiende planten langs landbouwgrond. Zo wordt bloemrijke vegetatie in het agrarisch landschap zichtbaar als onderdeel van de praktijk ‘Permacultuur’."@nl .

vocab:PermanentGrasslandSwardAtLeast5YearsOldRenewedWithin15years a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg> ;
    skos:broader vocab:GrasslandTypeSwardAge ;
    skos:definition "Grassland with a current sward at least five years old that has nevertheless been reseeded or renewed within the preceding fifteen years."@en,
        "Grasland met een huidige zode van ten minste vijf jaar oud dat in de afgelopen vijftien jaar wel is vernieuwd of opnieuw ingezaaid."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "permanent grassland sward  at least 5 years old renewed within 15years"@en,
        "Blijvend grasland van minstens vijf jaar, vernieuwd binnen vijftien jaar"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "see definition permanent grassland types"@en ;
    regenlmeta:photoCaptionStatus "visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "Animals are grazing on grassland. The photograph illustrates the practical connection between grazing, grassland use and livestock farming."@en,
        "De dieren grazen op grasland. De foto toont de praktische samenhang tussen beweiding, het gebruik van grasland en het houden van vee."@nl ;
    schema:creditText "Foto: Wikimedia Commons, grazende koeien in de provincie Utrecht (Nederland)." .

vocab:PermanentGrasslandSwardOlderThan15Year a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg> ;
    skos:broader vocab:GrasslandTypeSwardAge ;
    skos:definition "Grassland whose current sward has remained in place for more than fifteen years without full renewal or reseeding."@en,
        "Grasland waarvan de huidige zode meer dan vijftien jaar aanwezig is zonder volledige vernieuwing of herinzaai."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "permanent grassland sward older than 15 year"@en,
        "Blijvend grasland ouder dan vijftien jaar"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "see definition permanent grassland types"@en ;
    regenlmeta:photoCaptionStatus "visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "Animals are grazing on grassland. The photograph illustrates the practical connection between grazing, grassland use and livestock farming."@en,
        "De dieren grazen op grasland. De foto toont de praktische samenhang tussen beweiding, het gebruik van grasland en het houden van vee."@nl ;
    schema:creditText "Foto: Wikimedia Commons, grazende koeien in de provincie Utrecht (Nederland)." .

vocab:PermanentGrasslandSwardRegularyRenewedWithinThe5Years a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Rode_tractor_met_graslandwals.jpg> ;
    skos:broader vocab:GrasslandTypeSwardAge ;
    skos:definition "Grassland managed through repeated renewal or reseeding within intervals shorter than five years, resulting in a relatively young sward."@en,
        "Grasland dat met tussenpozen korter dan vijf jaar opnieuw wordt ingezaaid of vernieuwd, waardoor de zode relatief jong blijft."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "permanent grassland sward regulary renewed within the 5 years"@en,
        "Grasland dat binnen vijf jaar regelmatig wordt vernieuwd"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Rode_tractor_met_graslandwals.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "see definition permanent grassland types"@en ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “Rode tractor met graslandwals”. It illustrates the related agricultural context as an aspect of the practice “permanent grassland sward regulary renewed within the 5 years”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘Rode tractor met graslandwals’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Grasland dat binnen vijf jaar regelmatig wordt vernieuwd’."@nl .

vocab:PermanentGrasslandTreesHedges a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:A_cherry_orchard_with_sheep_in_Bemmel.jpg> ;
    skos:broader vocab:UsePerennialsMicro ;
    skos:definition "Long-term grassland that includes or borders established trees and hedgerows used for habitat, shelter or other functions alongside grass production."@en,
        "Langjarig grasland waarin of waarlangs blijvende bomen en heggen voorkomen die naast grasproductie leefgebied, beschutting of andere functies bieden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "permanent grassland, trees, hedges"@en,
        "Blijvend grasland met bomen en heggen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/A_cherry_orchard_with_sheep_in_Bemmel.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "Animals are grazing on grassland. The photograph illustrates the practical connection between grazing, grassland use and livestock farming."@en,
        "De dieren grazen op grasland. De foto toont de praktische samenhang tussen beweiding, het gebruik van grasland en het houden van vee."@nl ;
    schema:creditText "Foto: Wikimedia Commons, kersenboomgaard met schapen in Bemmel (Nederland)." .

vocab:PermanentGreeningGreenCoverOnPermanentCrops a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Alley_cropping_walnuts_(26285902856).jpg> ;
    skos:broader vocab:CropDiversificationCoverCrops ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Maintaining living ground vegetation in perennial crop systems, such as orchards or vineyards, between rows or beneath plants for much of the year."@en,
        "Het gedurende een groot deel van het jaar behouden van levende bodembedekking in meerjarige teelten, zoals boomgaarden of wijngaarden, tussen of onder de gewasrijen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (nl): Het aanhouden van levende bodembedekking in meerjarige teelten, zoals boomgaarden of wijngaarden, tussen de rijen of onder de bomen."@nl ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Permanent greening / green cover on permanent crops"@en,
        "Permanente groenbedekking bij meerjarige teelten"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Alley_cropping_walnuts_(26285902856).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "vegetative cover in orchards and vineyard. This can be between the rows, under the tree crowns or with other patterns"@en,
        "groene bodembedekking in bijvoorbeeld boomgaarden of wijngaarden. Deze kan zich bevinden tussen de rijen, onder de boomkruinen of in andere patronen"@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “Alley cropping walnuts”. It illustrates the related agricultural context as an aspect of the practice “Permanent greening / green cover on permanent crops”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘Alley cropping walnuts’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Permanente groenbedekking bij meerjarige teelten’."@nl .

vocab:PermanentVegetationAtBordersDitchCleaningBaggerenPreventLivestockAccessToWaterways a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Fencing_of_riparian_areas.jpg> ;
    skos:broader vocab:EcologicalWaterwayAndDitchManagement ;
    skos:definition "Maintaining vegetated water margins, managing ditch clearance and preventing livestock from entering waterways to protect banks and water quality."@en,
        "Het behouden van begroeide oevers, zorgvuldig uitvoeren van slootonderhoud en voorkomen dat vee watergangen betreedt om oevers en waterkwaliteit te beschermen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "permanent vegetation at borders; ditch cleaning (baggeren); Prevent livestock access to waterways"@en,
        "Permanente oevervegetatie, slootonderhoud en uitsluiten van vee"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Fencing_of_riparian_areas.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “Fencing of riparian areas”. It illustrates the related agricultural context as an aspect of the practice “permanent vegetation at borders; ditch cleaning (baggeren); Prevent livestock access to waterways”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘Fencing of riparian areas’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Permanente oevervegetatie, slootonderhoud en uitsluiten van vee’."@nl .

vocab:PesticidesManagementPlan a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg> ;
    skos:broader vocab:DiagnosisAndManagementPlansMeso ;
    skos:definition "A documented strategy for preventing, monitoring and controlling crop pests and diseases, including criteria for deciding when and how products may be used."@en,
        "Een vastgelegde strategie om plagen en ziekten te voorkomen, te monitoren en te beheersen, met criteria voor het eventueel inzetten van gewasbeschermingsmiddelen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "pesticides management plan"@en,
        "Gewasbeschermingsplan"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows crops grown in an organic farming context. It illustrates crop production and management on farmland as an aspect of the practice “pesticides management plan”."@en,
        "De foto toont een landbouwperceel met gewassen in een biologische landbouwcontext. Zo wordt teelt en gewasbeheer op landbouwgrond zichtbaar als onderdeel van de praktijk ‘Gewasbeschermingsplan’."@nl ;
    schema:creditText "Foto: Henk Monster / Anefo / Wikimedia Commons (controleer bron en licentie)." .

vocab:PlantJuiceAnalysis a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Field_soil_sampling.jpg> ;
    skos:broader vocab:MeasuringAndMonitoring ;
    skos:definition "Analysing sap extracted from plant tissues for nutrient or physiological indicators to inform crop management decisions."@en,
        "Het analyseren van uit plantenweefsel gewonnen sap op nutriënten of fysiologische indicatoren ter ondersteuning van teeltbeslissingen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
