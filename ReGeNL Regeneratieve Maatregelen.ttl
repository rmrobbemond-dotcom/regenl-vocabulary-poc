    schema:creditText "Foto: Wikimedia Commons, grazende koeien in de provincie Utrecht (Nederland)." .

vocab:ReductionLimitationOfSpecificFertilizers a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:FertilizationAndManureManagement ;
    skos:changeNote "Definitie en overgenomen uit ReGeNL practice_list_0.2.1, kolom: English scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Reducing or limiting designated fertiliser products or nutrients rather than imposing the same restriction on all fertiliser types."@en,
        "Het verminderen of begrenzen van aangewezen meststoffen of nutriënten in plaats van dezelfde beperking op alle meststoftypen toe te passen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (en): A ClassificationElement in the RegenerativePracticeFramework at Meso level with label 'Reduction/ limitation of specific  fertilizers'."@nl,
        "Voorgaande PoC-definitie (en): quantity or time limitation of application"@nl ;
    skos:inScheme vocab: ;
    skos:narrower vocab:MinimalUseOfExternalFertilizersInputsFromOutsideTheFarm,
        vocab:NoExternalFertilizersUsedAsInput,
        vocab:ReduceSyntheticFertilizers,
        vocab:ReducingFertilizerUse,
        vocab:ReducingSysntheticNFerterilizers,
        vocab:ReductionOrganicFertilizers,
        vocab:RestrictionInQuanityAboveLegalNorms,
        vocab:RestrictionInTimingAboveLegalNorms ;
    skos:notation "Meso" ;
    skos:prefLabel "Reduction/ limitation of specific  fertilizers"@en,
        "Specifieke meststoffen verminderen of beperken"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "quantity or time limitation of application"@en,
        "Het beperken van de hoeveelheid meststof of het tijdstip waarop bepaalde meststoffen worden toegediend."@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a compost heap containing organic material. It illustrates the collection and processing of organic residual materials as an aspect of the practice “Reduction/ limitation of specific  fertilizers”."@en,
        "De foto toont een composthoop met organisch materiaal. Zo wordt het verzamelen en verwerken van organische restmaterialen zichtbaar als onderdeel van de praktijk ‘Specifieke meststoffen verminderen of beperken’."@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:SoilAndMachineryUse a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilManagement ;
    skos:definition "Coordinating soil management with the selection, timing and traffic of farm machinery to limit damage to soil structure and support field operations."@en,
        "Het afstemmen van bodembeheer op machinekeuze, werktijdstip en rijbewegingen om schade aan bodemstructuur te beperken en veldwerk mogelijk te maken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
