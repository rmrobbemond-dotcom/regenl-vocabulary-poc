practice:R1-0039 a skos:Concept ;
    dcterms:identifier "PRACTICE_R1_0039" ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader practice:meso-a3d63c8cc17b39c3 ;
    skos:changeNote "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; afbeelding voorlopig behouden en gemarkeerd voor vervanging."@nl ;
    skos:definition "The deliberate reduction in the quantity of inorganic fertilisers applied, for example by better aligning fertilisation with crop nutrient requirements, improving nutrient management or using alternative nutrient sources."@en,
        "Het doelgericht verminderen van de hoeveelheid toegepaste anorganische meststoffen, bijvoorbeeld door een betere afstemming van de bemesting op de nutriëntenbehoefte van het gewas, efficiënter nutriëntenbeheer of het benutten van alternatieve nutriëntenbronnen."@nl ;
    skos:editorialNote "Not really a practice. Needs to be replaced by other practices"@en ;
    skos:inScheme practice:scheme ;
    skos:notation "Micro" ;
    skos:prefLabel "Reduction of use of inorganic fertilisers"@en,
        "Vermindering van het gebruik van anorganische meststoffen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlmeta:classificationLevel "Micro" ;
    regenlmeta:definitionStatus "user-reviewed" ;
    regenlmeta:farmerContentSource "Geplakte tekst(20261124-142404).txt" ;
    regenlmeta:farmerDescription "Reducing the use of mineral fertilisers, for example through more targeted fertilisation or the use of alternative nutrient sources."@en,
        "Het verminderen van het gebruik van minerale meststoffen, bijvoorbeeld door gerichter te bemesten of andere voedingsbronnen te benutten."@nl ;
    regenlmeta:farmerDescriptionStatus "user-reviewed" ;
    regenlmeta:farmerLabel "Reduce mineral fertiliser use"@en,
        "Minder kunstmest gebruiken"@nl ;
    regenlmeta:farmerTopic "Fertilisation and soil nutrition"@en,
