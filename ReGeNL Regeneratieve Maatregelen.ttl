practice:R1-0016 a skos:Concept ;
    dcterms:identifier "PRACTICE_R1_0016" ;
    skos:broader practice:meso-1c38510133a39039 ;
    skos:changeNote "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; Nederlandse formele benaming aangepast van ‘Afstotende gezelschapsplanten’ naar ‘Afstotende begeleidende gewassen’; nieuwe afbeelding nodig."@nl ;
    skos:definition "The deliberate cultivation of companion plant species within or near a main crop whose chemical or other biological properties deter the attraction, establishment or activity of specific pest organisms in the main crop."@en,
        "Het doelgericht telen van begeleidende plantensoorten in of nabij een hoofdgewas die door hun chemische of andere biologische eigenschappen de aantrekking, vestiging of activiteit van specifieke plaagorganismen in het hoofdgewas ontmoedigen."@nl ;
    skos:editorialNote "Mega ontbreekt in bron; afgeleid uit dezelfde Macro-categorie."@nl ;
    skos:inScheme practice:scheme ;
    skos:notation "Micro" ;
    skos:prefLabel "Repellent companion plants"@en,
        "Afstotende begeleidende gewassen"@nl ;
    regenlmeta:classificationLevel "Micro" ;
    regenlmeta:definitionStatus "user-reviewed" ;
    regenlmeta:farmerContentSource "Geplakte tekst(20261124-142404).txt" ;
    regenlmeta:farmerDescription "Growing plants alongside crops that can repel or deter certain insect pests."@en,
        "Het gebruiken van planten naast de teelt die bepaalde plaaginsecten kunnen afweren of ontmoedigen."@nl ;
    regenlmeta:farmerDescriptionStatus "user-reviewed" ;
    regenlmeta:farmerLabel "Grow pest-repellent companion plants"@en,
        "Afstotende buurplanten gebruiken"@nl ;
    regenlmeta:farmerTopic "Pests and diseases"@en,
        "Ziekten en plagen"@nl ;
    regenlmeta:originalPracticeIdentifier "PRACTICE_R1_0016" ;
