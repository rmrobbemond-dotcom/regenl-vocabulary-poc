    schema:creditText "Foto: Hugh Venables (controleer licentie op Commons)."@nl .

vocab:LocalOrNativeCropAndAnimalSpecies a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg> ;
    skos:broader vocab:NativeCropAndAnimalSpecies ;
    skos:definition "Selecting crop or livestock species and varieties that are locally adapted or native to the region, with attention to agroecological suitability."@en,
        "Het kiezen van gewas- of diersoorten en rassen die lokaal aangepast of inheems zijn, rekening houdend met geschiktheid voor het agro-ecosysteem."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Local or native crop and animal species"@en,
        "Lokale of inheemse gewas- en diersoorten"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Organic%20agriculture%20in%20the%20Netherlands%20(P-025148-00-08).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9292282_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Europese Commissie, audiovisuele dienst (CC BY 4.0)."@nl .

vocab:LocalOrRegionalCollaborationBetweenSectorsEGCropLivestock a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Sheep_under_solar_panels_(1)_2025-07-26.jpg> ;
    skos:broader vocab:ResourceSharingCollaborationBetweenArableProductionAndDairy ;
    skos:definition "Cooperation between farms or sectors in a locality, for example exchanging manure, feed, straw or land use between crop and livestock farms."@en,
        "Samenwerking tussen bedrijven of sectoren in een regio, bijvoorbeeld door uitwisseling van mest, voer, stro of grondgebruik tussen akkerbouw en veehouderij."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Local or regional collaboration between sectors (e.g. crop-livestock)"@en,
        "Lokale of regionale samenwerking tussen sectoren"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Sheep_under_solar_panels_(1)_2025-07-26.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_10503868_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Andy Li (CC0 1.0)."@nl .

vocab:MOBGrazing a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg> ;
    skos:broader vocab:GrazingSystem ;
    skos:definition "Grazing a pasture with a very high animal density for a short period followed by a comparatively long recovery period for vegetation."@en,
        "Het gedurende korte tijd beweiden van grasland met een zeer hoge dierdichtheid, gevolgd door een relatief lange herstelperiode van de vegetatie."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "MOB grazing"@en,
        "Mobbeweiding"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9285405_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "high denisty grazing, a grazing management system where a large herd of livestock grazes a small area for a short period, followed by a long rest period for the pasture to recover"@en,
        "Beweiding met een hoge veedichtheid gedurende een korte graasperiode, gevolgd door een relatief lange herstelperiode voor de vegetatie."@nl ;
    schema:creditText "Foto: Jeff Vanuga / USDA NRCS (publiek domein in de Verenigde Staten)."@nl .

vocab:ManureSampleAnalysis a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Field_soil_sampling.jpg> ;
    skos:broader vocab:MeasuringAndMonitoring ;
    skos:definition "Laboratory or on-farm analysis of manure samples to determine nutrient contents and other properties needed for fertilisation planning."@en,
        "Het analyseren van mestmonsters in het laboratorium of op het bedrijf om nutriëntengehalten en andere eigenschappen voor de bemestingsplanning te bepalen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Manure sample analysis"@en,
        "Mestmonsteranalyse"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Field_soil_sampling.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9284243_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Alessandro Samuel-Rosa (CC0 1.0)."@nl .

vocab:MechanicalPestManagement a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg> ;
    skos:broader vocab:NonChemicalControlWeedsPestsAndDiseases ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Reducing pest populations using physical or mechanical interventions such as barriers, traps, removal or mechanical destruction rather than chemical pesticides."@en,
        "Het verminderen van plaagorganismen met fysieke of mechanische ingrepen, zoals barrières, vallen, verwijderen of mechanisch bestrijden, in plaats van chemische middelen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Mechanical pest management"@en,
        "Mechanische plaagbeheersing"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9291665_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Mechanical pest management'."@en,
        "Plaagbestrijding met behulp van werktuigen of andere fysieke maatregelen, bv. netten of geluid"@nl ;
    schema:creditText "Foto: Henk Monster / Anefo / Wikimedia Commons (controleer bron en licentie)." .

vocab:MechanicalWeedManagement a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg> ;
    skos:broader vocab:NonChemicalControlWeedsPestsAndDiseases ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Managing weeds by mechanical actions such as hoeing, harrowing, brushing or cutting, instead of or in addition to herbicides."@en,
        "Het beheersen van onkruid met mechanische bewerkingen zoals schoffelen, eggen, borstelen of maaien, in plaats van of naast herbiciden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Mechanical weed management"@en,
        "Mechanische onkruidbestrijding"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9294904_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Mechanical weed management'."@en,
        "Onkruidbestrijding met behulp van werktuigen of andere fysiek maatregelen, incl. handmatig wieden"@nl ;
    schema:creditText "Foto: Hugh Venables (controleer licentie op Commons)."@nl .

vocab:MinimalUseOfExternalFertilizersInputsFromOutsideTheFarm a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:ReductionLimitationOfSpecificFertilizers ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Obtaining as much crop nutrition as feasible from on-farm nutrient cycling while limiting purchased or imported fertilisers."@en,
        "Het zoveel mogelijk voorzien in gewasvoeding door nutriëntenkringlopen op het eigen bedrijf en het beperken van aangekochte of aangevoerde meststoffen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Minimal use of external fertilizers inputs (from outside the farm)"@en,
        "Minimaal gebruik van meststoffen van buiten het bedrijf"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9288739_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Minimal use of external fertilizers inputs (from outside the farm)'."@en,
        "Het verminderd of minimaal gebruik van externe messtoffen"@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:MinimizeIrrigation a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Drip_irrigation.jpg> ;
    skos:broader vocab:MinimizeWaterUse ;
    skos:definition "Reducing irrigation frequency or volume by matching watering to crop needs and using soil-moisture conservation measures."@en,
        "Het beperken van beregeningsfrequentie of watervolume door watergiften op de gewasbehoefte af te stemmen en bodemvocht vast te houden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Minimize irrigation"@en,
        "Irrigatie minimaliseren"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Drip_irrigation.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9833703_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: USDA (public domain, U.S. federal government)."@nl .

vocab:MinimizeTractorUse a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilAndMachineryUse ;
    skos:definition "Reducing the number, distance or intensity of tractor operations through combined tasks, alternative equipment or less frequent field passes."@en,
        "Het verminderen van aantallen, afstanden of intensiteit van tractorbewerkingen door werkzaamheden te combineren, ander materieel of minder werkgangen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Minimize tractor use"@en,
        "Tractorinzet minimaliseren"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9283410_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:MinimumGrazingPeriodNoOrRestrictedGrazingGrazingLivestockDensityLimitation a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg> ;
    skos:broader vocab:ReductionInGrazingIntensity15LUHaForInstanceForVoluntaryEcoPracticePackages ;
    skos:definition "Restricting grazing duration, timing or livestock density on designated land to protect vegetation, soils or biodiversity under defined management rules."@en,
        "Het beperken van graasduur, graasmomenten of veebezetting op aangewezen grond om vegetatie, bodem of biodiversiteit volgens bepaalde beheerregels te beschermen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "minimum grazing period; no or restricted grazing; grazing livestock density limitation"@en,
        "Minimale beweidingsperiode of beperkingen aan beweiding en veebezetting"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9296085_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Jeff Vanuga / USDA NRCS (publiek domein in de Verenigde Staten)."@nl .

vocab:MinimumTillage a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:ReduceTillageMinimalTillage ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Preparing or managing soil with a reduced number or intensity of tillage operations compared with conventional plough-based cultivation."@en,
        "Het bewerken van de bodem met minder werkgangen of lagere bewerkingsintensiteit dan bij conventionele teelt met ploegen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Minimum tillage"@en,
        "Minimale grondbewerking"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9300754_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "tillage only in spots where plants are seeded"@en,
        "Alleen daar waar gezaaid of geplant wordt, wordt de bodem bewerkt"@nl ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:MixedFarmingIntegrateLivestock a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Sheep_under_solar_panels_(1)_2025-07-26.jpg> ;
    skos:broader vocab:ResourceSharingCollaborationBetweenArableProductionAndDairy ;
    skos:definition "Combining arable or horticultural crops with livestock on one farm so that resources such as feed, manure and crop residues can be cycled internally."@en,
        "Het combineren van akkerbouw of tuinbouw met veehouderij op één bedrijf zodat voer, mest en gewasresten onderling kunnen worden benut."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Mixed farming / integrate livestock"@en,
        "Gemengd bedrijf met geïntegreerde veehouderij"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Sheep_under_solar_panels_(1)_2025-07-26.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9297989_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Andy Li (CC0 1.0)."@nl .

vocab:MixedIntercroppingMixedCropping a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Intercropping_maize_and_beans.jpg> ;
    skos:broader vocab:CropDiversificationIntercroppingPolycultureNoMonocultureCompanionPlanting ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Growing two or more crop species at the same time in a mixed stand on one field without necessarily separating them into distinct rows."@en,
        "Het gelijktijdig verbouwen van twee of meer gewassoorten in een gemengde stand op één perceel, zonder dat afzonderlijke rijen nodig zijn."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (nl): Het op hetzelfde perceel gemengd inzaaien of telen van twee of meer gewassen zonder afzonderlijke rijen of stroken."@nl ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Mixed intercropping / mixed cropping"@en,
        "Mengteelt en gewascombinaties"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Intercropping_maize_and_beans.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9291249_2 ;
    regenlimg:proposedForPublication regenlimg:wur-54418_418941_9291249_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "Mixed cropping is a system of sowing two or more crops mixed together on the same field without any distinct row or strip pattern"@en,
        "Twee of meer gewassen worden gemengd op hetzelfde perceel gezaaid, zonder ruimtelijke structuur"@nl ;
    schema:creditText "Foto: AnnaJB (CC BY-SA 4.0)."@nl .

vocab:MobileChickenCoopsMicro a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg> ;
    skos:broader vocab:AnimalHousing ;
    skos:definition "Using movable poultry housing that can be relocated across farmland to provide changing outdoor access and distribute manure and grazing pressure."@en,
        "Het gebruiken van verplaatsbare kippenhokken die over landbouwgrond worden verschoven om wisselende buitenuitloop te bieden en mest en gebruiksdruk te spreiden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Mobile chicken coops"@en,
        "Mobiele kippenhokken"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9294554_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Jeff Vanuga / USDA NRCS (publiek domein in de Verenigde Staten)."@nl .

vocab:MobileChickenCoopsNano a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg> ;
    skos:broader vocab:OutdoorAccess ;
    skos:definition "Moving a portable chicken coop between specific pasture positions according to a planned schedule to avoid prolonged pressure at one spot."@en,
        "Het volgens een planning verplaatsen van een mobiel kippenhok tussen concrete plekken in het grasland om langdurige belasting van één locatie te vermijden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "Mobile chicken coops"@en,
        "Mobiele kippenhokken"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9294554_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Jeff Vanuga / USDA NRCS (publiek domein in de Verenigde Staten)."@nl .

vocab:MonitoringOfAnimalWelfare a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Dairy_farm_(P-062705-00-19).jpg> ;
    skos:broader vocab:AnimalHousing ;
    skos:definition "Regularly assessing animal-based indicators such as behaviour, injuries, body condition and health to detect and address welfare problems."@en,
        "Het regelmatig beoordelen van diergebonden indicatoren, zoals gedrag, verwondingen, lichaamsconditie en gezondheid, om welzijnsproblemen te signaleren en aan te pakken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "monitoring of animal welfare"@en,
        "Monitoring van dierenwelzijn"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Dairy%20farm%20(P-062705-00-19).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9297568_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Europese Commissie, audiovisuele dienst / Lukasz Kobus, Yügen (CC BY 4.0)."@nl .

vocab:MoreEfficientFertilizerAplication a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:SpecificFertilizerApplicationTechniques ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Improving placement, timing, dosing or equipment used for fertiliser application so that crops capture more nutrients and losses are reduced."@en,
        "Het verbeteren van plaatsing, timing, dosering of apparatuur bij bemesting zodat gewassen nutriënten beter benutten en verliezen afnemen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "More efficient fertilizer aplication"@en,
        "Efficiëntere meststoftoediening"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9289815_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'More efficient fertilizer aplication'."@en,
        "Maatregelen voor een effiecientere opname en minder verliezen van meststoffen"@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:MultispeciesCoverCrops a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg> ;
    skos:broader vocab:CropDiversificationCoverCrops ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Growing a cover-crop mixture containing at least two plant species with complementary root, nutrient or habitat characteristics."@en,
        "Het telen van een mengsel van minimaal twee bodembedekkende plantensoorten met verschillende wortel-, nutriënten- of leefgebiedfuncties."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (nl): Het inzaaien van een mengsel van minstens twee soorten groenbedekkers, bijvoorbeeld grassen, kruisbloemigen of vlinderbloemigen."@nl ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Multispecies cover crops"@en,
        "Bodembedekkers met meerdere soorten"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9284364_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "More then 1 different types of species of cover crops are sown (eg. Combination of combination of annual grasses, brassicas, and legumes)"@en,
        "mengsel van verschillende soorten bodembedekker (zoals een combinatie van eenjarige grassen, kruisbloemigen en vlinderbloemigen"@nl ;
    schema:creditText "Foto: Hugh Venables (controleer licentie op Commons)."@nl .

vocab:NativeTrees a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Hedgerow_around_an_arable_field_-_geograph.org.uk_-_3670471.jpg> ;
    skos:broader vocab:NativeCropAndAnimalSpecies ;
    skos:definition "Planting or retaining tree species naturally occurring in the region and suited to local ecological conditions."@en,
        "Het planten of behouden van boomsoorten die van nature in de regio voorkomen en passen bij de lokale ecologische omstandigheden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Native trees"@en,
        "Inheemse bomen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Hedgerow_around_an_arable_field_-_geograph.org.uk_-_3670471.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9286987_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Stanley Howe (controleer licentie op Commons)."@nl .

vocab:NaturalBufferZones a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Hedgerow_around_an_arable_field_-_geograph.org.uk_-_3670471.jpg> ;
    skos:broader vocab:HabitatProvisionBiodiversityEnhancement ;
    skos:definition "Maintaining strips or patches of semi-natural vegetation between farmland and vulnerable areas to intercept runoff, provide habitat or reduce disturbance."@en,
        "Het behouden van stroken of plekken halfnatuurlijke vegetatie tussen landbouwgrond en kwetsbare gebieden om afstroming op te vangen, leefgebied te bieden of verstoring te verminderen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Natural buffer zones"@en,
        "Natuurlijke bufferzones"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Hedgerow_around_an_arable_field_-_geograph.org.uk_-_3670471.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9282493_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Stanley Howe (controleer licentie op Commons)."@nl .

vocab:NaturalPestManagement a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg> ;
    skos:broader vocab:NonChemicalControlWeedsPestsAndDiseases ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Controlling crop pests by supporting natural enemies and ecological processes, such as predators, parasitoids or habitat-based regulation."@en,
        "Het beheersen van gewasplagen door natuurlijke vijanden en ecologische processen te ondersteunen, zoals predatoren, parasitoïden en leefgebiedbeheer."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Natural pest management"@en,
        "Natuurlijke plaagbeheersing"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9290970_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Natural pest management'."@en,
        "Het gebruik van nuttige organismen om schadelijke plagen te bestrijden."@nl ;
    schema:creditText "Foto: Hugh Venables (controleer licentie op Commons)."@nl .

vocab:NaturalWaterHarvesting a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Water_reservoir_used_for_irrigation_at_Hikkim_Village_spiti_India.jpg> ;
    skos:broader vocab:WaterStorage ;
    skos:definition "Capturing and retaining rainfall or surface runoff using landscape features, soil measures or natural storage for later infiltration or use."@en,
        "Het opvangen en vasthouden van neerslag of afstromend water met landschapselementen, bodemmaatregelen of natuurlijke buffers voor latere infiltratie of benutting."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Natural water harvesting"@en,
        "Natuurlijke wateropvang"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Water%20reservoir%20used%20for%20irrigation%20at%20Hikkim%20Village%20spiti%20India.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9290949_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Sumita Roy Dutta (Vrije licentie, controleer bronpagina)."@nl .

vocab:NaturalWeedManagement a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg> ;
    skos:broader vocab:NonChemicalControlWeedsPestsAndDiseases ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Suppressing weeds through ecological measures such as competition, mulching, grazing or crop rotation without relying primarily on synthetic herbicides."@en,
        "Het onderdrukken van onkruid via ecologische maatregelen zoals concurrentie door gewassen, mulch, beweiding of vruchtwisseling, zonder primair op synthetische herbiciden te steunen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Natural weed management"@en,
        "Natuurlijk onkruidbeheer"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9290794_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Natural weed management'."@en,
        "Ander natuurlijk onkruidbeheer, bv. specifieke groenbemesters of landbewerking voor de teelt"@nl ;
    schema:creditText "Foto: Hugh Venables (controleer licentie op Commons)."@nl .

vocab:NoExternalFertilizersUsedAsInput a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:ReductionLimitationOfSpecificFertilizers ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Operating the crop production system without fertilisers imported from outside the farm, relying instead on internal nutrient sources and cycling."@en,
        "Het telen zonder aanvoer van meststoffen van buiten het bedrijf en de gewasvoeding baseren op interne nutriëntenbronnen en kringlopen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "No external fertilizers used as input"@en,
        "Geen meststoffen van buiten het bedrijf"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9284474_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'No external fertilizers used as input'."@en,
        "Meststoffengebruik van alleen binnen het bedrijf en niet extern aangewende meststoffen"@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:NoFertilizationAlongsideOpenWater a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:SpecificFertilizerApplicationTechniques ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Leaving a designated strip adjacent to open water unfertilised to limit direct nutrient inputs and runoff into the watercourse."@en,
        "Het onbemest laten van een aangewezen strook langs open water om directe nutriëntenbelasting en afspoeling naar de watergang te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "No fertilization alongside open water"@en,
        "Niet bemesten langs open water"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9284864_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'No fertilization alongside open water'."@en,
        "Een bepaalde afstand houden tot de sloot of ander open water, met bemesting"@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:NoFungicides a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg> ;
    skos:broader vocab:LimitationOnTheUseOfPlantProtectionProducts ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Not applying fungicidal plant protection products to the specified crop or field during the relevant management period."@en,
        "Het gedurende de betreffende beheerperiode niet toepassen van fungiciden op het aangewezen gewas of perceel."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "No fungicides"@en,
        "Geen fungiciden"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9813726_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'No fungicides'."@en,
        "Totaal geen gebruik van fungiciden op het bedrijf. Eventueel wel andere middelen."@nl ;
    schema:creditText "Foto: Henk Monster / Anefo / Wikimedia Commons (controleer bron en licentie)." .

vocab:NoHeavyMachinery a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilAndMachineryUse ;
    skos:definition "Avoiding field machinery above a chosen weight or axle-load threshold to reduce pressure and the risk of soil compaction."@en,
        "Het vermijden van machines boven een afgesproken massa- of aslastgrens op percelen om drukbelasting en bodemverdichting te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "No heavy machinery"@en,
        "Geen zware machines"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9297217_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:NoHerbicides a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg> ;
    skos:broader vocab:LimitationOnTheUseOfPlantProtectionProducts ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Not applying herbicides to the specified crop or field, and using other means to manage weeds if needed."@en,
        "Het niet toepassen van herbiciden op het aangewezen gewas of perceel en waar nodig andere vormen van onkruidbeheer gebruiken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "No herbicides"@en,
        "Geen herbiciden"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9285430_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'No herbicides'."@en,
        "Totaal geen gebruik van herbiciden op het bedrijf. Eventueel wel andere middelen."@nl ;
    schema:creditText "Foto: Henk Monster / Anefo / Wikimedia Commons (controleer bron en licentie)." .

vocab:NoInsecticides a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg> ;
    skos:broader vocab:LimitationOnTheUseOfPlantProtectionProducts ;
    skos:definition "Not applying insecticidal products to the specified crop or field, using monitoring or non-insecticidal control measures where needed."@en,
        "Het niet toepassen van insecticiden op het aangewezen gewas of perceel en zo nodig monitoring of andere bestrijdingsmethoden gebruiken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "No insecticides"@en,
        "Geen insecticiden"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9293638_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'No insecticides'."@en ;
    schema:creditText "Foto: Henk Monster / Anefo / Wikimedia Commons (controleer bron en licentie)." .

vocab:NoResidualStreams a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Sheep_under_solar_panels_(1)_2025-07-26.jpg> ;
    skos:broader vocab:ReduceExternalInputs ;
    skos:definition "Designing farm processes so that usable by-products and waste streams are prevented, reduced or reused rather than leaving unmanaged residual material."@en,
        "Het zo inrichten van bedrijfsprocessen dat bruikbare bijproducten en afvalstromen worden voorkomen, verminderd of hergebruikt in plaats van als onbeheerde reststroom over te blijven."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "No residual streams"@en,
        "Geen reststromen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Sheep_under_solar_panels_(1)_2025-07-26.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9288757_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Andy Li (CC0 1.0)."@nl .

vocab:NoSyntheticPesticides a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg> ;
    skos:broader vocab:LimitationOnTheUseOfPlantProtectionProducts ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Managing crops without applying synthetic chemical crop-protection pesticides, relying on preventive, biological or mechanical methods where necessary."@en,
        "Het telen zonder synthetisch-chemische gewasbeschermingsmiddelen en zo nodig preventieve, biologische of mechanische methoden toepassen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "No synthetic pesticides"@en,
        "Geen synthetische gewasbeschermingsmiddelen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9290970_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'No synthetic pesticides'."@en,
        "Totaal geen gebruik van synthetische bestrijdingsmiddelen/gewasbeschermingsmiddelen op het bedrijf. Geen enkel type."@nl ;
    schema:creditText "Foto: Henk Monster / Anefo / Wikimedia Commons (controleer bron en licentie)." .

vocab:NoTillageMicro a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:NoTillageMeso ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Directly sowing or planting a crop without mechanically loosening or inverting the soil across the field before establishment."@en,
        "Het rechtstreeks zaaien of planten van een gewas zonder voorafgaande mechanische bewerking of kering van de bodem over het perceel."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "No tillage"@en,
        "Geen grondbewerking"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9300754_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "Geen bodembewerking tussen oogst en inzaai. Het nieuwe gewas wordt direct in de onbewerkte bodem gezaaid, zondat dat de grond sinds de vorige oogst is omgeploegd of losgemaakt"@nl ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (Public domain (US federal government))."@nl .

vocab:NonFarmAndOffFarmEmployment a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg> ;
    skos:broader vocab:PluralactivityWorkBeyondFarm ;
    skos:definition "Earning income from employment or professional activities outside the farm enterprise alongside agricultural work."@en,
        "Het verkrijgen van inkomsten uit betaald werk of beroepsactiviteiten buiten het landbouwbedrijf naast de agrarische werkzaamheden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "non-farm and off-farm employment"@en,
        "Werk buiten het landbouwbedrijf"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9287471_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Hugh Venables (controleer licentie op Commons)."@nl .

vocab:NutrientManagementPlan a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Field_soil_sampling.jpg> ;
    skos:broader vocab:DiagnosisAndManagementPlansMeso ;
    skos:definition "A documented assessment of nutrient supply, crop demand, application timing and nutrient balances used to guide fertilisation and limit losses."@en,
        "Een vastgelegd overzicht van nutriëntenaanbod, gewasbehoefte, toedieningstijdstippen en nutriëntenbalansen om bemesting te sturen en verliezen te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "nutrient management plan"@en,
        "Nutriëntenbeheerplan"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Field_soil_sampling.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9295774_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Alessandro Samuel-Rosa (CC0 1.0)."@nl .

vocab:OnFarmProcessing a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg> ;
    skos:broader vocab:IncomeDeepeningIncreasingAddedValueOfProduct ;
    skos:definition "Processing farm-grown or farm-raised products on the farm into food, feed or other goods to increase their usability or value."@en,
        "Het op het landbouwbedrijf verwerken van eigen plantaardige of dierlijke producten tot voedsel, voer of andere goederen om bruikbaarheid of waarde te verhogen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "On-farm processing"@en,
        "Verwerking op het landbouwbedrijf"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9295897_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Hugh Venables (controleer licentie op Commons)."@nl .

vocab:OnlyUseMachineryOnDryPeriods a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilAndMachineryUse ;
    skos:definition "Scheduling field operations with heavy equipment only when the soil is sufficiently dry or load-bearing to limit structural damage and compaction."@en,
        "Het uitvoeren van veldwerk met zware machines alleen wanneer de bodem voldoende droog of draagkrachtig is om structuurschade en verdichting te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "only use machinery on dry periods"@en,
        "Machines alleen inzetten in droge perioden"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9287471_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:OrganiseActivitiesForTheLocalCommunityEGParticipationEveningsWorkshopsParties a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Farm_Extension_Worker.jpg> ;
    skos:broader vocab:CommunityEngagement ;
    skos:definition "Hosting activities such as participation meetings, workshops or community gatherings that connect the farm with residents and local organisations."@en,
        "Het organiseren van bijvoorbeeld inspraakavonden, workshops of buurtbijeenkomsten die het landbouwbedrijf verbinden met bewoners en lokale organisaties."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Organise activities for the local community (e.g. participation evenings, workshops, parties)"@en,
        "Activiteiten voor de lokale gemeenschap organiseren"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Farm%20Extension%20Worker.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9290830_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Samuel Macharia (Vrije licentie, controleer bronpagina)."@nl .

vocab:Paludicultuur a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Drip_irrigation.jpg> ;
    skos:broader vocab:KeepWaterLevelsHighMeso ;
    skos:definition "Cultivating crops adapted to permanently wet or rewetted soils, such as peatlands, while maintaining high water tables."@en,
        "Het telen van gewassen die geschikt zijn voor permanent natte of vernatte bodems, zoals veengronden, terwijl hoge waterstanden behouden blijven."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "paludicultuur"@en,
        "Paludicultuur (natte teelt)"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Drip_irrigation.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9286888_2 ;
    regenlmeta:definitionReference <https://www.rvo.nl/subsidies-financiering/glb-2026/eco-regeling/eco-activiteiten-punten-en-waarde> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: USDA (public domain, U.S. federal government)."@nl .

vocab:ParticipationInCollectivesNetworksOrBoardsEGWaterboardPolitics a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Farm_Extension_Worker.jpg> ;
    skos:broader vocab:RepresentationOfFarmers ;
    skos:definition "Taking part in producer groups, networks, governing boards or public organisations to influence decisions and coordinate actions relevant to farming."@en,
        "Het deelnemen aan producentencollectieven, netwerken, besturen of publieke organisaties om besluiten te beïnvloeden en gezamenlijke agrarische activiteiten af te stemmen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Participation in collectives, networks or boards (e.g. waterboard, politics)"@en,
        "Deelname aan collectieven, netwerken en besturen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Farm%20Extension%20Worker.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9297943_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Samuel Macharia (Vrije licentie, controleer bronpagina)."@nl .

vocab:ParticipationInStudyGroupsReconsideringHumanNonhumanRelations a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Farm_Extension_Worker.jpg> ;
    skos:broader vocab:InformalLearning ;
    skos:definition "Joining organised discussions or learning groups that examine how farming practices affect and relate to animals, plants, soils and other non-human life."@en,
        "Het deelnemen aan studiegroepen die bespreken hoe landbouwpraktijken zich verhouden tot dieren, planten, bodems en ander niet-menselijk leven."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Participation in study groups, (reconsidering human-nonhuman relations)"@en,
        "Deelname aan studiegroepen over relaties tussen mens en natuur"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Farm%20Extension%20Worker.jpg?width=960> ;
