vocab:SpecificFertilizerApplicationTechniques a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:FertilizationAndManureManagement ;
    skos:changeNote "Definitie en overgenomen uit ReGeNL practice_list_0.2.1, kolom: English scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Using selected methods for nutrient placement or delivery, such as injection, band placement or precision spreading, to improve efficiency and reduce losses."@en,
        "Het toepassen van gekozen manieren om nutriënten toe te dienen, zoals injecteren, rijenbemesting of precisieverspreiding, om efficiëntie te vergroten en verliezen te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (en): A ClassificationElement in the RegenerativePracticeFramework at Meso level with label 'Specific fertilizer application techniques'."@nl,
        "Voorgaande PoC-definitie (en): quantity or time limitation of application"@nl ;
    skos:inScheme vocab: ;
    skos:narrower vocab:AddingWaterToSlurryManure,
        vocab:DepeningOnTheNeedOfTheCropLesOrLessOften,
        vocab:MoreEfficientFertilizerAplication,
        vocab:NoFertilizationAlongsideOpenWater ;
    skos:notation "Meso" ;
    skos:prefLabel "Specific fertilizer application techniques"@en,
        "Specifieke bemestingstechnieken"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9289815_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "quantity or time limitation of application"@en ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

