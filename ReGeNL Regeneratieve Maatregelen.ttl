vocab:FormsOfDirectFoodProvisioning a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Traditioneel_Betuws_streekfruitkraampje_in_de_wijk_Oosterhout_(Nijmegen-Noord).jpg> ;
    skos:broader vocab:FarmCitizenInteractions ;
