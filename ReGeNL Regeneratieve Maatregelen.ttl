    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a reservoir used for irrigation. It illustrates the storage of water for agricultural use as an aspect of the practice “Water storage”."@en,
