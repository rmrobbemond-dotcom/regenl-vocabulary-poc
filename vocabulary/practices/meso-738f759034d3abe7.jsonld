{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/meso-738f759034d3abe7",
  "type": "Concept",
  "prefLabel": {
    "nl": "Inheemse gewas- en diersoorten",
    "en": "Native crop and animal species"
  },
  "definition": {
    "nl": "Het inzetten van gewassoorten of veerassen die uit de regio afkomstig zijn of daar historisch thuishoren, met passend behoud en beheer.",
    "en": "Using crop species or livestock breeds originating from or historically established in the region, subject to suitable conservation and husbandry practice."
  },
  "notation": [
    "Meso"
  ],
  "narrower": [
