practice:R1-0041 a skos:Concept ;
    dcterms:identifier "PRACTICE_R1_0041" ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:A_manure_heap_in_the_field_-_geograph.org.uk_-_7427875.jpg> ;
    skos:broader practice:meso-5afe732b24c9ad5e ;
    skos:changeNote "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; afbeelding voorlopig behouden en gemarkeerd voor vervanging."@nl ;
    skos:definition "The application of manure originating from farm animals, consisting of excreta and potentially urine, bedding or other admixed materials, as a source of nutrients and organic matter for the soil and crops."@en,
        "Het toepassen van mest afkomstig van landbouwhuisdieren, bestaande uit uitwerpselen en eventueel urine, strooisel of andere bijgemengde materialen, als bron van nutriënten en organische stof voor de bodem en het gewas."@nl ;
    skos:inScheme practice:scheme ;
    skos:notation "Micro" ;
    skos:prefLabel "Application of animal manure"@en,
        "Toepassing van dierlijke mest"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/A_manure_heap_in_the_field_-_geograph.org.uk_-_7427875.jpg?width=960> ;
    regenlmeta:classificationLevel "Micro" ;
    regenlmeta:definitionStatus "user-reviewed" ;
    regenlmeta:farmerContentSource "Geplakte tekst(20261124-142404).txt" ;
    regenlmeta:farmerDescription "Fertilising soil or crops with animal manure, such as slurry or solid manure, in line with crop nutrient requirements."@en,
        "Het bemesten van de bodem of gewassen met dierlijke mest, zoals drijfmest of vaste mest, passend bij de behoefte van de teelt."@nl ;
    regenlmeta:farmerDescriptionStatus "user-reviewed" ;
    regenlmeta:farmerLabel "Apply animal manure"@en,
        "Dierlijke mest toepassen"@nl ;
    regenlmeta:farmerTopic "Fertilisation and soil nutrition"@en,
        "Bemesting en bodemvoeding"@nl ;
    regenlmeta:originalPracticeIdentifier "PRACTICE_R1_0041" ;
    regenlmeta:originalPracticeLabel "Application of animal manure"@en,
        "Toepassing van dierlijke mest"@nl ;
