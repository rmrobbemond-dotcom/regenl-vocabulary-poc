or use","nl":"Tractorinzet minimaliseren"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoHeavyMachinery","notation":["Micro"],"prefLabel":{"en":"No heavy machinery","nl":"Geen zware machines"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/OnlyUseMachineryOnDryPeriods","notation":["Micro"],"prefLabel":{"en":"only use machinery on dry periods","nl":"Machines alleen inzetten in droge perioden"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceHeavyMachinery","notation":["Micro"],"prefLabel":{"en":"Reduce heavy machinery","nl":"Inzet van zware machines verminderen"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceMechanizationManualLowTechFarming","notation":["Micro"],"prefLabel":{"en":"Reduce mechanization, Manual/low tech farming","nl":"Mechanisatie verminderen en handmatig of laagtechnologisch werken"}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SoilSeedbedPreparation","notation":["Meso"],"prefLabel":{"en":"soil - seedbed preparation","nl":"Bodem- en zaaibedvoorbereiding"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DirectSeeding","notation":["Micro"],"prefLabel":{"en":"Direct seeding","nl":"Directzaai"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Flachenrotte","notation":["Micro"],"prefLabel":{"en":"Flachenrotte","nl":"Flächenrotte (oppervlakkige compostering)"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/HugelkulturRaisedBeds","notation":["Micro"],"prefLabel":{"en":"Hügelkultur/ raised beds","nl":"Hügelkultur en verhoogde teeltbedden"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/KeepLivingRoots","notation":["Micro"],"prefLabel":{"en":"Keep living roots","nl":"Levende wortels in de bodem behouden"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MulchingWithCropResidues","notation":["Micro"],"prefLabel":{"en":"Mulching with crop residues","nl":"Mulchen met gewasresten"},"definition":{"en":"leaving or applying crop residues on the soil","nl":"Het achterlaten of aanbrengen van gewasresten op het bodemoppervlak als bedekking."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/StubbleRetentionIncorporateCropResiduesLeftoverPruningMaterialIncorporateStrawUseGreenCompostGreenManure","notation":["Nano"],"prefLabel":{"en":"Stubble retention; Incorporate crop residues; Leftover pruning material; Incorporate straw; Use green compost ; green manure","nl":"Stoppelresten behouden en organische restmaterialen inwerken"}}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceTillageMinimalTillage","notation":["Meso"],"prefLabel":{"en":"Reduce tillage/ minimal tillage","nl":"Grondbewerking verminderen of minimaliseren"},"definition":{"en":"minimize soil disturbance due to tillage","nl":"Het beperken van de intensiteit of frequentie van bodembewerking om verstoring van de bodem te verminderen."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NonInversionTillage","notation":["Micro"],"prefLabel":{"en":"Non-inversion tillage","nl":"Niet-kerende grondbewerking"},"definition":{"en":"loosens and aerates the soil without turning it over, preserving surface residues and maintaining soil structure","nl":"Grondbewerking waarbij de bodem wordt losgemaakt zonder de bodemlagen te keren, zodat een deel van de bovengrondse resten aan het oppervlak blijft."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ChiselPlowingSubsoiling","notation":["Nano"],"prefLabel":{"en":"chisel plowing, subsoiling","nl":"Woelen en diepwoelen"}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ShallowTillage","notation":["Micro"],"prefLabel":{"en":"Shallow tillage","nl":"Ondiepe grondbewerking"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/EcoPlough","notation":["Nano"],"prefLabel":{"en":"eco plough","nl":"Ecologische ploeg"}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MinimumTillage","notation":["Micro"],"prefLabel":{"en":"Minimum tillage","nl":"Minimale grondbewerking"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ShallowNonInversionTillage","notation":["Micro"],"prefLabel":{"en":"Shallow non-inversion tillage","nl":"Ondiepe niet-kerende grondbewerking"},"definition":{"en":"non-inversion tillage until e.g. maximum 0.06m depth","nl":"Niet-kerende bodembewerking tot beperkte diepte; in de bron wordt als voorbeeld maximaal 6 cm genoemd."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/StripTillage","notation":["Micro"],"prefLabel":{"en":"Strip tillage","nl":"Strokenbewerking (strip-till)"},"definition":{"en":"tillage in a narrow band (e.g. 0.15-0.30m)","nl":"Bodembewerking die beperkt blijft tot smalle stroken waarin wordt gezaaid of geplant."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoTillageMeso","notation":["Meso"],"prefLabel":{"en":"No tillage","nl":"Niet-kerende nulbewerking"},"definition":{"en":"no tillage applied between harvest and sowing. The crop is sown directly into the soil not tilled since the harvest of the previous crop.","nl":"Een teeltwijze waarbij tussen de oogst en de volgende inzaai geen grondbewerking plaatsvindt en direct in de onbewerkte bodem wordt gezaaid."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoTillageMicro","notation":["Micro"],"prefLabel":{"en":"No tillage","nl":"Geen grondbewerking"}}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CropManagament","notation":["Macro"],"prefLabel":{"en":"Crop managament","nl":"Gewasbeheer"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ExtensiveCropRotations","notation":["Meso"],"prefLabel":{"en":"Extensive crop rotations","nl":"Ruime vruchtwisseling"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/BreakPeriodInTheRotation","notation":["Micro"],"prefLabel":{"en":"Break period in the rotation","nl":"Rustperiode in de vruchtwisseling"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CropRotation","notation":["Micro"],"prefLabel":{"en":"Crop rotation","nl":"Vruchtwisseling"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DiversifiedCropRotation","notation":["Micro"],"prefLabel":{"en":"diversified crop rotation","nl":"Gevarieerde vruchtwisseling"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/HaveAMinimumRotationLengthOf6YearsFallow","notation":["Micro"],"prefLabel":{"en":"have a minimum rotation length of 6 years/ fallow","nl":"Vruchtwisseling van minimaal zes jaar of braaklegging"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/LegumesNFixingPlantsInOration","notation":["Micro"],"prefLabel":{"en":"Legumes (N-fixing plants) in oration","nl":"Vlinderbloemigen en stikstofbindende gewassen in de rotatie"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/UseBreakCrops","notation":["Micro"],"prefLabel":{"en":"Use break crops","nl":"Rustgewassen telen"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WinterCropsIntermediateCrops","notation":["Micro"],"prefLabel":{"en":"Winter crops / intermediate crops:","nl":"Wintergewassen en tussengewassen"},"definition":{"nl":"Een tussenteelt die in de winter wordt geteeld tussen twee hoofdteelten."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CropDiversificationCoverCrops","notation":["Meso"],"prefLabel":{"en":"Crop diversification -Cover crops:","nl":"Gewasdiversificatie met bodembedekkers"},"definition":{"en":"the inclusion of plants grown for agronomic or environmental purposes in addition to the main crop on a land management unit","nl":"Het telen van een aanvullend gewas voor landbouwkundige of milieukundige doeleinden naast of tussen de hoofdteelten."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CatchCrops","notation":["Micro"],"prefLabel":{"en":"Catch crops","nl":"Vanggewassen"},"definition":{"en":"fast growing cover crop, grown between successive plantings of a main crop. \" It scavenges the remaining nitrogen after the main crop is harvested, thereby reducing nutrient losses from leaching\" (for undersow see intercropping)","nl":"Een snelgroeiend vanggewas dat tussen opeenvolgende hoofdteelten wordt geteeld en resterende nutriënten, met name stikstof, kan opnemen om uitspoeling te beperken."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MultispeciesCoverCrops","notation":["Micro"],"prefLabel":{"en":"Multispecies cover crops","nl":"Bodembedekkers met meerdere soorten"},"definition":{"en":"More then 1 different types of species of cover crops are sown (eg. Combination of combination of annual grasses, brassicas, and legumes)","nl":"Het inzaaien van een mengsel van minstens twee soorten groenbedekkers, bijvoorbeeld grassen, kruisbloemigen of vlinderbloemigen."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PermanentGreeningGreenCoverOnPermanentCrops","notation":["Micro"],"prefLabel":{"en":"Permanent greening / green cover on permanent crops","nl":"Permanente groenbedekking bij meerjarige teelten"},"definition":{"en":"vegetative cover in orchards and vineyard. This can be between the rows, under the tree crowns or with other patterns","nl":"Het aanhouden van levende bodembedekking in meerjarige teelten, zoals boomgaarden of wijngaarden, tussen de rijen of onder de bomen."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SummerCoverCrops","notation":["Micro"],"prefLabel":{"en":"Summer cover crops","nl":"Zomerse bodembedekkers"},"definition":{"en":"Cover crops grown to provide vegetative cover of the soil in summer","nl":"Groenbedekkers die in de zomer worden geteeld om de bodem met vegetatie bedekt te houden."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WinterCoverCrops","notation":["Micro"],"prefLabel":{"en":"Winter cover crops","nl":"Winterse bodembedekkers"},"definition":{"en":"cover crops grown to provide vegetative cover of the soil in winter","nl":"Groenbedekkers die in de winter aanwezig zijn om de bodem met vegetatie bedekt te houden."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CultivationOfSpecificCropsOrVarieties","notation":["Meso"],"prefLabel":{"en":"Cultivation of specific crops or varieties","nl":"Teelt van specifieke gewassen of rassen"},"definition":{"en":"practices where the farmer is requested to use improved crop varieties and/or certified seeds"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DeepRootedSpecies","notation":["Micro"],"prefLabel":{"en":"Deep rooted species","nl":"Diepwortelende soorten"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DroughtTolerantCrops","notation":["Micro"],"prefLabel":{"en":"drought tolerant crops","nl":"Droogtetolerante gewassen"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SelectionOfCultivarsOnBasisOfNutritionalValueAndTaste","notation":["Micro"],"prefLabel":{"en":"selection of cultivars on basis of nutritional value and taste","nl":"Rassenkeuze op basis van voedingswaarde en smaak"}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CropDiversificationIntercroppingPolycultureNoMonocultureCompanionPlanting","notation":["Meso"],"prefLabel":{"en":"Crop diversification - Intercropping/ polyculture / no monoculture / companion planting","nl":"Gewasdiversificatie met mengteelt, polycultuur en combinatieteelt"},"definition":{"en":"Intercropping consists of growing several crops (annual or perennial) simultaneously in the same field for a significant amount of time, each crop developing and growing according to its physiology.","nl":"Het gedurende een overlappende groeiperiode gelijktijdig telen van meerdere gewassen op hetzelfde perceel."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MixedIntercroppingMixedCropping","notation":["Micro"],"prefLabel":{"en":"Mixed intercropping / mixed cropping","nl":"Mengteelt en gewascombinaties"},"definition":{"en":"Mixed cropping is a system of sowing two or more crops mixed together on the same field without any distinct row or strip pattern","nl":"Het op hetzelfde perceel gemengd inzaaien of telen van twee of meer gewassen zonder afzonderlijke rijen of stroken."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/RelayIntercropping","notation":["Micro"],"prefLabel":{"en":"Relay intercropping","nl":"Volgteelt in overlap met hoofdgewas (relay intercropping)"},"definition":{"en":"Type of intercropping where the species overlap only for a portion of their growth duration","nl":"Een mengteelt waarbij de groeiperiodes van twee of meer gewassen slechts gedeeltelijk overlappen."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/RowIntercropping","notation":["Micro"],"prefLabel":{"en":"Row intercropping","nl":"Rijenteelten met meerdere gewassen"},"definition":{"en":"two species cultivated in alternate rows","nl":"Het gelijktijdig telen van twee gewassen in afwisselende rijen op hetzelfde perceel."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/StripCropping","notation":["Micro"],"prefLabel":{"en":"Strip cropping","nl":"Strokenteelt"},"definition":{"en":"two or more species cultivated in alternative strips and at least one strip includes more than one row","nl":"Het telen van twee of meer gewassen in afwisselende stroken, waarbij een strook meerdere gewasrijen kan omvatten."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/UnderSowing","notation":["Micro"],"prefLabel":{"en":"Under sowing","nl":"Onderzaai"},"definition":{"en":"catch crop (see also cover crops), grown partly at the same time as the main crop","nl":"Het onderzaaien van een vang- of groenbedekker in een hoofdgewas, zodat de gewassen gedurende een deel van hun groei gelijktijdig aanwezig zijn."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Silvoarable","notation":["Micro"],"prefLabel":{"en":"Silvoarable","nl":"Bomen gecombineerd met akkerbouw"},"altLabel":{"en":["silvoarable"]},"definition":{"en":"the integration of trees and arable crops on the same field","nl":"Een agroforestrysysteem waarbij bomen en akkerbouwgewassen op hetzelfde perceel worden gecombineerd."}}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PlantProtection","notation":["Macro"],"prefLabel":{"en":"plant protection","nl":"Gewasbescherming"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NonChemicalControlWeedsPestsAndDiseases","notation":["Meso"],"prefLabel":{"en":"Non-chemical  control- weeds, pests and diseases","nl":"Niet-chemische beheersing van onkruid, plagen en ziekten"},"altLabel":{"en":["Non-chemical control- weeds, pests and diseases"]},"definition":{"en":"integrated pest management means careful consideration of all available plant protection methods and subsequent integration of appropriate measures that discourage the development of populations of harmful organisms and keep the use of plant protection products and other forms of intervention to levels that are economically and ecologically justified and reduce or minimise risks to human health and the environment"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/AlternativeBiocontrolProductUse","notation":["Micro"],"prefLabel":{"en":"Alternative biocontrol product use","nl":"Gebruik van alternatieve biologische bestrijdingsmiddelen"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/IntegratedPestManagementPrinciplesIPM","notation":["Micro"],"prefLabel":{"en":"Integrated pest management principles (IPM)","nl":"Principes van geïntegreerde gewasbescherming (IPM)"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/IntegratedWeedManagement","notation":["Micro"],"prefLabel":{"en":"Integrated weed management","nl":"Geïntegreerd onkruidbeheer"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MechanicalPestManagement","notation":["Micro"],"prefLabel":{"en":"Mechanical pest management","nl":"Mechanische plaagbeheersing"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MechanicalWeedManagement","notation":["Micro"],"prefLabel":{"en":"Mechanical weed management","nl":"Mechanische onkruidbestrijding"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NaturalPestManagement","notation":["Micro"],"prefLabel":{"en":"Natural pest management","nl":"Natuurlijke plaagbeheersing"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NaturalWeedManagement","notation":["Micro"],"prefLabel":{"en":"Natural weed management","nl":"Natuurlijk onkruidbeheer"}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/LimitationOnTheUseOfPlantProtectionProducts","notation":["Meso"],"prefLabel":{"en":"Limitation on the use of plant protection products","nl":"Beperking van gewasbeschermingsmiddelen"},"definition":{"en":"this class includes the practices where there are limitations in the use of plant protection products on the whole field (excluding partial spatial limitations such as  landscape features, buffer strips...)","nl":"Het beperken van het gebruik van gewasbeschermingsmiddelen op het gehele perceel."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoFungicides","notation":["Micro"],"prefLabel":{"en":"No fungicides","nl":"Geen fungiciden"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoHerbicides","notation":["Micro"],"prefLabel":{"en":"No herbicides","nl":"Geen herbiciden"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoInsecticides","notation":["Micro"],"prefLabel":{"en":"No insecticides","nl":"Geen insecticiden"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoSyntheticPesticides","notation":["Micro"],"prefLabel":{"en":"No synthetic pesticides","nl":"Geen synthetische gewasbeschermingsmiddelen"}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReductionOnTheUseOfPlantProtectionProducts","notation":["Meso"],"prefLabel":{"en":"Reduction on the use of plant protection products","nl":"Gewasbeschermingsmiddelengebruik verminderen"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceFungicides","notation":["Micro"],"prefLabel":{"en":"Reduce fungicides","nl":"Fungicidengebruik verminderen"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceHerbicides","notation":["Micro"],"prefLabel":{"en":"Reduce herbicides","nl":"Herbicidengebruik verminderen"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceInsecticides","notation":["Micro"],"prefLabel":{"en":"Reduce insecticides","nl":"Insecticidengebruik verminderen"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceSyntheticPesticides","notation":["Micro"],"prefLabel":{"en":"Reduce synthetic pesticides","nl":"Gebruik van synthetische gewasbeschermingsmiddelen verminderen"}}]}]}]}],"@context":{"@version":1.1,"id":"@id","type":"@type","@vocab":"http://www.w3.org/2004/02/skos/core#","xsd":"http://www.w3.org/2001/XMLSchema#","dct":"http://purl.org/dc/terms/","dc":"http://purl.org/dc/elements/1.1/","schema":"https://schema.org/","vann":"http://purl.org/vocab/vann/","ldp":"http://www.w3.org/ns/ldp#","owl":"http://www.w3.org/2002/07/owl#","title":{"@id":"dct:title","@container":"@language"},"dc:title":{"@id":"dc:title","@container":"@language"},"dc:description":{"@id":"dc:description","@container":"@language"},"description":{"@id":"dct:description","@container":"@language"},"license":{"@id":"dct:license","@container":"@language"},"issued":{"@id":"dct:issued","@type":"xsd:date"},"created":{"@id":"dct:created","@type":"xsd:date"},"modified":{"@id":"dct:modified","@type":"xsd:date"},"creator":"dct:creator","publisher":"dct:publisher","preferredNamespacePrefix":"vann:preferredNamespacePrefix","preferredNamespaceUri":"vann:preferredNamespaceUri","isBasedOn":"schema:isBasedOn","source":"dct:source","prefLabel":{"@container":"@language"},"altLabel":{"@container":["@language","@set"]},"hiddenLabel":{"@container":["@language","@set"]},"definition":{"@container":"@language"},"note":{"@container":["@language","@set"]},"changeNote":{"@container":["@language","@set"]},"editorialNote":{"@container":["@language","@set"]},"historyNote":{"@container":["@language","@set"]},"scopeNote":{"@container":["@language","@set"]},"notation":{"@container":"@set"},"example":{"@container":"@language"},"narrower":{"@container":"@set"},"related":{"@container":"@set"},"relatedMatch":{"@container":"@set"},"narrowerTransitive":{"@container":"@set"},"broaderTransitive":{"@container":"@set"},"broadMatch":{"@container":"@set"},"narrowMatch":{"@container":"@set"},"closeMatch":{"@container":"@set"},"exactMatch":{"@container":"@set"},"hasTopConcept":{"@container":"@set"},"inScheme":{"@container":"@set"},"topConceptOf":{"@container":"@set"},"deprecated":{"@id":"owl:deprecated","@type":"xsd:boolean"},"isReplacedBy":{"@id":"dct:isReplacedBy","@container":"@set"}}}