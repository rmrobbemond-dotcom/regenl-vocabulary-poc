{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/R1-0043",
  "type": "Concept",
  "prefLabel": {
    "nl": "Meting van de mestsamenstelling",
    "en": "Measurement of manure composition"
  },
  "definition": {
    "nl": "Het kwalitatief of kwantitatief bepalen van de samenstelling van mest door middel van monsteranalyse of sensormetingen, om inzicht te verkrijgen in nutriëntengehalten en andere relevante eigenschappen ten behoeve van bemestingsmanagement.",
    "en": "The qualitative or quantitative determination of manure composition through sample analysis or sensor-based measurements to obtain information on nutrient concentrations and other relevant properties for fertilisation management."
  },
  "changeNote": {
    "nl": [
      "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; formele benaming verbreed naar meting van de mestsamenstelling; nieuwe afbeelding nodig."
    ]
  },
  "notation": [
    "Micro"
  ],
  "broader": {
    "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/meso-5afe732b24c9ad5e",
    "prefLabel": {
      "nl": "Mest en slib gebruiken",
      "en": "Use of specific fertilizer types or manure  - manure & sludge"
    }
  },
  "inScheme": [
    {
