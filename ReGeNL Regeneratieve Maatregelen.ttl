vocab:Liming a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:SoilAmendments ;
    skos:definition "Applying lime-based materials to raise soil pH or correct acidity, according to soil tests and crop requirements."@en,
        "Het toedienen van kalkhoudende materialen om de bodem-pH te verhogen of verzuring te corrigeren op basis van bodemonderzoek en gewasbehoefte."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:Shells ;
    skos:notation "Micro" ;
    skos:prefLabel "Liming"@en,
        "Bekalking"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9292573_2 ;
