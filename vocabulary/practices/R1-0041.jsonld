{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/R1-0041",
  "type": "Concept",
  "prefLabel": {
    "nl": "Toepassing van dierlijke mest",
    "en": "Application of animal manure"
  },
  "definition": {
    "nl": "Het toepassen van mest afkomstig van landbouwhuisdieren, bestaande uit uitwerpselen en eventueel urine, strooisel of andere bijgemengde materialen, als bron van nutriënten en organische stof voor de bodem en het gewas.",
    "en": "The application of manure originating from farm animals, consisting of excreta and potentially urine, bedding or other admixed materials, as a source of nutrients and organic matter for the soil and crops."
  },
  "changeNote": {
    "nl": [
      "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; afbeelding voorlopig behouden en gemarkeerd voor vervanging."
    ]
  },
  "notation": [
    "Micro"
  ],
  "broader": {
    "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/meso-5afe732b24c9ad5e",
    "prefLabel": {
      "nl": "Mest en slib gebruiken",
      "en": "Use of specific fertilizer types or manure  - manure & sludge"
    }
  },
  "inScheme": [
    {
