        vocab:NaturalWeedManagement ;
    skos:notation "Meso" ;
    skos:prefLabel "Non-chemical  control- weeds, pests and diseases"@en,
        "Niet-chemische beheersing van onkruid, plagen en ziekten"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg?width=960> ;
