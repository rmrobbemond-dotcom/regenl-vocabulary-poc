    skos:broader vocab:FertilizationAndManureManagement ;
    skos:definition "Adding materials to soil to modify its physical, chemical or biological properties, such as structure, pH or water retention, beyond direct crop nutrition alone."@en,
        "Het toevoegen van materialen aan de bodem om fysische, chemische of biologische eigenschappen te veranderen, zoals structuur, pH of vochtvasthoudend vermogen, niet uitsluitend als bemesting."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:Biochar,
        vocab:Gypsum,
        vocab:Liming,
        vocab:PreparationMadeFromOrganicMaterials,
        vocab:SoilInnoculationWithMicrobiology,
        vocab:StoneFlowerZelolith ;
    skos:notation "Meso" ;
    skos:prefLabel "Soil amendments"@en,
        "Bodemverbeteraars"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Field_of_stubble%2C_with_compost_ready_for_spreading_-_geograph.org.uk_-_6973475.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Meso level with label 'Soil amendments'."@en ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a machine spreading material over farmland. It illustrates the application of materials to farmland as an aspect of the practice “Soil amendments”."@en,
        "De foto toont een machine die materiaal over landbouwgrond verspreidt. Zo wordt het gericht aanbrengen van materialen op het land zichtbaar als onderdeel van de praktijk ‘Bodemverbeteraars’."@nl .

