    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows samples being collected from agricultural soil. It illustrates the assessment of soil properties as an aspect of the practice “Plant juice analysis”."@en,
        "De foto toont het nemen van monsters uit landbouwgrond. Zo wordt het onderzoeken van bodemkenmerken zichtbaar als onderdeel van de praktijk ‘Plantsapanalyse’."@nl ;
    schema:creditText "Foto: Alessandro Samuel-Rosa (CC0 1.0)."@nl .

vocab:PlantingShadeTrees a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Pasture_cows_in_shade.jpg> ;
    skos:broader vocab:TreePlanning ;
