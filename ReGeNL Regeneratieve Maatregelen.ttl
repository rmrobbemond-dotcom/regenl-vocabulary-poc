    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Stone flower, Zelolith'."@en ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:StripCropping a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Intercropping_maize_and_beans.jpg> ;
    skos:broader vocab:CropDiversificationIntercroppingPolycultureNoMonocultureCompanionPlanting ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Growing different crops in adjacent, relatively narrow strips wide enough for field operations, often to increase diversity and reduce pest spread."@en,
        "Het telen van verschillende gewassen in naast elkaar liggende, relatief smalle stroken die breed genoeg zijn voor bewerking, vaak om diversiteit te vergroten en plaagverspreiding te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (nl): Het telen van twee of meer gewassen in afwisselende stroken, waarbij een strook meerdere gewasrijen kan omvatten."@nl ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Strip cropping"@en,
        "Strokenteelt"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Intercropping_maize_and_beans.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9292024_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "two or more species cultivated in alternative strips and at least one strip includes more than one row"@en,
        "Twee of meer gewassen die in afwisselnde stroken worden geteeld, waarbij ten minste een strook meer dan een rij bevat"@nl ;
    schema:creditText "Foto: AnnaJB (CC BY-SA 4.0)."@nl .

vocab:StripGrazing a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Strip_Grazing_at_Merrivale_Farm_-_geograph.org.uk_-_158315.jpg> ;
    skos:broader vocab:GrazingSystem ;
    skos:definition "Giving livestock access to a narrow section of pasture at a time, usually by moving temporary fencing to provide fresh forage incrementally."@en,
        "Het vee telkens toegang geven tot een smalle grasstrook, meestal door een tijdelijke afrastering te verplaatsen om stapsgewijs vers voer aan te bieden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "strip grazing"@en,
        "Stripgrazen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Strip_Grazing_at_Merrivale_Farm_-_geograph.org.uk_-_158315.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9298707_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "a rotational grazing method where animals are given access to a narrow strip of pasture using a temporary, movable fence, like electric tape"@en,
        "Een vorm van rotatiebeweiding waarbij dieren met een verplaatsbare afrastering telkens toegang krijgen tot een smalle strook grasland."@nl ;
    schema:creditText "Foto: Philip Halling (Controleer licentie op Commons)."@nl .

vocab:StripTillage a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:ReduceTillageMinimalTillage ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Cultivating only the narrow soil strips in which seeds will be placed, leaving the soil between strips largely undisturbed."@en,
        "Het bewerken van alleen de smalle stroken waarin wordt gezaaid, terwijl de bodem tussen de stroken grotendeels onbewerkt blijft."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (nl): Bodembewerking die beperkt blijft tot smalle stroken waarin wordt gezaaid of geplant."@nl ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Strip tillage"@en,
        "Strokenbewerking (strip-till)"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9292024_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "tillage in a narrow band (e.g. 0.15-0.30m)"@en,
        "Slechts een smalle strook van de grond (bijvoorbeeld 15-30cm breed) wordt bewerkt"@nl ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:StubbleRetentionIncorporateCropResiduesLeftoverPruningMaterialIncorporateStrawUseGreenCompostGreenManure a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:MulchingWithCropResidues ;
    skos:definition "Retaining stubble and returning crop, straw or pruning residues and green organic materials to the field to recycle biomass and nutrients."@en,
        "Het behouden van stoppels en terugbrengen van gewasresten, stro, snoeimateriaal en groene organische materialen naar het perceel om biomassa en nutriënten te hergebruiken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "Stubble retention; Incorporate crop residues; Leftover pruning material; Incorporate straw; Use green compost ; green manure"@en,
        "Stoppelresten behouden en organische restmaterialen inwerken"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9290949_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:SubsurfaceDrainage a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Drip_irrigation.jpg> ;
    skos:broader vocab:MaintainWaterlevelsConstant ;
    skos:definition "Using pipes or other drainage structures below the soil surface to control excess water and manage groundwater levels in agricultural fields."@en,
        "Het gebruiken van buizen of andere ondergrondse drainagevoorzieningen om overtollig water af te voeren en grondwaterstanden op percelen te beheersen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "subsurface drainage"@en,
        "Ondergrondse drainage"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Drip_irrigation.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9292726_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: USDA (public domain, U.S. federal government)."@nl .

vocab:SuitableMaterialForAnimalBedding a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Dairy_farm_(P-062705-00-19).jpg> ;
    skos:broader vocab:AnimalHousing ;
    skos:definition "Selecting bedding materials that provide livestock with hygienic, dry and comfortable lying conditions while considering availability and manure management."@en,
        "Het kiezen van strooiselmaterialen die dieren een hygiënische, droge en comfortabele ligplek bieden, met aandacht voor beschikbaarheid en mestbeheer."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "suitable material for animal bedding"@en,
        "Geschikt strooiselmateriaal voor dieren"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Dairy%20farm%20(P-062705-00-19).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9294374_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Europese Commissie, audiovisuele dienst / Lukasz Kobus, Yügen (CC BY 4.0)."@nl .

vocab:SummerCoverCrops a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg> ;
    skos:broader vocab:CropDiversificationCoverCrops ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Growing cover crops during the summer period, usually between main crops or after early harvest, to protect soil and take up available nutrients."@en,
        "Het in de zomer telen van bodembedekkers, meestal tussen hoofdteelten of na vroege oogst, om bodem te beschermen en beschikbare nutriënten op te nemen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (nl): Groenbedekkers die in de zomer worden geteeld om de bodem met vegetatie bedekt te houden."@nl ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Summer cover crops"@en,
        "Zomerse bodembedekkers"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9285117_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "Cover crops grown to provide vegetative cover of the soil in summer"@en,
        "gewassen die in de zomer worden geteeld om de bodem te bedekken en te beschermen"@nl ;
    schema:creditText "Foto: Hugh Venables (controleer licentie op Commons)."@nl .

vocab:SustainabilityCertificationEGOrganicBiodynamicOnTheWayTo a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Inspection_for_organic_certification_for_Lakadong_Turmeric_In_presence_of_Trinity_Saioo.jpg> ;
    skos:broader vocab:IncomeBroadeningPaymentsForEcosystemServices ;
    skos:definition "Obtaining or maintaining third-party verification of farm practices against a defined sustainability standard, such as organic or biodynamic certification."@en,
        "Het verkrijgen of behouden van onafhankelijke toetsing van de bedrijfsvoering aan een omschreven duurzaamheidsstandaard, zoals biologisch of biodynamisch."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "(Sustainability) certification (e.g. organic, biodynamic, on the way to...)"@en,
        "Duurzaamheidscertificering (biologisch, biodynamisch enzovoort)"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Inspection%20for%20organic%20certification%20for%20Lakadong%20Turmeric%20In%20presence%20of%20Trinity%20Saioo.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9286565_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Trinity Saioo (CC0 1.0)."@nl .

vocab:SustainabilityPaymentsByChainPartners a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:FarmersMarket.jpg> ;
