    schema:creditText "Foto: Wikimedia Commons, hernieuwbare energie op landbouwbedrijf (controleer bron en licentie)." .

vocab:SoilSeedbedPreparation a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Seedbed_preparation_with_corvids_Essonne_20230518.jpg> ;
    skos:broader vocab:SoilManagement ;
    skos:definition "Preparing the soil surface and seed zone for sowing or planting through selected mechanical operations while managing soil structure and moisture."@en,
        "Het voorbereiden van bodemoppervlak en zaai- of plantzone met gekozen bewerkingen, rekening houdend met bodemstructuur en vocht."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
