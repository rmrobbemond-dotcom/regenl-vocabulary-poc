        "en": "Suitable material for animal bedding"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/R1-0144",
      "prefLabel": {
        "nl": "Klimaat- en lichtregeling",
        "en": "Climate and light control"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/R1-0145",
      "prefLabel": {
        "nl": "Ruimte voor de dieren om te slapen en te rusten",
        "en": "Space for the animals to sleep and rest"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/R1-0146",
      "prefLabel": {
        "nl": "Gebouw voor emissiereductie",
        "en": "Building for emission reduction"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/R1-0147",
      "prefLabel": {
        "nl": "Verplaatsbare kippenhokken",
        "en": "Mobile chicken coops"
      }
    }
  ],
