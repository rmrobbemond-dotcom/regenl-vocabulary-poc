vocab:Silvoarable a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Cattle_grazing_in_a_silvopasture._(25086463696).jpg> ;
    skos:altLabel "silvoarable"@en ;
    skos:broader vocab:CropDiversificationIntercroppingPolycultureNoMonocultureCompanionPlanting,
        vocab:TreePlanning ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "An agroforestry system combining trees or shrubs with arable crops on the same land, for example crops between tree rows."@en,
        "Een agroforestrysysteem waarin bomen of struiken met akkerbouwgewassen op dezelfde grond worden gecombineerd, bijvoorbeeld teelten tussen bomenrijen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (nl): Een agroforestrysysteem waarbij bomen en akkerbouwgewassen op hetzelfde perceel worden gecombineerd."@nl ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Silvoarable"@en,
        "Bomen gecombineerd met akkerbouw"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Cattle_grazing_in_a_silvopasture._(25086463696).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9298066_2 ;
    regenlmeta:definitionReference <https://www.fao.org/agroforestry/about-agroforestry/overview/> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "the integration of trees and arable crops on the same field"@en,
        "De integratie van bomen en akkerbousgewassen op hetzelfde perceel"@nl ;
    schema:creditText "Foto: USDA (public domain, U.S. federal government)."@nl .

vocab:Silvopasture a skos:Concept ;
