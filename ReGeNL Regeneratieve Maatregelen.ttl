practice:R1-0043 a skos:Concept ;
    dcterms:identifier "PRACTICE_R1_0043" ;
    skos:broader practice:meso-5afe732b24c9ad5e ;
    skos:changeNote "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; formele benaming verbreed naar meting van de mestsamenstelling; nieuwe afbeelding nodig."@nl ;
    skos:definition "The qualitative or quantitative determination of manure composition through sample analysis or sensor-based measurements to obtain information on nutrient concentrations and other relevant properties for fertilisation management."@en,
        "Het kwalitatief of kwantitatief bepalen van de samenstelling van mest door middel van monsteranalyse of sensormetingen, om inzicht te verkrijgen in nutriëntengehalten en andere relevante eigenschappen ten behoeve van bemestingsmanagement."@nl ;
    skos:inScheme practice:scheme ;
    skos:notation "Micro" ;
    skos:prefLabel "Measurement of manure composition"@en,
        "Meting van de mestsamenstelling"@nl ;
    regenlmeta:classificationLevel "Micro" ;
    regenlmeta:definitionStatus "user-reviewed" ;
    regenlmeta:farmerContentSource "Geplakte tekst(20261124-142404).txt" ;
    regenlmeta:farmerDescription "Measuring or analysing manure composition, such as nitrogen and phosphorus concentrations, to better understand the amount of nutrients applied."@en,
        "Het meten of laten analyseren van de samenstelling van mest, bijvoorbeeld het stikstof- en fosfaatgehalte, om beter te weten hoeveel voedingsstoffen worden toegediend."@nl ;
    regenlmeta:farmerDescriptionStatus "user-reviewed" ;
    regenlmeta:farmerLabel "Measure manure composition"@en,
        "Mestsamenstelling meten"@nl ;
    regenlmeta:farmerTopic "Fertilisation and soil nutrition"@en,
        "Bemesting en bodemvoeding"@nl ;
