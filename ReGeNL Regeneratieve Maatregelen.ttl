    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Stanley Howe (controleer licentie op Commons)."@nl .

vocab:StoneFlowerZelolith a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:SoilAmendments ;
    skos:definition "Applying finely ground mineral rock powders or zeolite materials to soil to supply minerals or influence nutrient exchange and soil chemistry."@en,
        "Het toedienen van fijngemalen gesteentemeel of zeoliet aan de bodem om mineralen aan te voeren of nutriëntenuitwisseling en bodemchemie te beïnvloeden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Stone flower, Zelolith"@en,
        "Steenmeel en zeoliet"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9291570_2 ;
