vocab:MaintainWaterlevelsConstant a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Drip_irrigation.jpg> ;
    skos:broader vocab:WaterManagement ;
    skos:definition "Using water-control structures or drainage management to keep surface-water or groundwater levels near a chosen target with limited fluctuations."@en,
        "Het gebruiken van stuwen, regelbare drainage of ander waterbeheer om oppervlaktewater- of grondwaterstanden dicht bij een gekozen streefpeil te houden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:SubsurfaceDrainage ;
    skos:notation "Meso" ;
    skos:prefLabel "maintain waterlevels constant"@en,
        "Waterstanden constant houden"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Drip_irrigation.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9300657_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: USDA (public domain, U.S. federal government)."@nl .

vocab:MulchingWithCropResidues a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilSeedbedPreparation ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Leaving or spreading crop residues on the soil surface as a protective mulch layer that reduces bare soil exposure and can slow evaporation."@en,
        "Het laten liggen of verspreiden van gewasresten op het bodemoppervlak als mulchlaag die kale grond afdekt en verdamping kan beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (nl): Het achterlaten of aanbrengen van gewasresten op het bodemoppervlak als bedekking."@nl ;
    skos:inScheme vocab: ;
    skos:narrower vocab:StubbleRetentionIncorporateCropResiduesLeftoverPruningMaterialIncorporateStrawUseGreenCompostGreenManure ;
    skos:notation "Micro" ;
    skos:prefLabel "Mulching with crop residues"@en,
        "Mulchen met gewasresten"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9289815_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "leaving or applying crop residues on the soil"@en,
        "Het achterlaten of aanbrengen van gewasresten op de bodem"@nl ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:NewFormsOfAccessToLandLabourCapital a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Farm_Office.jpg> ;
    skos:broader vocab:FarmSocioEconomicManagement ;
    skos:definition "Arrangements that give farmers access to land, labour or financing through alternatives to conventional ownership or credit, such as cooperatives or shared-use contracts."@en,
        "Regelingen waarmee boeren via alternatieven voor traditioneel eigendom of krediet toegang krijgen tot grond, arbeid of financiering, zoals coöperaties en gedeeld gebruik."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:CrowdfundingZoopSharesTimebankingOfLabour ;
    skos:notation "Meso" ;
    skos:prefLabel "New forms of access to  land, labour, capital"@en,
        "Nieuwe vormen van toegang tot grond, arbeid en kapitaal"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Farm_Office.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9283176_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Tvjeevaraj / Wikimedia Commons (controleer bron en licentie)." .

vocab:NoSyntheticFertilizerUse a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:LimitationOfSpecificFertilizers ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Supplying crops without manufactured synthetic mineral fertilisers, relying on other nutrient sources while accounting for nutrient balances."@en,
        "Het telen zonder vervaardigde synthetische minerale meststoffen en andere nutriëntenbronnen gebruiken met aandacht voor de nutriëntenbalans."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:SyntheticFertilizer ;
    skos:notation "Micro" ;
    skos:prefLabel "No synthetic fertilizer use"@en,
        "Geen kunstmest"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9289815_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'No synthetic fertilizer use'."@en,
        "Totaal geen gebruik van bemesting met kunstmest"@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:NoTillageMeso a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilManagement ;
    skos:definition "A cropping approach that avoids routine soil tillage before sowing and establishes crops directly in untilled soil, often retaining residues."@en,
        "Een teeltbenadering waarin vóór het zaaien geen reguliere grondbewerking plaatsvindt en gewassen rechtstreeks in onbewerkte grond worden gevestigd, vaak met gewasresten."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:NoTillageMicro ;
    skos:notation "Meso" ;
    skos:prefLabel "No tillage"@en,
        "Niet-kerende nulbewerking"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9300754_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "no tillage applied between harvest and sowing. The crop is sown directly into the soil not tilled since the harvest of the previous crop."@en,
        "Een teeltwijze waarbij tussen de oogst en de volgende inzaai geen grondbewerking plaatsvindt en direct in de onbewerkte bodem wordt gezaaid."@nl ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (Public domain (US federal government))."@nl .

vocab:NonInversionTillage a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:ReduceTillageMinimalTillage ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Loosening or mixing soil without turning the soil profile over, preserving more of its natural layer arrangement than inversion ploughing."@en,
        "Het losmaken of mengen van de bodem zonder het bodemprofiel te keren, waardoor de natuurlijke gelaagdheid meer behouden blijft dan bij ploegen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (nl): Grondbewerking waarbij de bodem wordt losgemaakt zonder de bodemlagen te keren, zodat een deel van de bovengrondse resten aan het oppervlak blijft."@nl ;
    skos:inScheme vocab: ;
    skos:narrower vocab:ChiselPlowingSubsoiling ;
    skos:notation "Micro" ;
    skos:prefLabel "Non-inversion tillage"@en,
        "Niet-kerende grondbewerking"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9300754_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "loosens and aerates the soil without turning it over, preserving surface residues and maintaining soil structure"@en,
        "maakt de grond los and zorgt voor ventilering zonder de bodem te keren."@nl ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:OutdoorAccess a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg> ;
    skos:broader vocab:AnimalHousing ;
    skos:definition "Providing livestock with access to an outdoor area where animals can move, explore or graze under suitable safety and welfare conditions."@en,
        "Het bieden van toegang tot een buitenruimte waar landbouwhuisdieren kunnen bewegen, verkennen of grazen onder passende veiligheids- en welzijnsomstandigheden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:MobileChickenCoopsNano ;
    skos:notation "Micro" ;
    skos:prefLabel "outdoor access"@en,
        "Buitenuitloop"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9297568_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Jeff Vanuga / USDA NRCS (publiek domein in de Verenigde Staten)."@nl .

vocab:PluralactivityWorkBeyondFarm a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Scholtenpad_farm_campsite_near_Meddo.JPG> ;
    skos:broader vocab:FarmSocioEconomicManagement ;
    skos:definition "Combining agricultural work with additional professional or commercial activities outside the farm to diversify household or business income."@en,
        "Het combineren van landbouwactiviteiten met ander werk of ondernemerschap buiten het bedrijf om huishoud- of bedrijfsinkomsten te spreiden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:NonFarmAndOffFarmEmployment ;
    skos:notation "Meso" ;
    skos:prefLabel "Pluralactivity - work beyond farm"@en,
        "Nevenactiviteiten buiten de landbouw"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Scholtenpad_farm_campsite_near_Meddo.JPG?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9290682_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Wikimedia Commons, boerencamping / agritoerisme (controleer bron en licentie)." .

vocab:ReduceSyntheticFertilizers a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:ReductionLimitationOfSpecificFertilizers ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Lowering applications of industrially manufactured mineral fertilisers through improved nutrient management or substitution with other nutrient sources."@en,
        "Het verminderen van industrieel vervaardigde minerale meststoffen via beter nutriëntenbeheer of vervanging door andere nutriëntenbronnen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
