    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Hugh Venables (controleer licentie op Commons)."@nl .

vocab:SelfSufficiency a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Sheep_under_solar_panels_(1)_2025-07-26.jpg> ;
    skos:broader vocab:ReduceExternalInputs ;
    skos:definition "Increasing the share of resources or products needed by a farm or farm household that are produced or supplied internally rather than purchased externally."@en,
        "Het vergroten van het aandeel hulpbronnen of producten dat het landbouwbedrijf of huishouden zelf produceert of levert in plaats van extern inkoopt."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Self-sufficiency"@en,
        "Zelfvoorziening"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Sheep_under_solar_panels_(1)_2025-07-26.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9296486_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Wikimedia Commons, hernieuwbare energie op landbouwbedrijf (controleer bron en licentie)." .

vocab:ShadeTreePlanting a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Cattle_grazing_in_a_silvopasture._(25086463696).jpg> ;
    skos:broader vocab:Silvopasture ;
    skos:definition "Establishing trees at selected farm locations to provide shade that mitigates heat exposure for animals, crops or workers."@en,
        "Het aanplanten van bomen op gekozen plekken op het bedrijf om schaduw te bieden en hittebelasting van dieren, gewassen of medewerkers te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "shade tree planting"@en,
        "Schaduwbomen planten"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Cattle_grazing_in_a_silvopasture._(25086463696).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9296690_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: USDA (public domain, U.S. federal government)."@nl .

vocab:ShallowNonInversionTillage a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:ReduceTillageMinimalTillage ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Cultivating only the upper soil layer without turning over the soil profile, thereby limiting depth and inversion of disturbance."@en,
        "Het bewerken van uitsluitend de bovenste bodemlaag zonder het bodemprofiel te keren, zodat de verstoringsdiepte en bodemkering beperkt blijven."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (nl): Niet-kerende bodembewerking tot beperkte diepte; in de bron wordt als voorbeeld maximaal 6 cm genoemd."@nl ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Shallow non-inversion tillage"@en,
        "Ondiepe niet-kerende grondbewerking"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9300754_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "non-inversion tillage until e.g. maximum 0.06m depth"@en,
        "Losmaken van de bodem zonder deze te keren, tot bijvoorbeeld maximaal 6 cm diep"@nl ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:SharedUseAndOwnershipEGOfMachineryLandLabourEGMutualHelpCapital a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:IndividualAndCollectiveFormsOfCostReducingMeasures ;
    skos:definition "Pooling, co-owning or jointly using machinery, land, labour or capital among farms or community partners instead of arranging each resource separately."@en,
        "Het gezamenlijk inzetten, bezitten of financieren van machines, grond, arbeid of kapitaal door landbouwbedrijven of partners in plaats van alles afzonderlijk te organiseren."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Shared use and ownership (e.g. of machinery, land, labour (e.g. mutual help, capital)"@en,
        "Gezamenlijk gebruik en eigendom van machines, grond, arbeid of kapitaal"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9283176_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:SheepWoolFertilizer a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Sheep_shearing_Holland.jpg> ;
    skos:broader vocab:UseOfSpecificFertilizerTypesOrManure ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Applying processed sheep wool as an organic, slowly decomposing nutrient source, particularly of nitrogen, to soil or crops."@en,
        "Het gebruiken van verwerkte schapenwol als organische, langzaam afbrekende nutriëntenbron, vooral voor stikstof, voor bodem of gewassen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Sheep wool fertilizer"@en,
        "Schapenwol als meststof"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Sheep%20shearing%20Holland.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9286816_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "Het gebruik van schapenwol als meststof"@nl ;
    schema:creditText "Foto: Peter van der Sluijs (Vrije licentie, controleer bronpagina)."@nl .

vocab:Shells a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:Liming ;
    skos:definition "Applying ground shells or shell-derived calcium carbonate to soil, generally to influence acidity or supply calcium, subject to material suitability."@en,
        "Het toedienen van gemalen schelpen of daarvan afkomstig calciumcarbonaat aan de bodem, meestal voor beïnvloeding van de zuurgraad of aanvoer van calcium."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "shells"@en,
        "Schelpen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9833707_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

