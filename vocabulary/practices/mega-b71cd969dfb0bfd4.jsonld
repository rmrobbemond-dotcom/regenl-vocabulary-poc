{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/mega-b71cd969dfb0bfd4",
  "type": "Concept",
  "prefLabel": {
    "nl": "Landbeheer",
    "en": "Land management"
  },
  "definition": {
    "nl": "Het plannen en uitvoeren van de inrichting, het gebruik en het onderhoud van landbouwgrond, waaronder percelen, randen, bodem, water en landschapselementen.",
    "en": "Planning and implementing how agricultural land is allocated, used and maintained, including fields, margins, soil, water and landscape features."
  },
  "notation": [
    "Mega"
  ],
  "narrower": [
