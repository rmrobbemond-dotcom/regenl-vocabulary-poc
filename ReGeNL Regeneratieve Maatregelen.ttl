vocab:CompartmentedContinousGrazingNewNederlandsWeiden a skos:Concept ;
    skos:broader vocab:GrazingSystem ;
    skos:definition "(CCG) is a daily rotational grazing system where a pasture is divided into multiple compartments, and livestock are moved to a new compartment each day"@en,
        "Een beweidingssysteem waarbij grasland in compartimenten is verdeeld en dieren dagelijks naar een volgend compartiment worden verplaatst."@nl ;
    skos:editorialNote "Nederlandse vertaling is een redactioneel voorstel op basis van de bestaande Engelstalige bron en moet nog worden gevalideerd."@nl ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "compartmented continous grazing (New nederlands weiden)"@en,
        "Gecompartimenteerd continu beweiden (Nieuw Nederlands Weiden)"@nl .

