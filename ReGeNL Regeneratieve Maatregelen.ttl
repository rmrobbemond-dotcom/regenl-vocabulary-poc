vocab:PrivateBrand a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Shop_front_-_farm_shop.jpg> ;
    skos:broader vocab:IncomeDeepeningIncreasingAddedValueOfProduct ;
    skos:definition "Marketing farm products under a brand owned or controlled by the farm rather than solely under a retailer or commodity identity."@en,
        "Het op de markt brengen van boerderijproducten onder een eigen merk van het landbouwbedrijf in plaats van uitsluitend onder een handels- of generieke productnaam."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
