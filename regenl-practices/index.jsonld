{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/","type":"ConceptScheme","title":{"en":"ReGeNL – regenerative practices (PoC)","nl":"ReGeNL – regeneratieve landbouwpraktijken (PoC)"},"prefLabel":{"en":"ReGeNL regenerative practice framework","nl":"ReGeNL raamwerk regeneratieve landbouwpraktijken"},"description":{"en":"SKOS publication representation derived from the ReGeNL ontology. Hierarchical levels: Mega, Macro, Meso, Micro, Nano. Labels and definitions are copied from the source where present; missing text is not generated."},"hasTopConcept":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Biodigester","notation":["Micro"],"prefLabel":{"en":"Biodigester","nl":"Vergistingsinstallatie"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ExtendedGrazingTimeMinimumOf1500HoursYear","notation":["Micro"],"prefLabel":{"en":"Extended grazing time: minimum of 1500 hours/year","nl":"Verlengde weidegang: minimaal 1.500 uur per jaar"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ExtendedGrazingTimeMinimumOf720HoursYearMaximumOf1500HoursPerYear","notation":["Micro"],"prefLabel":{"en":"Extended grazing time: minimum of 720 hours/year (maximum of 1500 hours per year)","nl":"Verlengde weidegang: 720–1.500 uur per jaar"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SolarPannels","notation":["Micro"],"prefLabel":{"en":"Solar pannels","nl":"Zonnepanelen"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Bioeconomy","notation":["Mega"],"prefLabel":{"en":"Bioeconomy","nl":"Bio-economie"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/BioeconomyEnergyEfficiencyAndProduction","notation":["Macro"],"prefLabel":{"en":"Bioeconomy, energy efficiency and production","nl":"Bio-economie, energie-efficiëntie en productie"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/RenewableEnergy","notation":["Meso"],"prefLabel":{"en":"renewable energy","nl":"Hernieuwbare energie"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Agrovoltaics","notation":["Micro"],"prefLabel":{"en":"Agrovoltaics","nl":"Agrovoltaïsche systemen"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceDependencyOnFossilFuel","notation":["Micro"],"prefLabel":{"en":"Reduce dependency on fossil fuel","nl":"Afhankelijkheid van fossiele brandstoffen verminderen"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WindEnergy","notation":["Micro"],"prefLabel":{"en":"Wind energy","nl":"Windenergie"}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceExternalInputs","notation":["Meso"],"prefLabel":{"en":"Reduce external inputs","nl":"Externe inputs verminderen"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Food_crops_only","notation":["Micro"],"prefLabel":{"en":"Food crops only","nl":"Alleen voedselgewassen"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoResidualStreams","notation":["Micro"],"prefLabel":{"en":"No residual streams","nl":"Geen reststromen"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SelfSufficiency","notation":["Micro"],"prefLabel":{"en":"Self-sufficiency","nl":"Zelfvoorziening"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/UseLocalInputs","notation":["Micro"],"prefLabel":{"en":"Use local inputs","nl":"Lokale inputs gebruiken"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/UseOfResidualMaterials","notation":["Micro"],"prefLabel":{"en":"Use of residual materials","nl":"Restmaterialen gebruiken"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/UseOfNaturalRenewableResources","notation":["Micro"],"prefLabel":{"en":"Use of natural/renewable resources","nl":"Natuurlijke en hernieuwbare hulpbronnen gebruiken"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WoodBioplastics","notation":["Nano"],"prefLabel":{"en":"wood, bioplastics","nl":"Hout en bioplastics"}}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ResourceSharingCollaborationBetweenArableProductionAndDairy","notation":["Meso"],"prefLabel":{"en":"resource sharing, collaboration between arable production and dairy","nl":"Delen van middelen tussen akkerbouw en melkveehouderij"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/LocalOrRegionalCollaborationBetweenSectorsEGCropLivestock","notation":["Micro"],"prefLabel":{"en":"Local or regional collaboration between sectors (e.g. crop-livestock)","nl":"Lokale of regionale samenwerking tussen sectoren"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MixedFarmingIntegrateLivestock","notation":["Micro"],"prefLabel":{"en":"Mixed farming / integrate livestock","nl":"Gemengd bedrijf met geïntegreerde veehouderij"}}]}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CropProductionManagementGrasslandManagement","notation":["Mega"],"prefLabel":{"en":"Crop production management : grassland management","nl":"Graslandbeheer binnen gewasproductie"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/GrasslandAndGrazing","notation":["Macro"],"prefLabel":{"en":"Grassland and grazing","nl":"Grasland en beweiding"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/GrazingSystem","notation":["Meso"],"prefLabel":{"en":"grazing system","nl":"Beweidingssysteem"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CompartmentedContinousGrazingNewNederlandsWeiden","notation":["Micro"],"prefLabel":{"en":"compartmented continous grazing (New nederlands weiden)","nl":"Gecompartimenteerd continu beweiden (Nieuw Nederlands Weiden)"},"definition":{"en":"(CCG) is a daily rotational grazing system where a pasture is divided into multiple compartments, and livestock are moved to a new compartment each day","nl":"Een beweidingssysteem waarbij grasland in compartimenten is verdeeld en dieren dagelijks naar een volgend compartiment worden verplaatst."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/GrazingTrainingOfYoungstock","notation":["Micro"],"prefLabel":{"en":"grazing training of youngstock","nl":"Jongvee laten wennen aan weidegang"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/HolisticGrazing","notation":["Micro"],"prefLabel":{"en":"Holistic grazing","nl":"Holistisch beweiden"},"definition":{"en":"similar to rotational grazing but differs in that it more explicitly recognizes and provides a framework for adapting to the four basic ecosystem processes by increasing the recovery time","nl":"Een adaptieve vorm van beweidingsbeheer waarin graasdruk en herstelperioden worden afgestemd op de toestand van vegetatie, bodem en ecosysteemprocessen."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MOBGrazing","notation":["Micro"],"prefLabel":{"en":"MOB grazing","nl":"Mobbeweiding"},"definition":{"en":"high denisty grazing, a grazing management system where a large herd of livestock grazes a small area for a short period, followed by a long rest period for the pasture to recover","nl":"Beweiding met een hoge veedichtheid gedurende een korte graasperiode, gevolgd door een relatief lange herstelperiode voor de vegetatie."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/RotationalGrazing","notation":["Micro"],"prefLabel":{"en":"rotational grazing","nl":"Rotatiebeweiding"},"definition":{"en":"use more than one paddock in a pasture to restrict livestock grazing to a certain area","nl":"Een beweidingsmethode waarbij dieren achtereenvolgens toegang krijgen tot verschillende delen van grasland in plaats van voortdurend het hele perceel te beweiden."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Standweide","notation":["Micro"],"prefLabel":{"en":"standweide","nl":"Standweide"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/StripGrazing","notation":["Micro"],"prefLabel":{"en":"strip grazing","nl":"Stripgrazen"},"definition":{"en":"a rotational grazing method where animals are given access to a narrow strip of pasture using a temporary, movable fence, like electric tape","nl":"Een vorm van rotatiebeweiding waarbij dieren met een verplaatsbare afrastering telkens toegang krijgen tot een smalle strook grasland."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/VoisinRationalGrazing","notation":["Micro"],"prefLabel":{"en":"Voisin rational grazing","nl":"Rationeel beweiden volgens Voisin"},"definition":{"en":"VRG can be defined as a rational method for managing the soil–plant–animal complex through direct grazing and well-planned pasture rotation. the VRG follows four principles (1ste. recovery period, occupation, maximum performance, regualr performance)","nl":"Een planmatige vorm van rotatiebeweiding waarin de graas- en herstelperioden worden afgestemd op de groei van het gras en de beweidingsbehoefte van de dieren."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/GrasslandTypeEnhancedSpeciesRichness","notation":["Meso"],"prefLabel":{"en":"grassland type - enhanced species richness","nl":"Graslandtype met verhoogde soortenrijkdom"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ExtensiveSpeciesRichGrassland","notation":["Micro"],"prefLabel":{"en":"extensive species rich grassland","nl":"Extensief soortenrijk grasland"},"definition":{"en":"> 15 grasses and herbs per  25 m2","nl":"Soortenrijk grasland waarvoor in de bron een drempel van meer dan vijftien gras- en kruidensoorten per 25 m² wordt genoemd."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ProductiveMultispeciesSward","notation":["Micro"],"prefLabel":{"en":"productive multispecies sward","nl":"Productieve soortenrijke graszode"}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/GrazingManagement","notation":["Meso"],"prefLabel":{"en":"grazing management","nl":"Beweidingsbeheer"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/GrazingGeneral","notation":["Micro"],"prefLabel":{"en":"Grazing (general)","nl":"Beweiding (algemeen)"}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/GrasslandTypeSwardAge","notation":["Meso"],"prefLabel":{"en":"grassland type - sward age","nl":"Graslandtype naar leeftijd van de zode"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PermanentGrasslandSwardAtLeast5YearsOldRenewedWithin15years","notation":["Micro"],"prefLabel":{"en":"permanent grassland sward  at least 5 years old renewed within 15years","nl":"Blijvend grasland van minstens vijf jaar, vernieuwd binnen vijftien jaar"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PermanentGrasslandSwardOlderThan15Year","notation":["Micro"],"prefLabel":{"en":"permanent grassland sward older than 15 year","nl":"Blijvend grasland ouder dan vijftien jaar"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PermanentGrasslandSwardRegularyRenewedWithinThe5Years","notation":["Micro"],"prefLabel":{"en":"permanent grassland sward regulary renewed within the 5 years","nl":"Grasland dat binnen vijf jaar regelmatig wordt vernieuwd"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/TemporaryGrasslandSwardYoungerThan5Years","notation":["Micro"],"prefLabel":{"en":"temporary grassland , sward younger than 5 years","nl":"Tijdelijk grasland jonger dan vijf jaar"}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/AdaptiveMowingManagement","notation":["Meso"],"prefLabel":{"en":"adaptive mowing management","nl":"Adaptief maaibeheer"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DelayedMowingDateForMeadowBirdProtection15JuneOrBotanicalProtectionJuly","notation":["Micro"],"prefLabel":{"en":"delayed mowing date for meadow bird protection ( 15 June) or botanical protection (July)","nl":"Uitgestelde maaidatum voor weidevogels (15 juni) of botanisch beheer (juli)"},"definition":{"en":"diversification of mowing activitiesfarm scale to benefit biodiversity","nl":"Het uitstellen van maaiwerkzaamheden om bijvoorbeeld broedende weidevogels of botanische waarden te beschermen."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DelayedMowingDateForBirdProtection","notation":["Nano"],"prefLabel":{"en":"delayed mowing date for bird protection","nl":"Uitgestelde maaidatum voor vogelbescherming"}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DiversificationOfMowingActivitiesOnFieldAndFarmScale","notation":["Micro"],"prefLabel":{"en":"diversification of mowing activities on field and farm scale","nl":"Diversificatie van maaibeheer op perceels- en bedrijfsniveau"},"definition":{"en":"diversification of mowing activities on field and farm scale to benefit biodiversity and improve connectivity of habitats","nl":"Het variëren van maaimomenten of maaibeheer binnen percelen en bedrijven om biodiversiteit en de verbinding tussen leefgebieden te ondersteunen."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SinusMowingMosaikMowing","notation":["Nano"],"prefLabel":{"en":"sinus mowing, mosaik mowing,","nl":"Sinusmaaien en mozaïekmaaien"}}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ExtensificationOfGrazingManagementAdaptiveGrazingManagementMethod","notation":["Meso"],"prefLabel":{"en":"extensification of grazing management  - adaptive grazing management method","nl":"Extensivering en adaptief beweidingsbeheer"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReductionInGrazingIntensity15LUHaForInstanceForVoluntaryEcoPracticePackages","notation":["Micro"],"prefLabel":{"en":"Reduction in grazing intensity (1.5 LU/ha), for instance for voluntary eco practice packages","nl":"Verlagen van beweidingsintensiteit (bijvoorbeeld 1,5 GVE per ha)"},"definition":{"en":"for the ecoregeling , additional payment 2500 hours in 120 days max 3 LU per ha (huiskavel), 1500 hours in 120 days  max 5 LU ha ( huiskavel), for ALNb depending on the region as restriction in the number of LU per grassland site can be restricted"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MinimumGrazingPeriodNoOrRestrictedGrazingGrazingLivestockDensityLimitation","notation":["Nano"],"prefLabel":{"en":"minimum grazing period; no or restricted grazing; grazing livestock density limitation","nl":"Minimale beweidingsperiode of beperkingen aan beweiding en veebezetting"}}]}]}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/FinancialManagement","notation":["Mega"],"prefLabel":{"en":"Financial management","nl":"Financieel beheer"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/FarmSocioEconomicManagement","notation":["Macro"],"prefLabel":{"en":"Farm socio-economic management","nl":"Sociaal-economisch bedrijfsbeheer"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/IncomeDeepeningIncreasingAddedValueOfProduct","notation":["Meso"],"prefLabel":{"en":"Income deepening -increasing added value of product","nl":"Inkomensverdieping door hogere productwaarde"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CollectiveBrand","notation":["Micro"],"prefLabel":{"en":"Collective brand","nl":"Collectief merk"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CollectiveProssesing","notation":["Micro"],"prefLabel":{"en":"Collective prossesing","nl":"Collectieve verwerking"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CommunityBasedSupportedAgriculture","notation":["Micro"],"prefLabel":{"en":"Community based/supported agriculture","nl":"Gemeenschapslandbouw (CSA)"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DirectOnfarmAndCollectiveFormsOfSales","notation":["Micro"],"prefLabel":{"en":"Direct onfarm and collective forms of sales","nl":"Directe boerderijverkoop en collectieve afzet"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/FoodPurchasingByCitizensCooperatives","notation":["Micro"],"prefLabel":{"en":"Food purchasing by citizens cooperatives","nl":"Voedselaankoop door burgercoöperaties"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/OnFarmProcessing","notation":["Micro"],"prefLabel":{"en":"On-farm processing","nl":"Verwerking op het landbouwbedrijf"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PrivateBrand","notation":["Micro"],"prefLabel":{"en":"Private brand","nl":"Eigen merk"}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NewFormsOfAccessToLandLabourCapital","notation":["Meso"],"prefLabel":{"en":"New forms of access to  land, labour, capital","nl":"Nieuwe vormen van toegang tot grond, arbeid en kapitaal"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CrowdfundingZoopSharesTimebankingOfLabour","notation":["Micro"],"prefLabel":{"en":"Crowdfunding, zoop, shares, timebanking of labour","nl":"Crowdfunding, Zoöp, aandelen en tijdsruil van arbeid"}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/IncomeBroadeningPaymentsForEcosystemServices","notation":["Meso"],"prefLabel":{"en":"Income broadening- Payments for ecosystem services","nl":"Inkomensverbreding via betalingen voor ecosysteemdiensten"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/EcosystemservicePaymentsFromGovernment","notation":["Micro"],"prefLabel":{"en":"Ecosystemservice payments from government","nl":"Overheidsbetalingen voor ecosysteemdiensten"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SustainabilityCertificationEGOrganicBiodynamicOnTheWayTo","notation":["Micro"],"prefLabel":{"en":"(Sustainability) certification (e.g. organic, biodynamic, on the way to...)","nl":"Duurzaamheidscertificering (biologisch, biodynamisch enzovoort)"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SustainabilityPaymentsByChainPartners","notation":["Micro"],"prefLabel":{"en":"Sustainability payments by chain partners","nl":"Duurzaamheidsbetalingen door ketenpartners"}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/IncomeBroadeningMeso","notation":["Meso"],"prefLabel":{"en":"Income broadening","nl":"Inkomensverbreding"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/IncomeBroadeningMicro","notation":["Micro"],"prefLabel":{"en":"Income broadening","nl":"Inkomensverbreding"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ProvideCareFarming","notation":["Micro"],"prefLabel":{"en":"Provide care farming","nl":"Zorglandbouw aanbieden"}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/IndividualAndCollectiveFormsOfCostReducingMeasures","notation":["Meso"],"prefLabel":{"en":"Individual and collective forms of cost reducing measures","nl":"Individuele en collectieve kostenbesparende maatregelen"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/InputReductionOfEGAgrochemicalsAndFeed","notation":["Micro"],"prefLabel":{"en":"Input reduction of e.g. agrochemicals and feed","nl":"Vermindering van externe inputs zoals gewasbeschermingsmiddelen en voer"}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SharedUseAndOwnershipEGOfMachineryLandLabourEGMutualHelpCapital","notation":["Micro"],"prefLabel":{"en":"Shared use and ownership (e.g. of machinery, land, labour (e.g. mutual help, capital)","nl":"Gezamenlijk gebruik en eigendom van machines, grond, arbeid of kapitaal"}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PluralactivityWorkBeyondFarm","notation":["Meso"],"prefLabel":{"en":"Pluralactivity - work beyond farm","nl":"Nevenactiviteiten buiten de landbouw"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NonFarmAndOffFarmEmployment","notation":["Micro"],"prefLabel":{"en":"non-farm and off-farm employment","nl":"Werk buiten het landbouwbedrijf"}}]}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/InfraAndEquipmentManagement","notation":["Mega"],"prefLabel":{"en":"Infra and equipment management","nl":"Infrastructuur- en materieelbeheer"},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DiagnosisAndManagementPlansMacro","notation":["Macro"],"prefLabel":{"e