practice:R1-0044 a skos:Concept ;
    dcterms:identifier "PRACTICE_R1_0044" ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader practice:meso-212f8535a6bebf70 ;
