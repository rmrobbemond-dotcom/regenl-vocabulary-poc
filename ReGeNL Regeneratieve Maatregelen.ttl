    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Hedgerow_planting_on_footpath_near_Witley_Farm_-_geograph.org.uk_-_2859786.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a hedgerow and trees in farmland. It illustrates woody landscape elements as habitats and corridors as an aspect of the practice “tree planning”."@en,
