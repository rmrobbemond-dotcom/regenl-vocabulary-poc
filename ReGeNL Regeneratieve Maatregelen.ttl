vocab:CropManagament a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg> ;
    skos:broader vocab:CropProductionManagement ;
    skos:definition "Planning and carrying out field operations, crop selection and crop protection during the growing season to meet agronomic objectives and manage environmental effects."@en,
        "Het plannen en uitvoeren van veldbewerkingen, gewaskeuze en gewasbescherming gedurende het groeiseizoen om teeltdoelen en milieueffecten te beheren."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
