practice:R1-0015 a skos:Concept ;
    dcterms:identifier "PRACTICE_R1_0015" ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Hedgerow_on_Farmland_-_geograph.org.uk_-_7294771.jpg> ;
    skos:broader practice:meso-1c38510133a39039 ;
    skos:changeNote "Annotaties, formele naamswijziging en selecteerbaarheid goedgekeurd tijdens conceptreview; afbeelding kandidaat 1 overgenomen, visuele controle en licentiecontrole nog nodig. Hiërarchische positie behouden voor latere review."@nl ;
    skos:definition "The deliberate establishment of ecological infrastructure, such as hedgerows, field margins and scrub patches, providing natural enemies of crop pests with shelter, overwintering sites or suitable habitat conditions to support biological pest management."@en,
        "Het doelgericht aanleggen van ecologische infrastructuur, zoals hagen, akkerranden en struweel, die natuurlijke vijanden van gewasplagen schuilplaatsen, overwinteringsmogelijkheden of geschikte leefomstandigheden biedt ter ondersteuning van biologische plaagbeheersing."@nl ;
    skos:inScheme practice:scheme ;
    skos:notation "Micro" ;
    skos:prefLabel "Creating ecological infrastructure to shelter predators"@en,
        "Aanleg van ecologische infrastructuur voor natuurlijke vijanden"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Hedgerow_on_Farmland_-_geograph.org.uk_-_7294771.jpg?width=960> ;
    regenlmeta:classificationLevel "Micro" ;
    regenlmeta:definitionStatus "user-reviewed" ;
    regenlmeta:farmerContentSource "Geplakte tekst(20261124-142404).txt" ;
    regenlmeta:farmerDescription "Creating shelter and overwintering sites for natural enemies of pests, for example in hedgerows or field margins."@en,
        "Het aanleggen van schuil- en overwinteringsplekken voor natuurlijke vijanden van plagen, bijvoorbeeld in hagen of akkerranden."@nl ;
    regenlmeta:farmerDescriptionStatus "user-reviewed" ;
    regenlmeta:farmerLabel "Create shelters for natural enemies"@en,
        "Schuilplaatsen voor natuurlijke vijanden aanleggen"@nl ;
    regenlmeta:farmerTopic "Pests and diseases"@en,
        "Ziekten en plagen"@nl ;
    regenlmeta:originalPracticeIdentifier "PRACTICE_R1_0015" ;
    regenlmeta:originalPracticeLabel "Creating ecological infrastructures to shelter predators"@en,
        "Aanleg van ecologische infrastructuur om roofdieren onderdak te bieden"@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "A hedgerow in the agricultural landscape provides an example of ecological infrastructure that can offer shelter and overwintering opportunities for natural enemies of crop pests."@en,
        "Een haag in het agrarisch landschap vormt een voorbeeld van ecologische infrastructuur die natuurlijke vijanden van gewasplagen beschutting en overwinteringsmogelijkheden kan bieden."@nl ;
