vocab:Swales a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Drip_irrigation.jpg> ;
    skos:broader vocab:WaterStorage ;
    skos:definition "Constructing shallow, often contour-aligned vegetated depressions that intercept runoff and encourage water infiltration into the landscape."@en,
        "Het aanleggen van ondiepe, vaak langs hoogtelijnen gelegen begroeide geulen die afstromend water opvangen en infiltratie bevorderen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Swales"@en,
        "Wadi's en infiltratiegreppels"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Drip_irrigation.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_10503798_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: USDA (public domain, U.S. federal government)."@nl .

vocab:SyntheticFertilizer a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:NoSyntheticFertilizerUse ;
    skos:definition "Applying manufactured mineral fertilisers that supply plant nutrients in concentrated inorganic or industrially processed forms."@en,
        "Het toedienen van industrieel vervaardigde minerale meststoffen die plantenvoedingsstoffen leveren in geconcentreerde anorganische of industrieel verwerkte vorm."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "synthetic fertilizer"@en,
        "Kunstmest"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9289815_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:SyntropicFarming a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Cattle_grazing_in_a_silvopasture._(25086463696).jpg> ;
    skos:broader vocab:TreePlanning ;
    skos:definition "Managing highly diverse, often tree-based crop systems through planned succession, dense planting and pruning to build biomass and support ecological processes."@en,
        "Het beheren van zeer diverse, vaak boomrijke teeltsystemen via geplande successie, dichte beplanting en snoei om biomassa op te bouwen en ecologische processen te ondersteunen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Syntropic farming"@en,
        "Syntropische landbouw"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Cattle_grazing_in_a_silvopasture._(25086463696).jpg?width=960> ;
