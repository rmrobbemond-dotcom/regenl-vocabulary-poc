    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: USDA (public domain, U.S. federal government)."@nl .

vocab:TemporaryGrasslandSwardYoungerThan5Years a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg> ;
    skos:broader vocab:GrasslandTypeSwardAge ;
    skos:definition "Grassland with a sward younger than five years since establishment or renewal, often included in arable rotations rather than maintained indefinitely."@en,
        "Grasland met een zode jonger dan vijf jaar sinds aanleg of vernieuwing, vaak opgenomen in een akkerbouwrotatie in plaats van blijvend aangehouden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "temporary grassland , sward younger than 5 years"@en,
        "Tijdelijk grasland jonger dan vijf jaar"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9298707_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "see definition permanent grassland types"@en ;
    schema:creditText "Foto: Jeff Vanuga / USDA NRCS (publiek domein in de Verenigde Staten)."@nl .

vocab:TreesAndHedgesAsHabitat a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Hedgerow_around_an_arable_field_-_geograph.org.uk_-_3670471.jpg> ;
    skos:broader vocab:HabitatProvisionBiodiversityEnhancement ;
    skos:definition "Retaining, planting or managing trees and hedgerows to offer nesting sites, food, shelter and movement routes for wildlife."@en,
        "Het behouden, aanplanten of beheren van bomen en heggen die nestplaatsen, voedsel, beschutting en verplaatsingsroutes voor fauna bieden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Trees and hedges as habitat"@en,
        "Bomen en heggen als leefgebied"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Hedgerow_around_an_arable_field_-_geograph.org.uk_-_3670471.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9291509_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Stanley Howe (Controleer licentie op Commons)."@nl .

vocab:UnderSowing a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Intercropping_maize_and_beans.jpg> ;
    skos:broader vocab:CropDiversificationIntercroppingPolycultureNoMonocultureCompanionPlanting ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Sowing a second crop, often a cover crop, beneath an established main crop so that it grows before or after the main crop is harvested."@en,
        "Het inzaaien van een tweede gewas, vaak een bodembedekker, onder een bestaande hoofdteelt zodat het vóór of na de oogst van de hoofdteelt groeit."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (nl): Het onderzaaien van een vang- of groenbedekker in een hoofdgewas, zodat de gewassen gedurende een deel van hun groei gelijktijdig aanwezig zijn."@nl ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Under sowing"@en,
        "Onderzaai"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Intercropping_maize_and_beans.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9299142_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "catch crop (see also cover crops), grown partly at the same time as the main crop"@en,
        "Het telen van een tussen / vanggewas (zie ook bodembedekkers) waarbij er temporale overlap is met het hoofdgewas"@nl ;
    schema:creditText "Foto: AnnaJB (CC BY-SA 4.0)."@nl .

vocab:UseBreakCrops a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg> ;
    skos:broader vocab:ExtensiveCropRotations ;
    skos:definition "Including crops from different plant families or with distinct rooting and disease relationships to interrupt intensive cropping sequences."@en,
        "Het opnemen van gewassen uit andere plantenfamilies of met afwijkende beworteling en ziektegevoeligheid om een intensieve teeltvolgorde te onderbreken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Use break crops"@en,
        "Rustgewassen telen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9287093_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Hugh Venables (controleer licentie op Commons)."@nl .

vocab:UseLocalInputs a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Sheep_under_solar_panels_(1)_2025-07-26.jpg> ;
    skos:broader vocab:ReduceExternalInputs ;
    skos:definition "Prioritising materials, feed, seeds or other production inputs sourced on the farm or within the local region to shorten supply chains."@en,
        "Het voorrang geven aan materialen, voer, zaden of andere productiemiddelen van het eigen bedrijf of uit de regio om aanvoerketens te verkorten."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Use local inputs"@en,
        "Lokale inputs gebruiken"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Sheep_under_solar_panels_(1)_2025-07-26.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9299660_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Andy Li (CC0 1.0)."@nl .

vocab:UseOfBokashi a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:UseOfSpecificFertilizerTypesOrManure ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Applying fermented organic material prepared under relatively low-oxygen conditions as a soil input, distinct from fully matured aerobic compost."@en,
        "Het toepassen van onder relatief zuurstofarme omstandigheden gefermenteerd organisch materiaal als bodeminvoer, anders dan volledig uitgerijpte aerobe compost."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Use of bokashi"@en,
        "Bokashi toepassen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9286755_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Use of bokashi'."@en,
        "Het begruik van gefermenteerd organisch materiaal als meststof"@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:UseOfControlledReleaseOrOtherMitigatedFertilizersEnhancedEfficienyFertilizersReduceArtificialNFertilizersFoliarApplication a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:ReduceSyntheticFertilizers ;
    skos:definition "Using controlled-release or enhanced-efficiency fertilisers and targeted application methods to improve nutrient availability over time and reduce avoidable losses."@en,
        "Het gebruiken van gecontroleerd vrijkomende of efficiëntere meststoffen en gerichte toedieningsmethoden om nutriënten over de tijd beter beschikbaar te stellen en verliezen te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "Use of controlled release or other mitigated fertilizers/ enhanced efficieny fertilizers, Reduce artificial N fertilizers, Foliar application"@en,
        "Gecontroleerd vrijkomende en efficiëntere meststoffen gebruiken"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9287269_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:UseOfResidualMaterials a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Wood_chips_from_encroacher_bush_ready_for_industrial_use.jpg> ;
    skos:broader vocab:ReduceExternalInputs ;
    skos:definition "Using agricultural by-products or residual biomass as useful inputs for feed, bedding, fertilisation, materials or energy instead of discarding them."@en,
        "Het benutten van agrarische bijproducten of resterende biomassa als voer, strooisel, meststof, materiaal of energiebron in plaats van ze af te voeren."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Use of residual materials"@en,
