{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NonChemicalControlWeedsPestsAndDiseases",
  "type": "Concept",
  "prefLabel": {
    "nl": "Niet-chemische beheersing van onkruid, plagen en ziekten",
    "en": "Non-chemical  control- weeds, pests and diseases"
  },
  "altLabel": {
    "en": [
      "Non-chemical control- weeds, pests and diseases"
    ]
  },
  "definition": {
    "nl": "Het beheersen van onkruid, plagen en gewasziekten met mechanische, fysieke, biologische of teeltkundige methoden in plaats van chemische middelen.",
    "en": "Controlling weeds, pests and crop diseases with mechanical, physical, biological or cultural methods instead of chemical pesticides."
  },
  "changeNote": {
    "nl": [
      "Definitie en overgenomen uit ReGeNL practice_list_0.2.1, kolom: English scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."
    ]
  },
  "editorialNote": {
    "en": [
      "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."
    ]
  },
  "historyNote": {
    "nl": [
      "Voorgaande PoC-definitie (en): A ClassificationElement in the RegenerativePracticeFramework at Meso level with label 'Non-chemical control- weeds, pests and diseases'.",
      "Voorgaande PoC-definitie (en): integrated pest management means careful consideration of all available plant protection methods and subsequent integration of appropriate measures that discourage the development of populations of harmful organisms and keep the use of plant protection products and other forms of intervention to levels that are economically and ecologically justified and reduce or minimise risks to human health and the environment"
    ]
  },
  "notation": [
    "Meso"
  ],
