{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WaterStorage",
  "type": "Concept",
  "prefLabel": {
    "en": "Water storage",
    "nl": "Wateropslag"
  },
  "definition": {
    "en": "A classification entry in the ReGeNL regenerative practice framework referring to water storage. The precise scope and operational criteria have not yet been validated.",
    "nl": "Classificatieonderdeel binnen het ReGeNL-raamwerk voor regeneratieve landbouwpraktijken dat betrekking heeft op wateropslag. De precieze afbakening en eventuele toepassingscriteria moeten nog door domeinexperts worden vastgesteld."
  },
  "editorialNote": {
    "nl": [
      "Nederlandstalig label en omschrijving zijn voorstellen voor de PoC en zijn nog niet gevalideerd door de harmonisatietaakgroep."
    ]
  },
  "notation": [
    "Meso"
  ],
