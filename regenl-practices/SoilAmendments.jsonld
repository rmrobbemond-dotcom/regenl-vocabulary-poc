{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SoilAmendments",
  "type": "Concept",
  "prefLabel": {
    "en": "Soil amendments",
    "nl": "Bodemverbeteraars"
  },
  "definition": {
    "en": "A ClassificationElement in the RegenerativePracticeFramework at Meso level with label 'Soil amendments'.",
    "nl": "Classificatieonderdeel binnen het ReGeNL-raamwerk voor regeneratieve landbouwpraktijken dat betrekking heeft op bodemverbeteraars. De precieze afbakening en eventuele toepassingscriteria moeten nog door domeinexperts worden vastgesteld."
  },
  "editorialNote": {
    "en": [
      "The existing English definition is generic or insufficiently specified and requires expert review."
    ],
    "nl": [
      "Nederlandstalig label en omschrijving zijn voorstellen voor de PoC en zijn nog niet gevalideerd door de harmonisatietaakgroep."
    ]
  },
  "notation": [
    "Meso"
  ],
