practice:R1-0028 a skos:Concept ;
    dcterms:identifier "PRACTICE_R1_0028" ;
    skos:broader practice:meso-55ab0520b8c7ba93 ;
    skos:changeNote "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; nieuwe afbeelding nodig."@nl ;
    skos:definition "The deliberate exposure of unwanted plants to heat, for example through flames, hot water, steam or infrared radiation, to damage plant tissue and thereby suppress weed growth or survival."@en,
