{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReductionLimitationOfSpecificFertilizers",
  "type": "Concept",
  "prefLabel": {
    "nl": "Specifieke meststoffen verminderen of beperken",
    "en": "Reduction/ limitation of specific  fertilizers"
  },
  "definition": {
    "nl": "Het verminderen of begrenzen van aangewezen meststoffen of nutriënten in plaats van dezelfde beperking op alle meststoftypen toe te passen.",
    "en": "Reducing or limiting designated fertiliser products or nutrients rather than imposing the same restriction on all fertiliser types."
  },
  "changeNote": {
    "nl": [
      "Definitie en overgenomen uit ReGeNL practice_list_0.2.1, kolom: English scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."
    ]
  },
  "editorialNote": {
    "en": [
      "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."
    ]
  },
  "historyNote": {
    "nl": [
      "Voorgaande PoC-definitie (en): quantity or time limitation of application",
      "Voorgaande PoC-definitie (en): A ClassificationElement in the RegenerativePracticeFramework at Meso level with label 'Reduction/ limitation of specific  fertilizers'."
    ]
  },
  "notation": [
    "Meso"
  ],
  "narrower": [
    {
