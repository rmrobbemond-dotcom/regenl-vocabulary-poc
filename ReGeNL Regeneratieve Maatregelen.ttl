    regenlmeta:photoCaptionStatus "visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows camping in a rural setting. It illustrates a recreational activity on or near a farm as an aspect of the practice “Agrotourism”."@en,
        "De foto toont kamperen in een landelijke omgeving. Zo wordt een recreatieve nevenactiviteit op of nabij een landbouwbedrijf zichtbaar als onderdeel van de praktijk ‘Agritoerisme’."@nl ;
    schema:creditText "Foto: Wikimedia Commons, boerencamping / agritoerisme (controleer bron en licentie)." .

vocab:Bioeconomy a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg> ;
    skos:definition "Producing and using renewable biological resources, including crops, biomass and residues, for food, materials, energy or other products instead of relying solely on fossil resources."@en,
        "Het produceren en benutten van hernieuwbare biologische hulpbronnen, zoals gewassen, biomassa en reststromen, voor voedsel, materialen, energie of andere producten als alternatief voor fossiele grondstoffen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:BioeconomyEnergyEfficiencyAndProduction ;
    skos:notation "Mega" ;
    skos:prefLabel "Bioeconomy"@en,
        "Bio-economie"@nl ;
    skos:topConceptOf vocab: ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows oilseed radish grown as a green-manure crop. It illustrates the use of living ground cover in cropping as an aspect of the practice “Bioeconomy”."@en,
        "De foto toont bladrammenas als groenbemestend gewas op een akker. Zo wordt het gebruik van levende bodembedekking in de teelt zichtbaar als onderdeel van de praktijk ‘Bio-economie’."@nl ;
    schema:creditText "Foto: Wikimedia Commons, bladrammenas als groenbemester in Nederland." .

vocab:BuildingForEmissionReduction a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Dairy_farm_(P-062705-00-19).jpg> ;
    skos:broader vocab:AnimalHousing ;
    skos:definition "Constructing or modifying farm buildings to reduce releases of substances such as ammonia, methane, odour or particulate matter at their source."@en,
        "Het bouwen of aanpassen van agrarische gebouwen om uitstoot van bijvoorbeeld ammoniak, methaan, geur of fijnstof bij de bron te verminderen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:ImplementHousingSystemToSeperateManureAndUrineInSolidAndLiquidFractions ;
    skos:notation "Micro" ;
    skos:prefLabel "building for emission reduction"@en,
        "Gebouwen voor emissiereductie"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Dairy%20farm%20(P-062705-00-19).jpg?width=960> ;
