    regenlmeta:originalDefinition "training of youngstock improves immunity and grass intake"@en ;
    schema:creditText "Foto: Jeff Vanuga / USDA NRCS (publiek domein in de Verenigde Staten)."@nl .

vocab:GreenManureUse a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:UseOfSpecificFertilizerTypesOrManure ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Growing or incorporating a crop mainly to supply organic matter and sometimes nutrients to the soil rather than harvesting it as a marketable product."@en,
        "Het telen of inwerken van een gewas voornamelijk om organische stof en soms nutriënten aan de bodem toe te voegen, in plaats van het als hoofdproduct te oogsten."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Green manure use"@en,
        "Groenbemesting"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9815665_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Green manure use'."@en,
        "Het gebruik van Groenbemesting (green manure) als meststof"@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:Gypsum a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:SoilAmendments ;
    skos:definition "Applying calcium sulphate to soil as an amendment that supplies calcium and sulphur and can influence soil chemistry or structure under suitable conditions."@en,
        "Het toedienen van calciumsulfaat aan de bodem als bodemverbeteraar die calcium en zwavel levert en onder geschikte omstandigheden bodemchemie of structuur beïnvloedt."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "gypsum"@en,
        "Gips"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9290988_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'gypsum'."@en ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:HaveAMinimumRotationLengthOf6YearsFallow a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg> ;
    skos:broader vocab:ExtensiveCropRotations ;
    skos:definition "Using a crop rotation lasting at least six years before the starting crop recurs, potentially including a fallow or low-intensity phase."@en,
        "Het hanteren van een vruchtwisseling van minimaal zes jaar voordat het uitgangsgewas terugkeert, eventueel met een braak- of extensieve fase."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "have a minimum rotation length of 6 years/ fallow"@en,
        "Vruchtwisseling van minimaal zes jaar of braaklegging"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9295133_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Hugh Venables (controleer licentie op Commons)."@nl .

vocab:HolisticGrazing a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg> ;
    skos:broader vocab:GrazingSystem ;
    skos:definition "Adaptive planned grazing that adjusts herd movements, grazing intensity and recovery periods in response to ecological and livestock conditions."@en,
        "Adaptief geplande beweiding waarbij verplaatsingen van vee, graasdruk en herstelperiodes worden aangepast aan de toestand van vegetatie, bodem en dieren."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Holistic grazing"@en,
        "Holistisch beweiden"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9285405_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "similar to rotational grazing but differs in that it more explicitly recognizes and provides a framework for adapting to the four basic ecosystem processes by increasing the recovery time"@en,
        "Een adaptieve vorm van beweidingsbeheer waarin graasdruk en herstelperioden worden afgestemd op de toestand van vegetatie, bodem en ecosysteemprocessen."@nl ;
    schema:creditText "Foto: Jeff Vanuga / USDA NRCS (publiek domein in de Verenigde Staten)."@nl .

vocab:HugelkulturRaisedBeds a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilSeedbedPreparation ;
    skos:definition "Building raised planting beds with woody material and organic matter, allowing decomposition and gradual release of moisture and nutrients."@en,
        "Het aanleggen van verhoogde teeltbedden met houtachtig materiaal en organische stof die geleidelijk verteren en vocht en nutriënten kunnen vasthouden of vrijgeven."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Hügelkultur/ raised beds"@en,
        "Hügelkultur en verhoogde teeltbedden"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9283046_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:HumanureComposting a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:UseOfSpecificFertilizerTypesOrManure ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Treating human excreta through controlled composting to stabilise organic material and reduce pathogens before any permitted use; strict hygiene and legal requirements apply."@en,
        "Het onder gecontroleerde omstandigheden composteren van menselijke uitwerpselen om organisch materiaal te stabiliseren en ziekteverwekkers te verminderen; strenge hygiëne- en wettelijke eisen gelden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Humanure composting"@en,
        "Compostering van menselijke uitwerpselen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9300754_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Humanure composting'."@en,
        "Het gebruik van Humane mest compostering als meststof"@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:ImplementHousingSystemToSeperateManureAndUrineInSolidAndLiquidFractions a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Dairy_farm_(P-062705-00-19).jpg> ;
    skos:broader vocab:BuildingForEmissionReduction ;
    skos:definition "Using housing floors or manure collection systems that separate faeces and urine soon after excretion to enable different treatment and reduce some emissions."@en,
        "Het toepassen van stalvloeren of opvangsystemen die feces en urine kort na uitscheiding scheiden zodat beide fracties afzonderlijk kunnen worden behandeld en bepaalde emissies worden beperkt."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "Implement housing system to seperate manure and urine in solid and liquid fractions"@en,
        "Huisvestingssysteem voor scheiding van mest en urine"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Dairy%20farm%20(P-062705-00-19).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9300754_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Europese Commissie, audiovisuele dienst / Lukasz Kobus, Yügen (CC BY 4.0)."@nl .

vocab:IncomeBroadeningMicro a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:FarmersMarket.jpg> ;
    skos:broader vocab:IncomeBroadeningMeso ;
    skos:definition "Introducing concrete supplementary income activities, such as tourism, education, processing or paid services, alongside existing farm production."@en,
        "Het toevoegen van concrete neveninkomsten, zoals toerisme, educatie, verwerking of betaalde diensten, naast de bestaande agrarische productie."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Income broadening"@en,
        "Inkomensverbreding"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/FarmersMarket.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9813543_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Wikimedia Commons, boerenmarkt / afzet (controleer bron en licentie)." .

vocab:IncorperatingCropResidues a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:UseOfSpecificFertilizerTypesOrManure ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Mixing harvested crop residues such as straw, stems or leaves into the soil for decomposition and return of organic matter and nutrients."@en,
        "Het inwerken van oogstresten, zoals stro, stengels en bladeren, in de bodem zodat ze afbreken en organische stof en nutriënten terugleveren."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Incorperating crop residues"@en,
        "Inwerken van gewasresten"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9815665_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Incorperating crop residues'."@en,
        "Het gebruik van Gewasresten onder-/inwerken als meststof"@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:InfiltrationChannels a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Drip_irrigation.jpg> ;
    skos:broader vocab:WaterStorage ;
    skos:definition "Constructing shallow channels or trenches that direct and retain runoff so that water can infiltrate into the soil instead of flowing away rapidly."@en,
        "Het aanleggen van ondiepe geulen of sleuven die afstromend water opvangen en geleiden zodat het in de bodem kan infiltreren in plaats van snel af te voeren."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Infiltration channels"@en,
        "Infiltratiegeulen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Drip_irrigation.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9295758_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: USDA (public domain, U.S. federal government)."@nl .

vocab:InputReductionOfEGAgrochemicalsAndFeed a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg> ;
    skos:broader vocab:IndividualAndCollectiveFormsOfCostReducingMeasures ;
    skos:definition "Lowering the quantity or dependency on purchased external inputs, such as agrochemicals and feed, while managing production and animal needs."@en,
        "Het verminderen van hoeveelheden of afhankelijkheid van ingekochte inputs, zoals gewasbeschermingsmiddelen en voer, met behoud van aandacht voor productie- en dierbehoeften."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Input reduction of e.g. agrochemicals and feed"@en,
        "Vermindering van externe inputs zoals gewasbeschermingsmiddelen en voer"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9293516_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Jeff Vanuga / USDA NRCS (publiek domein in de Verenigde Staten)."@nl .

vocab:InsectHotels a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Insect_hotel.jpg> ;
    skos:broader vocab:HabitatProvisionBiodiversityEnhancement ;
    skos:definition "Installing structures with cavities or nesting materials that provide shelter or nesting sites for certain solitary bees and other beneficial insects."@en,
        "Het plaatsen van constructies met holtes of nestmateriaal als schuil- of nestgelegenheid voor bepaalde solitaire bijen en andere nuttige insecten."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Insect hotels"@en,
        "Insectenhotels"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Insect_hotel.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9297468_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Alexandre Dulaunoy (CC BY-SA 2.0)."@nl .

vocab:IntegratedPestManagementPrinciplesIPM a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg> ;
    skos:broader vocab:NonChemicalControlWeedsPestsAndDiseases ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Preventing and managing pests through monitoring, thresholds, resistant varieties and biological or non-chemical methods, using pesticides only when justified."@en,
        "Het voorkomen en beheersen van plagen via monitoring, schadedrempels, resistente rassen en biologische of niet-chemische methoden, met chemische middelen alleen wanneer gerechtvaardigd."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Integrated pest management principles (IPM)"@en,
        "Principes van geïntegreerde gewasbescherming (IPM)"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9290970_2 ;
    regenlmeta:definitionReference <https://www.fao.org/pest-and-pesticide-management/ipm/integrated-pest-management/en/> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Integrated pest management principles (IPM)'."@en,
        "Geintegreerd gebruik van bestrijdingsmethoden, waarbij biologische, mechanische en andere niet synthetische methoden de voorkeur hebben. Synthetische middelen worden alleen gebruikt als het niet anders kan."@nl ;
    schema:creditText "Foto: Henk Monster / Anefo / Wikimedia Commons (controleer bron en licentie)." .

vocab:IntegratedWeedManagement a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg> ;
    skos:broader vocab:NonChemicalControlWeedsPestsAndDiseases ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Combining preventive, cultural, mechanical and where necessary chemical approaches to manage weeds while reducing reliance on any single method."@en,
        "Het combineren van preventieve, teeltkundige, mechanische en zo nodig chemische maatregelen tegen onkruid om afhankelijkheid van één aanpak te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Integrated weed management"@en,
        "Geïntegreerd onkruidbeheer"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9285430_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Integrated weed management'."@en,
        "Geintegreerd gebruik van onkruidbestrijdingsmethoden, waarbij biologische, mechanische en andere niet synthetische methoden de voorkeur hebben. Synthetische herbiciden worden alleen gebruikt als het niet anders kan."@nl ;
    schema:creditText "Foto: Henk Monster / Anefo / Wikimedia Commons (controleer bron en licentie)." .

vocab:KeepLivingRoots a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilSeedbedPreparation ;
    skos:definition "Maintaining living plant roots in the soil for as much of the year as practical through perennial crops, cover crops or overlapping growing periods."@en,
        "Het zo lang mogelijk gedurende het jaar behouden van levende plantenwortels in de bodem via meerjarige gewassen, bodembedekkers of overlappende teeltperioden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Keep living roots"@en,
        "Levende wortels in de bodem behouden"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_10589287_2 ;
    regenlimg:proposedForPublication regenlimg:wur-54418_418941_10589287_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:KeepWaterLevelsHighMicro a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Drip_irrigation.jpg> ;
    skos:broader vocab:KeepWaterLevelsHighMeso ;
    skos:definition "Maintaining an agreed elevated surface-water or groundwater level through adjustable drains, weirs or water-control structures."@en,
        "Het handhaven van een afgesproken hogere oppervlaktewater- of grondwaterstand met regelbare drainage, stuwen of andere waterregelvoorzieningen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "keep water levels high"@en,
        "Hoge waterstanden handhaven"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Drip_irrigation.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9833703_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: USDA (public domain, U.S. federal government)."@nl .

vocab:LegumesNFixingPlantsInOration a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg> ;
    skos:broader vocab:ExtensiveCropRotations ;
    skos:definition "Including legumes or other nitrogen-fixing plants in crop rotations to introduce biologically fixed nitrogen and diversify cropping sequences."@en,
        "Het opnemen van vlinderbloemigen of andere stikstofbindende planten in de vruchtwisseling om biologisch gebonden stikstof aan te voeren en teelten te variëren."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Legumes (N-fixing plants) in oration"@en,
        "Vlinderbloemigen en stikstofbindende gewassen in de rotatie"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9287214_2 ;
