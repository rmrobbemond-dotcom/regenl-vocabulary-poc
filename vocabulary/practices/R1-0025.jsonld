{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/R1-0025",
  "type": "Concept",
  "prefLabel": {
    "nl": "Mulchen met anorganisch materiaal",
    "en": "Mulching with an inorganic material"
  },
  "definition": {
    "nl": "Het bedekken van het bodemoppervlak met anorganisch materiaal, zoals steen, grind, plastic folie of ander niet-organisch afdekmateriaal, om de kieming, opkomst of groei van ongewenste planten te beperken door lichtonderschepping en fysieke afscherming.",
    "en": "Covering the soil surface with inorganic material, such as stone, gravel, plastic film or other non-organic covering material, to suppress the germination, emergence or growth of unwanted plants through light interception and physical exclusion."
  },
  "changeNote": {
    "nl": [
      "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; nieuwe afbeelding nodig."
    ]
  },
  "notation": [
    "Micro"
  ],
  "broader": {
    "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/meso-55ab0520b8c7ba93",
    "prefLabel": {
      "nl": "Fysiek of mechanisch onkruidbeheer",
      "en": "Non-chemical weed management - physical/mechanical controls"
    }
  },
