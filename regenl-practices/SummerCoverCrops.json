{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SummerCoverCrops",
  "type": "Concept",
  "prefLabel": {
    "nl": "Zomerse bodembedekkers",
    "en": "Summer cover crops"
  },
  "definition": {
    "nl": "Het in de zomer telen van bodembedekkers, meestal tussen hoofdteelten of na vroege oogst, om bodem te beschermen en beschikbare nutriënten op te nemen.",
    "en": "Growing cover crops during the summer period, usually between main crops or after early harvest, to protect soil and take up available nutrients."
  },
  "changeNote": {
    "nl": [
      "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."
    ]
  },
  "editorialNote": {
    "en": [
      "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."
    ]
  },
  "historyNote": {
    "nl": [
      "Voorgaande PoC-definitie (nl): Groenbedekkers die in de zomer worden geteeld om de bodem met vegetatie bedekt te houden."
    ]
  },
  "notation": [
    "Micro"
  ],
  "broader": {
