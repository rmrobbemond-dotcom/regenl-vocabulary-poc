{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/meso-4822a6224e47d217",
  "type": "Concept",
  "prefLabel": {
    "nl": "Dierhuisvesting",
    "en": "Animal housing"
  },
  "definition": {
    "nl": "Het ontwerpen en beheren van stallen en schuilvoorzieningen voor landbouwhuisdieren, waaronder ruimte, stalklimaat, strooisel en toegang, met aandacht voor welzijn en emissies.",
    "en": "Designing and managing buildings and shelters for farm animals, including their space, climate, bedding and access, with attention to welfare and emissions."
  },
  "notation": [
    "Meso"
  ],
  "narrower": [
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/R1-0143",
