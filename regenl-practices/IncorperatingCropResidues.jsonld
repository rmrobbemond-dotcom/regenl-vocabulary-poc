{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/IncorperatingCropResidues",
  "type": "Concept",
  "prefLabel": {
    "nl": "Inwerken van gewasresten",
    "en": "Incorperating crop residues"
  },
  "definition": {
    "nl": "Het inwerken van oogstresten, zoals stro, stengels en bladeren, in de bodem zodat ze afbreken en organische stof en nutriënten terugleveren.",
    "en": "Mixing harvested crop residues such as straw, stems or leaves into the soil for decomposition and return of organic matter and nutrients."
  },
  "changeNote": {
    "nl": [
      "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."
    ]
  },
  "editorialNote": {
    "en": [
      "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."
    ]
  },
  "notation": [
    "Micro"
  ],
  "broader": {
    "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/UseOfSpecificFertilizerTypesOrManure",
    "prefLabel": {
      "nl": "Specifieke meststoffen of mesttypen gebruiken",
      "en": "use of specific fertilizer types or manure"
    }
  },
  "inScheme": [
