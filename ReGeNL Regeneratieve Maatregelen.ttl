vocab:SinusMowingMosaikMowing a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Mowing_the_Meadow_-_geograph.org.uk_-_1361509.jpg> ;
    skos:broader vocab:DiversificationOfMowingActivitiesOnFieldAndFarmScale ;
    skos:definition "Mowing in curved strips or in a spatial mosaic at different times, retaining uncut patches that provide shelter and flowering resources for wildlife."@en,
        "Het maaien in slingerende banen of ruimtelijke mozaïeken op verschillende momenten, waarbij ongemaaide delen beschutting en bloeiaanbod voor fauna behouden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "sinus mowing, mosaik mowing,"@en,
        "Sinusmaaien en mozaïekmaaien"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Mowing%20the%20Meadow%20-%20geograph.org.uk%20-%201361509.jpg?width=960> ;
