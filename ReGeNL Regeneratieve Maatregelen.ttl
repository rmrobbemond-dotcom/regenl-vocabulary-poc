    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Seedbed_preparation_with_corvids_Essonne_20230518.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "the practice of applying a layer of organic or inorganic material, to the surface of the soil"@en ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "Equipment is working the field before sowing. The photograph illustrates a step in preparing a suitable seedbed."@en,
        "Een werktuig bewerkt het perceel voor het zaaien. De foto laat een stap in het voorbereiden van een geschikt zaaibed zien."@nl .

vocab:CropDiversificationIntercroppingPolycultureNoMonocultureCompanionPlanting a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Intercropping_maize_and_beans.jpg> ;
    skos:broader vocab:CropManagament ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch meso. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Growing multiple crop species together or in close association on the same land instead of relying solely on single-species stands."@en,
        "Het gelijktijdig of in nauwe samenhang telen van meerdere gewassoorten op dezelfde grond in plaats van uitsluitend eenvormige monoculturen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (nl): Het gedurende een overlappende groeiperiode gelijktijdig telen van meerdere gewassen op hetzelfde perceel."@nl ;
    skos:inScheme vocab: ;
    skos:narrower vocab:MixedIntercroppingMixedCropping,
        vocab:RelayIntercropping,
        vocab:RowIntercropping,
        vocab:Silvoarable,
        vocab:StripCropping,
        vocab:UnderSowing ;
    skos:notation "Meso" ;
    skos:prefLabel "Crop diversification - Intercropping/ polyculture / no monoculture / companion planting"@en,
        "Gewasdiversificatie met mengteelt, polycultuur en combinatieteelt"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Intercropping_maize_and_beans.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "Intercropping consists of growing several crops (annual or perennial) simultaneously in the same field for a significant amount of time, each crop developing and growing according to its physiology."@en,
        "Meerdere gewassen (eenjarig of meerjarig) staat gelijktijdig op hetzelfde perceel gedurende een aanzienlijke periode, waarbij elk gewas zich ontwikkelt volgens zijn eigen fysiologie"@nl ;
    regenlmeta:photoCaptionStatus "description-review-needed" ;
    regenlmeta:photoPracticeDescription "Maize and beans grow together in the same field. The photograph shows how different crops can be grown simultaneously on the same agricultural land."@en,
        "Maïs en bonen groeien samen op hetzelfde perceel. De foto laat zien hoe verschillende gewassen gelijktijdig op één stuk landbouwgrond kunnen worden geteeld."@nl ;
    schema:creditText "Foto: AnnaJB (CC BY-SA 4.0)."@nl .

