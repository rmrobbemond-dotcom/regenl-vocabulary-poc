    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Liming'."@en ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:LimitationOfSpecificFertilizers a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:FertilizationAndManureManagement ;
    skos:changeNote "Definitie en overgenomen uit ReGeNL practice_list_0.2.1, kolom: English scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Restricting the use of designated fertiliser types or compositions, such as particular mineral inputs, under a defined farm management rule."@en,
        "Het beperken van het gebruik van bepaalde soorten of samenstellingen meststoffen, bijvoorbeeld specifieke minerale producten, volgens een afgesproken beheerregel."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (en): A ClassificationElement in the RegenerativePracticeFramework at Meso level with label 'Limitation of specific fertilizers'."@nl,
        "Voorgaande PoC-definitie (en): this class includes the practices where there are limitations in the use of fertilisers on the whole field (excluding partial spatial limitations such as  landscape features, buffer strips...)"@nl ;
    skos:inScheme vocab: ;
    skos:narrower vocab:NoSyntheticFertilizerUse ;
    skos:notation "Meso" ;
    skos:prefLabel "Limitation of specific fertilizers"@en,
        "Beperking van specifieke meststoffen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9289815_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "this class includes the practices where there are limitations in the use of fertilisers on the whole field (excluding partial spatial limitations such as  landscape features, buffer strips...)"@en,
        "Het beperken van het gebruik van bepaalde meststoffen op een perceel, bijvoorbeeld door typen of hoeveelheden toe te laten of uit te sluiten."@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

