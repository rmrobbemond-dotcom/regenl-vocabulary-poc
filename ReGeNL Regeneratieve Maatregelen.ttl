    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Europese Commissie, audiovisuele dienst (CC BY 4.0)."@nl .

vocab:RainfedSystem a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Drip_irrigation.jpg> ;
    skos:broader vocab:WaterStorage ;
    skos:definition "A crop production system supplied primarily by natural rainfall rather than regular irrigation, with management adapted to local rainfall patterns."@en,
        "Een teeltsysteem dat vooral afhankelijk is van natuurlijke neerslag in plaats van reguliere irrigatie, met beheer afgestemd op het lokale neerslagpatroon."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Rainfed system"@en,
        "Regenafhankelijk teeltsysteem"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Drip_irrigation.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9290026_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: USDA (public domain, U.S. federal government)."@nl .

vocab:ReduceDependencyOnFossilFuel a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Sheep_under_solar_panels_(1)_2025-07-26.jpg> ;
    skos:broader vocab:RenewableEnergy ;
    skos:definition "Reducing the farm's reliance on diesel, natural gas and other fossil energy through efficiency, electrification or renewable alternatives."@en,
        "Het verminderen van de afhankelijkheid van diesel, aardgas en andere fossiele energie door efficiëntie, elektrificatie of hernieuwbare alternatieven."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Reduce dependency on fossil fuel"@en,
        "Afhankelijkheid van fossiele brandstoffen verminderen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Sheep_under_solar_panels_(1)_2025-07-26.jpg?width=960> ;
