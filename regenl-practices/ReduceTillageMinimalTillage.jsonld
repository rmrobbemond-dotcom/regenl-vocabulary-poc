{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceTillageMinimalTillage",
  "type": "Concept",
  "prefLabel": {
    "en": "Reduce tillage/ minimal tillage",
    "nl": "Grondbewerking verminderen of minimaliseren"
  },
  "definition": {
    "en": "minimize soil disturbance due to tillage",
    "nl": "Het beperken van de intensiteit of frequentie van bodembewerking om verstoring van de bodem te verminderen."
  },
  "editorialNote": {
    "nl": [
      "Nederlandse vertaling is een redactioneel voorstel op basis van de bestaande Engelstalige bron en moet nog worden gevalideerd."
    ]
  },
  "notation": [
    "Meso"
  ],
  "narrower": [
    {
