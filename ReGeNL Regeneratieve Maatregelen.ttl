practice:R1-0007 a skos:Concept ;
    dcterms:identifier "PRACTICE_R1_0007" ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Ladybird_and_aphids.JPG> ;
    skos:broader practice:meso-93b8e2c13f947eb5 ;
    skos:changeNote "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; afbeelding kandidaat 1 overgenomen, visuele controle en licentiecontrole nog nodig."@nl ;
    skos:definition "The use or targeted promotion of predatory insects to regulate populations of agricultural crop pests through predation."@en,
        "Het inzetten of gericht stimuleren van predatoire insecten om populaties van schadelijke organismen in landbouwgewassen door predatie te beheersen."@nl ;
    skos:inScheme practice:scheme ;
    skos:notation "Micro" ;
    skos:prefLabel "Natural pest management - use of predatory beneficial insects such as ladybirds."@en,
        "Natuurlijke bestrijding van plagen – gebruik van roofinsecten zoals lieveheersbeestjes."@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Ladybird_and_aphids.JPG?width=960> ;
    regenlmeta:classificationLevel "Micro" ;
    regenlmeta:definitionStatus "user-reviewed" ;
    regenlmeta:farmerContentSource "Geplakte tekst(20261124-142404).txt" ;
    regenlmeta:farmerDescription "Using natural enemies, such as ladybirds, to control harmful insects in crops."@en,
        "Het inzetten van natuurlijke vijanden, zoals lieveheersbeestjes, om schadelijke insecten in gewassen te bestrijden."@nl ;
    regenlmeta:farmerDescriptionStatus "user-reviewed" ;
    regenlmeta:farmerLabel "Use beneficial predatory insects to control pests"@en,
        "Nuttige roofinsecten inzetten tegen plagen"@nl ;
    regenlmeta:farmerTopic "Pests and diseases"@en,
        "Ziekten en plagen"@nl ;
    regenlmeta:originalPracticeIdentifier "PRACTICE_R1_0007" ;
    regenlmeta:originalPracticeLabel "Natural pest management - use of predatory beneficial insects such as ladybirds."@en,
        "Natuurlijke bestrijding van plagen – gebruik van roofinsecten zoals lieveheersbeestjes."@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "A ladybird or its larva feeds on aphids. The photograph illustrates how predatory insects can contribute to the natural regulation of crop pests."@en,
        "Een lieveheersbeestje of de larve ervan voedt zich met bladluizen. De afbeelding illustreert hoe roofinsecten kunnen bijdragen aan de natuurlijke beheersing van gewasplagen."@nl ;
