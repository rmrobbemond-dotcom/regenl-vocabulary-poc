{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CropDiversificationIntercroppingPolycultureNoMonocultureCompanionPlanting",
  "type": "Concept",
  "prefLabel": {
    "nl": "Gewasdiversificatie met mengteelt, polycultuur en combinatieteelt",
    "en": "Crop diversification - Intercropping/ polyculture / no monoculture / companion planting"
  },
  "definition": {
    "nl": "Meerdere gewassen (eenjarig of meerjarig) staat gelijktijdig op hetzelfde perceel gedurende een aanzienlijke periode, waarbij elk gewas zich ontwikkelt volgens zijn eigen fysiologie",
    "en": "Intercropping consists of growing several crops (annual or perennial) simultaneously in the same field for a significant amount of time, each crop developing and growing according to its physiology."
  },
  "changeNote": {
    "nl": [
      "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch meso. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."
    ]
  },
  "editorialNote": {
    "nl": [
      "Nederlandse vertaling is een redactioneel voorstel op basis van de bestaande Engelstalige bron en moet nog worden gevalideerd."
    ]
  },
  "historyNote": {
    "nl": [
      "Voorgaande PoC-definitie (nl): Het gedurende een overlappende groeiperiode gelijktijdig telen van meerdere gewassen op hetzelfde perceel."
    ]
  },
