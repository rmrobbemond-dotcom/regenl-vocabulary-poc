practice:R1-0001 a skos:Concept ;
    dcterms:identifier "PRACTICE_R1_0001" ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:14-spotted_Ladybird_larva_eating_an_aphid_(16475286350).jpg> ;
    skos:broader practice:meso-2a4f6215769a1b7b ;
    skos:changeNote "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; afbeeldingslicentie nog te controleren."@nl ;
    skos:definition "Reducing the frequency or quantity of applications of insecticides that are not permitted under organic farming regulations."@en,
        "Het verminderen van de frequentie of hoeveelheid van toepassingen van insecticiden die niet zijn toegestaan binnen de biologische landbouw."@nl ;
    skos:editorialNote "Not really a practice. Needs to be replaced by other practices"@en ;
    skos:inScheme practice:scheme ;
    skos:notation "Micro" ;
    skos:prefLabel "Reduction in use of chemical products (insecticides) not allowed by organic regulations"@en,
        "Vermindering van het gebruik van chemische producten (insecticiden) die volgens de biologische regelgeving niet zijn toegestaan"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/14-spotted_Ladybird_larva_eating_an_aphid_(16475286350).jpg?width=960> ;
    regenlmeta:classificationLevel "Micro" ;
    regenlmeta:definitionStatus "user-reviewed" ;
    regenlmeta:farmerContentSource "Geplakte tekst(20261124-142404).txt" ;
    regenlmeta:farmerDescription "Using fewer insect control products that are not permitted in organic farming."@en,
        "Het verminderen van het gebruik van insectenbestrijdingsmiddelen die niet zijn toegestaan in de biologische landbouw."@nl ;
    regenlmeta:farmerDescriptionStatus "user-reviewed" ;
    regenlmeta:farmerLabel "Reduce the use of insecticides not permitted in organic farming"@en,
        "Minder niet-biologisch toegestane insecticiden gebruiken"@nl ;
    regenlmeta:farmerTopic "Pests and diseases"@en,
        "Ziekten en plagen"@nl ;
    regenlmeta:originalPracticeIdentifier "PRACTICE_R1_0001" ;
    regenlmeta:originalPracticeLabel "Reduction in use of chemical products (insecticides) not allowed by organic regulations"@en,
        "Vermindering van het gebruik van chemische producten (insecticiden) die volgens de biologische regelgeving niet zijn toegestaan"@nl ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "A ladybird or its larva feeds on aphids. The photograph illustrates natural pest control as an alternative to insecticide application."@en,
        "Een lieveheersbeestje of de larve ervan voedt zich met bladluizen. Zo is natuurlijke plaagbeheersing als alternatief voor insecticidetoepassing in beeld gebracht."@nl ;
