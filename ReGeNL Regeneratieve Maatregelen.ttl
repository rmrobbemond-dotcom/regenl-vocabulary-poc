        "Inkomensverdieping door hogere productwaarde"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Kaasbereiding_op_een_boerderij_in_Broek_in_Waterland%2C_Bestanddeelnr_189-0352.jpg?width=960> ;
