    skos:notation "Meso" ;
    skos:prefLabel "Crop diversification - Intercropping/ polyculture / no monoculture / companion planting"@en,
        "Gewasdiversificatie met mengteelt, polycultuur en combinatieteelt"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Intercropping_maize_and_beans.jpg?width=960> ;
