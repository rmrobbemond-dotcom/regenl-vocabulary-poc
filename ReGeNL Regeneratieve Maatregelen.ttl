    skos:broader vocab:UseOfSpecificFertilizerTypesOrManure ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Using chipped woody biomass on the farm, for example as mulch, bedding or soil-cover material, with effects depending on material and application."@en,
        "Het gebruiken van versnipperd hout op het bedrijf, bijvoorbeeld als mulch, strooisel of bodembedekking, waarbij effecten afhangen van materiaal en toepassing."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Wood chips"@en,
        "Houtsnippers"@nl ;
