vocab:NonChemicalControlWeedsPestsAndDiseases a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg> ;
    skos:altLabel "Non-chemical control- weeds, pests and diseases"@en ;
