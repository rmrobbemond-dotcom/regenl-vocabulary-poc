    regenlmeta:farmerContentSource "Geplakte tekst(20261124-142404).txt" ;
    regenlmeta:farmerDescription "Controlling weeds by damaging plants with a directed stream of abrasive material, such as sand or ground corn cobs."@en,
        "Het bestrijden van onkruid door planten te beschadigen met een gerichte straal schurend materiaal, zoals zand of vermalen maïskolven."@nl ;
    regenlmeta:farmerDescriptionStatus "user-reviewed" ;
