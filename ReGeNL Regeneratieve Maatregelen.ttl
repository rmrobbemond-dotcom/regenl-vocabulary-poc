practice:R1-0034 a skos:Concept ;
    dcterms:identifier "PRACTICE_R1_0034" ;
    skos:broader practice:meso-9f7398758c93bc3a ;
    skos:changeNote "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; formele benaming aangescherpt; nieuwe afbeelding nodig."@nl ;
    skos:definition "The deliberate reduction of spacing between plants or rows so that the crop more rapidly occupies available space, light and other resources, thereby limiting the establishment and growth of weeds."@en,
        "Het doelgericht verkleinen van de afstand tussen planten of rijen om de beschikbare ruimte, het licht en andere hulpbronnen sneller door het gewas te laten benutten, zodat de vestiging en groei van onkruid worden beperkt."@nl ;
    skos:inScheme practice:scheme ;
    skos:notation "Micro" ;
    skos:prefLabel "Narrow spacing"@en,
        "Kleinere plantafstand"@nl ;
    regenlmeta:classificationLevel "Micro" ;
    regenlmeta:definitionStatus "user-reviewed" ;
    regenlmeta:farmerContentSource "Geplakte tekst(20261124-142404).txt" ;
    regenlmeta:farmerDescription "Planting crops closer together so that weeds get less space and light."@en,
        "Het dichter op elkaar zetten van gewassen om de ruimte en het licht voor onkruid te beperken."@nl ;
    regenlmeta:farmerDescriptionStatus "user-reviewed" ;
    regenlmeta:farmerLabel "Use narrower plant spacing"@en,
        "Kleiner plantafstand gebruiken"@nl ;
    regenlmeta:farmerTopic "Weed management"@en,
        "Onkruidbeheer"@nl ;
    regenlmeta:originalPracticeIdentifier "PRACTICE_R1_0034" ;
    regenlmeta:originalPracticeLabel "Narrow spacing"@en,
