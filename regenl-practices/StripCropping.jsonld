{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/StripCropping",
  "type": "Concept",
  "prefLabel": {
    "nl": "Strokenteelt",
    "en": "Strip cropping"
  },
  "definition": {
    "nl": "Het telen van verschillende gewassen in naast elkaar liggende, relatief smalle stroken die breed genoeg zijn voor bewerking, vaak om diversiteit te vergroten en plaagverspreiding te beperken.",
    "en": "Growing different crops in adjacent, relatively narrow strips wide enough for field operations, often to increase diversity and reduce pest spread."
  },
  "changeNote": {
    "nl": [
      "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."
    ]
  },
  "editorialNote": {
    "en": [
      "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."
    ]
  },
  "historyNote": {
    "nl": [
      "Voorgaande PoC-definitie (nl): Het telen van twee of meer gewassen in afwisselende stroken, waarbij een strook meerdere gewasrijen kan omvatten."
    ]
  },
  "notation": [
    "Micro"
  ],
  "broader": {
    "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CropDiversificationIntercroppingPolycultureNoMonocultureCompanionPlanting",
    "prefLabel": {
      "nl": "Gewasdiversificatie met mengteelt, polycultuur en combinatieteelt",
      "en": "Crop diversification - Intercropping/ polyculture / no monoculture / companion planting"
    }
  },
  "inScheme": [
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/",
      "title": {
        "nl": "ReGeNL – regeneratieve landbouwpraktijken (PoC)",
        "en": "ReGeNL – regenerative practices (PoC)"
      }
    }
  ],
  "inSchemeAll": [
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/"
    }
