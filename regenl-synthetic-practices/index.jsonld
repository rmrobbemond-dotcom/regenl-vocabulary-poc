{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-synthetic-practices/","type":"ConceptScheme","title":{"en":"ReGeNL – synthetic farming practices (PoC)","nl":"ReGeNL – synthetische landbouwpraktijken (PoC)"},"description":{"nl":"Fictieve begrippen en indeling voor het testen van een begrippenbrowser. Niet vastgesteld door ReGeNL."},"hasTopConcept":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-synthetic-practices/soil-and-crops","prefLabel":{"en":"Soil and crops","nl":"Bodem en gewassen"},"definition":{"nl":"Verzamelcategorie voor praktijken rond bodem en gewassen in deze demonstratie."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-synthetic-practices/soil-management","prefLabel":{"en":"Soil management","nl":"Bodembeheer"},"definition":{"nl":"Demonstratiecategorie voor keuzes in het beheer van landbouwbodems."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-synthetic-practices/soil-cover","prefLabel":{"en":"Soil cover","nl":"Bodembedekking"},"definition":{"nl":"Demonstratiecategorie voor praktijken die de bodem gedurende een deel van het jaar bedekt houden."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-synthetic-practices/living-cover","prefLabel":{"en":"Living soil cover","nl":"Levende bodembedekking"},"definition":{"nl":"Bodembedekking met levende planten; gebruikt als demonstratiebegrip."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-synthetic-practices/cover-crop-between-seasons","prefLabel":{"en":"Cover crop between main crops","nl":"Vanggewas tussen teelten"},"altLabel":{"en":["Catch crop"],"nl":["Tussengewas"]},"definition":{"nl":"Voor deze demonstratie: een gewas dat in de periode tussen twee hoofdteelten wordt geteeld om de bodem bedekt te houden."},"example":{"nl":"Bijvoorbeeld een ingezaaid mengsel na de oogst van een hoofdgewas."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-synthetic-practices/mulching","prefLabel":{"en":"Mulching","nl":"Mulchen"},"altLabel":{"nl":["Bodem afdekken met organisch materiaal"]},"definition":{"nl":"Het aanbrengen of laten liggen van een laag materiaal op het bodemoppervlak."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-synthetic-practices/crop-diversity","prefLabel":{"en":"Crop diversity","nl":"Gewasdiversiteit"},"definition":{"nl":"Demonstratiecategorie voor variatie in geteelde gewassen."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-synthetic-practices/crop-rotation","prefLabel":{"en":"Crop rotation","nl":"Vruchtwisseling"},"definition":{"nl":"Het afwisselen van gewassen op hetzelfde perceel in opeenvolgende teeltperioden."}}]}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-synthetic-practices/landscape-and-nature","prefLabel":{"en":"Landscape and nature","nl":"Landschap en natuur"},"definition":{"nl":"Verzamelcategorie voor landschaps- en natuurgerichte praktijken in deze demonstratie."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-synthetic-practices/grassland-management","prefLabel":{"en":"Grassland management","nl":"Graslandbeheer"},"definition":{"nl":"Demonstratiecategorie voor praktijken in het beheer van grasland."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-synthetic-practices/species-rich-grassland","prefLabel":{"en":"Herb-rich grassland","nl":"Kruidenrijk grasland"},"altLabel":{"nl":["Kruidenrijk weiland"]},"definition":{"nl":"Voor deze demonstratie: grasland waarin naast grassen ook diverse kruidachtige plantensoorten voorkomen. Dit is geen officiële ReGeNL-afbakening of meetcriterium."},"example":{"nl":"Een perceel met verschillende grassen, klavers en andere kruiden."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-synthetic-practices/grassland-mowing","prefLabel":{"en":"Staggered mowing","nl":"Gefaseerd maaien"},"definition":{"nl":"Het maaien van verschillende delen van een grasland op verschillende momenten."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-synthetic-practices/field-boundaries","prefLabel":{"en":"Field margins","nl":"Perceelranden"},"definition":{"nl":"Demonstratiecategorie voor het beheer van stroken langs landbouwpercelen."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-synthetic-practices/flower-strip","prefLabel":{"en":"Flower strip","nl":"Bloemenstrook"},"definition":{"nl":"Een strook met bloeiende plantensoorten langs of binnen een landbouwperceel."}}]}]}],"@context":{"@version":1.1,"id":"@id","type":"@type","@vocab":"http://www.w3.org/2004/02/skos/core#","xsd":"http://www.w3.org/2001/XMLSchema#","dct":"http://purl.org/dc/terms/","dc":"http://purl.org/dc/elements/1.1/","schema":"https://schema.org/","vann":"http://purl.org/vocab/vann/","ldp":"http://www.w3.org/ns/ldp#","owl":"http://www.w3.org/2002/07/owl#","title":{"@id":"dct:title","@container":"@language"},"dc:title":{"@id":"dc:title","@container":"@language"},"dc:description":{"@id":"dc:description","@container":"@language"},"description":{"@id":"dct:description","@container":"@language"},"license":{"@id":"dct:license","@container":"@language"},"issued":{"@id":"dct:issued","@type":"xsd:date"},"created":{"@id":"dct:created","@type":"xsd:date"},"modified":{"@id":"dct:modified","@type":"xsd:date"},"creator":"dct:creator","publisher":"dct:publisher","preferredNamespacePrefix":"vann:preferredNamespacePrefix","preferredNamespaceUri":"vann:preferredNamespaceUri","isBasedOn":"schema:isBasedOn","source":"dct:source","prefLabel":{"@container":"@language"},"altLabel":{"@container":["@language","@set"]},"hiddenLabel":{"@container":["@language","@set"]},"definition":{"@container":"@language"},"note":{"@container":["@language","@set"]},"changeNote":{"@conta