{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/LimitationOfSpecificFertilizers",
  "type": "Concept",
  "prefLabel": {
    "nl": "Beperking van specifieke meststoffen",
    "en": "Limitation of specific fertilizers"
  },
  "definition": {
    "nl": "Het beperken van het gebruik van bepaalde meststoffen op een perceel, bijvoorbeeld door typen of hoeveelheden toe te laten of uit te sluiten.",
    "en": "this class includes the practices where there are limitations in the use of fertilisers on the whole field (excluding partial spatial limitations such as  landscape features, buffer strips...)"
  },
  "changeNote": {
    "nl": [
      "Definitie en overgenomen uit ReGeNL practice_list_0.2.1, kolom: English scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."
    ]
  },
  "editorialNote": {
    "nl": [
      "Nederlandse vertaling is een redactioneel voorstel op basis van de bestaande Engelstalige bron en moet nog worden gevalideerd."
    ]
  },
  "historyNote": {
    "nl": [
      "Voorgaande PoC-definitie (en): A ClassificationElement in the RegenerativePracticeFramework at Meso level with label 'Limitation of specific fertilizers'.",
      "Voorgaande PoC-definitie (en): this class includes the practices where there are limitations in the use of fertilisers on the whole field (excluding partial spatial limitations such as  landscape features, buffer strips...)"
    ]
  },
  "notation": [
    "Meso"
  ],
