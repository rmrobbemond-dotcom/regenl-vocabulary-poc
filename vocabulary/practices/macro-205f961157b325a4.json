  "prefLabel": {
    "nl": "Regeneratief vermogen",
    "en": "regenerative capacity"
  },
  "definition": {
    "nl": "Het vermogen van een agrarische bodem of productiesysteem om functies te herstellen en ecologische processen na verstoring te behouden of te verbeteren.",
    "en": "The capacity of an agricultural soil or production system to recover functions and maintain or improve ecological processes after disturbance."
  },
