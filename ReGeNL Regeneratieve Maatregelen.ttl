vocab:ReduceExternalInputs a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Sheep_under_solar_panels_(1)_2025-07-26.jpg> ;
    skos:broader vocab:BioeconomyEnergyEfficiencyAndProduction ;
    skos:definition "Lowering the quantities of materials and services brought onto the farm from outside, such as purchased fertilisers, feed, pesticides or energy."@en,
