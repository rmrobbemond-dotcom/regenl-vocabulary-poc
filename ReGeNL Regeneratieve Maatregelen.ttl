        vocab:PlantProtection,
        vocab:SoilManagement ;
    skos:notation "Mega" ;
    skos:prefLabel "Crop Production Management"@en,
        "Gewasproductiebeheer"@nl ;
    skos:topConceptOf vocab: ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/NRCSIA99284_-_Iowa_(3263)(NRCS_Photo_Gallery).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Mega level with label 'Crop Production Management'."@en ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “NRCSIA99284 - Iowa”. It illustrates the related agricultural context as an aspect of the practice “Crop Production Management”."@en,
