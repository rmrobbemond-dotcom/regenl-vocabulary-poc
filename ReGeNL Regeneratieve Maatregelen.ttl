    skos:narrower vocab:OrganiseActivitiesForTheLocalCommunityEGParticipationEveningsWorkshopsParties ;
    skos:notation "Meso" ;
    skos:prefLabel "Community engagement"@en,
        "Betrokkenheid van de lokale gemeenschap"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Farm%20Extension%20Worker.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a person involved in agricultural extension or farm advisory work, illustrating an opportunity for engagement with the local community."@en,
        "De foto toont een medewerker in de context van landbouwvoorlichting of bedrijfsbegeleiding. Daarmee wordt een onderdeel van ‘Betrokkenheid van de lokale gemeenschap’ zichtbaar."@nl ;
    schema:creditText "Foto: Samuel Macharia (Vrije licentie, controleer bronpagina)."@nl .

