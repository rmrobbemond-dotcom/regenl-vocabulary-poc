{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/R1-0029",
  "type": "Concept",
  "prefLabel": {
    "nl": "Bodemsolarisatie",
    "en": "Soil solarisation"
  },
  "definition": {
    "nl": "Het doelgericht verhogen van de bodemtemperatuur door vochtige grond gedurende een bepaalde periode af te dekken met transparante folie, waarbij zonnestraling wordt benut om de kiemkracht, groei of overleving van onkruiden en andere ongewenste bodemorganismen te beperken.",
    "en": "The deliberate increase of soil temperature by covering moist soil with transparent film for a defined period, using solar radiation to reduce the germination capacity, growth or survival of weeds and other unwanted soil organisms."
  },
  "changeNote": {
    "nl": [
      "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; Nederlandse voorkeursbenaming aangepast naar Bodemsolarisatie; nieuwe afbeelding nodig."
    ]
  },
  "notation": [
    "Micro"
  ],
  "broader": {
