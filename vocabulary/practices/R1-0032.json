{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/R1-0032",
  "type": "Concept",
  "prefLabel": {
    "nl": "Gerichte inzet van landbouwhuisdieren voor onkruidbeheer",
    "en": "Targeted use of livestock for weed management"
  },
  "definition": {
    "nl": "Het doelgericht inzetten van landbouwhuisdieren om ongewenste vegetatie te verwijderen of te onderdrukken door middel van begrazing, vraat, wroeten of scharrelen.",
    "en": "The deliberate use of farm animals to remove or suppress unwanted vegetation through grazing, browsing, rooting or scratching."
  },
  "changeNote": {
    "nl": [
      "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; formele benaming verbreed; nieuwe afbeelding nodig."
    ]
  },
  "notation": [
    "Micro"
  ],
