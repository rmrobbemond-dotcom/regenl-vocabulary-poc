    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Rode_tractor_met_graslandwals.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "Animals are grazing on grassland. The photograph illustrates the practical connection between grazing, grassland use and livestock farming."@en,
        "De dieren grazen op grasland. De foto toont de praktische samenhang tussen beweiding, het gebruik van grasland en het houden van vee."@nl .

vocab:DelayedMowingDateForMeadowBirdProtection15JuneOrBotanicalProtectionJuly a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Vluchtheuvel_weiland.jpg> ;
    skos:broader vocab:AdaptiveMowingManagement ;
    skos:definition "Keeping grassland uncut until approximately 15 June for meadow birds or into July for botanical management, with actual dates adjusted to ecological conditions and agreements."@en,
        "Het niet maaien van grasland tot ongeveer 15 juni voor weidevogels of tot in juli voor botanisch beheer, waarbij feitelijke datums afhangen van ecologische omstandigheden en afspraken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:DelayedMowingDateForBirdProtection ;
    skos:notation "Micro" ;
    skos:prefLabel "delayed mowing date for meadow bird protection ( 15 June) or botanical protection (July)"@en,
        "Uitgestelde maaidatum voor weidevogels (15 juni) of botanisch beheer (juli)"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Vluchtheuvel%20weiland.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "diversification of mowing activitiesfarm scale to benefit biodiversity"@en,
        "Het uitstellen van maaiwerkzaamheden om bijvoorbeeld broedende weidevogels of botanische waarden te beschermen."@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "Animals are grazing on grassland. The photograph illustrates the practical connection between grazing, grassland use and livestock farming."@en,
        "De dieren grazen op grasland. De foto toont de praktische samenhang tussen beweiding, het gebruik van grasland en het houden van vee."@nl ;
    schema:creditText "Foto: Apus apus (Commons vrije licentie; controleer bronpagina)."@nl .

vocab:DiversificationOfMowingActivitiesOnFieldAndFarmScale a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:A_view_over_mowed_fields_with_rows_of_raked_grass,_in_evening_sunlight%3B_North-Netherlands_in_May_2012.jpg> ;
    skos:broader vocab:AdaptiveMowingManagement ;
    skos:definition "Varying mowing times, frequency or locations across fields and the farm to create different vegetation structures and leave refuges for wildlife."@en,
        "Het variëren van maaimomenten, maaifrequentie en locaties binnen percelen en het bedrijf om verschillende vegetatiestructuren en schuilplekken voor fauna te behouden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:SinusMowingMosaikMowing ;
    skos:notation "Micro" ;
    skos:prefLabel "diversification of mowing activities on field and farm scale"@en,
        "Diversificatie van maaibeheer op perceels- en bedrijfsniveau"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/A_view_over_mowed_fields_with_rows_of_raked_grass,_in_evening_sunlight%3B_North-Netherlands_in_May_2012.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "diversification of mowing activities on field and farm scale to benefit biodiversity and improve connectivity of habitats"@en,
        "Het variëren van maaimomenten of maaibeheer binnen percelen en bedrijven om biodiversiteit en de verbinding tussen leefgebieden te ondersteunen."@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “A view over mowed fields with rows of raked grass, in evening sun”. It illustrates the related agricultural context as an aspect of the practice “diversification of mowing activities on field and farm scale”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘A view over mowed fields with rows of raked grass, in evening sun’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Diversificatie van maaibeheer op perceels- en bedrijfsniveau’."@nl ;
    schema:creditText "Foto: Wikimedia Commons, gemaaid grasland met windrijen in Drenthe (Nederland)." .

vocab:EcologicalWaterwayAndDitchManagement a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Flowering_cow_parsley_along_the_field.jpg> ;
    skos:broader vocab:HabitatProvisionBiodiversityEnhancement ;
    skos:definition "Managing banks and watercourses with measures such as phased mowing, vegetation retention and reduced disturbance to support aquatic and riparian biodiversity."@en,
        "Het ecologisch beheren van slootkanten en watergangen met bijvoorbeeld gefaseerd maaien, behoud van vegetatie en beperkte verstoring voor water- en oevernatuur."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:PermanentVegetationAtBordersDitchCleaningBaggerenPreventLivestockAccessToWaterways ;
    skos:notation "Micro" ;
    skos:prefLabel "Ecological waterway and ditch management"@en,
        "Ecologisch beheer van watergangen en sloten"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Flowering_cow_parsley_along_the_field.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "Flowering vegetation grows along the field. The photograph shows how a vegetated field margin provides space for herbs and flowers within the agricultural landscape."@en,
        "Langs het perceel staat bloeiende vegetatie. De foto toont hoe een begroeide rand ruimte biedt aan kruiden en bloemen binnen het landbouwlandschap."@nl ;
    schema:creditText "Foto: Wikimedia Commons, bloemrijke akkerrand met fluitenkruid in Drenthe (Nederland)." .

vocab:ExtensificationOfGrazingManagementAdaptiveGrazingManagementMethod a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg> ;
    skos:broader vocab:GrasslandAndGrazing ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch meso. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Reducing grazing intensity or adjusting stocking rate, grazing duration and rest periods in response to vegetation conditions and management objectives."@en,
        "Het verlagen van de beweidingsdruk of aanpassen van veebezetting, graasduur en rustperiodes op basis van vegetatietoestand en beheerdoelen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:ReductionInGrazingIntensity15LUHaForInstanceForVoluntaryEcoPracticePackages ;
    skos:notation "Meso" ;
    skos:prefLabel "extensification of grazing management  - adaptive grazing management method"@en,
        "Extensivering en adaptief beweidingsbeheer"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "weidepremie ( basis 120 dagen = 720 uur), ecoregeling weidepremie 1500 uur of 2500 uur, (speciefiek voor staatsbosheheer verlengte weidepremie > 900uur > 1800uur)"@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "Animals are grazing on grassland. The photograph illustrates the practical connection between grazing, grassland use and livestock farming."@en,
        "De dieren grazen op grasland. De foto toont de praktische samenhang tussen beweiding, het gebruik van grasland en het houden van vee."@nl ;
    schema:creditText "Foto: Wikimedia Commons, grazende koeien in de provincie Utrecht (Nederland)." .

vocab:FarmEducation a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Dairy_princess_with_school_children_visiting_a_dairy_farm,_Maryhill_(I0003237).jpg> ;
    skos:broader vocab:FarmCitizenInteractions ;
