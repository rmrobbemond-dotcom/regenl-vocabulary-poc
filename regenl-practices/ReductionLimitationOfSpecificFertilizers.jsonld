{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReductionLimitationOfSpecificFertilizers",
  "type": "Concept",
  "prefLabel": {
    "en": "Reduction/ limitation of specific  fertilizers",
    "nl": "Specifieke meststoffen verminderen of beperken"
  },
  "definition": {
    "nl": "Classificatieonderdeel binnen het ReGeNL-raamwerk voor regeneratieve landbouwpraktijken dat betrekking heeft op specifieke meststoffen verminderen of beperken. De precieze afbakening en eventuele toepassingscriteria moeten nog door domeinexperts worden vastgesteld."
  },
  "editorialNote": {
    "nl": [
      "Nederlandstalig label en omschrijving zijn voorstellen voor de PoC en zijn nog niet gevalideerd door de harmonisatietaakgroep."
    ]
  },
  "notation": [
    "Meso"
  ],
  "narrower": [
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReductionOrganicFertilizers",
      "prefLabel": {
        "en": "Reduction organic fertilizers",
        "nl": "Organische bemesting verminderen"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MinimalUseOfExternalFertilizersInputsFromOutsideTheFarm",
      "prefLabel": {
        "en": "Minimal use of external fertilizers inputs (from outside the farm)",
        "nl": "Minimaal gebruik van meststoffen van buiten het bedrijf"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoExternalFertilizersUsedAsInput",
      "prefLabel": {
        "en": "No external fertilizers used as input",
        "nl": "Geen meststoffen van buiten het bedrijf"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReducingFertilizerUse",
      "prefLabel": {
        "en": "Reducing fertilizer use",
        "nl": "Meststoffengebruik verminderen"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReducingSysntheticNFerterilizers",
      "prefLabel": {
        "en": "Reducing sysnthetic N-ferterilizers",
        "nl": "Gebruik van synthetische stikstofmeststoffen verminderen"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/RestrictionInQuanityAboveLegalNorms",
      "prefLabel": {
        "en": "restriction in quanity (above legal norms)",
        "nl": "Aanvullende beperking van hoeveelheden boven wettelijke normen"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/RestrictionInTimingAboveLegalNorms",
      "prefLabel": {
        "en": "restriction in timing (above legal norms)",
        "nl": "Aanvullende beperking van tijdstip boven wettelijke normen"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceSyntheticFertilizers",
      "prefLabel": {
        "en": "Reduce synthetic fertilizers",
        "nl": "Kunstmestgebruik verminderen"
      }
    }
  ],
  "broader": {
