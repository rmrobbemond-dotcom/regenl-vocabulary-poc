{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/","type":"ConceptScheme","title":{"nl":"ReGeNL – regeneratieve landbouwpraktijken (PoC)","en":"ReGeNL – regenerative practices (PoC)"},"prefLabel":{"nl":"ReGeNL raamwerk regeneratieve landbouwpraktijken","en":"ReGeNL regenerative practice framework"},"description":{"en":"SKOS publication representation derived from the ReGeNL ontology. Hierarchical levels: Mega, Macro, Meso, Micro, Nano. Labels and definitions are copied from the source where present; missing text is not generated."},"hasTopConcept":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Bioeconomy","notation":["Mega"],"prefLabel":{"nl":"Bio-economie","en":"Bioeconomy"},"definition":{"nl":"Het produceren en benutten van hernieuwbare biologische hulpbronnen, zoals gewassen, biomassa en reststromen, voor voedsel, materialen, energie of andere producten als alternatief voor fossiele grondstoffen.","en":"Producing and using renewable biological resources, including crops, biomass and residues, for food, materials, energy or other products instead of relying solely on fossil resources."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/BioeconomyEnergyEfficiencyAndProduction","notation":["Macro"],"prefLabel":{"nl":"Bio-economie, energie-efficiëntie en productie","en":"Bioeconomy, energy efficiency and production"},"definition":{"nl":"Bedrijfsmaatregelen die hernieuwbare energie of biobased producten voortbrengen en tegelijk de energievraag beperken door efficiëntere technieken en processen.","en":"Farm management practices that produce renewable energy or bio-based products and reduce energy demand through efficient technologies and processes."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/RenewableEnergy","notation":["Meso"],"prefLabel":{"nl":"Hernieuwbare energie","en":"renewable energy"},"definition":{"nl":"Het opwekken of gebruiken van energie uit zich natuurlijk vernieuwende bronnen, zoals zonlicht, wind of duurzaam beheerde biomassa, voor bedrijfsactiviteiten.","en":"Generating or using energy from naturally replenishing sources, such as sunlight, wind or sustainably managed biomass, for farm activities."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Agrovoltaics","notation":["Micro"],"prefLabel":{"nl":"Agrovoltaïsche systemen","en":"Agrovoltaics"},"definition":{"nl":"Het combineren van elektriciteitsopwekking met zonnepanelen en landbouwproductie op hetzelfde grondoppervlak, waarbij gewassen of dieren onder of tussen de panelen ruimte behouden.","en":"Combining electricity generation from photovoltaic panels with agricultural production on the same area, with a layout that allows crops or livestock beneath or between panels."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Biodigester","notation":["Micro"],"prefLabel":{"nl":"Vergistingsinstallatie","en":"Biodigester"},"definition":{"nl":"Een installatie waarin organisch materiaal, zoals mest of gewasresten, zonder zuurstof wordt afgebroken tot biogas en een restproduct dat digestaat wordt genoemd.","en":"An installation that anaerobically decomposes organic material such as manure or crop residues to produce biogas and a residual material called digestate."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceDependencyOnFossilFuel","notation":["Micro"],"prefLabel":{"nl":"Afhankelijkheid van fossiele brandstoffen verminderen","en":"Reduce dependency on fossil fuel"},"definition":{"nl":"Het verminderen van de afhankelijkheid van diesel, aardgas en andere fossiele energie door efficiëntie, elektrificatie of hernieuwbare alternatieven.","en":"Reducing the farm's reliance on diesel, natural gas and other fossil energy through efficiency, electrification or renewable alternatives."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SolarPannels","notation":["Micro"],"prefLabel":{"nl":"Zonnepanelen","en":"Solar pannels"},"definition":{"nl":"Het plaatsen of benutten van fotovoltaïsche zonnepanelen die zonlicht omzetten in elektriciteit voor bedrijfsgebruik of levering aan het net.","en":"Installing or using photovoltaic panels that convert sunlight into electricity for farm operations or export to the grid."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WindEnergy","notation":["Micro"],"prefLabel":{"nl":"Windenergie","en":"Wind energy"},"definition":{"nl":"Het opwekken van elektriciteit uit wind met turbines op of bij landbouwgrond voor eigen gebruik of levering aan het elektriciteitsnet.","en":"Producing electricity from wind using turbines on or associated with agricultural land to supply farm demand or the power grid."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceExternalInputs","notation":["Meso"],"prefLabel":{"nl":"Externe inputs verminderen","en":"Reduce external inputs"},"definition":{"nl":"Het verminderen van hoeveelheden van buiten aangevoerde materialen en diensten, zoals aangekochte meststoffen, voer, gewasbeschermingsmiddelen of energie.","en":"Lowering the quantities of materials and services brought onto the farm from outside, such as purchased fertilisers, feed, pesticides or energy."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Food_crops_only","notation":["Micro"],"prefLabel":{"nl":"Alleen voedselgewassen","en":"Food crops only"},"definition":{"nl":"Het beperken van een teeltareaal of productiestrategie tot gewassen bestemd voor menselijke voeding, in plaats van andere toepassingen zoals energie of sierproducten.","en":"Restricting a specified cropping area or production strategy to crops intended directly or indirectly for human food rather than non-food uses."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoResidualStreams","notation":["Micro"],"prefLabel":{"nl":"Geen reststromen","en":"No residual streams"},"definition":{"nl":"Het zo inrichten van bedrijfsprocessen dat bruikbare bijproducten en afvalstromen worden voorkomen, verminderd of hergebruikt in plaats van als onbeheerde reststroom over te blijven.","en":"Designing farm processes so that usable by-products and waste streams are prevented, reduced or reused rather than leaving unmanaged residual material."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SelfSufficiency","notation":["Micro"],"prefLabel":{"nl":"Zelfvoorziening","en":"Self-sufficiency"},"definition":{"nl":"Het vergroten van het aandeel hulpbronnen of producten dat het landbouwbedrijf of huishouden zelf produceert of levert in plaats van extern inkoopt.","en":"Increasing the share of resources or products needed by a farm or farm household that are produced or supplied internally rather than purchased externally."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/UseLocalInputs","notation":["Micro"],"prefLabel":{"nl":"Lokale inputs gebruiken","en":"Use local inputs"},"definition":{"nl":"Het voorrang geven aan materialen, voer, zaden of andere productiemiddelen van het eigen bedrijf of uit de regio om aanvoerketens te verkorten.","en":"Prioritising materials, feed, seeds or other production inputs sourced on the farm or within the local region to shorten supply chains."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/UseOfResidualMaterials","notation":["Micro"],"prefLabel":{"nl":"Restmaterialen gebruiken","en":"Use of residual materials"},"definition":{"nl":"Het benutten van agrarische bijproducten of resterende biomassa als voer, strooisel, meststof, materiaal of energiebron in plaats van ze af te voeren.","en":"Using agricultural by-products or residual biomass as useful inputs for feed, bedding, fertilisation, materials or energy instead of discarding them."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/UseOfNaturalRenewableResources","notation":["Micro"],"prefLabel":{"nl":"Natuurlijke en hernieuwbare hulpbronnen gebruiken","en":"Use of natural/renewable resources"},"definition":{"nl":"Het vervangen van niet-hernieuwbare grondstoffen door duurzaam beschikbare natuurlijke of hernieuwbare hulpbronnen in bedrijfsprocessen en producten.","en":"Replacing non-renewable raw materials with sustainably supplied natural or renewable resources in farm operations and products."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WoodBioplastics","notation":["Nano"],"prefLabel":{"nl":"Hout en bioplastics","en":"wood, bioplastics"},"definition":{"nl":"Het produceren of gebruiken van houtgebaseerde materialen en bioplastics die geheel of gedeeltelijk uit hernieuwbare biomassa bestaan als alternatief voor fossiele materialen.","en":"Producing or using wood-based materials and bio-based plastics derived partly or wholly from renewable biomass as alternatives to fossil-based materials."}}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ResourceSharingCollaborationBetweenArableProductionAndDairy","notation":["Meso"],"prefLabel":{"nl":"Delen van middelen tussen akkerbouw en melkveehouderij","en":"resource sharing, collaboration between arable production and dairy"},"definition":{"nl":"Samenwerking tussen akkerbouw- en melkveebedrijven om middelen zoals mest, voer, machines, grondgebruik of gewasresten te delen.","en":"Cooperation between crop and dairy farms to share resources such as manure, feed, machinery, land use or crop residues."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/LocalOrRegionalCollaborationBetweenSectorsEGCropLivestock","notation":["Micro"],"prefLabel":{"nl":"Lokale of regionale samenwerking tussen sectoren","en":"Local or regional collaboration between sectors (e.g. crop-livestock)"},"definition":{"nl":"Samenwerking tussen bedrijven of sectoren in een regio, bijvoorbeeld door uitwisseling van mest, voer, stro of grondgebruik tussen akkerbouw en veehouderij.","en":"Cooperation between farms or sectors in a locality, for example exchanging manure, feed, straw or land use between crop and livestock farms."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MixedFarmingIntegrateLivestock","notation":["Micro"],"prefLabel":{"nl":"Gemengd bedrijf met geïntegreerde veehouderij","en":"Mixed farming / integrate livestock"},"definition":{"nl":"Het combineren van akkerbouw of tuinbouw met veehouderij op één bedrijf zodat voer, mest en gewasresten onderling kunnen worden benut.","en":"Combining arable or horticultural crops with livestock on one farm so that resources such as feed, manure and crop residues can be cycled internally."}}]}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CropProductionManagementGrasslandManagement","notation":["Mega"],"prefLabel":{"nl":"Graslandbeheer binnen gewasproductie","en":"Crop production management : grassland management"},"definition":{"nl":"Het beheren van grasland als landbouwgewas via keuzes over soorten, bemesting, maaien, beweiden en vernieuwing.","en":"Managing grassland as an agricultural crop through choices about species, fertilisation, cutting, grazing and renewal."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/GrasslandAndGrazing","notation":["Macro"],"prefLabel":{"nl":"Grasland en beweiding","en":"Grassland and grazing"},"definition":{"nl":"Samenhangend beheer van graslandvegetatie en benutting door grazende dieren, met aandacht voor soortensamenstelling, ruwvoerproductie en graasdruk.","en":"Integrated management of grassland vegetation and its use by grazing animals, including species composition, forage production and grazing pressure."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/GrazingSystem","notation":["Meso"],"prefLabel":{"nl":"Beweidingssysteem","en":"grazing system"},"definition":{"nl":"Een vastgelegde werkwijze voor wanneer en waar vee graast, zoals standweide, rotatiebeweiding of stripgrazen.","en":"A defined arrangement for organising when and where livestock graze, such as continuous, rotational or strip grazing."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CompartmentedContinousGrazingNewNederlandsWeiden","notation":["Micro"],"prefLabel":{"nl":"Gecompartimenteerd continu beweiden (Nieuw Nederlands Weiden)","en":"compartmented continous grazing (New nederlands weiden)"},"definition":{"nl":"Een beweidingssysteem waarbij grasland in compartimenten is verdeeld en koeien volgens een planning regelmatig vers gras krijgen, zoals bij Nieuw Nederlands Weiden.","en":"A grazing system dividing grassland into several compartments while supplying grazing areas in a planned sequence and maintaining frequent access to fresh pasture."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/GrazingTrainingOfYoungstock","notation":["Micro"],"prefLabel":{"nl":"Jongvee laten wennen aan weidegang","en":"grazing training of youngstock"},"definition":{"nl":"Het geleidelijk laten wennen van jongvee aan grasland om graasgedrag te ontwikkelen en vertrouwd te raken met afrasteringen, weersomstandigheden en buiten voeren.","en":"Gradually introducing young livestock to pasture to develop grazing behaviour and familiarity with fences, weather and outdoor feeding."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/HolisticGrazing","notation":["Micro"],"prefLabel":{"nl":"Holistisch beweiden","en":"Holistic grazing"},"definition":{"nl":"Adaptief geplande beweiding waarbij verplaatsingen van vee, graasdruk en herstelperiodes worden aangepast aan de toestand van vegetatie, bodem en dieren.","en":"Adaptive planned grazing that adjusts herd movements, grazing intensity and recovery periods in response to ecological and livestock conditions."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MOBGrazing","notation":["Micro"],"prefLabel":{"nl":"Mobbeweiding","en":"MOB grazing"},"definition":{"nl":"Het gedurende korte tijd beweiden van grasland met een zeer hoge dierdichtheid, gevolgd door een relatief lange herstelperiode van de vegetatie.","en":"Grazing a pasture with a very high animal density for a short period followed by a comparatively long recovery period for vegetation."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/RotationalGrazing","notation":["Micro"],"prefLabel":{"nl":"Rotatiebeweiding","en":"rotational grazing"},"definition":{"nl":"Het achtereenvolgens verplaatsen van vee tussen afgebakende graasdelen, zodat eerder beweid grasland kan herstellen voordat de dieren terugkeren.","en":"Moving livestock among defined grazing areas in sequence so that grazed pasture can recover before animals return."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Standweide","notation":["Micro"],"prefLabel":{"nl":"Standweide","en":"standweide"},"definition":{"nl":"Een vorm van voortdurende beweiding waarbij dieren gedurende langere tijd toegang hebben tot hetzelfde grasland of graasblok in plaats van frequent tussen percelen te wisselen.","en":"Continuous grazing in which animals have access to the same pasture or grazing unit over an extended period rather than being moved frequently between paddocks."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/StripGrazing","notation":["Micro"],"prefLabel":{"nl":"Stripgrazen","en":"strip grazing"},"definition":{"nl":"Het vee telkens toegang geven tot een smalle grasstrook, meestal door een tijdelijke afrastering te verplaatsen om stapsgewijs vers voer aan te bieden.","en":"Giving livestock access to a narrow section of pasture at a time, usually by moving temporary fencing to provide fresh forage incrementally."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/VoisinRationalGrazing","notation":["Micro"],"prefLabel":{"nl":"Rationeel beweiden volgens Voisin","en":"Voisin rational grazing"},"definition":{"nl":"Een planmatige vorm van rotatiebeweiding gebaseerd op voldoende herstelperiodes van gras, korte bezettingsduur en afstemming van het grasaanbod op de behoeften van het vee.","en":"A planned rotational grazing method based on adequate pasture recovery periods, short occupation times and allocating forage according to livestock needs."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/GrazingManagement","notation":["Meso"],"prefLabel":{"nl":"Beweidingsbeheer","en":"grazing management"},"definition":{"nl":"Het plannen van veebezetting, graasperioden, rusttijden en perceelindeling om diervoeding en de conditie van het grasland in balans te houden.","en":"Planning stocking density, grazing periods, rest periods and pasture allocation to balance animal feeding with grassland condition."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ExtendedGrazingTimeMinimumOf1500HoursYear","notation":["Micro"],"prefLabel":{"nl":"Verlengde weidegang: minimaal 1.500 uur per jaar","en":"Extended grazing time: minimum of 1500 hours/year"},"definition":{"nl":"Het vee gedurende minimaal 1.500 uur per jaar toegang geven tot grasland, opgeteld over de afzonderlijke perioden van weidegang.","en":"Providing grazing access to livestock for at least 1,500 hours per year, measured as accumulated time outdoors on pasture."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ExtendedGrazingTimeMinimumOf720HoursYearMaximumOf1500HoursPerYear","notation":["Micro"],"prefLabel":{"nl":"Verlengde weidegang: 720–1.500 uur per jaar","en":"Extended grazing time: minimum of 720 hours/year (maximum of 1500 hours per year)"},"definition":{"nl":"Het vee gedurende minimaal 720 maar minder dan 1.500 uur per jaar toegang geven tot grasland, opgeteld over de afzonderlijke weideperioden.","en":"Providing grazing access to livestock for at least 720 but less than 1,500 hours per year, measured as accumulated pasture access time."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/GrazingGeneral","notation":["Micro"],"prefLabel":{"nl":"Beweiding (algemeen)","en":"Grazing (general)"},"definition":{"nl":"Het laten opnemen van staande vegetatie door landbouwhuisdieren op grasland of andere beweidbare grond in plaats van uitsluitend geoogst voer aan te bieden.","en":"Allowing farm animals to consume standing vegetation directly from grassland or other grazable land rather than supplying all forage as harvested feed."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/GrasslandTypeEnhancedSpeciesRichness","notation":["Meso"],"prefLabel":{"nl":"Graslandtype met verhoogde soortenrijkdom","en":"grassland type - enhanced species richness"},"definition":{"nl":"Grasland dat bewust met extra gras-, kruiden- of vlinderbloemige soorten is ingezaaid of beheerd om de botanische diversiteit te vergroten ten opzichte van een eenvoudige zode.","en":"Grassland deliberately established or managed with additional grass, herb or legume species to increase botanical diversity compared with a simple sward."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ExtensiveSpeciesRichGrassland","notation":["Micro"],"prefLabel":{"nl":"Extensief soortenrijk grasland","en":"extensive species rich grassland"},"definition":{"nl":"Het beheren van kruiden- en soortenrijk grasland met weinig externe inputs, doorgaans via beperkte bemesting en aangepast maaien of beweiden.","en":"Maintaining low-input grassland with a diverse mixture of grasses and herbs, often managed through low fertilisation and adjusted mowing or grazing."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ProductiveMultispeciesSward","notation":["Micro"],"prefLabel":{"nl":"Productieve soortenrijke graszode","en":"productive multispecies sward"},"definition":{"nl":"Een graszode die bewust uit meerdere productieve grassen, vlinderbloemigen of kruiden bestaat voor ruwvoeropbrengst en gevarieerde beworteling.","en":"A grassland sward intentionally composed of multiple productive grasses, legumes or herbs that contribute to forage yield and diverse rooting."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/GrasslandTypeSwardAge","notation":["Meso"],"prefLabel":{"nl":"Graslandtype naar leeftijd van de zode","en":"grassland type - sward age"},"definition":{"nl":"Het indelen van grasland naar de tijd dat de huidige zode aanwezig is sinds aanleg of de laatste vernieuwing.","en":"Classifying grassland according to how long the current sward has existed since establishment or last renewal."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PermanentGrasslandSwardAtLeast5YearsOldRenewedWithin15years","notation":["Micro"],"prefLabel":{"nl":"Blijvend grasland van minstens vijf jaar, vernieuwd binnen vijftien jaar","en":"permanent grassland sward  at least 5 years old renewed within 15years"},"definition":{"nl":"Grasland met een huidige zode van ten minste vijf jaar oud dat in de afgelopen vijftien jaar wel is vernieuwd of opnieuw ingezaaid.","en":"Grassland with a current sward at least five years old that has nevertheless been reseeded or renewed within the preceding fifteen years."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PermanentGrasslandSwardOlderThan15Year","notation":["Micro"],"prefLabel":{"nl":"Blijvend grasland ouder dan vijftien jaar","en":"permanent grassland sward older than 15 year"},"definition":{"nl":"Grasland waarvan de huidige zode meer dan vijftien jaar aanwezig is zonder volledige vernieuwing of herinzaai.","en":"Grassland whose current sward has remained in place for more than fifteen years without full renewal or reseeding."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PermanentGrasslandSwardRegularyRenewedWithinThe5Years","notation":["Micro"],"prefLabel":{"nl":"Grasland dat binnen vijf jaar regelmatig wordt vernieuwd","en":"permanent grassland sward regulary renewed within the 5 years"},"definition":{"nl":"Grasland dat met tussenpozen korter dan vijf jaar opnieuw wordt ingezaaid of vernieuwd, waardoor de zode relatief jong blijft.","en":"Grassland managed through repeated renewal or reseeding within intervals shorter than five years, resulting in a relatively young sward."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/TemporaryGrasslandSwardYoungerThan5Years","notation":["Micro"],"prefLabel":{"nl":"Tijdelijk grasland jonger dan vijf jaar","en":"temporary grassland , sward younger than 5 years"},"definition":{"nl":"Grasland met een zode jonger dan vijf jaar sinds aanleg of vernieuwing, vaak opgenomen in een akkerbouwrotatie in plaats van blijvend aangehouden.","en":"Grassland with a sward younger than five years since establishment or renewal, often included in arable rotations rather than maintained indefinitely."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/AdaptiveMowingManagement","notation":["Meso"],"prefLabel":{"nl":"Adaptief maaibeheer","en":"adaptive mowing management"},"definition":{"nl":"Het aanpassen van maaidata, maaifrequentie, maaihoogte en ruimtelijk maaipatroon aan de actuele vegetatieontwikkeling, weersomstandigheden en biodiversiteitsdoelen in plaats van een vast maaischema.","en":"Adjusting mowing dates, frequency, height and spatial patterns to current vegetation growth, weather and biodiversity objectives rather than following a fixed schedule."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DelayedMowingDateForMeadowBirdProtection15JuneOrBotanicalProtectionJuly","notation":["Micro"],"prefLabel":{"nl":"Uitgestelde maaidatum voor weidevogels (15 juni) of botanisch beheer (juli)","en":"delayed mowing date for meadow bird protection ( 15 June) or botanical protection (July)"},"definition":{"nl":"Het niet maaien van grasland tot ongeveer 15 juni voor weidevogels of tot in juli voor botanisch beheer, waarbij feitelijke datums afhangen van ecologische omstandigheden en afspraken.","en":"Keeping grassland uncut until approximately 15 June for meadow birds or into July for botanical management, with actual dates adjusted to ecological conditions and agreements."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DelayedMowingDateForBirdProtection","notation":["Nano"],"prefLabel":{"nl":"Uitgestelde maaidatum voor vogelbescherming","en":"delayed mowing date for bird protection"},"definition":{"nl":"Het uitstellen van het maaien van grasland of vegetatie tot een bepaalde datum of na het broedseizoen om verstoring en sterfte van vogels te verminderen.","en":"Postponing cutting of grassland or vegetation until a specified date or after nesting periods to reduce disturbance and mortality of birds."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DiversificationOfMowingActivitiesOnFieldAndFarmScale","notation":["Micro"],"prefLabel":{"nl":"Diversificatie van maaibeheer op perceels- en bedrijfsniveau","en":"diversification of mowing activities on field and farm scale"},"definition":{"nl":"Het variëren van maaimomenten, maaifrequentie en locaties binnen percelen en het bedrijf om verschillende vegetatiestructuren en schuilplekken voor fauna te behouden.","en":"Varying mowing times, frequency or locations across fields and the farm to create different vegetation structures and leave refuges for wildlife."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SinusMowingMosaikMowing","notation":["Nano"],"prefLabel":{"nl":"Sinusmaaien en mozaïekmaaien","en":"sinus mowing, mosaik mowing,"},"definition":{"nl":"Het maaien in slingerende banen of ruimtelijke mozaïeken op verschillende momenten, waarbij ongemaaide delen beschutting en bloeiaanbod voor fauna behouden.","en":"Mowing in curved strips or in a spatial mosaic at different times, retaining uncut patches that provide shelter and flowering resources for wildlife."}}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ExtensificationOfGrazingManagementAdaptiveGrazingManagementMethod","notation":["Meso"],"prefLabel":{"nl":"Extensivering en adaptief beweidingsbeheer","en":"extensification of grazing management  - adaptive grazing management method"},"definition":{"nl":"Het verlagen van de beweidingsdruk of aanpassen van veebezetting, graasduur en rustperiodes op basis van vegetatietoestand en beheerdoelen.","en":"Reducing grazing intensity or adjusting stocking rate, grazing duration and rest periods in response to vegetation conditions and management objectives."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReductionInGrazingIntensity15LUHaForInstanceForVoluntaryEcoPracticePackages","notation":["Micro"],"prefLabel":{"nl":"Verlagen van beweidingsintensiteit (bijvoorbeeld 1,5 GVE per ha)","en":"Reduction in grazing intensity (1.5 LU/ha), for instance for voluntary eco practice packages"},"definition":{"nl":"Het verlagen van de graasdruk door de veebezetting per hectare te begrenzen, bijvoorbeeld rond 1,5 grootvee-eenheid per hectare wanneer een beheerovereenkomst dat vereist.","en":"Reducing grazing pressure by limiting livestock units per hectare, for example to around 1.5 livestock units per hectare where required by a management agreement."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MinimumGrazingPeriodNoOrRestrictedGrazingGrazingLivestockDensityLimitation","notation":["Nano"],"prefLabel":{"nl":"Minimale beweidingsperiode of beperkingen aan beweiding en veebezetting","en":"minimum grazing period; no or restricted grazing; grazing livestock density limitation"},"definition":{"nl":"Het beperken van graasduur, graasmomenten of veebezetting op aangewezen grond om vegetatie, bodem of biodiversiteit volgens bepaalde beheerregels te beschermen.","en":"Restricting grazing duration, timing or livestock density on designated land to protect vegetation, soils or biodiversity under defined management rules."}}]}]}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/FinancialManagement","notation":["Mega"],"prefLabel":{"nl":"Financieel beheer","en":"Financial management"},"definition":{"nl":"Het plannen, vastleggen en beheersen van inkomsten, uitgaven, investeringen, liquiditeit en financiële risico's van het landbouwbedrijf.","en":"Planning, recording and controlling farm income, expenses, investments, cash flow and financial risks to support business continuity."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/FarmSocioEconomicManagement","notation":["Macro"],"prefLabel":{"nl":"Sociaal-economisch bedrijfsbeheer","en":"Farm socio-economic management"},"definition":{"nl":"Het beheren van arbeid, financiën, zakelijke relaties, maatschappelijke betrokkenheid en inkomensbronnen naast de agrarische productie.","en":"Managing labour, finance, business relationships, community engagement and income diversification alongside the farm's agricultural activities."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/IncomeDeepeningIncreasingAddedValueOfProduct","notation":["Meso"],"prefLabel":{"nl":"Inkomensverdieping door hogere productwaarde","en":"Income deepening -increasing added value of product"},"definition":{"nl":"Het verhogen van de opbrengst per eenheid landbouwproduct door verwerking, merkontwikkeling, kwaliteitsonderscheid of kortere afzetketens.","en":"Increasing revenue per unit of farm produce through processing, branding, quality differentiation or shorter marketing chains."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CollectiveBrand","notation":["Micro"],"prefLabel":{"nl":"Collectief merk","en":"Collective brand"},"definition":{"nl":"Het ontwikkelen en gebruiken van één gezamenlijk merk door meerdere producenten om producten met gedeelde kwaliteits- of herkomstkenmerken te vermarkten.","en":"Developing and using a shared product identity or trade mark by several producers to market goods under common quality or origin characteristics."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CollectiveProssesing","notation":["Micro"],"prefLabel":{"nl":"Collectieve verwerking","en":"Collective prossesing"},"definition":{"nl":"Het gezamenlijk verwerken van agrarische producten via gedeelde voorzieningen, machines of een producentenorganisatie om kosten te delen of productwaarde te verhogen.","en":"Processing agricultural products jointly through shared facilities, equipment or a producer organisation to increase efficiency or product value."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CommunityBasedSupportedAgriculture","notation":["Micro"],"prefLabel":{"nl":"Gemeenschapslandbouw (CSA)","en":"Community based/supported agriculture"},"definition":{"nl":"Een voedselproductie- en afzetsysteem waarin consumenten zich direct aan een bedrijf verbinden, vaak via abonnement of vooruitbetaling en soms door risico en oogst te delen.","en":"A food production and distribution arrangement in which consumers make a direct commitment to a farm, often through subscriptions or prepayment and sometimes sharing risks and harvests."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DirectOnfarmAndCollectiveFormsOfSales","notation":["Micro"],"prefLabel":{"nl":"Directe boerderijverkoop en collectieve afzet","en":"Direct onfarm and collective forms of sales"},"definition":{"nl":"Het rechtstreeks verkopen van boerderijproducten aan consumenten op het bedrijf of gezamenlijk via producentenwinkels, markten, pakketten of andere collectieve afzetkanalen.","en":"Selling farm products directly to consumers on the farm or jointly through producer-owned shops, markets, box schemes or other collective channels."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/FoodPurchasingByCitizensCooperatives","notation":["Micro"],"prefLabel":{"nl":"Voedselaankoop door burgercoöperaties","en":"Food purchasing by citizens cooperatives"},"definition":{"nl":"Het gezamenlijk inkopen van voedsel door consumenten via een coöperatie die rechtstreeks bij boeren of afgesproken producentennetwerken afneemt.","en":"Consumers organising joint food purchases through a cooperative that sources products directly from farmers or defined producer networks."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/OnFarmProcessing","notation":["Micro"],"prefLabel":{"nl":"Verwerking op het landbouwbedrijf","en":"On-farm processing"},"definition":{"nl":"Het op het landbouwbedrijf verwerken van eigen plantaardige of dierlijke producten tot voedsel, voer of andere goederen om bruikbaarheid of waarde te verhogen.","en":"Processing farm-grown or farm-raised products on the farm into food, feed or other goods to increase their usability or value."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PrivateBrand","notation":["Micro"],"prefLabel":{"nl":"Eigen merk","en":"Private brand"},"definition":{"nl":"Het op de markt brengen van boerderijproducten onder een eigen merk van het landbouwbedrijf in plaats van uitsluitend onder een handels- of generieke productnaam.","en":"Marketing farm products under a brand owned or controlled by the farm rather than solely under a retailer or commodity identity."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NewFormsOfAccessToLandLabourCapital","notation":["Meso"],"prefLabel":{"nl":"Nieuwe vormen van toegang tot grond, arbeid en kapitaal","en":"New forms of access to  land, labour, capital"},"definition":{"nl":"Regelingen waarmee boeren via alternatieven voor traditioneel eigendom of krediet toegang krijgen tot grond, arbeid of financiering, zoals coöperaties en gedeeld gebruik.","en":"Arrangements that give farmers access to land, labour or financing through alternatives to conventional ownership or credit, such as cooperatives or shared-use contracts."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CrowdfundingZoopSharesTimebankingOfLabour","notation":["Micro"],"prefLabel":{"nl":"Crowdfunding, Zoöp, aandelen en tijdsruil van arbeid","en":"Crowdfunding, zoop, shares, timebanking of labour"},"definition":{"nl":"Het inzetten van alternatieve vormen om financiering, betrokkenheid of arbeid te organiseren, zoals crowdfunding, aandelen, arbeidsruil of een Zoöp-bestuursmodel.","en":"Using alternative arrangements to mobilise money, participation or work for a farm, such as crowdfunding, ownership shares, labour exchanges or a Zoöp governance structure."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/IncomeBroadeningPaymentsForEcosystemServices","notation":["Meso"],"prefLabel":{"nl":"Inkomensverbreding via betalingen voor ecosysteemdiensten","en":"Income broadening- Payments for ecosystem services"},"definition":{"nl":"Het verkrijgen van extra bedrijfsinkomsten via vergoedingen voor het leveren of behouden van ecosysteemdiensten, zoals leefgebied, waterkwaliteit of koolstofvastlegging.","en":"Generating additional farm income through payments linked to the provision or maintenance of ecosystem services such as habitat, water quality or carbon storage."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/EcosystemservicePaymentsFromGovernment","notation":["Micro"],"prefLabel":{"nl":"Overheidsbetalingen voor ecosysteemdiensten","en":"Ecosystemservice payments from government"},"definition":{"nl":"Het ontvangen van een overheidsvergoeding voor afgesproken of aantoonbaar geleverd beheer dat ecosysteemdiensten ondersteunt, zoals biodiversiteit, waterkwaliteit of koolstofopslag.","en":"Receiving public compensation for verified or agreed farm management that provides ecosystem services such as biodiversity, water quality or carbon storage."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SustainabilityCertificationEGOrganicBiodynamicOnTheWayTo","notation":["Micro"],"prefLabel":{"nl":"Duurzaamheidscertificering (biologisch, biodynamisch enzovoort)","en":"(Sustainability) certification (e.g. organic, biodynamic, on the way to...)"},"definition":{"nl":"Het verkrijgen of behouden van onafhankelijke toetsing van de bedrijfsvoering aan een omschreven duurzaamheidsstandaard, zoals biologisch of biodynamisch.","en":"Obtaining or maintaining third-party verification of farm practices against a defined sustainability standard, such as organic or biodynamic certification."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SustainabilityPaymentsByChainPartners","notation":["Micro"],"prefLabel":{"nl":"Duurzaamheidsbetalingen door ketenpartners","en":"Sustainability payments by chain partners"},"definition":{"nl":"Het ontvangen van vergoedingen of prijstoeslagen van afnemers of andere ketenpartners voor het voldoen aan afgesproken milieu- of sociale prestaties.","en":"Receiving payments or price premiums from buyers or other supply-chain actors for meeting agreed environmental or social performance requirements."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/IncomeBroadeningMeso","notation":["Meso"],"prefLabel":{"nl":"Inkomensverbreding","en":"Income broadening"},"definition":{"nl":"Het spreiden van bedrijfsinkomsten door naast de primaire landbouwproductie extra producten, diensten of activiteiten te ontwikkelen.","en":"Diversifying farm revenue by developing additional products, services or activities beyond primary agricultural production."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/IncomeBroadeningMicro","notation":["Micro"],"prefLabel":{"nl":"Inkomensverbreding","en":"Income broadening"},"definition":{"nl":"Het toevoegen van concrete neveninkomsten, zoals toerisme, educatie, verwerking of betaalde diensten, naast de bestaande agrarische productie.","en":"Introducing concrete supplementary income activities, such as tourism, education, processing or paid services, alongside existing farm production."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ProvideCareFarming","notation":["Micro"],"prefLabel":{"nl":"Zorglandbouw aanbieden","en":"Provide care farming"},"definition":{"nl":"Het aanbieden van georganiseerde zorg of begeleide activiteiten aan mensen met een zorgvraag als onderdeel van de dienstverlening en omgeving van het landbouwbedrijf.","en":"Offering organised care or supported activities to people with care needs as part of the farm's services and environment."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/IndividualAndCollectiveFormsOfCostReducingMeasures","notation":["Meso"],"prefLabel":{"nl":"Individuele en collectieve kostenbesparende maatregelen","en":"Individual and collective forms of cost reducing measures"},"definition":{"nl":"Het verlagen van bedrijfs- of investeringskosten door eigen efficiëntiemaatregelen of gezamenlijke inkoop, machines en voorzieningen met andere bedrijven.","en":"Reducing farm operating or investment costs through individual efficiency measures or shared purchasing, machinery and infrastructure with other farms."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/InputReductionOfEGAgrochemicalsAndFeed","notation":["Micro"],"prefLabel":{"nl":"Vermindering van externe inputs zoals gewasbeschermingsmiddelen en voer","en":"Input reduction of e.g. agrochemicals and feed"},"definition":{"nl":"Het verminderen van hoeveelheden of afhankelijkheid van ingekochte inputs, zoals gewasbeschermingsmiddelen en voer, met behoud van aandacht voor productie- en dierbehoeften.","en":"Lowering the quantity or dependency on purchased external inputs, such as agrochemicals and feed, while managing production and animal needs."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SharedUseAndOwnershipEGOfMachineryLandLabourEGMutualHelpCapital","notation":["Micro"],"prefLabel":{"nl":"Gezamenlijk gebruik en eigendom van machines, grond, arbeid of kapitaal","en":"Shared use and ownership (e.g. of machinery, land, labour (e.g. mutual help, capital)"},"definition":{"nl":"Het gezamenlijk inzetten, bezitten of financieren van machines, grond, arbeid of kapitaal door landbouwbedrijven of partners in plaats van alles afzonderlijk te organiseren.","en":"Pooling, co-owning or jointly using machinery, land, labour or capital among farms or community partners instead of arranging each resource separately."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PluralactivityWorkBeyondFarm","notation":["Meso"],"prefLabel":{"nl":"Nevenactiviteiten buiten de landbouw","en":"Pluralactivity - work beyond farm"},"definition":{"nl":"Het combineren van landbouwactiviteiten met ander werk of ondernemerschap buiten het bedrijf om huishoud- of bedrijfsinkomsten te spreiden.","en":"Combining agricultural work with additional professional or commercial activities outside the farm to diversify household or business income."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NonFarmAndOffFarmEmployment","notation":["Micro"],"prefLabel":{"nl":"Werk buiten het landbouwbedrijf","en":"non-farm and off-farm employment"},"definition":{"nl":"Het verkrijgen van inkomsten uit betaald werk of beroepsactiviteiten buiten het landbouwbedrijf naast de agrarische werkzaamheden.","en":"Earning income from employment or professional activities outside the farm enterprise alongside agricultural work."}}]}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/InfraAndEquipmentManagement","notation":["Mega"],"prefLabel":{"nl":"Infrastructuur- en materieelbeheer","en":"Infra and equipment management"},"definition":{"nl":"Het plannen van aanschaf, onderhoud, gebruik en vervanging van agrarische infrastructuur, gebouwen, machines en gereedschappen voor doelmatige bedrijfsvoering.","en":"Planning acquisition, maintenance, use and replacement of farm infrastructure, buildings, machinery and tools to support efficient and responsible operations."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DiagnosisAndManagementPlansMacro","notation":["Macro"],"prefLabel":{"nl":"Diagnose- en beheerplannen","en":"diagnosis and management plans"},"definition":{"nl":"Een overkoepelende aanpak voor het beoordelen van bedrijfs- of gebiedsomstandigheden, vaststellen van knelpunten en plannen van doelen, maatregelen en monitoring.","en":"An overarching approach to assessing farm or landscape conditions, identifying problems and setting coordinated objectives, measures and monitoring arrangements."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MeasuringAndMonitoring","notation":["Meso"],"prefLabel":{"nl":"Meten en monitoren","en":"Measuring and monitoring"},"definition":{"nl":"Het systematisch en herhaald verzamelen van waarnemingen of metingen over bedrijfsmaatregelen, bodem, gewassen, dieren of milieuresultaten om veranderingen te volgen.","en":"Systematically collecting repeated observations or measurements of farm practices, soil, crops, livestock or environmental outcomes to assess change over time."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ManureSampleAnalysis","notation":["Micro"],"prefLabel":{"nl":"Mestmonsteranalyse","en":"Manure sample analysis"},"definition":{"nl":"Het analyseren van mestmonsters in het laboratorium of op het bedrijf om nutriëntengehalten en andere eigenschappen voor de bemestingsplanning te bepalen.","en":"Laboratory or on-farm analysis of manure samples to determine nutrient contents and other properties needed for fertilisation planning."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PlantJuiceAnalysis","notation":["Micro"],"prefLabel":{"nl":"Plantsapanalyse","en":"Plant juice analysis"},"definition":{"nl":"Het analyseren van uit plantenweefsel gewonnen sap op nutriënten of fysiologische indicatoren ter ondersteuning van teeltbeslissingen.","en":"Analysing sap extracted from plant tissues for nutrient or physiological indicators to inform crop management decisions."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/RemoteSensingMonitoring","notation":["Micro"],"prefLabel":{"nl":"Monitoring via remote sensing","en":"Remote sensing monitoring"},"definition":{"nl":"Het herhaald waarnemen van gewassen, bodem of landgebruik met sensoren op satellieten, vliegtuigen of drones die gereflecteerde of uitgezonden straling meten.","en":"Repeatedly observing crops, soil or land conditions through sensors that measure reflected or emitted energy from satellites, aircraft or drones."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SatelliteImageryAndMonitoring","notation":["Micro"],"prefLabel":{"nl":"Satellietbeelden en monitoring","en":"Satellite imagery and monitoring"},"definition":{"nl":"Het gebruiken van herhaalde satellietbeelden en daaruit afgeleide indicatoren voor vegetatie, vocht of landbedekking om perceelomstandigheden en veranderingen te volgen.","en":"Using repeated satellite images and derived vegetation, moisture or land-cover indicators to observe field conditions and detect changes over time."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SilageFeedSampleAnalysis","notation":["Micro"],"prefLabel":{"nl":"Analyse van kuilvoer- en voedermonsters","en":"Silage/feed sample analysis"},"definition":{"nl":"Het laboratoriumonderzoek van kuilvoer- of voermonsters op nutriënten, droge stof en kwaliteitsindicatoren voor rantsoenberekening en voerbeheer.","en":"Laboratory analysis of silage or feed samples for nutrients, dry matter and quality indicators to guide ration formulation and feed management."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SoilSampling","notation":["Micro"],"prefLabel":{"nl":"Bemonstering van de bodem","en":"Soil sampling"},"definition":{"nl":"Het nemen van representatieve bodemmonsters op vastgelegde locaties en diepten voor laboratoriumonderzoek of beoordeling in het veld.","en":"Collecting representative samples of soil at defined locations and depths for laboratory analysis or field assessment."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DiagnosisAndManagementPlansMeso","notation":["Meso"],"prefLabel":{"nl":"Diagnose- en beheerplannen","en":"diagnosis and management plans"},"definition":{"nl":"Het opstellen en gebruiken van concrete diagnoses en beheerplannen om ingrepen op een bedrijf of perceel te kiezen, uit te voeren en te evalueren.","en":"The preparation and use of specific diagnostic assessments and management plans to choose, implement and evaluate interventions on a farm or field."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NutrientManagementPlan","notation":["Micro"],"prefLabel":{"nl":"Nutriëntenbeheerplan","en":"nutrient management plan"},"definition":{"nl":"Een vastgelegd overzicht van nutriëntenaanbod, gewasbehoefte, toedieningstijdstippen en nutriëntenbalansen om bemesting te sturen en verliezen te beperken.","en":"A documented assessment of nutrient supply, crop demand, application timing and nutrient balances used to guide fertilisation and limit losses."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PesticidesManagementPlan","notation":["Micro"],"prefLabel":{"nl":"Gewasbeschermingsplan","en":"pesticides management plan"},"definition":{"nl":"Een vastgelegde strategie om plagen en ziekten te voorkomen, te monitoren en te beheersen, met criteria voor het eventueel inzetten van gewasbeschermingsmiddelen.","en":"A documented strategy for preventing, monitoring and controlling crop pests and diseases, including criteria for deciding when and how products may be used."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WaterManagementPlan","notation":["Micro"],"prefLabel":{"nl":"Waterbeheerplan","en":"water management plan"},"definition":{"nl":"Een vastgelegd plan met waterbronnen, risico's, doelen en maatregelen voor irrigatie, drainage, opslag, waterbesparing en monitoring op het bedrijf.","en":"A documented plan defining farm water sources, risks, targets and measures for irrigation, drainage, storage, conservation and monitoring."}}]}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/LivestockManagementAnimalHusbandryMega","notation":["Mega"],"prefLabel":{"nl":"Veehouderijbeheer","en":"Livestock management / animal husbandry"},"definition":{"nl":"Het overkoepelende beheerdomein voor het houden van landbouwhuisdieren, met productie, huisvesting, gezondheid, welzijn, voer en milieueffecten.","en":"The overarching management domain for keeping farm animals, encompassing production, housing, health, welfare, feed and environmental impacts."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/LivestockManagementAnimalHusbandryMacro","notation":["Macro"],"prefLabel":{"nl":"Veehouderijbeheer","en":"Livestock management / animal husbandry"},"definition":{"nl":"Het samenhangend aansturen van voeding, fokkerij, huisvesting, gezondheid, welzijn en beweiding van landbouwhuisdieren binnen het bedrijf.","en":"Coordinating livestock feeding, breeding, housing, health, welfare and grazing within a farm production system."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/AnimalHousing","notation":["Meso"],"prefLabel":{"nl":"Dierhuisvesting","en":"animal housing"},"definition":{"nl":"Het ontwerpen en beheren van stallen en schuilvoorzieningen voor landbouwhuisdieren, waaronder ruimte, stalklimaat, strooisel en toegang, met aandacht voor welzijn en emissies.","en":"Designing and managing buildings and shelters for farm animals, including their space, climate, bedding and access, with attention to welfare and emissions."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ClimateAndLightControl","notation":["Micro"],"prefLabel":{"nl":"Klimaat- en lichtregeling","en":"climate and light control"},"definition":{"nl":"Het regelen van temperatuur, luchtvochtigheid, ventilatie en licht in agrarische productieomgevingen om aan gewas- of dierbehoeften te voldoen en hulpbronnen efficiënt te benutten.","en":"Regulating temperature, humidity, ventilation and light in agricultural production environments to meet crop or animal requirements while managing resource use."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/BuildingForEmissionReduction","notation":["Micro"],"prefLabel":{"nl":"Gebouwen voor emissiereductie","en":"building for emission reduction"},"definition":{"nl":"Het bouwen of aanpassen van agrarische gebouwen om uitstoot van bijvoorbeeld ammoniak, methaan, geur of fijnstof bij de bron te verminderen.","en":"Constructing or modifying farm buildings to reduce releases of substances such as ammonia, methane, odour or particulate matter at their source."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ImplementHousingSystemToSeperateManureAndUrineInSolidAndLiquidFractions","notation":["Nano"],"prefLabel":{"nl":"Huisvestingssysteem voor scheiding van mest en urine","en":"Implement housing system to seperate manure and urine in solid and liquid fractions"},"definition":{"nl":"Het toepassen van stalvloeren of opvangsystemen die feces en urine kort na uitscheiding scheiden zodat beide fracties afzonderlijk kunnen worden behandeld en bepaalde emissies worden beperkt.","en":"Using housing floors or manure collection systems that separate faeces and urine soon after excretion to enable different treatment and reduce some emissions."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MobileChickenCoopsMicro","notation":["Micro"],"prefLabel":{"nl":"Mobiele kippenhokken","en":"Mobile chicken coops"},"definition":{"nl":"Het gebruiken van verplaatsbare kippenhokken die over landbouwgrond worden verschoven om wisselende buitenuitloop te bieden en mest en gebruiksdruk te spreiden.","en":"Using movable poultry housing that can be relocated across farmland to provide changing outdoor access and distribute manure and grazing pressure."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/OutdoorAccess","notation":["Micro"],"prefLabel":{"nl":"Buitenuitloop","en":"outdoor access"},"definition":{"nl":"Het bieden van toegang tot een buitenruimte waar landbouwhuisdieren kunnen bewegen, verkennen of grazen onder passende veiligheids- en welzijnsomstandigheden.","en":"Providing livestock with access to an outdoor area where animals can move, explore or graze under suitable safety and welfare conditions."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MobileChickenCoopsNano","notation":["Nano"],"prefLabel":{"nl":"Mobiele kippenhokken","en":"Mobile chicken coops"},"definition":{"nl":"Het volgens een planning verplaatsen van een mobiel kippenhok tussen concrete plekken in het grasland om langdurige belasting van één locatie te vermijden.","en":"Moving a portable chicken coop between specific pasture positions according to a planned schedule to avoid prolonged pressure at one spot."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MonitoringOfAnimalWelfare","notation":["Micro"],"prefLabel":{"nl":"Monitoring van dierenwelzijn","en":"monitoring of animal welfare"},"definition":{"nl":"Het regelmatig beoordelen van diergebonden indicatoren, zoals gedrag, verwondingen, lichaamsconditie en gezondheid, om welzijnsproblemen te signaleren en aan te pakken.","en":"Regularly assessing animal-based indicators such as behaviour, injuries, body condition and health to detect and address welfare problems."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SpaceForTheAnimalsToSleepAndRest","notation":["Micro"],"prefLabel":{"nl":"Rust- en ligruimte voor dieren","en":"space for the animals to sleep and rest"},"definition":{"nl":"Het bieden van voldoende geschikte rust- en ligplaatsen voor dieren, met schone en comfortabele oppervlakken, als onderdeel van diergericht huisvestingsbeheer.","en":"Providing livestock with sufficient, suitable resting and lying areas, including clean and comfortable surfaces, as part of housing welfare management."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SuitableMaterialForAnimalBedding","notation":["Micro"],"prefLabel":{"nl":"Geschikt strooiselmateriaal voor dieren","en":"suitable material for animal bedding"},"definition":{"nl":"Het kiezen van strooiselmaterialen die dieren een hygiënische, droge en comfortabele ligplek bieden, met aandacht voor beschikbaarheid en mestbeheer.","en":"Selecting bedding materials that provide livestock with hygienic, dry and comfortable lying conditions while considering availability and manure management."}}]}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PeopleManagement","notation":["Mega"],"prefLabel":{"nl":"Personeelsbeheer","en":"people management"},"definition":{"nl":"Het organiseren van werving, scholing, werkbelasting, arbeidsomstandigheden en arbeidsrelaties van medewerkers op het landbouwbedrijf.","en":"Organising recruitment, training, workload, working conditions and employment relationships for workers on the farm."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/FarmCitizenInteractions","notation":["Macro"],"prefLabel":{"nl":"Interacties tussen landbouwbedrijf en burgers","en":"farm-citizen interactions"},"definition":{"nl":"Het opbouwen van direct contact tussen het landbouwbedrijf en burgers door gesprekken, participatie, bijeenkomsten of gezamenlijke activiteiten.","en":"Establishing direct contacts between the farm and members of the public through dialogue, participation, events or shared activities."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/FormsOfDirectFoodProvisioning","notation":["Meso"],"prefLabel":{"nl":"Vormen van directe voedselvoorziening","en":"Forms of direct food provisioning"},"definition":{"nl":"Afzetvormen waarbij voedsel met weinig tussenhandel rechtstreeks van landbouwbedrijven naar consumenten gaat, zoals pakketten, zelfoogst of boerderijwinkels.","en":"Arrangements that deliver food directly from farms to consumers with few intermediaries, such as farm boxes, self-picking or farm shops."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CSASelfPickingOnFarmsShops","notation":["Micro"],"prefLabel":{"nl":"Gemeenschapslandbouw, zelfpluk en boerderijwinkels","en":"CSA, self-picking, on-farms shops"},"definition":{"nl":"Vormen van rechtstreekse voedselvoorziening waarbij consumenten producten verkrijgen via gemeenschapslandbouw, zelfoogst of een winkel op het landbouwbedrijf.","en":"Farm-to-consumer arrangements in which customers obtain produce through community-supported agriculture, self-harvesting or a shop on the farm."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/GreenCare","notation":["Meso"],"prefLabel":{"nl":"Groene zorg","en":"Green care"},"definition":{"nl":"Het inzetten van de boerderijomgeving, dieren, planten en werkzaamheden in georganiseerde zorg-, begeleidings- of therapeutische trajecten.","en":"Using farm environments, animals, plants and activities in organised care, support or therapeutic programmes for people with care needs."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DifferentTypesOfClients","notation":["Micro"],"prefLabel":{"nl":"Verschillende typen afnemers","en":"Different types of clients"},"definition":{"nl":"Het spreiden van de klantenkring over consumenten, bedrijven, instellingen of coöperatieve afnemers om minder afhankelijk te worden van één afzetkanaal.","en":"Diversifying the farm's customer base across consumer, business, institutional or cooperative buyers to reduce dependence on a single sales channel."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/FarmEducation","notation":["Meso"],"prefLabel":{"nl":"Educatie op het landbouwbedrijf","en":"Farm education"},"definition":{"nl":"Het aanbieden van georganiseerde leeractiviteiten op een actief landbouwbedrijf over landbouw, voedselproductie, natuur of bedrijfsvoering.","en":"Providing structured learning experiences on a working farm about agriculture, food production, nature or farm management."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/FaciliateFarmVisits","notation":["Micro"],"prefLabel":{"nl":"Faciliteren van boerderijbezoeken","en":"Faciliate 'farm visits'"},"definition":{"nl":"Het organiseren van bezoeken aan het landbouwbedrijf voor burgers, adviseurs, studenten of collega-boeren om de bedrijfsvoering te bekijken en kennis uit te wisselen.","en":"Organising farm visits for citizens, advisers, students or other farmers to observe production practices and exchange information on site."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CommunityEngagement","notation":["Meso"],"prefLabel":{"nl":"Betrokkenheid van de lokale gemeenschap","en":"Community engagement"},"definition":{"nl":"Het organiseren van contact tussen een landbouwbedrijf en omwonenden of lokale organisaties, met ruimte voor deelname, dialoog en wederzijds begrip over de bedrijfsvoering.","en":"Creating structured interactions between a farm and local residents or organisations, allowing participation, dialogue and mutual understanding about farm activities."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/OrganiseActivitiesForTheLocalCommunityEGParticipationEveningsWorkshopsParties","notation":["Micro"],"prefLabel":{"nl":"Activiteiten voor de lokale gemeenschap organiseren","en":"Organise activities for the local community (e.g. participation evenings, workshops, parties)"},"definition":{"nl":"Het organiseren van bijvoorbeeld inspraakavonden, workshops of buurtbijeenkomsten die het landbouwbedrijf verbinden met bewoners en lokale organisaties.","en":"Hosting activities such as participation meetings, workshops or community gatherings that connect the farm with residents and local organisations."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/RepresentationOfFarmers","notation":["Meso"],"prefLabel":{"nl":"Belangenvertegenwoordiging van boeren","en":"Representation of farmers"},"definition":{"nl":"Het namens boeren deelnemen aan overleg, onderhandelingen of besluitvormende organen om gezamenlijke belangen uit te dragen en te behartigen.","en":"Acting on behalf of farmers in consultation, negotiations or decision-making bodies to communicate and defend their shared interests."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ParticipationInCollectivesNetworksOrBoardsEGWaterboardPolitics","notation":["Micro"],"prefLabel":{"nl":"Deelname aan collectieven, netwerken en besturen","en":"Participation in collectives, networks or boards (e.g. waterboard, politics)"},"definition":{"nl":"Het deelnemen aan producentencollectieven, netwerken, besturen of publieke organisaties om besluiten te beïnvloeden en gezamenlijke agrarische activiteiten af te stemmen.","en":"Taking part in producer groups, networks, governing boards or public organisations to influence decisions and coordinate actions relevant to farming."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Agrotourism","notation":["Meso"],"prefLabel":{"nl":"Agritoerisme","en":"Agrotourism"},"definition":{"nl":"Het aanbieden van toeristische en recreatieve activiteiten op of rond een actief landbouwbedrijf, zoals logeren, rondleidingen of boerderijbeleving, als aanvullende bedrijfsactiviteit.","en":"Providing tourism and recreation activities connected to a working farm, such as farm stays, tours or on-farm experiences, as a complementary business activity."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WalkingTrailsOnFarmLandCamping","notation":["Micro"],"prefLabel":{"nl":"Wandelpaden en kamperen op landbouwgrond","en":"Walking trails on farm land, camping,"},"definition":{"nl":"Het aanbieden van wandelroutes, recreatieve toegang of kampeervoorzieningen op landbouwgrond, afgestemd op de reguliere bedrijfsvoering.","en":"Providing recreational access, walking routes or camping facilities on agricultural land while coordinating visitor use with farming operations."}}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/RegenerativeCapacityClassificationElement","notation":["Macro"],"prefLabel":{"nl":"Regeneratief vermogen","en":"regenerative capacity"},"definition":{"nl":"Het vermogen van een agrarische bodem of productiesysteem om functies te herstellen en ecologische processen na verstoring te behouden of te verbeteren.","en":"The capacity of an agricultural soil or production system to recover functions and maintain or improve ecological processes after disturbance."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/FormalLearning","notation":["Meso"],"prefLabel":{"nl":"Formeel leren","en":"formal learning"},"definition":{"nl":"Deelname aan georganiseerd onderwijs of scholing met vooraf bepaalde leerdoelen, een programma en vaak toetsing of certificering.","en":"Participation in organised education or training with specified learning goals, a curriculum and often assessment or certification."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CompetenceDevelopmentOpportunitiesAtPublicEducationalInstitutes","notation":["Micro"],"prefLabel":{"nl":"Mogelijkheden voor competentieontwikkeling in het openbaar onderwijs","en":"(Competence) development opportunities at public educational institutes"},"definition":{"nl":"Het bieden van mogelijkheden aan boeren of medewerkers om kennis en vaardigheden te ontwikkelen via opleidingen, cursussen of trainingen bij openbare onderwijsinstellingen.","en":"Providing farmers or farm workers with opportunities to acquire skills and knowledge through courses, training or qualifications offered by public educational institutions."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/InformalLearning","notation":["Meso"],"prefLabel":{"nl":"Informeel leren","en":"Informal learning"},"definition":{"nl":"Leren door praktijkervaring, observeren, overleg met collega's of dagelijkse ervaringen zonder vast lesprogramma of formeel diploma.","en":"Learning through practice, observation, peer discussion or everyday experience without a formal curriculum or qualification."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ParticipationInStudyGroupsReconsideringHumanNonhumanRelations","notation":["Micro"],"prefLabel":{"nl":"Deelname aan studiegroepen over relaties tussen mens en natuur","en":"Participation in study groups, (reconsidering human-nonhuman relations)"},"definition":{"nl":"Het deelnemen aan studiegroepen die bespreken hoe landbouwpraktijken zich verhouden tot dieren, planten, bodems en ander niet-menselijk leven.","en":"Joining organised discussions or learning groups that examine how farming practices affect and relate to animals, plants, soils and other non-human life."}}]}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/LandManagement","notation":["Mega"],"prefLabel":{"nl":"Landbeheer","en":"Land management"},"definition":{"nl":"Het plannen en uitvoeren van de inrichting, het gebruik en het onderhoud van landbouwgrond, waaronder percelen, randen, bodem, water en landschapselementen.","en":"Planning and implementing how agricultural land is allocated, used and maintained, including fields, margins, soil, water and landscape features."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WaterManagement","notation":["Macro"],"prefLabel":{"nl":"Waterbeheer","en":"Water management"},"definition":{"nl":"Het afstemmen van drainage, irrigatie, wateropslag en peilbeheer op landbouwgrond om productie, waterkwaliteit en ecologische behoeften te dienen.","en":"Coordinating drainage, irrigation, storage and water-level control on farmland to maintain production while addressing water quality and ecological needs."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WaterStorage","notation":["Meso"],"prefLabel":{"nl":"Wateropslag","en":"Water storage"},"definition":{"nl":"Het tijdelijk vasthouden van water in tanks, vijvers, bodems of aangelegde reservoirs voor later gebruik of gecontroleerde afgifte.","en":"Holding water temporarily in tanks, ponds, soils or constructed reservoirs for use or controlled release at a later time."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Ditches","notation":["Micro"],"prefLabel":{"nl":"Sloten","en":"Ditches"},"definition":{"nl":"Het beheren of onderhouden van open sloten en afwateringskanalen in landbouwgebied om waterstanden en afvoer te regelen met aandacht voor leefgebiedfuncties.","en":"Managing or maintaining open drainage and water-conveyance channels in farmland to regulate water levels and movement while considering habitat functions."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/InfiltrationChannels","notation":["Micro"],"prefLabel":{"nl":"Infiltratiegeulen","en":"Infiltration channels"},"definition":{"nl":"Het aanleggen van ondiepe geulen of sleuven die afstromend water opvangen en geleiden zodat het in de bodem kan infiltreren in plaats van snel af te voeren.","en":"Constructing shallow channels or trenches that direct and retain runoff so that water can infiltrate into the soil instead of flowing away rapidly."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NaturalWaterHarvesting","notation":["Micro"],"prefLabel":{"nl":"Natuurlijke wateropvang","en":"Natural water harvesting"},"definition":{"nl":"Het opvangen en vasthouden van neerslag of afstromend water met landschapselementen, bodemmaatregelen of natuurlijke buffers voor latere infiltratie of benutting.","en":"Capturing and retaining rainfall or surface runoff using landscape features, soil measures or natural storage for later infiltration or use."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Pond","notation":["Micro"],"prefLabel":{"nl":"Poel","en":"Pond"},"definition":{"nl":"Het aanleggen of onderhouden van een kleine stilstaande waterpartij op landbouwgrond voor waterberging, leefgebied voor soorten of andere bedrijfsfuncties.","en":"Creating or maintaining a small standing-water body on farmland for water storage, wildlife habitat or other farm functions."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/RainfedSystem","notation":["Micro"],"prefLabel":{"nl":"Regenafhankelijk teeltsysteem","en":"Rainfed system"},"definition":{"nl":"Een teeltsysteem dat vooral afhankelijk is van natuurlijke neerslag in plaats van reguliere irrigatie, met beheer afgestemd op het lokale neerslagpatroon.","en":"A crop production system supplied primarily by natural rainfall rather than regular irrigation, with management adapted to local rainfall patterns."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Swales","notation":["Micro"],"prefLabel":{"nl":"Wadi's en infiltratiegreppels","en":"Swales"},"definition":{"nl":"Het aanleggen van ondiepe, vaak langs hoogtelijnen gelegen begroeide geulen die afstromend water opvangen en infiltratie bevorderen.","en":"Constructing shallow, often contour-aligned vegetated depressions that intercept runoff and encourage water infiltration into the landscape."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WaterBuffers","notation":["Micro"],"prefLabel":{"nl":"Waterbuffers","en":"Water buffers"},"definition":{"nl":"Het aanleggen of gebruiken van tijdelijke waterbergingsgebieden die overtollige neerslag of afstroming opvangen en water vertraagd afvoeren of laten infiltreren.","en":"Creating or using temporary storage areas that absorb excess rainwater or runoff and release or infiltrate water more gradually."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WaterFiltration","notation":["Micro"],"prefLabel":{"nl":"Waterfiltratie","en":"Water filtration"},"definition":{"nl":"Het verwijderen van zwevende stoffen, nutriënten of andere verontreinigingen uit agrarische waterstromen met filters, vegetatie, substraten of zuiveringssystemen.","en":"Removing suspended matter, nutrients or other contaminants from farm-related water flows using filters, vegetation, substrates or treatment systems."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WaterReservoirs","notation":["Micro"],"prefLabel":{"nl":"Waterreservoirs","en":"Water reservoirs"},"definition":{"nl":"Het aanleggen of onderhouden van bassins, tanks of vijvers voor opslag van water voor beregening, vee of andere bedrijfsbehoeften.","en":"Constructing or maintaining basins, tanks or ponds intended to store water for irrigation, livestock or other farm needs."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MinimizeWaterUse","notation":["Meso"],"prefLabel":{"nl":"Watergebruik minimaliseren","en":"Minimize water use"},"definition":{"nl":"Het verminderen van het totale waterverbruik van bedrijfsactiviteiten of teelten door efficiëntie, hergebruik of vraaggericht beheer.","en":"Reducing the total water consumed by farm operations or crops through efficiency, reuse or demand management."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WaterSavingIrrigation","notation":["Micro"],"prefLabel":{"nl":"Waterbesparende irrigatie","en":"water-saving irrigation"},"definition":{"nl":"Het toepassen van irrigatietechnieken of schema's die het benodigde water leveren met minder verspilling door verdamping, lekkage, afstroming of overberegening.","en":"Applying irrigation technologies or schedules that deliver the required water with less waste through evaporation, leakage, runoff or overwatering."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DripIrrigation","notation":["Nano"],"prefLabel":{"nl":"Druppelirrigatie","en":"Drip irrigation"},"definition":{"nl":"Het langzaam en plaatselijk toedienen van water via druppelaars of druppelslangen bij de wortelzone, met gerichte dosering en minder verdamping en afstroming.","en":"Applying water slowly and locally through emitters or drip lines near plant roots, allowing controlled watering with reduced evaporation and runoff."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DryFarming","notation":["Micro"],"prefLabel":{"nl":"Droge teelt zonder irrigatie","en":"Dry farming"},"definition":{"nl":"Het telen van gewassen zonder reguliere beregening, op basis van neerslag, opgeslagen bodemvocht en maatregelen die water vasthouden.","en":"Growing crops without routine irrigation by relying on precipitation, stored soil moisture and water-conserving soil and crop management."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MinimizeIrrigation","notation":["Micro"],"prefLabel":{"nl":"Irrigatie minimaliseren","en":"Minimize irrigation"},"definition":{"nl":"Het beperken van beregeningsfrequentie of watervolume door watergiften op de gewasbehoefte af te stemmen en bodemvocht vast te houden.","en":"Reducing irrigation frequency or volume by matching watering to crop needs and using soil-moisture conservation measures."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceWaterUse","notation":["Micro"],"prefLabel":{"nl":"Watergebruik verminderen","en":"Reduce water use"},"definition":{"nl":"Het verminderen van de hoeveelheid water die bedrijfsprocessen of beregening verbruiken door betere planning, efficiënte voorzieningen of hergebruik.","en":"Decreasing the amount of water consumed by farm processes or crop irrigation through better scheduling, efficient devices or reuse."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/KeepWaterLevelsHighMeso","notation":["Meso"],"prefLabel":{"nl":"Hoge waterstanden handhaven","en":"keep water levels high"},"definition":{"nl":"Het sturen van waterstanden op landbouwgrond naar een relatief hoog streefpeil om ontwatering of bodemdaling te beperken en waar passend natte omstandigheden te ondersteunen.","en":"Managing farmland water levels at a relatively high target to limit drainage or subsidence and support wet conditions where appropriate."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/KeepWaterLevelsHighMicro","notation":["Micro"],"prefLabel":{"nl":"Hoge waterstanden handhaven","en":"keep water levels high"},"definition":{"nl":"Het handhaven van een afgesproken hogere oppervlaktewater- of grondwaterstand met regelbare drainage, stuwen of andere waterregelvoorzieningen.","en":"Maintaining an agreed elevated surface-water or groundwater level through adjustable drains, weirs or water-control structures."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Paludicultuur","notation":["Micro"],"prefLabel":{"nl":"Paludicultuur (natte teelt)","en":"paludicultuur"},"definition":{"nl":"Het telen van gewassen die geschikt zijn voor permanent natte of vernatte bodems, zoals veengronden, terwijl hoge waterstanden behouden blijven.","en":"Cultivating crops adapted to permanently wet or rewetted soils, such as peatlands, while maintaining high water tables."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MaintainWaterlevelsConstant","notation":["Meso"],"prefLabel":{"nl":"Waterstanden constant houden","en":"maintain waterlevels constant"},"definition":{"nl":"Het gebruiken van stuwen, regelbare drainage of ander waterbeheer om oppervlaktewater- of grondwaterstanden dicht bij een gekozen streefpeil te houden.","en":"Using water-control structures or drainage management to keep surface-water or groundwater levels near a chosen target with limited fluctuations."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SubsurfaceDrainage","notation":["Micro"],"prefLabel":{"nl":"Ondergrondse drainage","en":"subsurface drainage"},"definition":{"nl":"Het gebruiken van buizen of andere ondergrondse drainagevoorzieningen om overtollig water af te voeren en grondwaterstanden op percelen te beheersen.","en":"Using pipes or other drainage structures below the soil surface to control excess water and manage groundwater levels in agricultural fields."}}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/AgroforestryAndPerennialIntegratedSystems","notation":["Macro"],"prefLabel":{"nl":"Agroforestry en systemen met meerjarige gewassen","en":"Agroforestry and Perennial-Integrated Systems -"},"definition":{"nl":"Landgebruikssystemen waarin bomen, struiken of andere meerjarige gewassen met eenjarige teelten of vee worden gecombineerd tot een gevarieerd productiesysteem met blijvende vegetatie.","en":"Land-use systems combining woody vegetation or other perennial crops with annual crops or livestock to create a diversified and persistent production structure."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Reforestation","notation":["Meso"],"prefLabel":{"nl":"Herbebossing","en":"Reforestation"},"definition":{"nl":"Het herstellen van bomen en bosvegetatie op grond die eerder bos was maar de boombedekking heeft verloren.","en":"Re-establishing trees and forest vegetation on land that previously carried forest but has lost its tree cover."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/AfforestationReforestationReplantingTrees","notation":["Micro"],"prefLabel":{"nl":"Bebossing, herbebossing en herplant van bomen","en":"Afforestation, Reforestation, replanting trees"},"definition":{"nl":"Het vestigen van bomen op voorheen onbeboste grond, herstellen van boombedekking na ontbossing of vervangen van verdwenen bomen door aanplant of natuurlijke verjonging.","en":"Establishing trees on previously non-forested land, restoring tree cover on deforested land, or replacing lost trees through planting or natural regeneration."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ForestConservation","notation":["Micro"],"prefLabel":{"nl":"Bosbehoud","en":"Forest conservation"},"definition":{"nl":"Het beschermen van bestaande bossen en hun ecologische functies door ontbossing te voorkomen en aantasting of versnippering tegen te gaan.","en":"Protecting existing forest cover and ecological functions by avoiding clearing and managing threats such as degradation or fragmentation."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/TreePlanning","notation":["Meso"],"prefLabel":{"nl":"Bomen aanplanten en beheren","en":"tree planning"},"definition":{"nl":"Het plannen waar en hoe bomen op een landbouwbedrijf worden aangeplant en beheerd, inclusief soortkeuze, plantafstand, onderhoud en beoogde functies.","en":"Planning where and how trees will be planted and managed on a farm, including species choice, spacing, maintenance and intended functions."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Agroforestry","notation":["Micro"],"prefLabel":{"nl":"Agroforestry","en":"Agroforestry"},"definition":{"nl":"Het doelbewust combineren van bomen of struiken met gewassen en/of vee binnen dezelfde beheereenheid, zodat houtige en agrarische onderdelen ecologisch en economisch samenhangen.","en":"Deliberately integrating trees or shrubs with crops and/or livestock on the same land management unit so that the woody and agricultural components interact."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/FoodForest","notation":["Micro"],"prefLabel":{"nl":"Voedselbos","en":"Food forest"},"definition":{"nl":"Een doelbewust ingericht meerlagig teeltsysteem met vooral meerjarige eetbare planten, waaronder bomen en struiken, voor voedsel en andere producten.","en":"A deliberately designed, multi-layered system of mainly perennial edible plants, including trees and shrubs, managed for food and other useful products."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Permaculture","notation":["Micro"],"prefLabel":{"nl":"Permacultuur","en":"Permaculture"},"definition":{"nl":"Een ontwerpbenadering voor productieve landschappen die ecologische relaties, diversiteit en kringlopen benut om gewassen, dieren, water en menselijke activiteiten samenhangend in te richten.","en":"A design approach for productive landscapes that uses ecological relationships, diversity and resource cycling to organise crops, animals, water and human activities."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PlantingShadeTrees","notation":["Micro"],"prefLabel":{"nl":"Schaduwbomen aanplanten","en":"Planting shade trees"},"definition":{"nl":"Het aanplanten van bomen voor schaduw aan vee, gewassen of mensen en voor beperking van hittestress in het agrarische landschap.","en":"Establishing trees to provide shade for livestock, crops or people and to reduce heat exposure in agricultural landscapes."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Silvopasture","notation":["Micro"],"prefLabel":{"nl":"Bomen gecombineerd met beweiding","en":"Silvopasture"},"definition":{"nl":"Een agroforestrysysteem waarin bomen of struiken doelbewust worden gecombineerd met grazend vee en ruwvoerproductie op hetzelfde oppervlak.","en":"An agroforestry system deliberately combining trees or shrubs with grazing livestock and forage production in the same area."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ShadeTreePlanting","notation":["Nano"],"prefLabel":{"nl":"Schaduwbomen planten","en":"shade tree planting"},"definition":{"nl":"Het aanplanten van bomen op gekozen plekken op het bedrijf om schaduw te bieden en hittebelasting van dieren, gewassen of medewerkers te beperken.","en":"Establishing trees at selected farm locations to provide shade that mitigates heat exposure for animals, crops or workers."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SyntropicFarming","notation":["Micro"],"prefLabel":{"nl":"Syntropische landbouw","en":"Syntropic farming"},"definition":{"nl":"Het beheren van zeer diverse, vaak boomrijke teeltsystemen via geplande successie, dichte beplanting en snoei om biomassa op te bouwen en ecologische processen te ondersteunen.","en":"Managing highly diverse, often tree-based crop systems through planned succession, dense planting and pruning to build biomass and support ecological processes."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Silvoarable","notation":["Micro"],"prefLabel":{"nl":"Bomen gecombineerd met akkerbouw","en":"Silvoarable"},"altLabel":{"en":["silvoarable"]},"definition":{"nl":"Een agroforestrysysteem waarin bomen of struiken met akkerbouwgewassen op dezelfde grond worden gecombineerd, bijvoorbeeld teelten tussen bomenrijen.","en":"An agroforestry system combining trees or shrubs with arable crops on the same land, for example crops between tree rows."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/UsePerennialsMeso","notation":["Meso"],"prefLabel":{"nl":"Meerjarige gewassen gebruiken","en":"Use perennials"},"definition":{"nl":"Het opnemen van meerjarige gewassen die gedurende meerdere jaren productief blijven of levende plantstructuren behouden binnen het teeltsysteem.","en":"Including perennial crops that remain productive or maintain living plant structures across multiple years as part of the cropping system."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/UsePerennialsMicro","notation":["Micro"],"prefLabel":{"nl":"Meerjarige gewassen gebruiken","en":"Use perennials"},"definition":{"nl":"Het telen van een concreet meerjarig gewas op een perceel in plaats van jaarlijks een eenjarig gewas opnieuw te vestigen, waar passend met minder bodemverstoring.","en":"Cultivating an identified perennial crop on a field rather than re-establishing an annual crop each year, reducing yearly soil disturbance where appropriate."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PermanentGrasslandTreesHedges","notation":["Nano"],"prefLabel":{"nl":"Blijvend grasland met bomen en heggen","en":"permanent grassland, trees, hedges"},"definition":{"nl":"Langjarig grasland waarin of waarlangs blijvende bomen en heggen voorkomen die naast grasproductie leefgebied, beschutting of andere functies bieden.","en":"Long-term grassland that includes or borders established trees and hedgerows used for habitat, shelter or other functions alongside grass production."}}]}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WildlifeProtection","notation":["Macro"],"prefLabel":{"nl":"Bescherming van wilde dieren","en":"wildlife protection"},"definition":{"nl":"Het voorkomen van schade aan wilde dieren door agrarische activiteiten via leefgebiedbeheer, aangepaste werkzaamheden, afrastering of soortgerichte maatregelen.","en":"Preventing harm to wild animals from farm activities through habitat management, adjusted operations, fencing or other species-specific measures."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/HabitatProvisionBiodiversityEnhancement","notation":["Meso"],"prefLabel":{"nl":"Leefgebieden creëren en biodiversiteit versterken","en":"Habitat provision/ biodiversity enhancement"},"definition":{"nl":"Het aanleggen, herstellen of beheren van leefgebieden op landbouwgrond om diversiteit of aantallen wilde planten en dieren te ondersteunen.","en":"Creating, restoring or managing habitats on farmland to support a greater diversity or abundance of wild plants and animals."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/FlowerHerbNatureStrips","notation":["Micro"],"prefLabel":{"nl":"Bloemen-, kruiden- en natuurstroken","en":"Flower/herb/nature strips"},"definition":{"nl":"Het aanleggen of behouden van stroken met bloemen, kruiden of halfnatuurlijke vegetatie langs of in percelen als leefgebied en voedselbron voor fauna.","en":"Establishing or retaining strips of flowering plants, herbs or semi-natural vegetation along or within fields to provide habitat and food resources for wildlife."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/BiodiversityLanesFieldMarginsSteppingStones05Ha","notation":["Nano"],"prefLabel":{"nl":"Biodiversiteitsstroken, akkerranden en stapstenen (meer dan 0,5 ha)","en":"biodiversity lanes; field margins; stepping stones (> 0.5 ha)"},"definition":{"nl":"Het aanleggen of beheren van begroeide akkerranden, verbindingsstroken of leefgebiedplekken groter dan 0,5 hectare die voedsel, beschutting en verbindingen voor soorten bieden.","en":"Creating or maintaining vegetated field margins, corridors or habitat patches larger than 0.5 hectares that offer food, shelter and ecological connections for species."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/BiodiversitySheltersEGBushes","notation":["Micro"],"prefLabel":{"nl":"Schuilplaatsen voor biodiversiteit (bijvoorbeeld struiken)","en":"Biodiversity shelters (e.g. bushes)"},"definition":{"nl":"Het behouden of aanleggen van kleine leefgebiedstructuren, zoals struiken en struweel, die wilde soorten beschutting, nestgelegenheid of een schuilplek bieden.","en":"Providing small habitat structures such as shrubs, scrub patches or shelter belts that give wild organisms cover, nesting opportunities or refuge."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/BirdAndBatBoxes","notation":["Micro"],"prefLabel":{"nl":"Vogel- en vleermuiskasten","en":"Bird and bat boxes"},"definition":{"nl":"Het plaatsen van kunstmatige nest- of verblijfplaatsen voor vogels en vleermuizen op of naast landbouwgrond waar natuurlijke plaatsen beperkt aanwezig zijn.","en":"Installing artificial nesting or roosting structures for birds and bats on or near agricultural land where suitable natural sites are scarce."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/InsectHotels","notation":["Micro"],"prefLabel":{"nl":"Insectenhotels","en":"Insect hotels"},"definition":{"nl":"Het plaatsen van constructies met holtes of nestmateriaal als schuil- of nestgelegenheid voor bepaalde solitaire bijen en andere nuttige insecten.","en":"Installing structures with cavities or nesting materials that provide shelter or nesting sites for certain solitary bees and other beneficial insects."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NaturalBufferZones","notation":["Micro"],"prefLabel":{"nl":"Natuurlijke bufferzones","en":"Natural buffer zones"},"definition":{"nl":"Het behouden van stroken of plekken halfnatuurlijke vegetatie tussen landbouwgrond en kwetsbare gebieden om afstroming op te vangen, leefgebied te bieden of verstoring te verminderen.","en":"Maintaining strips or patches of semi-natural vegetation between farmland and vulnerable areas to intercept runoff, provide habitat or reduce disturbance."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/EcologicalWaterwayAndDitchManagement","notation":["Micro"],"prefLabel":{"nl":"Ecologisch beheer van watergangen en sloten","en":"Ecological waterway and ditch management"},"definition":{"nl":"Het ecologisch beheren van slootkanten en watergangen met bijvoorbeeld gefaseerd maaien, behoud van vegetatie en beperkte verstoring voor water- en oevernatuur.","en":"Managing banks and watercourses with measures such as phased mowing, vegetation retention and reduced disturbance to support aquatic and riparian biodiversity."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PermanentVegetationAtBordersDitchCleaningBaggerenPreventLivestockAccessToWaterways","notation":["Nano"],"prefLabel":{"nl":"Permanente oevervegetatie, slootonderhoud en uitsluiten van vee","en":"permanent vegetation at borders; ditch cleaning (baggeren); Prevent livestock access to waterways"},"definition":{"nl":"Het behouden van begroeide oevers, zorgvuldig uitvoeren van slootonderhoud en voorkomen dat vee watergangen betreedt om oevers en waterkwaliteit te beschermen.","en":"Maintaining vegetated water margins, managing ditch clearance and preventing livestock from entering waterways to protect banks and water quality."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/RuggedVegetation","notation":["Micro"],"prefLabel":{"nl":"Ruigtevegetatie","en":"rugged vegetation"},"definition":{"nl":"Het behouden of ontwikkelen van hogere, minder intensief beheerde ruige kruidenvegetatie of struweel als gevarieerd leefgebied in het landbouwlandschap.","en":"Retaining or developing taller, less intensively managed herbaceous vegetation or scrub patches as varied habitat in the agricultural landscape."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SteppingStones05Ha","notation":["Micro"],"prefLabel":{"nl":"Ecologische stapstenen (meer dan 0,5 ha)","en":"stepping stones (> 0.5 ha)"},"definition":{"nl":"Het aanleggen of behouden van leefgebiedplekken groter dan 0,5 hectare die als tussenliggende schuilplaatsen of verbindingen tussen grotere natuurgebieden dienen.","en":"Creating or retaining habitat patches larger than 0.5 hectares that serve as intermediate refuges or links between larger natural areas."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/TreesAndHedgesAsHabitat","notation":["Micro"],"prefLabel":{"nl":"Bomen en heggen als leefgebied","en":"Trees and hedges as habitat"},"definition":{"nl":"Het behouden, aanplanten of beheren van bomen en heggen die nestplaatsen, voedsel, beschutting en verplaatsingsroutes voor fauna bieden.","en":"Retaining, planting or managing trees and hedgerows to offer nesting sites, food, shelter and movement routes for wildlife."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WettedZonesSwalesForMeadowBirds","notation":["Micro"],"prefLabel":{"nl":"Natte zones en greppels voor weidevogels","en":"Wetted zones/swales (for meadow birds)"},"definition":{"nl":"Het aanleggen of behouden van ondiepe natte plekken en waterhoudende laagtes in grasland die geschikte voedsel- en broedomstandigheden voor weidevogels bieden.","en":"Creating or maintaining shallow wet areas and water-filled depressions in grassland that provide feeding and breeding habitat conditions for meadow birds."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NativeCropAndAnimalSpecies","notation":["Meso"],"prefLabel":{"nl":"Inheemse gewas- en diersoorten","en":"Native crop and animal species"},"definition":{"nl":"Het inzetten van gewassoorten of veerassen die uit de regio afkomstig zijn of daar historisch thuishoren, met passend behoud en beheer.","en":"Using crop species or livestock breeds originating from or historically established in the region, subject to suitable conservation and husbandry practice."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/LocalOrNativeCropAndAnimalSpecies","notation":["Micro"],"prefLabel":{"nl":"Lokale of inheemse gewas- en diersoorten","en":"Local or native crop and animal species"},"definition":{"nl":"Het kiezen van gewas- of diersoorten en rassen die lokaal aangepast of inheems zijn, rekening houdend met geschiktheid voor het agro-ecosysteem.","en":"Selecting crop or livestock species and varieties that are locally adapted or native to the region, with attention to agroecological suitability."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NativeTrees","notation":["Micro"],"prefLabel":{"nl":"Inheemse bomen","en":"Native trees"},"definition":{"nl":"Het planten of behouden van boomsoorten die van nature in de regio voorkomen en passen bij de lokale ecologische omstandigheden.","en":"Planting or retaining tree species naturally occurring in the region and suited to local ecological conditions."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ProtectNativeSpecies","notation":["Micro"],"prefLabel":{"nl":"Inheemse soorten beschermen","en":"Protect native species"},"definition":{"nl":"Het uitvoeren van beheermaatregelen die het voortbestaan van in de regio van nature voorkomende planten- en diersoorten beschermen of verbeteren.","en":"Applying management measures that conserve or improve the survival of plant and animal species naturally occurring in the region."}}]}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CropProductionManagement","notation":["Mega"],"prefLabel":{"nl":"Gewasproductiebeheer","en":"Crop Production Management"},"definition":{"nl":"De samenhangende aansturing van gewasproductie, waaronder vruchtwisseling, bodembewerking, zaaien, bemesting, gewasbescherming en oogst.","en":"The coordinated management of crop production, including rotations, soil preparation, sowing, nutrition, pest control and harvest."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/FertilizationAndManureManagement","notation":["Macro"],"prefLabel":{"nl":"Bemesting en mestbeheer","en":"fertilization and manure management"},"definition":{"nl":"Het plannen van productie, opslag, verwerking en toediening van mest en meststoffen om gewassen te voeden en verliezen naar lucht en water te beperken.","en":"Planning the production, storage, treatment and application of manure and fertilisers to supply crops with nutrients while limiting losses to air and water."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SpecificFertilizerApplicationTechniques","notation":["Meso"],"prefLabel":{"nl":"Specifieke bemestingstechnieken","en":"Specific fertilizer application techniques"},"definition":{"nl":"Het toepassen van gekozen manieren om nutriënten toe te dienen, zoals injecteren, rijenbemesting of precisieverspreiding, om efficiëntie te vergroten en verliezen te beperken.","en":"Using selected methods for nutrient placement or delivery, such as injection, band placement or precision spreading, to improve efficiency and reduce losses."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/AddingWaterToSlurryManure","notation":["Micro"],"prefLabel":{"nl":"Water toevoegen aan drijfmest","en":"Adding water to slurry manure"},"definition":{"nl":"Het verdunnen van drijfmest met water vóór of tijdens het uitrijden, zodat de mest beter vloeit en infiltreert en onder geschikte omstandigheden minder ammoniak kan vervluchtigen.","en":"Diluting livestock slurry with water before or during application to improve flow and infiltration and potentially reduce ammonia loss under suitable conditions."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DepeningOnTheNeedOfTheCropLesOrLessOften","notation":["Micro"],"prefLabel":{"nl":"Afstemmen op gewasbehoefte (minder of minder vaak)","en":"Depening on the need of the crop (les or less often)"},"definition":{"nl":"Het afstemmen van hoeveelheden en frequentie van water, meststoffen of andere inputs op de gemeten of verwachte gewasbehoefte in plaats van standaard meer toe te dienen.","en":"Adjusting application rates and frequency of irrigation, fertilisers or other inputs to measured or expected crop demand rather than applying a fixed excess."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MoreEfficientFertilizerAplication","notation":["Micro"],"prefLabel":{"nl":"Efficiëntere meststoftoediening","en":"More efficient fertilizer aplication"},"definition":{"nl":"Het verbeteren van plaatsing, timing, dosering of apparatuur bij bemesting zodat gewassen nutriënten beter benutten en verliezen afnemen.","en":"Improving placement, timing, dosing or equipment used for fertiliser application so that crops capture more nutrients and losses are reduced."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoFertilizationAlongsideOpenWater","notation":["Micro"],"prefLabel":{"nl":"Niet bemesten langs open water","en":"No fertilization alongside open water"},"definition":{"nl":"Het onbemest laten van een aangewezen strook langs open water om directe nutriëntenbelasting en afspoeling naar de watergang te beperken.","en":"Leaving a designated strip adjacent to open water unfertilised to limit direct nutrient inputs and runoff into the watercourse."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SoilAmendments","notation":["Meso"],"prefLabel":{"nl":"Bodemverbeteraars","en":"Soil amendments"},"definition":{"nl":"Het toevoegen van materialen aan de bodem om fysische, chemische of biologische eigenschappen te veranderen, zoals structuur, pH of vochtvasthoudend vermogen, niet uitsluitend als bemesting.","en":"Adding materials to soil to modify its physical, chemical or biological properties, such as structure, pH or water retention, beyond direct crop nutrition alone."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SoilInnoculationWithMicrobiology","notation":["Micro"],"prefLabel":{"nl":"Bodem enten met micro-organismen","en":"Soil innoculation with microbiology"},"definition":{"nl":"Het toevoegen van geselecteerde micro-organismen aan bodem of wortelzone om biologische functies of interacties tussen planten en microben te beïnvloeden.","en":"Introducing selected microorganisms into soil or the root zone with the aim of influencing biological functions or plant-microbe interactions."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/BioInocculantsBiostimulantEffectiveMicroorganismsOrganicBasedPreparations","notation":["Nano"],"prefLabel":{"nl":"Microbiële inoculanten, biostimulanten en organische preparaten","en":"Bio inocculants; Biostimulant; Effective microorganisms; Organic-based preparations"},"definition":{"nl":"Het toedienen van microbiële inoculanten, biostimulanten of organische preparaten om nutriëntenbeschikbaarheid, plantengroei, wortelontwikkeling of biologische bodemprocessen te beïnvloeden.","en":"Applying microbial inoculants, biostimulants or organic preparations intended to influence nutrient availability, plant growth, root development or soil biological processes."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Biochar","notation":["Micro"],"prefLabel":{"nl":"Biochar","en":"biochar"},"definition":{"nl":"Het toepassen van koolstofrijk materiaal dat door verhitting van biomassa bij weinig zuurstof is gemaakt, vooral als bodemverbeteraar en mogelijk voor langdurige koolstofvastlegging.","en":"Applying carbon-rich material made by heating biomass under oxygen-limited conditions, mainly as a soil amendment and potentially as a long-term carbon store."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Gypsum","notation":["Micro"],"prefLabel":{"nl":"Gips","en":"gypsum"},"definition":{"nl":"Het toedienen van calciumsulfaat aan de bodem als bodemverbeteraar die calcium en zwavel levert en onder geschikte omstandigheden bodemchemie of structuur beïnvloedt.","en":"Applying calcium sulphate to soil as an amendment that supplies calcium and sulphur and can influence soil chemistry or structure under suitable conditions."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PreparationMadeFromOrganicMaterials","notation":["Micro"],"prefLabel":{"nl":"Preparaat van organisch materiaal","en":"Preparation made from organic materials"},"definition":{"nl":"Het gebruiken van een preparaat gemaakt uit organisch plantaardig of dierlijk materiaal, zoals extracten of gefermenteerde producten, als landbouwkundige input.","en":"Using a preparation produced from organic plant or animal materials, such as extracts or fermented products, as an agricultural input."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Liming","notation":["Micro"],"prefLabel":{"nl":"Bekalking","en":"Liming"},"definition":{"nl":"Het toedienen van kalkhoudende materialen om de bodem-pH te verhogen of verzuring te corrigeren op basis van bodemonderzoek en gewasbehoefte.","en":"Applying lime-based materials to raise soil pH or correct acidity, according to soil tests and crop requirements."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Shells","notation":["Nano"],"prefLabel":{"nl":"Schelpen","en":"shells"},"definition":{"nl":"Het toedienen van gemalen schelpen of daarvan afkomstig calciumcarbonaat aan de bodem, meestal voor beïnvloeding van de zuurgraad of aanvoer van calcium.","en":"Applying ground shells or shell-derived calcium carbonate to soil, generally to influence acidity or supply calcium, subject to material suitability."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/StoneFlowerZelolith","notation":["Micro"],"prefLabel":{"nl":"Steenmeel en zeoliet","en":"Stone flower, Zelolith"},"definition":{"nl":"Het toedienen van fijngemalen gesteentemeel of zeoliet aan de bodem om mineralen aan te voeren of nutriëntenuitwisseling en bodemchemie te beïnvloeden.","en":"Applying finely ground mineral rock powders or zeolite materials to soil to supply minerals or influence nutrient exchange and soil chemistry."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/UseOfSpecificFertilizerTypesOrManure","notation":["Meso"],"prefLabel":{"nl":"Specifieke meststoffen of mesttypen gebruiken","en":"use of specific fertilizer types or manure"},"definition":{"nl":"Het kiezen van specifieke meststoffen of mesttypen vanwege nutriëntensamenstelling, vrijkomgedrag of bodemeffecten, afgestemd op gewas en bodem.","en":"Choosing defined fertiliser or manure types for their nutrient composition, release properties or soil effects, according to crop and soil needs."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Biofertilizer","notation":["Micro"],"prefLabel":{"nl":"Biologische meststof","en":"Biofertilizer"},"definition":{"nl":"Het toepassen van microbiële producten of biologisch verkregen bemestende inputs om nutriëntenbeschikbaarheid of plantenvoeding te ondersteunen; de precieze categorie hangt af van samenstelling en regelgeving.","en":"Using a microbial product or biologically derived fertilising input to support nutrient availability or plant nutrition; the exact category depends on product composition and regulation."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CompostTea","notation":["Micro"],"prefLabel":{"nl":"Compostthee","en":"Compost tea"},"definition":{"nl":"Een waterig extract van compost, soms met beluchting bereid, dat als vloeibare bodem- of plantbehandeling wordt gebruikt; samenstelling en werkzaamheid verschillen per bereiding.","en":"An aqueous extract of compost, sometimes prepared with aeration, used as a liquid soil or plant treatment; composition and evidence of effectiveness vary by preparation."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CompostUse","notation":["Micro"],"prefLabel":{"nl":"Compostgebruik","en":"Compost use"},"definition":{"nl":"Het toedienen van biologisch afgebroken organisch materiaal aan de bodem voor aanvoer van organische stof en nutriënten en beïnvloeding van structuur en bodemleven.","en":"Applying biologically decomposed organic materials to soil to add organic matter and nutrients and influence soil structure and biological activity."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Digestate","notation":["Micro"],"prefLabel":{"nl":"Digestaat","en":"digestate"},"definition":{"nl":"Het benutten van het restmateriaal na anaerobe vergisting van mest of andere biomassa als nutriëntenbron of bodeminvoer, afhankelijk van samenstelling en regelgeving.","en":"Using the residual material remaining after anaerobic digestion of manure or other biomass as a nutrient source or soil input, subject to composition and regulations."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/FoliarFertilizerUse","notation":["Micro"],"prefLabel":{"nl":"Bladbemesting","en":"Foliar fertilizer use"},"definition":{"nl":"Het via bespuiting toedienen van opgeloste voedingsstoffen op bladeren als aanvulling op de gewasvoeding, waarbij opname afhangt van nutriëntvorm en gewastoestand.","en":"Applying dissolved nutrients to leaves by spraying in order to supplement crop nutrition, with uptake depending on nutrient form and plant conditions."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/GreenManureUse","notation":["Micro"],"prefLabel":{"nl":"Groenbemesting","en":"Green manure use"},"definition":{"nl":"Het telen of inwerken van een gewas voornamelijk om organische stof en soms nutriënten aan de bodem toe te voegen, in plaats van het als hoofdproduct te oogsten.","en":"Growing or incorporating a crop mainly to supply organic matter and sometimes nutrients to the soil rather than harvesting it as a marketable product."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/HumanureComposting","notation":["Micro"],"prefLabel":{"nl":"Compostering van menselijke uitwerpselen","en":"Humanure composting"},"definition":{"nl":"Het onder gecontroleerde omstandigheden composteren van menselijke uitwerpselen om organisch materiaal te stabiliseren en ziekteverwekkers te verminderen; strenge hygiëne- en wettelijke eisen gelden.","en":"Treating human excreta through controlled composting to stabilise organic material and reduce pathogens before any permitted use; strict hygiene and legal requirements apply."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/IncorperatingCropResidues","notation":["Micro"],"prefLabel":{"nl":"Inwerken van gewasresten","en":"Incorperating crop residues"},"definition":{"nl":"Het inwerken van oogstresten, zoals stro, stengels en bladeren, in de bodem zodat ze afbreken en organische stof en nutriënten terugleveren.","en":"Mixing harvested crop residues such as straw, stems or leaves into the soil for decomposition and return of organic matter and nutrients."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SheepWoolFertilizer","notation":["Micro"],"prefLabel":{"nl":"Schapenwol als meststof","en":"Sheep wool fertilizer"},"definition":{"nl":"Het gebruiken van verwerkte schapenwol als organische, langzaam afbrekende nutriëntenbron, vooral voor stikstof, voor bodem of gewassen.","en":"Applying processed sheep wool as an organic, slowly decomposing nutrient source, particularly of nitrogen, to soil or crops."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SolidManure","notation":["Micro"],"prefLabel":{"nl":"Vaste mest","en":"solid manure"},"definition":{"nl":"Het toepassen van dierlijke mest met een relatief hoog drogestofgehalte, vaak met strooisel, als organische meststof of bodemverbeteraar.","en":"Applying livestock manure with a relatively high dry-matter content, often containing bedding material, as an organic fertiliser or soil amendment."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/UseOfBokashi","notation":["Micro"],"prefLabel":{"nl":"Bokashi toepassen","en":"Use of bokashi"},"definition":{"nl":"Het toepassen van onder relatief zuurstofarme omstandigheden gefermenteerd organisch materiaal als bodeminvoer, anders dan volledig uitgerijpte aerobe compost.","en":"Applying fermented organic material prepared under relatively low-oxygen conditions as a soil input, distinct from fully matured aerobic compost."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/UsingOrganicFertilizers","notation":["Micro"],"prefLabel":{"nl":"Organische meststoffen gebruiken","en":"Using organic fertilizers"},"definition":{"nl":"Het toedienen van bemestende materialen uit plantaardige of dierlijke bronnen, zoals mest of compost, voor nutriënten en vaak organische stof.","en":"Applying fertilising materials derived from plant or animal sources, such as manure or compost, to supply nutrients and often organic matter."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Vermicompost","notation":["Micro"],"prefLabel":{"nl":"Wormencompost","en":"Vermicompost"},"definition":{"nl":"Het gebruiken van organisch materiaal dat met behulp van regenwormen en micro-organismen is afgebroken en omgezet als bodemverbeteraar of meststof.","en":"Using organic material decomposed and processed with the help of earthworms and microorganisms as a soil amendment or fertiliser."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WoodChips","notation":["Micro"],"prefLabel":{"nl":"Houtsnippers","en":"Wood chips"},"definition":{"nl":"Het gebruiken van versnipperd hout op het bedrijf, bijvoorbeeld als mulch, strooisel of bodembedekking, waarbij effecten afhangen van materiaal en toepassing.","en":"Using chipped woody biomass on the farm, for example as mulch, bedding or soil-cover material, with effects depending on material and application."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReductionLimitationOfSpecificFertilizers","notation":["Meso"],"prefLabel":{"nl":"Specifieke meststoffen verminderen of beperken","en":"Reduction/ limitation of specific  fertilizers"},"definition":{"nl":"Het verminderen of begrenzen van aangewezen meststoffen of nutriënten in plaats van dezelfde beperking op alle meststoftypen toe te passen.","en":"Reducing or limiting designated fertiliser products or nutrients rather than imposing the same restriction on all fertiliser types."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReductionOrganicFertilizers","notation":["Micro"],"prefLabel":{"nl":"Organische bemesting verminderen","en":"Reduction organic fertilizers"},"definition":{"nl":"Het verminderen van giften organische meststoffen of mest om nutriëntenbalansen te verbeteren en overmatige nutriëntenbelasting te beperken.","en":"Reducing applications of organic fertilisers or manures to meet nutrient balances and limit excess nutrient loading."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/EGAnimalManure","notation":["Nano"],"prefLabel":{"nl":"Dierlijke mest","en":"(e.g. animal manure)"},"definition":{"nl":"Het toepassen van uitwerpselen of strooiselmest van landbouwhuisdieren als organische bron van nutriënten en organische stof, met aandacht voor opslag en emissies.","en":"Applying excreta or bedding-based manure from farm animals as an organic source of nutrients and organic matter, with attention to storage and application impacts."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MinimalUseOfExternalFertilizersInputsFromOutsideTheFarm","notation":["Micro"],"prefLabel":{"nl":"Minimaal gebruik van meststoffen van buiten het bedrijf","en":"Minimal use of external fertilizers inputs (from outside the farm)"},"definition":{"nl":"Het zoveel mogelijk voorzien in gewasvoeding door nutriëntenkringlopen op het eigen bedrijf en het beperken van aangekochte of aangevoerde meststoffen.","en":"Obtaining as much crop nutrition as feasible from on-farm nutrient cycling while limiting purchased or imported fertilisers."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoExternalFertilizersUsedAsInput","notation":["Micro"],"prefLabel":{"nl":"Geen meststoffen van buiten het bedrijf","en":"No external fertilizers used as input"},"definition":{"nl":"Het telen zonder aanvoer van meststoffen van buiten het bedrijf en de gewasvoeding baseren op interne nutriëntenbronnen en kringlopen.","en":"Operating the crop production system without fertilisers imported from outside the farm, relying instead on internal nutrient sources and cycling."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReducingFertilizerUse","notation":["Micro"],"prefLabel":{"nl":"Meststoffengebruik verminderen","en":"Reducing fertilizer use"},"definition":{"nl":"Het verminderen van de totale meststoffengift terwijl de nutriëntenaanvoer op de gewasbehoefte wordt afgestemd en balansen worden gevolgd.","en":"Reducing total fertiliser inputs while matching crop nutrient supply to demand and monitoring nutrient balances."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReducingSysntheticNFerterilizers","notation":["Micro"],"prefLabel":{"nl":"Gebruik van synthetische stikstofmeststoffen verminderen","en":"Reducing sysnthetic N-ferterilizers"},"definition":{"nl":"Het specifiek verminderen van synthetische stikstofmeststoffen, bijvoorbeeld via vlinderbloemigen, organische nutriëntenbronnen of nauwkeuriger bemesting.","en":"Specifically reducing manufactured nitrogen fertilisers, for example by using legumes, organic nutrient sources or more precise application."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/RestrictionInQuanityAboveLegalNorms","notation":["Micro"],"prefLabel":{"nl":"Aanvullende beperking van hoeveelheden boven wettelijke normen","en":"restriction in quanity (above legal norms)"},"definition":{"nl":"Het hanteren van een aanvullende vrijwillige of contractuele maximumhoeveelheid voor een input, strenger dan de wettelijke beperking.","en":"Imposing an additional voluntary or contractual cap on quantities of an input beyond the restrictions already required by law."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/RestrictionInTimingAboveLegalNorms","notation":["Micro"],"prefLabel":{"nl":"Aanvullende beperking van tijdstip boven wettelijke normen","en":"restriction in timing (above legal norms)"},"definition":{"nl":"Het hanteren van aanvullende beperkingen aan het tijdstip waarop een input of maatregel wordt gebruikt, strenger dan wettelijke perioden of timingregels.","en":"Imposing additional restrictions on when a farming input or practice may be used, beyond legally required closed periods or timing rules."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceSyntheticFertilizers","notation":["Micro"],"prefLabel":{"nl":"Kunstmestgebruik verminderen","en":"Reduce synthetic fertilizers"},"definition":{"nl":"Het verminderen van industrieel vervaardigde minerale meststoffen via beter nutriëntenbeheer of vervanging door andere nutriëntenbronnen.","en":"Lowering applications of industrially manufactured mineral fertilisers through improved nutrient management or substitution with other nutrient sources."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/UseOfControlledReleaseOrOtherMitigatedFertilizersEnhancedEfficienyFertilizersReduceArtificialNFertilizersFoliarApplication","notation":["Nano"],"prefLabel":{"nl":"Gecontroleerd vrijkomende en efficiëntere meststoffen gebruiken","en":"Use of controlled release or other mitigated fertilizers/ enhanced efficieny fertilizers, Reduce artificial N fertilizers, Foliar application"},"definition":{"nl":"Het gebruiken van gecontroleerd vrijkomende of efficiëntere meststoffen en gerichte toedieningsmethoden om nutriënten over de tijd beter beschikbaar te stellen en verliezen te beperken.","en":"Using controlled-release or enhanced-efficiency fertilisers and targeted application methods to improve nutrient availability over time and reduce avoidable losses."}}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/LimitationOfSpecificFertilizers","notation":["Meso"],"prefLabel":{"nl":"Beperking van specifieke meststoffen","en":"Limitation of specific fertilizers"},"definition":{"nl":"Het beperken van het gebruik van bepaalde soorten of samenstellingen meststoffen, bijvoorbeeld specifieke minerale producten, volgens een afgesproken beheerregel.","en":"Restricting the use of designated fertiliser types or compositions, such as particular mineral inputs, under a defined farm management rule."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoSyntheticFertilizerUse","notation":["Micro"],"prefLabel":{"nl":"Geen kunstmest","en":"No synthetic fertilizer use"},"definition":{"nl":"Het telen zonder vervaardigde synthetische minerale meststoffen en andere nutriëntenbronnen gebruiken met aandacht voor de nutriëntenbalans.","en":"Supplying crops without manufactured synthetic mineral fertilisers, relying on other nutrient sources while accounting for nutrient balances."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SyntheticFertilizer","notation":["Nano"],"prefLabel":{"nl":"Kunstmest","en":"synthetic fertilizer"},"definition":{"nl":"Het toedienen van industrieel vervaardigde minerale meststoffen die plantenvoedingsstoffen leveren in geconcentreerde anorganische of industrieel verwerkte vorm.","en":"Applying manufactured mineral fertilisers that supply plant nutrients in concentrated inorganic or industrially processed forms."}}]}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SoilManagement","notation":["Macro"],"prefLabel":{"nl":"Bodembeheer","en":"Soil management"},"definition":{"nl":"Het plannen en toepassen van maatregelen die bodemstructuur, vruchtbaarheid, bodemleven, waterhuishouding en het langdurige productievermogen beschermen of verbeteren.","en":"Planning and applying practices that protect or improve soil structure, fertility, biology, water dynamics and long-term productive capacity."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SoilAndMachineryUse","notation":["Meso"],"prefLabel":{"nl":"Bodem en machinegebruik","en":"Soil and machinery use"},"definition":{"nl":"Het afstemmen van bodembeheer op machinekeuze, werktijdstip en rijbewegingen om schade aan bodemstructuur te beperken en veldwerk mogelijk te maken.","en":"Coordinating soil management with the selection, timing and traffic of farm machinery to limit damage to soil structure and support field operations."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ApplicationMachinesWithLowerAxelweight10TonsAxle","notation":["Micro"],"prefLabel":{"nl":"Machines met lagere aslast (minder dan 10 ton per as)","en":"Application machines with lower axelweight (<10 tons/axle)"},"definition":{"nl":"Het gebruiken van werktuigen voor veldtoepassingen met een aslast onder 10 ton per as om de belasting van de bodem en het risico op diepe verdichting te beperken.","en":"Using field application machinery with an axle load below 10 tonnes per axle to reduce pressure on soil and the risk of deep compaction compared with heavier equipment."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ControlledTrafficLanes","notation":["Micro"],"prefLabel":{"nl":"Vaste rijpaden","en":"Controlled traffic lanes"},"definition":{"nl":"Het concentreren van zware veldbewegingen op vaste rijsporen zodat de overige bodem minder vaak wordt bereden en minder risico op verdichting heeft.","en":"Restricting heavy field traffic to permanent, designated wheel tracks so that the remainder of the field is driven on less frequently and is less compacted."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ControlledTrafficLanesPerSeason","notation":["Micro"],"prefLabel":{"nl":"Seizoensgebonden vaste rijpaden","en":"Controlled traffic lanes per season"},"definition":{"nl":"Het per teeltseizoen aanwijzen en gebruiken van rijsporen voor machines om willekeurig rijden en de oppervlakte met herhaalde wielbelasting te beperken.","en":"Planning designated machine tracks for a growing season, rather than driving randomly across the field, to limit the area repeatedly compacted by wheels."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DragHoseManureSpreading","notation":["Micro"],"prefLabel":{"nl":"Mest uitrijden met sleepslangen","en":"Drag hose manure spreading"},"definition":{"nl":"Het via een lange slang vanaf een pomp of opslagtank aanvoeren van drijfmest naar de veldmachine, zodat zware mesttanks minder over het perceel hoeven te rijden.","en":"Supplying slurry to a field applicator through a hose from a remote pump or tank, avoiding repeated trips by heavy slurry tankers on the field."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MinimizeTractorUse","notation":["Micro"],"prefLabel":{"nl":"Tractorinzet minimaliseren","en":"Minimize tractor use"},"definition":{"nl":"Het verminderen van aantallen, afstanden of intensiteit van tractorbewerkingen door werkzaamheden te combineren, ander materieel of minder werkgangen.","en":"Reducing the number, distance or intensity of tractor operations through combined tasks, alternative equipment or less frequent field passes."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoHeavyMachinery","notation":["Micro"],"prefLabel":{"nl":"Geen zware machines","en":"No heavy machinery"},"definition":{"nl":"Het vermijden van machines boven een afgesproken massa- of aslastgrens op percelen om drukbelasting en bodemverdichting te beperken.","en":"Avoiding field machinery above a chosen weight or axle-load threshold to reduce pressure and the risk of soil compaction."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/OnlyUseMachineryOnDryPeriods","notation":["Micro"],"prefLabel":{"nl":"Machines alleen inzetten in droge perioden","en":"only use machinery on dry periods"},"definition":{"nl":"Het uitvoeren van veldwerk met zware machines alleen wanneer de bodem voldoende droog of draagkrachtig is om structuurschade en verdichting te beperken.","en":"Scheduling field operations with heavy equipment only when the soil is sufficiently dry or load-bearing to limit structural damage and compaction."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceHeavyMachinery","notation":["Micro"],"prefLabel":{"nl":"Inzet van zware machines verminderen","en":"Reduce heavy machinery"},"definition":{"nl":"Het verminderen van zware veldmachines door lichter materieel, minder werkgangen of aangepaste logistiek om bodemverdichting te beperken.","en":"Decreasing use of high-weight field machinery through lighter equipment, fewer passes or changes in field logistics to limit soil compaction."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceMechanizationManualLowTechFarming","notation":["Micro"],"prefLabel":{"nl":"Mechanisatie verminderen en handmatig of laagtechnologisch werken","en":"Reduce mechanization, Manual/low tech farming"},"definition":{"nl":"Het vervangen van een deel van machinale werkzaamheden door handarbeid of laagtechnologisch gereedschap om machinegebruik of energievraag te beperken.","en":"Replacing part of mechanised farm operations with manual work or low-technology equipment to reduce machinery use or energy demand."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SoilSeedbedPreparation","notation":["Meso"],"prefLabel":{"nl":"Bodem- en zaaibedvoorbereiding","en":"soil - seedbed preparation"},"definition":{"nl":"Het voorbereiden van bodemoppervlak en zaai- of plantzone met gekozen bewerkingen, rekening houdend met bodemstructuur en vocht.","en":"Preparing the soil surface and seed zone for sowing or planting through selected mechanical operations while managing soil structure and moisture."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DirectSeeding","notation":["Micro"],"prefLabel":{"nl":"Directzaai","en":"Direct seeding"},"definition":{"nl":"Het direct zaaien van zaad op de uiteindelijke groeiplaats, vaak in gewasresten of nauwelijks bewerkte grond, zonder eerst planten op te kweken en te verplanten.","en":"Sowing seed directly into its final growing position, often into crop residues or minimally disturbed soil, without raising and transplanting seedlings."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Flachenrotte","notation":["Micro"],"prefLabel":{"nl":"Flächenrotte (oppervlakkige compostering)","en":"Flachenrotte"},"definition":{"nl":"Het oppervlakkig laten verteren van verse plantenresten of organisch materiaal, vaak met lichte inwerking in de bovenste bodemlaag om biologische afbraak te stimuleren.","en":"Shallow surface decomposition of fresh plant residues or organic materials, often with limited incorporation into the topsoil to encourage biological breakdown."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/HugelkulturRaisedBeds","notation":["Micro"],"prefLabel":{"nl":"Hügelkultur en verhoogde teeltbedden","en":"Hügelkultur/ raised beds"},"definition":{"nl":"Het aanleggen van verhoogde teeltbedden met houtachtig materiaal en organische stof die geleidelijk verteren en vocht en nutriënten kunnen vasthouden of vrijgeven.","en":"Building raised planting beds with woody material and organic matter, allowing decomposition and gradual release of moisture and nutrients."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/KeepLivingRoots","notation":["Micro"],"prefLabel":{"nl":"Levende wortels in de bodem behouden","en":"Keep living roots"},"definition":{"nl":"Het zo lang mogelijk gedurende het jaar behouden van levende plantenwortels in de bodem via meerjarige gewassen, bodembedekkers of overlappende teeltperioden.","en":"Maintaining living plant roots in the soil for as much of the year as practical through perennial crops, cover crops or overlapping growing periods."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MulchingWithCropResidues","notation":["Micro"],"prefLabel":{"nl":"Mulchen met gewasresten","en":"Mulching with crop residues"},"definition":{"nl":"Het laten liggen of verspreiden van gewasresten op het bodemoppervlak als mulchlaag die kale grond afdekt en verdamping kan beperken.","en":"Leaving or spreading crop residues on the soil surface as a protective mulch layer that reduces bare soil exposure and can slow evaporation."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/StubbleRetentionIncorporateCropResiduesLeftoverPruningMaterialIncorporateStrawUseGreenCompostGreenManure","notation":["Nano"],"prefLabel":{"nl":"Stoppelresten behouden en organische restmaterialen inwerken","en":"Stubble retention; Incorporate crop residues; Leftover pruning material; Incorporate straw; Use green compost ; green manure"},"definition":{"nl":"Het behouden van stoppels en terugbrengen van gewasresten, stro, snoeimateriaal en groene organische materialen naar het perceel om biomassa en nutriënten te hergebruiken.","en":"Retaining stubble and returning crop, straw or pruning residues and green organic materials to the field to recycle biomass and nutrients."}}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceTillageMinimalTillage","notation":["Meso"],"prefLabel":{"nl":"Grondbewerking verminderen of minimaliseren","en":"Reduce tillage/ minimal tillage"},"definition":{"nl":"Het verminderen van frequentie, diepte of oppervlakte van mechanische bodembewerking ten opzichte van conventionele teelt om bodemverstoring te beperken.","en":"Reducing the frequency, depth or area of mechanical soil cultivation compared with conventional tillage to limit soil disturbance."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NonInversionTillage","notation":["Micro"],"prefLabel":{"nl":"Niet-kerende grondbewerking","en":"Non-inversion tillage"},"definition":{"nl":"Het losmaken of mengen van de bodem zonder het bodemprofiel te keren, waardoor de natuurlijke gelaagdheid meer behouden blijft dan bij ploegen.","en":"Loosening or mixing soil without turning the soil profile over, preserving more of its natural layer arrangement than inversion ploughing."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ChiselPlowingSubsoiling","notation":["Nano"],"prefLabel":{"nl":"Woelen en diepwoelen","en":"chisel plowing, subsoiling"},"definition":{"nl":"Het losmaken van verdichte bodemlagen met tanden of diepwoelers, meestal zonder de bodem volledig te keren, om beworteling en waterbeweging te verbeteren.","en":"Loosening compacted soil layers with tines or subsoilers, usually without fully inverting the soil, to improve rooting and water movement."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ShallowTillage","notation":["Micro"],"prefLabel":{"nl":"Ondiepe grondbewerking","en":"Shallow tillage"},"definition":{"nl":"Mechanische bodembewerking tot een relatief geringe diepte voor zaaibedvoorbereiding of gewasbeheer zonder diepe verstoring.","en":"Mechanical cultivation restricted to a relatively small depth to prepare or manage the seedbed without deep soil disturbance."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/EcoPlough","notation":["Nano"],"prefLabel":{"nl":"Ecologische ploeg","en":"eco plough"},"definition":{"nl":"Het gebruiken van een ploeg of werktuig dat ondieper werkt of de bodem minder verstoort dan conventioneel diep kerend ploegen; de uitvoering hangt af van het werktuig.","en":"Using a plough or tillage implement designed to work shallower or disturb the soil less than conventional deep inversion ploughing; the exact method depends on the machine."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MinimumTillage","notation":["Micro"],"prefLabel":{"nl":"Minimale grondbewerking","en":"Minimum tillage"},"definition":{"nl":"Het bewerken van de bodem met minder werkgangen of lagere bewerkingsintensiteit dan bij conventionele teelt met ploegen.","en":"Preparing or managing soil with a reduced number or intensity of tillage operations compared with conventional plough-based cultivation."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ShallowNonInversionTillage","notation":["Micro"],"prefLabel":{"nl":"Ondiepe niet-kerende grondbewerking","en":"Shallow non-inversion tillage"},"definition":{"nl":"Het bewerken van uitsluitend de bovenste bodemlaag zonder het bodemprofiel te keren, zodat de verstoringsdiepte en bodemkering beperkt blijven.","en":"Cultivating only the upper soil layer without turning over the soil profile, thereby limiting depth and inversion of disturbance."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/StripTillage","notation":["Micro"],"prefLabel":{"nl":"Strokenbewerking (strip-till)","en":"Strip tillage"},"definition":{"nl":"Het bewerken van alleen de smalle stroken waarin wordt gezaaid, terwijl de bodem tussen de stroken grotendeels onbewerkt blijft.","en":"Cultivating only the narrow soil strips in which seeds will be placed, leaving the soil between strips largely undisturbed."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoTillageMeso","notation":["Meso"],"prefLabel":{"nl":"Niet-kerende nulbewerking","en":"No tillage"},"definition":{"nl":"Een teeltbenadering waarin vóór het zaaien geen reguliere grondbewerking plaatsvindt en gewassen rechtstreeks in onbewerkte grond worden gevestigd, vaak met gewasresten.","en":"A cropping approach that avoids routine soil tillage before sowing and establishes crops directly in untilled soil, often retaining residues."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoTillageMicro","notation":["Micro"],"prefLabel":{"nl":"Geen grondbewerking","en":"No tillage"},"definition":{"nl":"Het rechtstreeks zaaien of planten van een gewas zonder voorafgaande mechanische bewerking of kering van de bodem over het perceel.","en":"Directly sowing or planting a crop without mechanically loosening or inverting the soil across the field before establishment."}}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CropManagament","notation":["Macro"],"prefLabel":{"nl":"Gewasbeheer","en":"Crop managament"},"definition":{"nl":"Het plannen en uitvoeren van veldbewerkingen, gewaskeuze en gewasbescherming gedurende het groeiseizoen om teeltdoelen en milieueffecten te beheren.","en":"Planning and carrying out field operations, crop selection and crop protection during the growing season to meet agronomic objectives and manage environmental effects."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ExtensiveCropRotations","notation":["Meso"],"prefLabel":{"nl":"Ruime vruchtwisseling","en":"Extensive crop rotations"},"definition":{"nl":"Het toepassen van ruimere vruchtwisselingen met meer gewassen of langere tijd tussen herhaling van hetzelfde gewas, eventueel met rustgewassen of braak.","en":"Using rotations with more crops or longer intervals before the same crop returns, potentially including soil-restoring crops and fallow phases."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/BreakPeriodInTheRotation","notation":["Micro"],"prefLabel":{"nl":"Rustperiode in de vruchtwisseling","en":"Break period in the rotation"},"definition":{"nl":"Het opnemen van een geplande tussenperiode of extensieve fase tussen teelten om ziekte- en plaagcycli te doorbreken en bodem of vegetatie te laten herstellen.","en":"Including a planned interval or low-intensity phase between crops in a rotation to interrupt pest cycles and allow soil or vegetation recovery."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CropRotation","notation":["Micro"],"prefLabel":{"nl":"Vruchtwisseling","en":"Crop rotation"},"definition":{"nl":"Het achtereenvolgens telen van verschillende gewassen of gewasgroepen op hetzelfde perceel volgens een gepland meerjarig bouwplan.","en":"Growing different crop species or crop groups on the same field in a planned temporal sequence across successive growing seasons."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DiversifiedCropRotation","notation":["Micro"],"prefLabel":{"nl":"Gevarieerde vruchtwisseling","en":"diversified crop rotation"},"definition":{"nl":"Het ontwerpen van een vruchtwisseling met meerdere gewassoorten of plantenfamilies en verschillende groeiperioden om plaagcycli te doorbreken en het bodemgebruik te variëren.","en":"Designing a rotation with several crop species or botanical families and differing growth periods to interrupt pest cycles and diversify soil use."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/HaveAMinimumRotationLengthOf6YearsFallow","notation":["Micro"],"prefLabel":{"nl":"Vruchtwisseling van minimaal zes jaar of braaklegging","en":"have a minimum rotation length of 6 years/ fallow"},"definition":{"nl":"Het hanteren van een vruchtwisseling van minimaal zes jaar voordat het uitgangsgewas terugkeert, eventueel met een braak- of extensieve fase.","en":"Using a crop rotation lasting at least six years before the starting crop recurs, potentially including a fallow or low-intensity phase."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/LegumesNFixingPlantsInOration","notation":["Micro"],"prefLabel":{"nl":"Vlinderbloemigen en stikstofbindende gewassen in de rotatie","en":"Legumes (N-fixing plants) in oration"},"definition":{"nl":"Het opnemen van vlinderbloemigen of andere stikstofbindende planten in de vruchtwisseling om biologisch gebonden stikstof aan te voeren en teelten te variëren.","en":"Including legumes or other nitrogen-fixing plants in crop rotations to introduce biologically fixed nitrogen and diversify cropping sequences."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/UseBreakCrops","notation":["Micro"],"prefLabel":{"nl":"Rustgewassen telen","en":"Use break crops"},"definition":{"nl":"Het opnemen van gewassen uit andere plantenfamilies of met afwijkende beworteling en ziektegevoeligheid om een intensieve teeltvolgorde te onderbreken.","en":"Including crops from different plant families or with distinct rooting and disease relationships to interrupt intensive cropping sequences."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WinterCropsIntermediateCrops","notation":["Micro"],"prefLabel":{"nl":"Wintergewassen en tussengewassen","en":"Winter crops / intermediate crops:"},"definition":{"nl":"Het telen van een gewas in de winter of tussen twee hoofdteelten voor bodembedekking, oogstbare productie of opname van resterende nutriënten.","en":"Cultivating a crop during the winter or in the interval between main crops to provide cover, harvestable output or nutrient capture."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CropDiversificationCoverCrops","notation":["Meso"],"prefLabel":{"nl":"Gewasdiversificatie met bodembedekkers","en":"Crop diversification -Cover crops:"},"definition":{"nl":"Het vergroten van de soortenvariatie in het teeltsysteem door bodembedekkers tussen of naast hoofdgewassen te telen voor bodembedekking en ecologische functies.","en":"Increasing the range of plant species in the cropping system by introducing cover crops between or alongside main crops for soil cover and ecological functions."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CatchCrops","notation":["Micro"],"prefLabel":{"nl":"Vanggewassen","en":"Catch crops"},"definition":{"nl":"Het telen van een gewas na of naast de hoofdteelt dat resterende nutriënten, vooral stikstof, opneemt en verliezen tussen teelten beperkt.","en":"Growing a crop after or alongside the main crop to take up residual nutrients, especially nitrogen, and reduce losses between production cycles."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MultispeciesCoverCrops","notation":["Micro"],"prefLabel":{"nl":"Bodembedekkers met meerdere soorten","en":"Multispecies cover crops"},"definition":{"nl":"Het telen van een mengsel van minimaal twee bodembedekkende plantensoorten met verschillende wortel-, nutriënten- of leefgebiedfuncties.","en":"Growing a cover-crop mixture containing at least two plant species with complementary root, nutrient or habitat characteristics."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PermanentGreeningGreenCoverOnPermanentCrops","notation":["Micro"],"prefLabel":{"nl":"Permanente groenbedekking bij meerjarige teelten","en":"Permanent greening / green cover on permanent crops"},"definition":{"nl":"Het gedurende een groot deel van het jaar behouden van levende bodembedekking in meerjarige teelten, zoals boomgaarden of wijngaarden, tussen of onder de gewasrijen.","en":"Maintaining living ground vegetation in perennial crop systems, such as orchards or vineyards, between rows or beneath plants for much of the year."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SummerCoverCrops","notation":["Micro"],"prefLabel":{"nl":"Zomerse bodembedekkers","en":"Summer cover crops"},"definition":{"nl":"Het in de zomer telen van bodembedekkers, meestal tussen hoofdteelten of na vroege oogst, om bodem te beschermen en beschikbare nutriënten op te nemen.","en":"Growing cover crops during the summer period, usually between main crops or after early harvest, to protect soil and take up available nutrients."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/WinterCoverCrops","notation":["Micro"],"prefLabel":{"nl":"Winterse bodembedekkers","en":"Winter cover crops"},"definition":{"nl":"Het telen van een gewas dat in de winter levende bodembedekking biedt om de bodem te beschermen, restnutriënten op te nemen en erosie of uitspoeling te beperken.","en":"Growing a crop that maintains living vegetation over winter to protect soil, capture residual nutrients and reduce winter erosion or leaching."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CultivationOfSpecificCropsOrVarieties","notation":["Meso"],"prefLabel":{"nl":"Teelt van specifieke gewassen of rassen","en":"Cultivation of specific crops or varieties"},"definition":{"nl":"Het kiezen en telen van bepaalde gewassen of rassen vanwege specifieke teeltkundige, voedingskundige, ecologische of marktgerichte eigenschappen.","en":"Selecting and growing particular crops or cultivars because of defined agronomic, nutritional, ecological or market characteristics."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DeepRootedSpecies","notation":["Micro"],"prefLabel":{"nl":"Diepwortelende soorten","en":"Deep rooted species"},"definition":{"nl":"Het inzetten van plantensoorten met relatief diepe wortels die diepere bodemlagen benutten en bodemstructuur, nutriëntenopname en droogtebestendigheid kunnen beïnvloeden.","en":"Including plant species with relatively deep root systems to access deeper soil layers and influence soil structure, nutrient uptake and drought tolerance."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DroughtTolerantCrops","notation":["Micro"],"prefLabel":{"nl":"Droogtetolerante gewassen","en":"drought tolerant crops"},"definition":{"nl":"Het kiezen van gewassen of rassen die bij beperkte watervoorziening relatief goed kunnen groeien of produceren dankzij fysiologische of bouwkundige eigenschappen.","en":"Choosing crop species or varieties capable of maintaining growth or yield under limited water availability through physiological or morphological adaptations."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/SelectionOfCultivarsOnBasisOfNutritionalValueAndTaste","notation":["Micro"],"prefLabel":{"nl":"Rassenkeuze op basis van voedingswaarde en smaak","en":"selection of cultivars on basis of nutritional value and taste"},"definition":{"nl":"Het kiezen van gewasrassen op basis van gewenste voedingskundige samenstelling en smaakeigenschappen, naast de teeltprestaties.","en":"Selecting crop varieties for desired nutritional composition and sensory properties, such as flavour, alongside agronomic performance."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/CropDiversificationIntercroppingPolycultureNoMonocultureCompanionPlanting","notation":["Meso"],"prefLabel":{"nl":"Gewasdiversificatie met mengteelt, polycultuur en combinatieteelt","en":"Crop diversification - Intercropping/ polyculture / no monoculture / companion planting"},"definition":{"nl":"Het gelijktijdig of in nauwe samenhang telen van meerdere gewassoorten op dezelfde grond in plaats van uitsluitend eenvormige monoculturen.","en":"Growing multiple crop species together or in close association on the same land instead of relying solely on single-species stands."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MixedIntercroppingMixedCropping","notation":["Micro"],"prefLabel":{"nl":"Mengteelt en gewascombinaties","en":"Mixed intercropping / mixed cropping"},"definition":{"nl":"Het gelijktijdig verbouwen van twee of meer gewassoorten in een gemengde stand op één perceel, zonder dat afzonderlijke rijen nodig zijn.","en":"Growing two or more crop species at the same time in a mixed stand on one field without necessarily separating them into distinct rows."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/RelayIntercropping","notation":["Micro"],"prefLabel":{"nl":"Volgteelt in overlap met hoofdgewas (relay intercropping)","en":"Relay intercropping"},"definition":{"nl":"Het inzaaien van een tweede gewas in een nog groeiend eerste gewas, zodat hun groeiperioden tijdelijk overlappen voordat het eerste gewas wordt geoogst.","en":"Sowing a second crop into a standing first crop so their growing periods overlap for part of the season before the first crop is harvested."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/RowIntercropping","notation":["Micro"],"prefLabel":{"nl":"Rijenteelten met meerdere gewassen","en":"Row intercropping"},"definition":{"nl":"Het telen van twee of meer gewassoorten in afwisselende of aangrenzende rijen op hetzelfde perceel gedurende overlappende groeiperioden.","en":"Growing two or more crop species in alternating or adjacent rows in the same field during overlapping growing periods."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/StripCropping","notation":["Micro"],"prefLabel":{"nl":"Strokenteelt","en":"Strip cropping"},"definition":{"nl":"Het telen van verschillende gewassen in naast elkaar liggende, relatief smalle stroken die breed genoeg zijn voor bewerking, vaak om diversiteit te vergroten en plaagverspreiding te beperken.","en":"Growing different crops in adjacent, relatively narrow strips wide enough for field operations, often to increase diversity and reduce pest spread."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/UnderSowing","notation":["Micro"],"prefLabel":{"nl":"Onderzaai","en":"Under sowing"},"definition":{"nl":"Het inzaaien van een tweede gewas, vaak een bodembedekker, onder een bestaande hoofdteelt zodat het vóór of na de oogst van de hoofdteelt groeit.","en":"Sowing a second crop, often a cover crop, beneath an established main crop so that it grows before or after the main crop is harvested."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Silvoarable","notation":["Micro"],"prefLabel":{"nl":"Bomen gecombineerd met akkerbouw","en":"Silvoarable"},"altLabel":{"en":["silvoarable"]},"definition":{"nl":"Een agroforestrysysteem waarin bomen of struiken met akkerbouwgewassen op dezelfde grond worden gecombineerd, bijvoorbeeld teelten tussen bomenrijen.","en":"An agroforestry system combining trees or shrubs with arable crops on the same land, for example crops between tree rows."}}]}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/PlantProtection","notation":["Macro"],"prefLabel":{"nl":"Gewasbescherming","en":"plant protection"},"definition":{"nl":"Het voorkomen, monitoren en beheersen van onkruid, plagen en ziekten om schade aan geteelde planten te beperken.","en":"The prevention, monitoring and management of weeds, pests and diseases to limit damage to cultivated plants."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NonChemicalControlWeedsPestsAndDiseases","notation":["Meso"],"prefLabel":{"nl":"Niet-chemische beheersing van onkruid, plagen en ziekten","en":"Non-chemical  control- weeds, pests and diseases"},"altLabel":{"en":["Non-chemical control- weeds, pests and diseases"]},"definition":{"nl":"Het beheersen van onkruid, plagen en gewasziekten met mechanische, fysieke, biologische of teeltkundige methoden in plaats van chemische middelen.","en":"Controlling weeds, pests and crop diseases with mechanical, physical, biological or cultural methods instead of chemical pesticides."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/AlternativeBiocontrolProductUse","notation":["Micro"],"prefLabel":{"nl":"Gebruik van alternatieve biologische bestrijdingsmiddelen","en":"Alternative biocontrol product use"},"definition":{"nl":"Het inzetten van biologische bestrijders of biologisch afgeleide middelen, zoals nuttige micro-organismen of natuurlijke vijanden, als alternatief voor gangbare chemische bestrijdingsmiddelen.","en":"Using biological control agents or biologically derived products, such as beneficial microorganisms or natural enemies, as alternatives to conventional chemical pest-control products."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/IntegratedPestManagementPrinciplesIPM","notation":["Micro"],"prefLabel":{"nl":"Principes van geïntegreerde gewasbescherming (IPM)","en":"Integrated pest management principles (IPM)"},"definition":{"nl":"Het voorkomen en beheersen van plagen via monitoring, schadedrempels, resistente rassen en biologische of niet-chemische methoden, met chemische middelen alleen wanneer gerechtvaardigd.","en":"Preventing and managing pests through monitoring, thresholds, resistant varieties and biological or non-chemical methods, using pesticides only when justified."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/IntegratedWeedManagement","notation":["Micro"],"prefLabel":{"nl":"Geïntegreerd onkruidbeheer","en":"Integrated weed management"},"definition":{"nl":"Het combineren van preventieve, teeltkundige, mechanische en zo nodig chemische maatregelen tegen onkruid om afhankelijkheid van één aanpak te beperken.","en":"Combining preventive, cultural, mechanical and where necessary chemical approaches to manage weeds while reducing reliance on any single method."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MechanicalPestManagement","notation":["Micro"],"prefLabel":{"nl":"Mechanische plaagbeheersing","en":"Mechanical pest management"},"definition":{"nl":"Het verminderen van plaagorganismen met fysieke of mechanische ingrepen, zoals barrières, vallen, verwijderen of mechanisch bestrijden, in plaats van chemische middelen.","en":"Reducing pest populations using physical or mechanical interventions such as barriers, traps, removal or mechanical destruction rather than chemical pesticides."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/MechanicalWeedManagement","notation":["Micro"],"prefLabel":{"nl":"Mechanische onkruidbestrijding","en":"Mechanical weed management"},"definition":{"nl":"Het beheersen van onkruid met mechanische bewerkingen zoals schoffelen, eggen, borstelen of maaien, in plaats van of naast herbiciden.","en":"Managing weeds by mechanical actions such as hoeing, harrowing, brushing or cutting, instead of or in addition to herbicides."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NaturalPestManagement","notation":["Micro"],"prefLabel":{"nl":"Natuurlijke plaagbeheersing","en":"Natural pest management"},"definition":{"nl":"Het beheersen van gewasplagen door natuurlijke vijanden en ecologische processen te ondersteunen, zoals predatoren, parasitoïden en leefgebiedbeheer.","en":"Controlling crop pests by supporting natural enemies and ecological processes, such as predators, parasitoids or habitat-based regulation."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NaturalWeedManagement","notation":["Micro"],"prefLabel":{"nl":"Natuurlijk onkruidbeheer","en":"Natural weed management"},"definition":{"nl":"Het onderdrukken van onkruid via ecologische maatregelen zoals concurrentie door gewassen, mulch, beweiding of vruchtwisseling, zonder primair op synthetische herbiciden te steunen.","en":"Suppressing weeds through ecological measures such as competition, mulching, grazing or crop rotation without relying primarily on synthetic herbicides."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/LimitationOnTheUseOfPlantProtectionProducts","notation":["Meso"],"prefLabel":{"nl":"Beperking van gewasbeschermingsmiddelen","en":"Limitation on the use of plant protection products"},"definition":{"nl":"Het begrenzen van de inzet van gewasbeschermingsmiddelen, bijvoorbeeld via minder toepassingen, beperkingen voor werkzame stoffen of een kleiner behandeld oppervlak.","en":"Setting limits on the use of plant protection products, for example by restricting applications, active substances or treated area."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoFungicides","notation":["Micro"],"prefLabel":{"nl":"Geen fungiciden","en":"No fungicides"},"definition":{"nl":"Het gedurende de betreffende beheerperiode niet toepassen van fungiciden op het aangewezen gewas of perceel.","en":"Not applying fungicidal plant protection products to the specified crop or field during the relevant management period."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoHerbicides","notation":["Micro"],"prefLabel":{"nl":"Geen herbiciden","en":"No herbicides"},"definition":{"nl":"Het niet toepassen van herbiciden op het aangewezen gewas of perceel en waar nodig andere vormen van onkruidbeheer gebruiken.","en":"Not applying herbicides to the specified crop or field, and using other means to manage weeds if needed."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoInsecticides","notation":["Micro"],"prefLabel":{"nl":"Geen insecticiden","en":"No insecticides"},"definition":{"nl":"Het niet toepassen van insecticiden op het aangewezen gewas of perceel en zo nodig monitoring of andere bestrijdingsmethoden gebruiken.","en":"Not applying insecticidal products to the specified crop or field, using monitoring or non-insecticidal control measures where needed."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/NoSyntheticPesticides","notation":["Micro"],"prefLabel":{"nl":"Geen synthetische gewasbeschermingsmiddelen","en":"No synthetic pesticides"},"definition":{"nl":"Het telen zonder synthetisch-chemische gewasbeschermingsmiddelen en zo nodig preventieve, biologische of mechanische methoden toepassen.","en":"Managing crops without applying synthetic chemical crop-protection pesticides, relying on preventive, biological or mechanical methods where necessary."}}]},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReductionOnTheUseOfPlantProtectionProducts","notation":["Meso"],"prefLabel":{"nl":"Gewasbeschermingsmiddelengebruik verminderen","en":"Reduction on the use of plant protection products"},"definition":{"nl":"Het verminderen van hoeveelheid, toepassingsfrequentie of behandeld oppervlak van gewasbeschermingsmiddelen binnen een duidelijke gewasbeschermingsstrategie.","en":"Reducing the amount, frequency or treated area of plant protection products while maintaining an explicit crop-protection strategy."},"narrower":[{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceFungicides","notation":["Micro"],"prefLabel":{"nl":"Fungicidengebruik verminderen","en":"Reduce fungicides"},"definition":{"nl":"Het verminderen van het aantal of de dosis fungicidetoepassingen en tegelijk preventie, monitoring of alternatieve ziektebeheersing inzetten.","en":"Reducing the number or dose of fungicide applications while using prevention, monitoring or alternative disease-control measures."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceHerbicides","notation":["Micro"],"prefLabel":{"nl":"Herbicidengebruik verminderen","en":"Reduce herbicides"},"definition":{"nl":"Het verminderen van herbicidengebruik via lagere doseringen of minder toepassingen en aanvullend mechanisch of ecologisch onkruidbeheer.","en":"Reducing the use of herbicides through lower application rates or frequency and complementary mechanical or ecological weed management."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceInsecticides","notation":["Micro"],"prefLabel":{"nl":"Insecticidengebruik verminderen","en":"Reduce insecticides"},"definition":{"nl":"Het verminderen van insecticidetoepassingen door preventieve teeltmaatregelen, monitoring en waar passend niet-chemische plaagbeheersing.","en":"Reducing insecticide applications by using preventive crop measures, monitoring and non-chemical pest control where appropriate."}},{"id":"https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/ReduceSyntheticPesticides","notation":["Micro"],"prefLabel":{"nl":"Gebruik van synthetische gewasbeschermingsmiddelen verminderen","en":"Reduce synthetic pesticides"},"definition":{"nl":"Het verminderen van synthetisch-chemische gewasbeschermingsmiddelen door preventie, monitoring en niet-chemische gewasbescherming te versterken.","en":"Reducing applications of synthetic chemical pesticides by strengthening prevention, monitoring and non-chemical crop protection measures."}}]}]}]}],"@context":{"@version":1.1,"id":"@id","type":"@type","@vocab":"http://www.w3.org/2004/02/skos/core#","xsd":"http://www.w3.org/2001/XMLSchema#","dct":"http://purl.org/dc/terms/","dc":"http://purl.org/dc/elements/1.1/","schema":"https://schema.org/","vann":"http://purl.org/vocab/vann/","ldp":"http://www.w3.org/ns/ldp#","owl":"http://www.w3.org/2002/07/owl#","title":{"@id":"dct:title","@container":"@language"},"dc:title":{"@id":"dc:title","@container":"@language"},"dc:description":{"@id":"dc:description","@container":"@language"},"description":{"@id":"dct:description","@container":"@language"},"license":{"@id":"dct:license","@container":"@language"},"issued":{"@id":"dct:issued","@type":"xsd:date"},"created":{"@id":"dct:created","@type":"xsd:date"},"modified":{"@id":"dct:modified","@type":"xsd:date"},"creator":"dct:creator","publisher":"dct:publisher","preferredNamespacePrefix":"vann:preferredNamespacePrefix","preferredNamespaceUri":"vann:preferredNamespaceUri","isBasedOn":"schema:isBasedOn","source":"dct:source","prefLabel":{"@container":"@language"},"altLabel":{"@container":["@language","@set"]},"hiddenLabel":{"@container":["@language","@set"]},"definition":{"@container":"@language"},"note":{"@container":["@language","@set"]},"changeNote":{"@container":["@language","@set"]},"editorialNote":{"@container":["@language","@set"]},"historyNote":{"@container":["@language","@set"]},"scopeNote":{"@container":["@language","@set"]},"notation":{"@container":"@set"},"example":{"@container":"@language"},"narrower":{"@container":"@set"},"related":{"@container":"@set"},"relatedMatch":{"@container":"@set"},"narrowerTransitive":{"@container":"@set"},"broaderTransitive":{"@container":"@set"},"broadMatch":{"@container":"@set"},"narrowMatch":{"@container":"@set"},"closeMatch":{"@container":"@set"},"exactMatch":{"@container":"@set"},"hasTopConcept":{"@container":"@set"},"inScheme":{"@container":"@set"},"topConceptOf":{"@container":"@set"},"deprecated":{"@id":"owl:deprecated","@type":"xsd:boolean"},"isReplacedBy":{"@id":"dct:isReplacedBy","@container":"@set"}}}