vocab:ReduceFungicides a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg> ;
    skos:broader vocab:ReductionOnTheUseOfPlantProtectionProducts ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Reducing the number or dose of fungicide applications while using prevention, monitoring or alternative disease-control measures."@en,
        "Het verminderen van het aantal of de dosis fungicidetoepassingen en tegelijk preventie, monitoring of alternatieve ziektebeheersing inzetten."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Reduce fungicides"@en,
        "Fungicidengebruik verminderen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9283649_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Reduce fungicides'."@en,
        "Fungiciden zoveel mogelijk verminderen en/of alleen gebruik in uiterste noodzaak"@nl ;
    schema:creditText "Foto: Henk Monster / Anefo / Wikimedia Commons (controleer bron en licentie)." .

vocab:ReduceHeavyMachinery a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilAndMachineryUse ;
    skos:definition "Decreasing use of high-weight field machinery through lighter equipment, fewer passes or changes in field logistics to limit soil compaction."@en,
        "Het verminderen van zware veldmachines door lichter materieel, minder werkgangen of aangepaste logistiek om bodemverdichting te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Reduce heavy machinery"@en,
        "Inzet van zware machines verminderen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9297217_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:ReduceHerbicides a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg> ;
    skos:broader vocab:ReductionOnTheUseOfPlantProtectionProducts ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Reducing the use of herbicides through lower application rates or frequency and complementary mechanical or ecological weed management."@en,
        "Het verminderen van herbicidengebruik via lagere doseringen of minder toepassingen en aanvullend mechanisch of ecologisch onkruidbeheer."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Reduce herbicides"@en,
        "Herbicidengebruik verminderen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg?width=960> ;
