vocab:GrasslandTypeSwardAge a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg> ;
    skos:broader vocab:GrasslandAndGrazing ;
    skos:definition "Classifying grassland according to how long the current sward has existed since establishment or last renewal."@en,
        "Het indelen van grasland naar de tijd dat de huidige zode aanwezig is sinds aanleg of de laatste vernieuwing."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:PermanentGrasslandSwardAtLeast5YearsOldRenewedWithin15years,
        vocab:PermanentGrasslandSwardOlderThan15Year,
        vocab:PermanentGrasslandSwardRegularyRenewedWithinThe5Years,
        vocab:TemporaryGrasslandSwardYoungerThan5Years ;
    skos:notation "Meso" ;
    skos:prefLabel "grassland type - sward age"@en,
        "Graslandtype naar leeftijd van de zode"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Grazing_cows_in_the_open_fields_of_Utrecht_province.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "Animals are grazing on grassland. The photograph illustrates the practical connection between grazing, grassland use and livestock farming."@en,
        "De dieren grazen op grasland. De foto toont de praktische samenhang tussen beweiding, het gebruik van grasland en het houden van vee."@nl ;
    schema:creditText "Foto: Wikimedia Commons, grazende koeien in de provincie Utrecht (Nederland)." .

vocab:LimitationOnTheUseOfPlantProtectionProducts a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg> ;
    skos:broader vocab:PlantProtection ;
    skos:changeNote "Definitie en overgenomen uit ReGeNL practice_list_0.2.1, kolom: English scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Setting limits on the use of plant protection products, for example by restricting applications, active substances or treated area."@en,
        "Het begrenzen van de inzet van gewasbeschermingsmiddelen, bijvoorbeeld via minder toepassingen, beperkingen voor werkzame stoffen of een kleiner behandeld oppervlak."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (en): A ClassificationElement in the RegenerativePracticeFramework at Meso level with label 'Limitation on the use of plant protection products'."@nl,
        "Voorgaande PoC-definitie (en): this class includes the practices where there are limitations in the use of plant protection products on the whole field (excluding partial spatial limitations such as  landscape features, buffer strips...)"@nl ;
    skos:inScheme vocab: ;
    skos:narrower vocab:NoFungicides,
        vocab:NoHerbicides,
        vocab:NoInsecticides,
        vocab:NoSyntheticPesticides ;
    skos:notation "Meso" ;
    skos:prefLabel "Limitation on the use of plant protection products"@en,
        "Beperking van gewasbeschermingsmiddelen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "this class includes the practices where there are limitations in the use of plant protection products on the whole field (excluding partial spatial limitations such as  landscape features, buffer strips...)"@en,
        "Het beperken van het gebruik van gewasbeschermingsmiddelen op het gehele perceel."@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows crops grown in an organic farming context. It illustrates crop production and management on farmland as an aspect of the practice “Limitation on the use of plant protection products”."@en,
        "De foto toont een landbouwperceel met gewassen in een biologische landbouwcontext. Zo wordt teelt en gewasbeheer op landbouwgrond zichtbaar als onderdeel van de praktijk ‘Beperking van gewasbeschermingsmiddelen’."@nl ;
    schema:creditText "Foto: Henk Monster / Anefo / Wikimedia Commons (controleer bron en licentie)." .

vocab:MinimizeWaterUse a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Drip_irrigation.jpg> ;
    skos:broader vocab:WaterManagement ;
    skos:definition "Reducing the total water consumed by farm operations or crops through efficiency, reuse or demand management."@en,
        "Het verminderen van het totale waterverbruik van bedrijfsactiviteiten of teelten door efficiëntie, hergebruik of vraaggericht beheer."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:DryFarming,
        vocab:MinimizeIrrigation,
        vocab:ReduceWaterUse,
        vocab:WaterSavingIrrigation ;
    skos:notation "Meso" ;
    skos:prefLabel "Minimize water use"@en,
        "Watergebruik minimaliseren"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Drip_irrigation.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "Water is delivered close to the plants through drip irrigation lines. This is a clear example of targeted water application in crop production."@en,
        "Water wordt via druppelleidingen dicht bij de planten aangevoerd. Dit is een herkenbaar voorbeeld van gerichte watertoediening in de teelt."@nl .

vocab:ReductionOnTheUseOfPlantProtectionProducts a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Gurken_Feld_Unkraut_Hackger%C3%A4t-1-Josef_Schlaghecken.jpg> ;
    skos:broader vocab:PlantProtection ;
    skos:changeNote "Definitie en overgenomen uit ReGeNL practice_list_0.2.1, kolom: English scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Reducing the amount, frequency or treated area of plant protection products while maintaining an explicit crop-protection strategy."@en,
        "Het verminderen van hoeveelheid, toepassingsfrequentie of behandeld oppervlak van gewasbeschermingsmiddelen binnen een duidelijke gewasbeschermingsstrategie."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (en): A ClassificationElement in the RegenerativePracticeFramework at Meso level with label 'Reduction on the use of plant protection products'."@nl,
        "Voorgaande PoC-definitie (en): this class includes the practices where there are limitations in the use of fertilisers on the whole field (excluding partial spatial limitations such as  landscape features, buffer strips...)"@nl ;
    skos:inScheme vocab: ;
    skos:narrower vocab:ReduceFungicides,
        vocab:ReduceHerbicides,
        vocab:ReduceInsecticides,
        vocab:ReduceSyntheticPesticides ;
    skos:notation "Meso" ;
    skos:prefLabel "Reduction on the use of plant protection products"@en,
        "Gewasbeschermingsmiddelengebruik verminderen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Gurken_Feld_Unkraut_Hackger%C3%A4t-1-Josef_Schlaghecken.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "this class includes the practices where there are limitations in the use of fertilisers on the whole field (excluding partial spatial limitations such as  landscape features, buffer strips...)"@en ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "Weeds are mechanically hoed between crop rows. The photograph illustrates how equipment can control weeds without directly applying herbicides."@en,
        "Tussen de gewasrijen wordt mechanisch geschoffeld. De foto illustreert hoe onkruid met een werktuig kan worden bestreden zonder directe inzet van herbiciden."@nl .

vocab:SoilManagement a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg> ;
    skos:broader vocab:CropProductionManagement ;
    skos:definition "Planning and applying practices that protect or improve soil structure, fertility, biology, water dynamics and long-term productive capacity."@en,
        "Het plannen en toepassen van maatregelen die bodemstructuur, vruchtbaarheid, bodemleven, waterhuishouding en het langdurige productievermogen beschermen of verbeteren."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:NoTillageMeso,
        vocab:ReduceTillageMinimalTillage,
        vocab:SoilAndMachineryUse,
        vocab:SoilSeedbedPreparation ;
    skos:notation "Macro" ;
    skos:prefLabel "Soil management"@en,
        "Bodembeheer"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The field is covered with oilseed radish. This crop illustrates how green manure can contribute to soil cover and crop rotation."@en,
        "Het perceel is begroeid met bladrammenas. Het gewas laat zien hoe een groenbemester onderdeel kan zijn van bodembedekking en vruchtwisseling."@nl ;
    schema:creditText "Foto: Wikimedia Commons, bladrammenas als groenbemester in Nederland." .

vocab:SpecificFertilizerApplicationTechniques a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:FertilizationAndManureManagement ;
    skos:changeNote "Definitie en overgenomen uit ReGeNL practice_list_0.2.1, kolom: English scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Using selected methods for nutrient placement or delivery, such as injection, band placement or precision spreading, to improve efficiency and reduce losses."@en,
        "Het toepassen van gekozen manieren om nutriënten toe te dienen, zoals injecteren, rijenbemesting of precisieverspreiding, om efficiëntie te vergroten en verliezen te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (en): A ClassificationElement in the RegenerativePracticeFramework at Meso level with label 'Specific fertilizer application techniques'."@nl,
        "Voorgaande PoC-definitie (en): quantity or time limitation of application"@nl ;
    skos:inScheme vocab: ;
    skos:narrower vocab:AddingWaterToSlurryManure,
        vocab:DepeningOnTheNeedOfTheCropLesOrLessOften,
        vocab:MoreEfficientFertilizerAplication,
        vocab:NoFertilizationAlongsideOpenWater ;
    skos:notation "Meso" ;
    skos:prefLabel "Specific fertilizer application techniques"@en,
        "Specifieke bemestingstechnieken"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "quantity or time limitation of application"@en ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows a compost heap containing organic material. It illustrates the collection and processing of organic residual materials as an aspect of the practice “Specific fertilizer application techniques”."@en,
        "De foto toont een composthoop met organisch materiaal. Zo wordt het verzamelen en verwerken van organische restmaterialen zichtbaar als onderdeel van de praktijk ‘Specifieke bemestingstechnieken’."@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:WaterManagement a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Waterbeheersing_onderaan_de_dijk._Locatie,_Noarderleech.jpg> ;
    skos:broader vocab:LandManagement ;
    skos:definition "Coordinating drainage, irrigation, storage and water-level control on farmland to maintain production while addressing water quality and ecological needs."@en,
        "Het afstemmen van drainage, irrigatie, wateropslag en peilbeheer op landbouwgrond om productie, waterkwaliteit en ecologische behoeften te dienen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:KeepWaterLevelsHighMeso,
        vocab:MaintainWaterlevelsConstant,
        vocab:MinimizeWaterUse,
        vocab:WaterStorage ;
    skos:notation "Macro" ;
    skos:prefLabel "Water management"@en,
        "Waterbeheer"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Waterbeheersing_onderaan_de_dijk._Locatie%2C_Noarderleech.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “Waterbeheersing onderaan de dijk. Locatie, Noarderleech”. It illustrates the related agricultural context as an aspect of the practice “Water management”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘Waterbeheersing onderaan de dijk. Locatie, Noarderleech’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Waterbeheer’."@nl .

vocab:CropDiversificationCoverCrops a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg> ;
    skos:broader vocab:CropManagament ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch meso. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Increasing the range of plant species in the cropping system by introducing cover crops between or alongside main crops for soil cover and ecological functions."@en,
        "Het vergroten van de soortenvariatie in het teeltsysteem door bodembedekkers tussen of naast hoofdgewassen te telen voor bodembedekking en ecologische functies."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (nl): Het telen van een aanvullend gewas voor landbouwkundige of milieukundige doeleinden naast of tussen de hoofdteelten."@nl ;
    skos:inScheme vocab: ;
    skos:narrower vocab:CatchCrops,
        vocab:MultispeciesCoverCrops,
        vocab:PermanentGreeningGreenCoverOnPermanentCrops,
        vocab:SummerCoverCrops,
        vocab:WinterCoverCrops ;
    skos:notation "Meso" ;
    skos:prefLabel "Crop diversification -Cover crops:"@en,
        "Gewasdiversificatie met bodembedekkers"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Bladrammenas_groenbemesting_Raphanus_sativus_subsp._oleiferus.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "the inclusion of plants grown for agronomic or environmental purposes in addition to the main crop on a land management unit"@en,
        "Gewassen die worden geteeld voor agronomische of milieu/ ecologische doeleinden, aanvullend op een hoofdgewas"@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "The field is covered with oilseed radish. This crop illustrates how green manure can contribute to soil cover and crop rotation."@en,
        "Het perceel is begroeid met bladrammenas. Het gewas laat zien hoe een groenbemester onderdeel kan zijn van bodembedekking en vruchtwisseling."@nl ;
    schema:creditText "Foto: Wikimedia Commons, bladrammenas als groenbemester in Nederland." .

vocab:FertilizationAndManureManagement a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:A_manure_storage_silo_in_the_fields_near_Smilde,_Netherlands,_spring_2012.jpg> ;
    skos:broader vocab:CropProductionManagement ;
    skos:definition "Planning the production, storage, treatment and application of manure and fertilisers to supply crops with nutrients while limiting losses to air and water."@en,
        "Het plannen van productie, opslag, verwerking en toediening van mest en meststoffen om gewassen te voeden en verliezen naar lucht en water te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:LimitationOfSpecificFertilizers,
        vocab:ReductionLimitationOfSpecificFertilizers,
        vocab:SoilAmendments,
        vocab:SpecificFertilizerApplicationTechniques,
        vocab:UseOfSpecificFertilizerTypesOrManure ;
    skos:notation "Macro" ;
    skos:prefLabel "fertilization and manure management"@en,
        "Bemesting en mestbeheer"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/A_manure_storage_silo_in_the_fields_near_Smilde%2C_Netherlands%2C_spring_2012.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Macro level with label 'fertilization and manure management'."@en ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows animal manure on a farm. It illustrates the management of organic nutrient flows as an aspect of the practice “fertilization and manure management”."@en,
        "De foto toont dierlijke mest op een landbouwbedrijf. Zo wordt het beheer van organische nutriëntenstromen zichtbaar als onderdeel van de praktijk ‘Bemesting en mestbeheer’."@nl .

vocab:ReduceTillageMinimalTillage a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilManagement ;
    skos:definition "Reducing the frequency, depth or area of mechanical soil cultivation compared with conventional tillage to limit soil disturbance."@en,
        "Het verminderen van frequentie, diepte of oppervlakte van mechanische bodembewerking ten opzichte van conventionele teelt om bodemverstoring te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:MinimumTillage,
        vocab:NonInversionTillage,
        vocab:ShallowNonInversionTillage,
        vocab:ShallowTillage,
        vocab:StripTillage ;
    skos:notation "Meso" ;
    skos:prefLabel "Reduce tillage/ minimal tillage"@en,
        "Grondbewerking verminderen of minimaliseren"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "minimize soil disturbance due to tillage"@en,
        "Het beperken van de intensiteit of frequentie van bodembewerking om verstoring van de bodem te verminderen."@nl ;
    regenlmeta:photoCaptionStatus "image-replacement-needed" ;
    regenlmeta:photoPracticeDescription "Agricultural soil is the focus of the photograph, making the physical basis of soil management visible."@en,
        "De landbouwbodem staat centraal op de foto. Zo wordt de fysieke basis van het bodembeheer zichtbaar."@nl ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:RenewableEnergy a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Sheep_under_solar_panels_(1)_2025-07-26.jpg> ;
    skos:broader vocab:BioeconomyEnergyEfficiencyAndProduction ;
    skos:definition "Generating or using energy from naturally replenishing sources, such as sunlight, wind or sustainably managed biomass, for farm activities."@en,
        "Het opwekken of gebruiken van energie uit zich natuurlijk vernieuwende bronnen, zoals zonlicht, wind of duurzaam beheerde biomassa, voor bedrijfsactiviteiten."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
