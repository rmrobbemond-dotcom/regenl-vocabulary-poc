{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/R1-0016",
  "type": "Concept",
  "prefLabel": {
    "nl": "Afstotende begeleidende gewassen",
    "en": "Repellent companion plants"
  },
  "definition": {
    "nl": "Het doelgericht telen van begeleidende plantensoorten in of nabij een hoofdgewas die door hun chemische of andere biologische eigenschappen de aantrekking, vestiging of activiteit van specifieke plaagorganismen in het hoofdgewas ontmoedigen.",
    "en": "The deliberate cultivation of companion plant species within or near a main crop whose chemical or other biological properties deter the attraction, establishment or activity of specific pest organisms in the main crop."
  },
  "changeNote": {
    "nl": [
      "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; Nederlandse formele benaming aangepast van ‘Afstotende gezelschapsplanten’ naar ‘Afstotende begeleidende gewassen’; nieuwe afbeelding nodig."
    ]
  },
  "editorialNote": {
    "nl": [
      "Mega ontbreekt in bron; afgeleid uit dezelfde Macro-categorie."
    ]
  },
  "notation": [
    "Micro"
  ],
  "broader": {
    "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/meso-1c38510133a39039",
    "prefLabel": {
      "nl": "Push-pull-plaagbeheer",
      "en": "Push-pull pest manamgent"
    }
  },
  "inScheme": [
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/scheme"
