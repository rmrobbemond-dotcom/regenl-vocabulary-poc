practice:R1-0042 a skos:Concept ;
    dcterms:identifier "PRACTICE_R1_0042" ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Anaerobic_digestate.JPG> ;
    skos:broader practice:meso-5afe732b24c9ad5e ;
    skos:changeNote "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; formele benaming aangepast; afbeeldingskandidaat overgenomen."@nl ;
    skos:definition "The application of digestate from anaerobic digestion or suitable sludge streams from wastewater treatment or other processing operations as a source of nutrients and potentially organic matter for the soil and crops."@en,
        "Het toepassen van digestaat uit anaerobe vergisting of daarvoor geschikte slibstromen uit afvalwaterzuivering of andere verwerkingsprocessen als bron van nutriënten en eventueel organische stof voor de bodem en het gewas."@nl ;
    skos:inScheme practice:scheme ;
    skos:notation "Micro" ;
    skos:prefLabel "Application of digestate or sludge as fertiliser"@en,
        "Toepassing van digestaat of slib als meststof"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Anaerobic_digestate.JPG?width=960> ;
    regenlmeta:classificationLevel "Micro" ;
    regenlmeta:definitionStatus "user-reviewed" ;
    regenlmeta:farmerContentSource "Geplakte tekst(20261124-142404).txt" ;
    regenlmeta:farmerDescription "Using digestate or suitable sludge as fertiliser, provided that its application is legally permitted and safe."@en,
        "Het gebruiken van digestaat of een geschikte slibstroom als meststof, voor zover dit wettelijk is toegestaan en veilig kan."@nl ;
    regenlmeta:farmerDescriptionStatus "user-reviewed" ;
    regenlmeta:farmerLabel "Apply digestate or sludge as fertiliser"@en,
        "Digestaat of slib toepassen"@nl ;
    regenlmeta:farmerTopic "Fertilisation and soil nutrition"@en,
        "Bemesting en bodemvoeding"@nl ;
    regenlmeta:originalPracticeIdentifier "PRACTICE_R1_0042" ;
