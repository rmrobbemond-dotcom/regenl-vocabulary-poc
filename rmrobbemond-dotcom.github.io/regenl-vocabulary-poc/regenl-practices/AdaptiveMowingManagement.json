{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/AdaptiveMowingManagement",
  "type": "Concept",
  "prefLabel": {
    "nl": "Adaptief maaibeheer",
    "en": "adaptive mowing management"
  },
  "definition": {
    "nl": "Het aanpassen van maaidata, maaifrequentie, maaihoogte en ruimtelijk maaipatroon aan de actuele vegetatieontwikkeling, weersomstandigheden en biodiversiteitsdoelen in plaats van een vast maaischema.",
    "en": "Adjusting mowing dates, frequency, height and spatial patterns to current vegetation growth, weather and biodiversity objectives rather than following a fixed schedule."
  },
  "editorialNote": {
    "en": [
      "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."
    ]
  },
  "notation": [
    "Meso"
  ],
  "narrower": [
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DelayedMowingDateForMeadowBirdProtection15JuneOrBotanicalProtectionJuly",
      "prefLabel": {
        "nl": "Uitgestelde maaidatum voor weidevogels (15 juni) of botanisch beheer (juli)",
        "en": "delayed mowing date for meadow bird protection ( 15 June) or botanical protection (July)"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/DiversificationOfMowingActivitiesOnFieldAndFarmScale",
      "prefLabel": {
        "nl": "Diversificatie van maaibeheer op perceels- en bedrijfsniveau",
        "en": "diversification of mowing activities on field and farm scale"
      }
    }
  ],
  "broader": {
    "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/GrasslandAndGrazing",
