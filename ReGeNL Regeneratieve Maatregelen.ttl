vocab:SolidManure a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:UseOfSpecificFertilizerTypesOrManure ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Applying livestock manure with a relatively high dry-matter content, often containing bedding material, as an organic fertiliser or soil amendment."@en,
        "Het toepassen van dierlijke mest met een relatief hoog drogestofgehalte, vaak met strooisel, als organische meststof of bodemverbeteraar."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "solid manure"@en,
        "Vaste mest"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9300754_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'solid manure'."@en,
        "Het gebruik van vaste mest of stalmest"@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:SpaceForTheAnimalsToSleepAndRest a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Dairy_farm_(P-062705-00-19).jpg> ;
    skos:broader vocab:AnimalHousing ;
    skos:definition "Providing livestock with sufficient, suitable resting and lying areas, including clean and comfortable surfaces, as part of housing welfare management."@en,
        "Het bieden van voldoende geschikte rust- en ligplaatsen voor dieren, met schone en comfortabele oppervlakken, als onderdeel van diergericht huisvestingsbeheer."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "space for the animals to sleep and rest"@en,
        "Rust- en ligruimte voor dieren"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Dairy%20farm%20(P-062705-00-19).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_10503798_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Europese Commissie, audiovisuele dienst / Lukasz Kobus, Yügen (CC BY 4.0)."@nl .

vocab:Standweide a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg> ;
    skos:broader vocab:GrazingSystem ;
    skos:definition "Continuous grazing in which animals have access to the same pasture or grazing unit over an extended period rather than being moved frequently between paddocks."@en,
        "Een vorm van voortdurende beweiding waarbij dieren gedurende langere tijd toegang hebben tot hetzelfde grasland of graasblok in plaats van frequent tussen percelen te wisselen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "standweide"@en,
        "Standweide"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9291745_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Jeff Vanuga / USDA NRCS (publiek domein in de Verenigde Staten)."@nl .

vocab:SteppingStones05Ha a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Hedgerow_around_an_arable_field_-_geograph.org.uk_-_3670471.jpg> ;
    skos:broader vocab:HabitatProvisionBiodiversityEnhancement ;
    skos:definition "Creating or retaining habitat patches larger than 0.5 hectares that serve as intermediate refuges or links between larger natural areas."@en,
        "Het aanleggen of behouden van leefgebiedplekken groter dan 0,5 hectare die als tussenliggende schuilplaatsen of verbindingen tussen grotere natuurgebieden dienen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "stepping stones (> 0.5 ha)"@en,
        "Ecologische stapstenen (meer dan 0,5 ha)"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Hedgerow_around_an_arable_field_-_geograph.org.uk_-_3670471.jpg?width=960> ;
