    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Reduce insecticides'."@en,
        "Insecticiden zoveel mogelijk verminderen en/of alleen gebruik in uiterste noodzaak"@nl ;
    schema:creditText "Foto: Henk Monster / Anefo / Wikimedia Commons (controleer bron en licentie)." .

vocab:ReduceMechanizationManualLowTechFarming a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Soil_Health_(20220420-NRCS-UNK-063).jpg> ;
    skos:broader vocab:SoilAndMachineryUse ;
    skos:definition "Replacing part of mechanised farm operations with manual work or low-technology equipment to reduce machinery use or energy demand."@en,
        "Het vervangen van een deel van machinale werkzaamheden door handarbeid of laagtechnologisch gereedschap om machinegebruik of energievraag te beperken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Reduce mechanization, Manual/low tech farming"@en,
        "Mechanisatie verminderen en handmatig of laagtechnologisch werken"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Soil_Health_(20220420-NRCS-UNK-063).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9294505_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Jason Johnson / USDA NRCS (public domain, U.S. federal government)."@nl .

vocab:ReduceSyntheticPesticides a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg> ;
    skos:broader vocab:ReductionOnTheUseOfPlantProtectionProducts ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Reducing applications of synthetic chemical pesticides by strengthening prevention, monitoring and non-chemical crop protection measures."@en,
        "Het verminderen van synthetisch-chemische gewasbeschermingsmiddelen door preventie, monitoring en niet-chemische gewasbescherming te versterken."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Reduce synthetic pesticides"@en,
        "Gebruik van synthetische gewasbeschermingsmiddelen verminderen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Organic_agriculture_in_the_Netherlands_(P-025148-00-08).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9293638_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Reduce synthetic pesticides'."@en,
        "Synthetische bestrijdingsmiddelen/gewasbeschermingsmiddelen zoveel mogelijk verminderen"@nl ;
    schema:creditText "Foto: Henk Monster / Anefo / Wikimedia Commons (controleer bron en licentie)." .

vocab:ReduceWaterUse a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Drip_irrigation.jpg> ;
    skos:broader vocab:MinimizeWaterUse ;
    skos:definition "Decreasing the amount of water consumed by farm processes or crop irrigation through better scheduling, efficient devices or reuse."@en,
        "Het verminderen van de hoeveelheid water die bedrijfsprocessen of beregening verbruiken door betere planning, efficiënte voorzieningen of hergebruik."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Reduce water use"@en,
        "Watergebruik verminderen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Drip_irrigation.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9294505_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: USDA (public domain, U.S. federal government)."@nl .

vocab:ReducingFertilizerUse a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:ReductionLimitationOfSpecificFertilizers ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Reducing total fertiliser inputs while matching crop nutrient supply to demand and monitoring nutrient balances."@en,
        "Het verminderen van de totale meststoffengift terwijl de nutriëntenaanvoer op de gewasbehoefte wordt afgestemd en balansen worden gevolgd."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Reducing fertilizer use"@en,
        "Meststoffengebruik verminderen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9289815_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Reducing fertilizer use'."@en,
        "Algemene vermindering van meststoffengebruik"@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:ReducingSysntheticNFerterilizers a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:ReductionLimitationOfSpecificFertilizers ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Specifically reducing manufactured nitrogen fertilisers, for example by using legumes, organic nutrient sources or more precise application."@en,
        "Het specifiek verminderen van synthetische stikstofmeststoffen, bijvoorbeeld via vlinderbloemigen, organische nutriëntenbronnen of nauwkeuriger bemesting."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Reducing sysnthetic N-ferterilizers"@en,
        "Gebruik van synthetische stikstofmeststoffen verminderen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9287214_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'Reducing sysnthetic N-ferterilizers'."@en,
        "Het verminderd of minimaal gebruik van kunstmest met stikstof"@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:RelayIntercropping a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Intercropping_maize_and_beans.jpg> ;
    skos:broader vocab:CropDiversificationIntercroppingPolycultureNoMonocultureCompanionPlanting ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Sowing a second crop into a standing first crop so their growing periods overlap for part of the season before the first crop is harvested."@en,
        "Het inzaaien van een tweede gewas in een nog groeiend eerste gewas, zodat hun groeiperioden tijdelijk overlappen voordat het eerste gewas wordt geoogst."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (nl): Een mengteelt waarbij de groeiperiodes van twee of meer gewassen slechts gedeeltelijk overlappen."@nl ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Relay intercropping"@en,
        "Volgteelt in overlap met hoofdgewas (relay intercropping)"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Intercropping_maize_and_beans.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9299142_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "Type of intercropping where the species overlap only for a portion of their growth duration"@en,
        "Twee of meer hoofdgewassen die slechts gedurende een deel van hun groeiperiode overlappen"@nl ;
    schema:creditText "Foto: AnnaJB (CC BY-SA 4.0)."@nl .

vocab:RemoteSensingMonitoring a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Precision_Farming_in_Minnesota_-_False_Colour.jpg> ;
    skos:broader vocab:MeasuringAndMonitoring ;
    skos:definition "Repeatedly observing crops, soil or land conditions through sensors that measure reflected or emitted energy from satellites, aircraft or drones."@en,
        "Het herhaald waarnemen van gewassen, bodem of landgebruik met sensoren op satellieten, vliegtuigen of drones die gereflecteerde of uitgezonden straling meten."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Remote sensing monitoring"@en,
        "Monitoring via remote sensing"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Precision_Farming_in_Minnesota_-_False_Colour.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9289865_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Beeld: Wikimedia Commons, precisielandbouw / remote sensing (controleer bron en licentie)." .

vocab:RestrictionInQuanityAboveLegalNorms a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:ReductionLimitationOfSpecificFertilizers ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Imposing an additional voluntary or contractual cap on quantities of an input beyond the restrictions already required by law."@en,
        "Het hanteren van een aanvullende vrijwillige of contractuele maximumhoeveelheid voor een input, strenger dan de wettelijke beperking."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "restriction in quanity (above legal norms)"@en,
        "Aanvullende beperking van hoeveelheden boven wettelijke normen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9297943_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'restriction in quanity (above legal norms)'."@en,
        "Specifieke normen voor de hoeveeheid bemesting die strenger zijn dan de geldende wetgeving"@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:RestrictionInTimingAboveLegalNorms a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Compost_heap_at_a_farmstead_i.jpg> ;
    skos:broader vocab:ReductionLimitationOfSpecificFertilizers ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch farmer explanation. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Imposing additional restrictions on when a farming input or practice may be used, beyond legally required closed periods or timing rules."@en,
        "Het hanteren van aanvullende beperkingen aan het tijdstip waarop een input of maatregel wordt gebruikt, strenger dan wettelijke perioden of timingregels."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "restriction in timing (above legal norms)"@en,
        "Aanvullende beperking van tijdstip boven wettelijke normen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Compost_heap_at_a_farmstead_i.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9815657_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "A ClassificationElement in the RegenerativePracticeFramework at Micro level with label 'restriction in timing (above legal norms)'."@en,
        "Specifieke normen het momenten van bemest die strenger zijn dan de geldende wetgeving"@nl ;
    schema:creditText "Foto: Alandislands (CC BY-SA; controleer versie)."@nl .

vocab:RotationalGrazing a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg> ;
    skos:broader vocab:GrazingSystem ;
    skos:definition "Moving livestock among defined grazing areas in sequence so that grazed pasture can recover before animals return."@en,
        "Het achtereenvolgens verplaatsen van vee tussen afgebakende graasdelen, zodat eerder beweid grasland kan herstellen voordat de dieren terugkeren."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "rotational grazing"@en,
        "Rotatiebeweiding"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/NRCSAR02005_-_Arkansas_%28193%29%28NRCS_Photo_Gallery%29.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9285405_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "use more than one paddock in a pasture to restrict livestock grazing to a certain area"@en,
        "Een beweidingsmethode waarbij dieren achtereenvolgens toegang krijgen tot verschillende delen van grasland in plaats van voortdurend het hele perceel te beweiden."@nl ;
    schema:caption "Rotational grazing using electric fencing: contrast between grazed and ungrazed pasture."@en,
        "Rotatiebeweiding met elektrische afrastering: verschil tussen beweid en nog niet beweid grasland."@nl ;
    schema:creditText "Foto: Jeff Vanuga / USDA NRCS (publiek domein in de Verenigde Staten)."@nl .

vocab:RowIntercropping a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Intercropping_maize_and_beans.jpg> ;
    skos:broader vocab:CropDiversificationIntercroppingPolycultureNoMonocultureCompanionPlanting ;
    skos:changeNote "Definitie nl overgenomen uit ReGeNL practice_list_0.2.1, kolom: Dutch scientific. Bronbestand: practice_list_0.2.1__git_ (1).xlsx."@nl ;
    skos:definition "Growing two or more crop species in alternating or adjacent rows in the same field during overlapping growing periods."@en,
        "Het telen van twee of meer gewassoorten in afwisselende of aangrenzende rijen op hetzelfde perceel gedurende overlappende groeiperioden."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:historyNote "Voorgaande PoC-definitie (nl): Het gelijktijdig telen van twee gewassen in afwisselende rijen op hetzelfde perceel."@nl ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Row intercropping"@en,
        "Rijenteelten met meerdere gewassen"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Intercropping_maize_and_beans.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9298066_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:originalDefinition "two species cultivated in alternate rows"@en,
        "Twee of meer soorten die in afwisselende rijen worden geteeld"@nl ;
    schema:creditText "Foto: AnnaJB (CC BY-SA 4.0)."@nl .

vocab:RuggedVegetation a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Hedgerow_around_an_arable_field_-_geograph.org.uk_-_3670471.jpg> ;
    skos:broader vocab:HabitatProvisionBiodiversityEnhancement ;
    skos:definition "Retaining or developing taller, less intensively managed herbaceous vegetation or scrub patches as varied habitat in the agricultural landscape."@en,
        "Het behouden of ontwikkelen van hogere, minder intensief beheerde ruige kruidenvegetatie of struweel als gevarieerd leefgebied in het landbouwlandschap."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "rugged vegetation"@en,
        "Ruigtevegetatie"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Hedgerow_around_an_arable_field_-_geograph.org.uk_-_3670471.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9283978_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Foto: Stanley Howe (controleer licentie op Commons)."@nl .

vocab:SatelliteImageryAndMonitoring a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Precision_Farming_in_Minnesota_-_False_Colour.jpg> ;
    skos:broader vocab:MeasuringAndMonitoring ;
    skos:definition "Using repeated satellite images and derived vegetation, moisture or land-cover indicators to observe field conditions and detect changes over time."@en,
        "Het gebruiken van herhaalde satellietbeelden en daaruit afgeleide indicatoren voor vegetatie, vocht of landbedekking om perceelomstandigheden en veranderingen te volgen."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Satellite imagery and monitoring"@en,
        "Satellietbeelden en monitoring"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Precision_Farming_in_Minnesota_-_False_Colour.jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9290718_2 ;
    regenlmeta:definitionStatus "editorial-draft" ;
    schema:creditText "Beeld: Wikimedia Commons, precisielandbouw / remote sensing (controleer bron en licentie)." .

vocab:SelectionOfCultivarsOnBasisOfNutritionalValueAndTaste a skos:Concept ;
    dcterms:source <https://commons.wikimedia.org/wiki/File:Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg> ;
    skos:broader vocab:CultivationOfSpecificCropsOrVarieties ;
    skos:definition "Selecting crop varieties for desired nutritional composition and sensory properties, such as flavour, alongside agronomic performance."@en,
        "Het kiezen van gewasrassen op basis van gewenste voedingskundige samenstelling en smaakeigenschappen, naast de teeltprestaties."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "selection of cultivars on basis of nutritional value and taste"@en,
        "Rassenkeuze op basis van voedingswaarde en smaak"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Cover_crop_in_field_-_geograph.org.uk_-_5236028.jpg?width=960> ;
