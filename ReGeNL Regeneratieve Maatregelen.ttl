    skos:inScheme vocab: ;
    skos:notation "Micro" ;
    skos:prefLabel "Planting shade trees"@en,
        "Schaduwbomen aanplanten"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Cattle_grazing_in_a_silvopasture._(25086463696).jpg?width=960> ;
    regenlimg:proposedDepiction regenlimg:wur-54418_418941_9287660_2 ;
