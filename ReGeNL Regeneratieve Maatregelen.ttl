practice:R1-0024 a skos:Concept ;
    dcterms:identifier "PRACTICE_R1_0024" ;
    skos:broader practice:meso-6e527d77f1befe6a ;
    skos:changeNote "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; formele benaming aangescherpt; nieuwe afbeelding nodig."@nl ;
    skos:definition "Covering the soil surface with organic or biodegradable material to suppress the germination, emergence or growth of unwanted plants through mechanisms including light interception and physical exclusion."@en,
        "Het bedekken van het bodemoppervlak met organisch of biologisch afbreekbaar materiaal om de kieming, opkomst of groei van ongewenste planten te beperken door onder meer lichtonderschepping en fysieke afscherming."@nl ;
    skos:inScheme practice:scheme ;
    skos:notation "Micro" ;
    skos:prefLabel "Mulching with organic or biodegradable material"@en,
        "Mulchen met organisch of biologisch afbreekbaar materiaal"@nl ;
    regenlmeta:classificationLevel "Micro" ;
    regenlmeta:definitionStatus "user-reviewed" ;
    regenlmeta:farmerContentSource "Geplakte tekst(20261124-142404).txt" ;
    regenlmeta:farmerDescription "Covering the soil with materials such as straw, wood chips, crop residues or biodegradable mulch film to suppress weed growth."@en,
        "Het bedekken van de bodem met bijvoorbeeld stro, houtsnippers, gewasresten of afbreekbare mulchfolie om onkruidgroei te beperken."@nl ;
    regenlmeta:farmerDescriptionStatus "user-reviewed" ;
    regenlmeta:farmerLabel "Mulch with organic or biodegradable materials"@en,
        "Mulchen met organisch of biologisch afbreekbaar materiaal"@nl ;
