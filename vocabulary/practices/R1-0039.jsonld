{
  "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/R1-0039",
  "type": "Concept",
  "prefLabel": {
    "nl": "Vermindering van het gebruik van anorganische meststoffen",
    "en": "Reduction of use of inorganic fertilisers"
  },
  "definition": {
    "nl": "Het doelgericht verminderen van de hoeveelheid toegepaste anorganische meststoffen, bijvoorbeeld door een betere afstemming van de bemesting op de nutriëntenbehoefte van het gewas, efficiënter nutriëntenbeheer of het benutten van alternatieve nutriëntenbronnen.",
    "en": "The deliberate reduction in the quantity of inorganic fertilisers applied, for example by better aligning fertilisation with crop nutrient requirements, improving nutrient management or using alternative nutrient sources."
  },
  "changeNote": {
    "nl": [
      "Annotaties en selecteerbaarheid goedgekeurd tijdens conceptreview; afbeelding voorlopig behouden en gemarkeerd voor vervanging."
    ]
  },
  "editorialNote": {
    "en": [
      "Not really a practice. Needs to be replaced by other practices"
    ]
  },
  "notation": [
    "Micro"
  ],
  "broader": {
    "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/vocabulary/practices/meso-a3d63c8cc17b39c3",
    "prefLabel": {
      "nl": "Beperking van specifieke meststoffen",
      "en": "Reduction/ limitation of specific  fertilizers"
    }
  },
  "inScheme": [
    {
