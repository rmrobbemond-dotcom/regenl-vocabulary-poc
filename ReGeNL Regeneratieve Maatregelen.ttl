    skos:inScheme vocab: ;
    skos:notation "Nano" ;
    skos:prefLabel "wood, bioplastics"@en,
        "Hout en bioplastics"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Bio-K_Blister_CG.jpg?width=960> ;
    regenlmeta:definitionStatus "editorial-draft" ;
    regenlmeta:photoCaptionStatus "candidate-visual-and-license-review-needed" ;
    regenlmeta:photoPracticeDescription "The photograph shows an agricultural subject identified in the source as “Bio-K Blister CG”. It illustrates the related agricultural context as an aspect of the practice “wood, bioplastics”."@en,
        "De foto toont een landbouwkundig onderwerp dat in de bron als ‘Bio-K Blister CG’ wordt aangeduid. Zo wordt de betreffende landbouwcontext zichtbaar als onderdeel van de praktijk ‘Hout en bioplastics’."@nl .

vocab:WoodChips a skos:Concept ;
