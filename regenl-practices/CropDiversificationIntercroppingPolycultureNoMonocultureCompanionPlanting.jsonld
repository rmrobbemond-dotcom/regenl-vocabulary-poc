        "en": "Mixed intercropping / mixed cropping",
        "nl": "Mengteelt en gewascombinaties"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/RelayIntercropping",
      "prefLabel": {
        "en": "Relay intercropping",
        "nl": "Volgteelt in overlap met hoofdgewas (relay intercropping)"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/RowIntercropping",
      "prefLabel": {
        "en": "Row intercropping",
        "nl": "Rijenteelten met meerdere gewassen"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/StripCropping",
      "prefLabel": {
        "en": "Strip cropping",
        "nl": "Strokenteelt"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/UnderSowing",
      "prefLabel": {
        "en": "Under sowing",
        "nl": "Onderzaai"
      }
    },
    {
      "id": "https://rmrobbemond-dotcom.github.io/regenl-vocabulary-poc/regenl-practices/Silvoarable",
      "prefLabel": {
        "en": "Silvoarable",
        "nl": "Bomen gecombineerd met akkerbouw"
      }
    }
  ],
