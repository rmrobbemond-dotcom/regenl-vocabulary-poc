  "prefLabel": {
    "nl": "Individuele en collectieve kostenbesparing",
    "en": "Individual and collective forms of cost reducing measures"
  },
  "definition": {
    "nl": "Categorie voor maatregelen binnen individuele en collectieve kostenbesparing.",
    "en": "Category of practices concerning individual and collective forms of cost reducing measures."
  },
  "notation": [
    "Meso"
  ],
