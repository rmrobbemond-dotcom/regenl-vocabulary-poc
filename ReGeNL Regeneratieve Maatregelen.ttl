    skos:broader vocab:FarmCitizenInteractions ;
    skos:definition "Arrangements that deliver food directly from farms to consumers with few intermediaries, such as farm boxes, self-picking or farm shops."@en,
        "Afzetvormen waarbij voedsel met weinig tussenhandel rechtstreeks van landbouwbedrijven naar consumenten gaat, zoals pakketten, zelfoogst of boerderijwinkels."@nl ;
    skos:editorialNote "Bilingual definition drafted for the PoC; requires validation by ReGeNL domain experts. Previous source definitions are retained in regenlmeta:originalDefinition."@en ;
    skos:inScheme vocab: ;
    skos:narrower vocab:CSASelfPickingOnFarmsShops ;
    skos:notation "Meso" ;
    skos:prefLabel "Forms of direct food provisioning"@en,
        "Vormen van directe voedselvoorziening"@nl ;
    foaf:depiction <https://commons.wikimedia.org/wiki/Special:Redirect/file/Shop_front_-_farm_shop.jpg?width=960> ;
